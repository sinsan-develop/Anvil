{
 "$schema":"http://json-schema.org/draft-07/schema#",
 "$id":"anvil-host-trust-registration-v1",
 "title":"ConnectorTrustRequest",
 "oneOf":[{"$ref":"#/definitions/HostTrustRegistration"},{"$ref":"#/definitions/HostTrustConfirmation"},{"$ref":"#/definitions/HostTrustEnrollment"},{"$ref":"#/definitions/HostTrustProof"},{"$ref":"#/definitions/HostExchangeChallenge"},{"$ref":"#/definitions/HostCredentialIssue"}],
 "definitions":{
  "Uuid":{"type":"string","pattern":"^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
  "Hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},
  "Nonce":{"type":"string","pattern":"^[A-Za-z0-9_-]{43}$"},
  "Signature":{"type":"string","pattern":"^[A-Za-z0-9_-]{86}$"},
  "Timestamp":{"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"},
  "Reason":{"type":"string","minLength":1,"maxLength":20000},
  "ConnectorPolicyRef":{"type":"object","additionalProperties":false,"required":["id","version","contentHash"],"properties":{"id":{"$ref":"#/definitions/Uuid"},"version":{"type":"integer","minimum":1,"maximum":9007199254740991},"contentHash":{"$ref":"#/definitions/Hash"}}},
  "HostTrustRegistration":{
   "type":"object","additionalProperties":false,"required":["kind","hostLabel","expectedHostFingerprint","policyRef","expiresAt","reason"],
   "properties":{"kind":{"const":"HOST_TRUST_REGISTRATION"},"hostLabel":{"type":"string","minLength":1,"maxLength":200},"expectedHostFingerprint":{"$ref":"#/definitions/Hash"},"policyRef":{"$ref":"#/definitions/ConnectorPolicyRef"},"expiresAt":{"$ref":"#/definitions/Timestamp"},"reason":{"$ref":"#/definitions/Reason"}}
  },
  "HostTrustConfirmation":{
   "type":"object","additionalProperties":false,"required":["registrationId","observedHostFingerprint","scopeDigest","decision","reason"],
   "properties":{"registrationId":{"$ref":"#/definitions/Uuid"},"observedHostFingerprint":{"$ref":"#/definitions/Hash"},"scopeDigest":{"$ref":"#/definitions/Hash"},"decision":{"enum":["APPROVE","REJECT"]},"reason":{"$ref":"#/definitions/Reason"}}
  },
  "HostTrustEnrollment":{
   "type":"object","additionalProperties":false,"required":["registrationId","oneTimeCode","observedHostFingerprint","clientNonce","connectorVersion","publicKeySpki"],
   "properties":{"registrationId":{"$ref":"#/definitions/Uuid"},"oneTimeCode":{"$ref":"#/definitions/Nonce"},"observedHostFingerprint":{"$ref":"#/definitions/Hash"},"clientNonce":{"$ref":"#/definitions/Nonce"},"connectorVersion":{"type":"string","pattern":"^[A-Za-z0-9._+-]{1,80}$"},"publicKeySpki":{"type":"string","pattern":"^[A-Za-z0-9_-]{122}$"}}
  },
  "HostProofPayload":{
   "type":"object","additionalProperties":false,"required":["protocolVersion","installationId","registrationId","scopeDigest","publicKeyFingerprint","serverNonce","clientNonce","expiresAt"],
   "properties":{"protocolVersion":{"const":1},"installationId":{"$ref":"#/definitions/Uuid"},"registrationId":{"$ref":"#/definitions/Uuid"},"scopeDigest":{"$ref":"#/definitions/Hash"},"publicKeyFingerprint":{"$ref":"#/definitions/Hash"},"serverNonce":{"$ref":"#/definitions/Nonce"},"clientNonce":{"$ref":"#/definitions/Nonce"},"expiresAt":{"$ref":"#/definitions/Timestamp"}}
  },
  "HostTrustProof":{
   "type":"object","additionalProperties":false,"required":["challengeId","payload","signature"],
   "properties":{"challengeId":{"$ref":"#/definitions/Uuid"},"payload":{"$ref":"#/definitions/HostProofPayload"},"signature":{"$ref":"#/definitions/Signature"}}
  },
  "HostExchangeChallenge":{
   "type":"object","additionalProperties":false,"required":["kind","payload","signature"],
   "properties":{"kind":{"const":"CHALLENGE"},"payload":{"$ref":"#/definitions/HostProofPayload"},"signature":{"$ref":"#/definitions/Signature"}}
  },
  "HostCredentialIssue":{
   "type":"object","additionalProperties":false,"required":["kind","challengeId","payload","signature"],
   "properties":{"kind":{"const":"ISSUE"},"challengeId":{"$ref":"#/definitions/Uuid"},"payload":{"$ref":"#/definitions/HostProofPayload"},"signature":{"$ref":"#/definitions/Signature"}}
  }
 }
}
