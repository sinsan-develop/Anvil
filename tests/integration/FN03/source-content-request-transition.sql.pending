-- 미실행 미래 SQL 전이 반례 SOURCE. 실제 PG/REDGREEN/구문·경합/CAS·COMMIT 검증은 NOT_RUN.
-- typed row는 phase/전이 투영이며 완전한 원문·FK·현재권위·서명·receipt/audit fixture가 아니다.
BEGIN;
DO $$
DECLARE b anvil.source_content_requests;n anvil.source_content_requests;issued anvil.source_content_requests;reported anvil.source_content_requests;
BEGIN
 b.project_id='75000000-0000-4000-8000-000000000001';b.id='75000000-0000-4000-8000-000000000002';b.version=1;
 b.state='CREATED';b.created_at='2026-10-23T16:00:00.000Z';b.updated_at=b.created_at;b.expires_at=b.created_at+interval '10 minutes';b.exchange_failures=0;
 n=b;n.state='CHALLENGED';n.updated_at=b.created_at+interval '1 second';n.preflight_json='{}';n.preflight_digest=repeat('a',64);n.challenge_json='{}';n.challenge_issued_at=n.updated_at;n.challenge_expires_at=n.updated_at+interval '60 seconds';
 ASSERT anvil.source_content_request_transition_shape(b,n,n.updated_at) IS TRUE,'TRANSITION_CHALLENGE_PROJECTION';
 ASSERT anvil.source_content_request_transition_shape(b,n,n.updated_at-interval '1 ms') IS FALSE,'TRANSITION_WRONG_TIME';
 b=n;n.updated_at=b.updated_at+interval '1 second';n.exchange_failures=1;
 ASSERT anvil.source_content_request_transition_shape(b,n,n.updated_at) IS TRUE,'TRANSITION_FAILURE_ONE';
 n.exchange_failures=2;ASSERT anvil.source_content_request_transition_shape(b,n,n.updated_at) IS FALSE,'TRANSITION_FAILURE_JUMP';
 n=b;n.updated_at=b.updated_at+interval '1 second';n.challenge_json='{"renewed":true}';ASSERT anvil.source_content_request_transition_shape(b,n,n.updated_at) IS FALSE,'TRANSITION_CHALLENGE_REFRESH';
 issued=b;issued.state='ISSUED';issued.updated_at=b.created_at+interval '2 seconds';issued.credential_token_digest=repeat('b',64);issued.credential_scope='SOURCE_DOCUMENT_CONTENT_HASH_ONLY';issued.credential_issued_at=issued.updated_at;issued.credential_expires_at=issued.updated_at+interval '60 seconds';issued.proof_signature=repeat('A',86);issued.observation_request_ref='{}';issued.observation_nonce_digest=repeat('c',64);issued.permit_json=jsonb_build_object('issuedAt','2026-10-23T16:00:02.000Z','observeBefore','2026-10-23T16:01:02.000Z');
 ASSERT anvil.source_content_request_transition_shape(b,issued,issued.updated_at) IS TRUE,'TRANSITION_ISSUE_PROJECTION';
 n=issued;n.preflight_digest=repeat('d',64);ASSERT anvil.source_content_request_transition_shape(b,n,n.updated_at) IS FALSE,'TRANSITION_ISSUE_CHANGED_ORIGINAL';
 n=issued;n.id='75000000-0000-4000-8000-000000000009';ASSERT anvil.source_content_request_transition_shape(b,n,n.updated_at) IS FALSE,'TRANSITION_CHANGED_IDENTITY';
 reported=issued;reported.state='REPORTED';reported.updated_at=b.created_at+interval '3 seconds';reported.report_consumed_at=reported.updated_at;reported.report_consumed_command_id='75000000-0000-4000-8000-000000000003';
 ASSERT anvil.source_content_request_transition_shape(issued,reported,reported.updated_at) IS TRUE,'TRANSITION_REPORT_PROJECTION';
 n=reported;n.observation_nonce_digest=repeat('d',64);ASSERT anvil.source_content_request_transition_shape(issued,n,n.updated_at) IS FALSE,'TRANSITION_REPORT_CHANGED_NONCE';
 n=reported;n.report_consumed_command_id='75000000-0000-4000-8000-000000000004';ASSERT anvil.source_content_request_transition_shape(reported,n,n.updated_at) IS FALSE,'TRANSITION_SAME_MS_RECONSUMPTION';
 ASSERT anvil.source_content_request_transition_shape(reported,reported,reported.expires_at+interval '1 second') IS TRUE,'TRANSITION_REPLAY_NOT_PERMISSION';
 n=reported;n.state='REVOKED';n.updated_at=n.created_at+interval '4 seconds';n.revoked_at=n.updated_at;n.revoke_command_id='75000000-0000-4000-8000-000000000005';
 ASSERT anvil.source_content_request_transition_shape(reported,n,n.updated_at) IS TRUE,'TRANSITION_REVOKE_PRESERVES_CONSUMPTION';
 b=n;n=reported;n.updated_at=b.updated_at+interval '1 ms';ASSERT anvil.source_content_request_transition_shape(b,n,n.updated_at) IS FALSE,'TRANSITION_REVOKED_REENTRY';
 n=issued;n.state='UNKNOWN';n.updated_at=n.created_at+interval '4 seconds';ASSERT anvil.source_content_request_transition_shape(issued,n,n.updated_at) IS TRUE,'TRANSITION_UNKNOWN';
 issued.updated_at=n.updated_at+interval '1 ms';ASSERT anvil.source_content_request_transition_shape(n,issued,issued.updated_at) IS FALSE,'TRANSITION_UNKNOWN_REENTRY';
 n=reported;n.state='EXPIRED';ASSERT anvil.source_content_request_transition_shape(reported,n,n.updated_at) IS FALSE,'TRANSITION_EARLY_EXPIRED';
 n.updated_at=n.credential_expires_at;ASSERT anvil.source_content_request_transition_shape(reported,n,n.updated_at) IS TRUE,'TRANSITION_EXPIRED_PRESERVES_CONSUMPTION';
END;$$;
ROLLBACK;
