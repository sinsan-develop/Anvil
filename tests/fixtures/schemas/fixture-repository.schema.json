{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://envil.sinsan.kr/schemas/test/fixture-repository.schema.json",
  "title": "Anvil G-06 Fixture Repository",
  "type": "object",
  "required": ["fixture_id", "schema_version", "source_hash", "source_files", "git", "toolchain", "expected_test"],
  "properties": {
    "fixture_id": {"enum": ["FIX-PY-CLEAN", "FIX-PY-DIRTY", "FIX-PY-REDFAIL", "FIX-TS-CLEAN", "FIX-TS-NOTOOL", "FIX-PROTECTED", "FIX-LARGE", "FIX-CONFLICT"]},
    "schema_version": {"const": "1.0.0"},
    "source_hash": {"type": "string", "pattern": "^sha256:[0-9A-F]{64}$"},
    "source_files": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["path", "bytes", "sha256"]}}
  },
  "additionalProperties": true
}
