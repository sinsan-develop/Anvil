REVOKE ALL ON FUNCTION anvil.fn106_packet_valid(anvil.normal_start_preparation_dispatches,jsonb) FROM PUBLIC,anvil_v3_app;
ALTER FUNCTION anvil.fn106_complete(uuid,uuid) OWNER TO anvil_v3_migrator;
REVOKE ALL ON FUNCTION anvil.fn106_complete(uuid,uuid) FROM PUBLIC,anvil_v3_app;
ALTER FUNCTION anvil.fn106_current(uuid,text,jsonb,text) OWNER TO anvil_v3_migrator;
REVOKE ALL ON FUNCTION anvil.fn106_current(uuid,text,jsonb,text) FROM PUBLIC,anvil_v3_app;
ALTER FUNCTION anvil.fn106_result_max(anvil.normal_start_preparation_dispatches) OWNER TO anvil_v3_migrator;
REVOKE ALL ON FUNCTION anvil.fn106_result_max(anvil.normal_start_preparation_dispatches) FROM PUBLIC,anvil_v3_app;
ALTER FUNCTION anvil.fn106_storage_actual(uuid) OWNER TO anvil_v3_migrator;
REVOKE ALL ON FUNCTION anvil.fn106_storage_actual(uuid) FROM PUBLIC,anvil_v3_app;
ALTER FUNCTION anvil.fn106_storage_future(uuid) OWNER TO anvil_v3_migrator;
REVOKE ALL ON FUNCTION anvil.fn106_storage_future(uuid) FROM PUBLIC,anvil_v3_app;
ALTER FUNCTION anvil.fn106_result(uuid,jsonb,text,boolean) OWNER TO anvil_v3_migrator;
REVOKE ALL ON FUNCTION anvil.fn106_result(uuid,jsonb,text,boolean) FROM PUBLIC,anvil_v3_app;
ALTER FUNCTION anvil.fn106_immutable() OWNER TO anvil_v3_migrator;
REVOKE ALL ON FUNCTION anvil.fn106_immutable() FROM PUBLIC,anvil_v3_app;
ALTER FUNCTION anvil.fn106_final() OWNER TO anvil_v3_migrator;
REVOKE ALL ON FUNCTION anvil.fn106_final() FROM PUBLIC,anvil_v3_app;
ALTER FUNCTION anvil.fn08_normal_start_preparation_dispatch_claim(uuid,uuid,uuid,uuid,jsonb,jsonb,jsonb,jsonb,text) OWNER TO anvil_v3_migrator;
REVOKE ALL ON FUNCTION anvil.fn08_normal_start_preparation_dispatch_claim(uuid,uuid,uuid,uuid,jsonb,jsonb,jsonb,jsonb,text) FROM PUBLIC,anvil_v3_app;
ALTER FUNCTION anvil.fn08_normal_start_preparation_result_basis(uuid,text,jsonb,text) OWNER TO anvil_v3_migrator;
REVOKE ALL ON FUNCTION anvil.fn08_normal_start_preparation_result_basis(uuid,text,jsonb,text) FROM PUBLIC,anvil_v3_app;
ALTER FUNCTION anvil.fn08_normal_start_preparation_result_commit(uuid,jsonb,text) OWNER TO anvil_v3_migrator;
