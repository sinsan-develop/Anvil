-- FN09 A: HUMAN 메타 탐색 요청과 동일 등록 DISCOVERY 획득. 미적용; 실제 PG/ACL/동시성 NOT_RUN.
-- FIRST/slot/init/tail, result receipt, 선택 원문/정산, normal 검토는 아직 미연결.
-- 기존 0090/0097 파일과 일반 분기는 보존; 미공급 result/SELECT는 계속 닫힘.
BEGIN;
CREATE TABLE anvil.normal_understanding_read_requests(
 project_id uuid NOT NULL, id uuid NOT NULL, execution_id uuid NOT NULL,generation bigint NOT NULL,
 grant_id uuid NOT NULL,grant_version bigint NOT NULL,command_id uuid NOT NULL,
 content_hash text NOT NULL CHECK(content_hash~'^[0-9a-f]{64}$'),snapshot_json jsonb NOT NULL,
 created_at timestamptz NOT NULL,expires_at timestamptz NOT NULL,
 PRIMARY KEY(project_id,id),UNIQUE(project_id,command_id),
 FOREIGN KEY(project_id,execution_id,generation) REFERENCES anvil.executions(project_id,id,generation),
 FOREIGN KEY(project_id,grant_id,grant_version) REFERENCES anvil.execution_grants(project_id,id,version),
 FOREIGN KEY(project_id,command_id) REFERENCES anvil.commands(project_id,id),
 CHECK(expires_at>created_at AND expires_at<=created_at+interval '30 seconds'),
 CHECK(octet_length(anvil.fn01_json(snapshot_json))<=8192),
 CHECK(snapshot_json->>'state'='PENDING_SOURCE' AND snapshot_json->'sourceScope'='null'::jsonb)
);
ALTER TABLE anvil.normal_understanding_read_requests OWNER TO anvil_v3_migrator;
REVOKE ALL ON anvil.normal_understanding_read_requests FROM PUBLIC,anvil_v3_app;
-- 본문 없는 메타데이터도 일반 SELECT/INSERT/UPDATE/DELETE를 열지 않는다.

CREATE FUNCTION anvil.fn09_normal_understanding_request_basis(s uuid,a uuid,c uuid,q jsonb,policy jsonb,expected_tx text)
RETURNS jsonb LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog AS $$
DECLARE p uuid;eid uuid;gen bigint;pc anvil.project_control;m anvil.project_members;hs anvil.auth_sessions;
 pv anvil.permission_policy_versions;g anvil.execution_grants;x anvil.execution_commands;f jsonb;rule jsonb;cur record;
 allowed boolean=false;until_at timestamptz;at timestamptz;ctx jsonb;
BEGIN
 IF expected_tx IS DISTINCT FROM txid_current()::text OR NOT COALESCE(anvil.execution_json_shape(q,ARRAY['schemaVersion','projectId','commandId','clientId','controlGeneration','operation','targetId','expectedVersion','baselineRefs','approvalRef','payload']),false)
  OR q->'schemaVersion' IS DISTINCT FROM '1'::jsonb OR q->>'operation' IS DISTINCT FROM 'readNormalUnderstandingResponse'
  OR q->>'clientId' IS DISTINCT FROM c::text OR q->'baselineRefs' IS DISTINCT FROM '[]'::jsonb OR q->'approvalRef' IS DISTINCT FROM 'null'::jsonb
  OR NOT COALESCE(anvil.execution_json_shape(q->'payload',ARRAY['assignmentRef','preparationRef']),false)
  OR NOT COALESCE(anvil.execution_preparation_ref_valid(q#>'{payload,assignmentRef}'),false)
  OR NOT COALESCE(anvil.execution_preparation_ref_valid(q#>'{payload,preparationRef}'),false)
  OR octet_length(anvil.fn01_json(q))>8192 THEN RAISE EXCEPTION 'NORMAL_UNDERSTANDING_REQUEST_INVALID';END IF;
 p=(q->>'projectId')::uuid;eid=(q->>'targetId')::uuid;gen=(q->>'expectedVersion')::bigint;
 IF gen IS NULL OR gen<1 OR gen>9007199254740991 OR q->'expectedVersion' IS DISTINCT FROM to_jsonb(gen) OR q->'controlGeneration' IS DISTINCT FROM to_jsonb((q->>'controlGeneration')::bigint) OR (q->>'commandId')::uuid IS NULL THEN RAISE EXCEPTION 'NORMAL_UNDERSTANDING_REQUEST_INVALID';END IF;
 PERFORM anvil.fn01_active(s,a,c);
 SELECT * INTO hs FROM anvil.auth_sessions WHERE id=s AND user_id=a AND client_id=c;
 PERFORM id FROM anvil.projects WHERE id=p AND archived_at IS NULL FOR UPDATE;
 IF NOT FOUND THEN RAISE EXCEPTION 'NOT_FOUND';END IF;
 SELECT * INTO m FROM anvil.project_members WHERE project_id=p AND user_id=a AND revoked_at IS NULL FOR SHARE;
 SELECT * INTO pc FROM anvil.project_control WHERE project_id=p FOR UPDATE;
 IF m.participation IS DISTINCT FROM 'OWNER' OR pc.actor_id IS DISTINCT FROM a OR pc.client_id IS DISTINCT FROM c OR pc.revoked_at IS NOT NULL
  OR pc.generation::text IS DISTINCT FROM q->>'controlGeneration' THEN RAISE EXCEPTION 'PROJECT_CONTROL_REQUIRED';END IF;
 SELECT v.* INTO pv FROM anvil.permission_policies h JOIN anvil.permission_policy_versions v
  ON v.project_id=h.project_id AND v.policy_id=h.id AND v.version=h.head_version WHERE h.project_id=p FOR SHARE OF h;
 IF pv.policy_id IS NULL OR policy IS DISTINCT FROM jsonb_build_object('id',pv.policy_id,'version',pv.version,'contentHash',pv.content_hash)
  OR pv.content_hash IS DISTINCT FROM anvil.fn01_hash(jsonb_build_object('rules',pv.rules_json,'reason',pv.reason,'reviewRefs',pv.review_refs))
  THEN RAISE EXCEPTION 'POLICY_INTEGRITY_FAILED';END IF;
 at=clock_timestamp();IF hs.reauth_until IS NULL OR hs.reauth_until<=at THEN RAISE EXCEPTION 'REAUTHENTICATION_REQUIRED';END IF;until_at=least(hs.idle_expires_at,hs.absolute_expires_at,hs.reauth_until);
 FOR rule IN SELECT value FROM jsonb_array_elements(pv.rules_json) LOOP
  -- 일반 DENY/REQUIRE_APPROVAL을 좁은 AUTO보다 먼저 보존한다. 복수 project scope도 매칭 후 거절한다.
  IF rule#>>'{subjectRef,kind}'='HUMAN' AND rule#>>'{subjectRef,userId}'=a::text AND rule->'operations' ? 'readNormalUnderstandingResponse'
   AND EXISTS(SELECT 1 FROM jsonb_array_elements(rule->'targetScopes') t WHERE t->>'kind'='PROJECT' AND t->>'projectId'=p::text)
   AND (rule->>'expiresAt')::timestamptz>at THEN
   IF rule->>'disposition' IS DISTINCT FROM 'AUTO' OR rule->'subjectRef' IS DISTINCT FROM jsonb_build_object('kind','HUMAN','userId',a)
    OR rule->'targetScopes' IS DISTINCT FROM jsonb_build_array(jsonb_build_object('kind','PROJECT','projectId',p)) OR rule->'limitPolicyRef' IS DISTINCT FROM 'null'::jsonb
    THEN RAISE EXCEPTION 'PROJECT_OPERATION_DENIED';END IF;
   allowed=true;until_at=least(until_at,(rule->>'expiresAt')::timestamptz);
  END IF;
 END LOOP;
 IF NOT allowed THEN RAISE EXCEPTION 'PROJECT_OPERATION_DENIED';END IF;
 -- 탐색 입력은 exact assignment/preparation일 뿐 출력 부모/최초 FIRST를 주장하지 않는다.
 SELECT * INTO STRICT g FROM anvil.execution_grants z WHERE z.project_id=p AND z.execution_id=eid AND z.generation=gen
  AND z.snapshot_json->>'transport'='NORMAL_PROTECTED' AND z.snapshot_json#>>'{binding,intent,mode}'='CONTEXT_REVIEW'
  AND z.snapshot_json#>'{binding,intent,assignmentRef}'=q#>'{payload,assignmentRef}' AND z.snapshot_json#>'{binding,preparationRef}'=q#>'{payload,preparationRef}';
 f=g.snapshot_json->'binding';
 IF f#>>'{subject,userId}' IS DISTINCT FROM a::text OR f#>>'{subject,clientId}' IS DISTINCT FROM c::text
  OR f#>>'{subject,humanSessionId}' IS DISTINCT FROM s::text OR f#>>'{subject,credentialGeneration}' IS DISTINCT FROM hs.credential_generation::text
  OR EXISTS(SELECT 1 FROM anvil.executions newer WHERE newer.project_id=p AND newer.id=eid AND newer.generation>gen)
  OR NOT anvil.normal_start_material_complete(p,g.command_id) THEN RAISE EXCEPTION 'NORMAL_UNDERSTANDING_REQUEST_CURRENT_REQUIRED';END IF;
 SELECT * INTO STRICT cur FROM anvil.normal_exchange_current(p,(f#>>'{registration,connectorId}')::uuid,eid,g.id,g.version,g.content_hash,(f#>>'{executionCredentialReservation,generation}')::bigint);
 SELECT * INTO STRICT x FROM anvil.execution_commands z WHERE z.project_id=p AND z.created_command_id=g.command_id
  AND z.execution_id=eid AND z.generation=gen AND z.grant_id=g.id AND z.grant_version=g.version AND z.snapshot_json->>'operation'='START_SESSION';
 IF x.content_hash IS DISTINCT FROM anvil.execution_json_hash(x.snapshot_json-'envelope') OR x.envelope_hash IS DISTINCT FROM anvil.execution_json_hash((x.snapshot_json->'envelope')-'envelopeHash')
  OR x.snapshot_json#>>'{envelope,envelopeHash}' IS DISTINCT FROM x.envelope_hash THEN RAISE EXCEPTION 'NORMAL_UNDERSTANDING_REQUEST_SOURCE_INVALID';END IF;
 until_at=least(until_at,cur.deadline);at=clock_timestamp();IF until_at<=at THEN RAISE EXCEPTION 'NORMAL_UNDERSTANDING_REQUEST_EXPIRED';END IF;
 ctx=jsonb_build_object('projectId',p,'executionId',eid,'executionGeneration',gen,'grantRef',jsonb_build_object('id',g.id,'version',g.version,'contentHash',g.content_hash),
  'registrationRef',f#>'{registration,ref}','connectorId',f#>'{registration,connectorId}','credentialGeneration',f#>'{executionCredentialReservation,generation}',
  'startCommandId',x.snapshot_json#>'{envelope,commandId}','startCommandRef',jsonb_build_object('id',x.id,'version',x.version,'contentHash',x.content_hash),
  'assignmentRef',f#>'{intent,assignmentRef}','preparationRef',f->'preparationRef','contextBundleRef',f#>'{intent,contextBundleRef}','sessionBindingRef',f#>'{agentSession,sessionRef}');
 RETURN jsonb_build_object('context',ctx,'observedAt',to_char(at AT TIME ZONE 'UTC','YYYY-MM-DD"T"HH24:MI:SS.MS"Z"'),
  'expiresAt',to_char(until_at AT TIME ZONE 'UTC','YYYY-MM-DD"T"HH24:MI:SS.MS"Z"'));
END;
$$;

CREATE FUNCTION anvil.fn09_normal_understanding_request_complete(p uuid,rid uuid) RETURNS boolean
LANGUAGE plpgsql STABLE SECURITY DEFINER SET search_path=pg_catalog AS $$
DECLARE r anvil.normal_understanding_read_requests;c anvil.commands;s jsonb;q jsonb;ref jsonb;scope_hash text;
BEGIN
 SELECT * INTO r FROM anvil.normal_understanding_read_requests WHERE project_id=p AND id=rid;IF NOT FOUND THEN RETURN false;END IF;
 s=r.snapshot_json;q=s->'request';ref=jsonb_build_object('id',r.id,'version',1,'contentHash',r.content_hash);
 IF r.content_hash IS DISTINCT FROM anvil.fn01_hash(s) OR NOT COALESCE(anvil.execution_json_shape(s,ARRAY['schemaVersion','purpose','request','context','requestedBy','policyRef','state','sourceScope','createdAt','expiresAt']),false)
  OR s->>'purpose' IS DISTINCT FROM 'NORMAL_UNDERSTANDING_METADATA_DISCOVERY' OR s->'schemaVersion' IS DISTINCT FROM '1'::jsonb
  OR s->>'state' IS DISTINCT FROM 'PENDING_SOURCE' OR s->'sourceScope' IS DISTINCT FROM 'null'::jsonb
  OR q->>'operation' IS DISTINCT FROM 'readNormalUnderstandingResponse' OR q->>'projectId' IS DISTINCT FROM p::text
  OR s#>>'{context,projectId}' IS DISTINCT FROM p::text OR s#>>'{context,executionId}' IS DISTINCT FROM r.execution_id::text
  OR s#>>'{context,executionGeneration}' IS DISTINCT FROM r.generation::text OR s#>>'{context,grantRef,id}' IS DISTINCT FROM r.grant_id::text
  OR s#>>'{context,grantRef,version}' IS DISTINCT FROM r.grant_version::text
  OR (s->>'createdAt')::timestamptz IS DISTINCT FROM r.created_at OR (s->>'expiresAt')::timestamptz IS DISTINCT FROM r.expires_at THEN RETURN false;END IF;
 SELECT * INTO c FROM anvil.commands WHERE project_id=p AND id=r.command_id;
 IF c.id IS NULL OR c.scope_kind IS DISTINCT FROM 'PROJECT' OR c.scope_id IS DISTINCT FROM p OR c.operation IS DISTINCT FROM 'readNormalUnderstandingResponse' OR c.state IS DISTINCT FROM 'APPLIED'
  OR c.command_id::text IS DISTINCT FROM q->>'commandId' OR c.request_hash IS DISTINCT FROM anvil.fn01_hash(q)
  OR c.actor_id::text IS DISTINCT FROM s#>>'{requestedBy,userId}' OR c.client_id::text IS DISTINCT FROM s#>>'{requestedBy,clientId}'
  OR c.client_id::text IS DISTINCT FROM q->>'clientId' OR c.control_generation::text IS DISTINCT FROM q->>'controlGeneration'
  OR c.expected_version::text IS DISTINCT FROM q->>'expectedVersion' OR c.policy_ref IS DISTINCT FROM s->'policyRef'
  OR c.approval_consumption_id IS NOT NULL OR c.payload_ref IS NOT NULL OR q->'approvalRef' IS DISTINCT FROM 'null'::jsonb
  OR c.result_ref->>'status' IS DISTINCT FROM 'APPLIED' OR c.result_ref->>'projectId' IS DISTINCT FROM p::text OR c.result_ref->>'commandId' IS DISTINCT FROM c.command_id::text
  OR c.result_ref->>'targetId' IS DISTINCT FROM rid::text OR c.result_ref->'version' IS DISTINCT FROM '1'::jsonb
  OR c.result_ref->'data' IS DISTINCT FROM jsonb_build_object('ref',ref,'status','NORMAL_UNDERSTANDING_METADATA_REQUESTED','requestRef',ref,'state','PENDING_SOURCE',
   'sourceAvailable',false,'selectionAvailable',false,'expiresAt',s->'expiresAt') THEN RETURN false;END IF;
 scope_hash=anvil.fn01_hash(jsonb_build_object('projectId',p,'actorId',c.actor_id,'clientId',c.client_id,'controlGeneration',c.control_generation,'requestHash',c.request_hash,'policyRef',c.policy_ref,'targetRef',ref));
 IF (SELECT count(*) FROM anvil.authorization_receipts ar WHERE ar.id=c.authorization_receipt_id AND ar.command_id=c.id AND ar.scope_kind='PROJECT' AND ar.scope_id=p
  AND ar.subject_ref=jsonb_build_object('kind','HUMAN','userId',c.actor_id,'clientId',c.client_id) AND ar.policy_ref=c.policy_ref AND ar.scope_digest=scope_hash AND ar.approval_decision_ref IS NULL)<>1
  OR (SELECT count(*) FROM anvil.audit_events au WHERE au.project_id=p AND au.command_id=c.id AND au.operation_id=c.operation_id
  AND au.actor_ref=jsonb_build_object('kind','HUMAN','userId',c.actor_id) AND au.client_ref=c.client_id AND au.target_ref=ref AND au.policy_ref=c.policy_ref
  AND au.approval_ref IS NULL AND au.scope_digest=scope_hash AND au.outcome='APPLIED' AND au.source_kind='HUMAN_COMMAND' AND au.reason_code='EXPLICIT_NORMAL_UNDERSTANDING_METADATA_REQUEST')<>1 THEN RETURN false;END IF;
 RETURN true;
EXCEPTION WHEN OTHERS THEN RETURN false;
END;
$$;

CREATE FUNCTION anvil.fn09_normal_understanding_request_insert(s uuid,a uuid,c uuid,q jsonb,policy jsonb,expected_tx text,ref jsonb,snapshot jsonb,cid uuid)
RETURNS jsonb LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog AS $$
DECLARE b jsonb;p uuid;at timestamptz;created timestamptz;until_at timestamptz;g jsonb;hs anvil.auth_sessions;
BEGIN
 b=anvil.fn09_normal_understanding_request_basis(s,a,c,q,policy,expected_tx);p=(q->>'projectId')::uuid;at=clock_timestamp();
 SELECT * INTO hs FROM anvil.auth_sessions WHERE id=s;
 IF NOT COALESCE(anvil.execution_preparation_ref_valid(ref),false) OR ref->'version' IS DISTINCT FROM '1'::jsonb
  OR ref->>'contentHash' IS DISTINCT FROM anvil.fn01_hash(snapshot) OR octet_length(anvil.fn01_json(snapshot))>8192
  OR NOT COALESCE(anvil.execution_json_shape(snapshot,ARRAY['schemaVersion','purpose','request','context','requestedBy','policyRef','state','sourceScope','createdAt','expiresAt']),false)
  OR snapshot->'schemaVersion' IS DISTINCT FROM '1'::jsonb OR snapshot->>'purpose' IS DISTINCT FROM 'NORMAL_UNDERSTANDING_METADATA_DISCOVERY'
  OR snapshot->'request' IS DISTINCT FROM q OR snapshot->'context' IS DISTINCT FROM b->'context' OR snapshot->'policyRef' IS DISTINCT FROM policy
  OR snapshot->>'state' IS DISTINCT FROM 'PENDING_SOURCE' OR snapshot->'sourceScope' IS DISTINCT FROM 'null'::jsonb
  OR snapshot->'requestedBy' IS DISTINCT FROM jsonb_build_object('kind','HUMAN','userId',a,'clientId',c,'sessionId',s,'credentialGeneration',hs.credential_generation,'controlGeneration',(q->>'controlGeneration')::bigint)
  THEN RAISE EXCEPTION 'NORMAL_UNDERSTANDING_REQUEST_INVALID';END IF;
 created=(snapshot->>'createdAt')::timestamptz;until_at=(snapshot->>'expiresAt')::timestamptz;g=b#>'{context,grantRef}';
 IF created>at OR created<transaction_timestamp()-interval '30 seconds' OR until_at<=at OR until_at>created+interval '30 seconds' OR until_at>(b->>'expiresAt')::timestamptz
  THEN RAISE EXCEPTION 'NORMAL_UNDERSTANDING_REQUEST_EXPIRED';END IF;
 -- project lock는 basis에서 유지된다. 불명/만료 요청은 자동 삭제·재발급하지 않는다.
 IF (SELECT count(*) FROM anvil.normal_understanding_read_requests r WHERE r.project_id=p AND r.execution_id=(q->>'targetId')::uuid AND r.generation=(q->>'expectedVersion')::bigint)>=1000
  THEN RAISE EXCEPTION 'NORMAL_UNDERSTANDING_REQUEST_LIMIT';END IF;
 IF EXISTS(SELECT 1 FROM anvil.normal_understanding_read_requests r WHERE r.project_id=p AND r.execution_id=(q->>'targetId')::uuid AND r.generation=(q->>'expectedVersion')::bigint)
  THEN RAISE EXCEPTION 'NORMAL_UNDERSTANDING_REQUEST_PENDING';END IF;
 INSERT INTO anvil.normal_understanding_read_requests(project_id,id,execution_id,generation,grant_id,grant_version,command_id,content_hash,snapshot_json,created_at,expires_at)
 VALUES(p,(ref->>'id')::uuid,(q->>'targetId')::uuid,(q->>'expectedVersion')::bigint,(g->>'id')::uuid,(g->>'version')::bigint,cid,ref->>'contentHash',snapshot,created,until_at);
 IF NOT anvil.fn09_normal_understanding_request_complete(p,(ref->>'id')::uuid) THEN RAISE EXCEPTION 'NORMAL_UNDERSTANDING_REQUEST_INCOMPLETE';END IF;
 RETURN ref;
END;
$$;

CREATE FUNCTION anvil.fn09_normal_understanding_request_immutable() RETURNS trigger LANGUAGE plpgsql SET search_path=pg_catalog AS $$
BEGIN RAISE EXCEPTION 'NORMAL_UNDERSTANDING_REQUEST_IMMUTABLE';END;
$$;
CREATE FUNCTION anvil.fn09_normal_understanding_request_replay(s uuid,a uuid,c uuid,q jsonb,policy jsonb,expected_tx text)
RETURNS TABLE(id uuid,content_hash text,snapshot_json jsonb,result_ref jsonb,complete boolean)
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog AS $$
DECLARE b jsonb;r anvil.normal_understanding_read_requests;cmd anvil.commands;p uuid;
BEGIN
 b=anvil.fn09_normal_understanding_request_basis(s,a,c,q,policy,expected_tx);p=(q->>'projectId')::uuid;
 SELECT * INTO cmd FROM anvil.commands z WHERE z.project_id=p AND z.actor_id=a AND z.command_id=(q->>'commandId')::uuid;
 IF NOT FOUND THEN RETURN;END IF;
 IF cmd.client_id IS DISTINCT FROM c OR cmd.operation IS DISTINCT FROM 'readNormalUnderstandingResponse' OR cmd.request_hash IS DISTINCT FROM anvil.fn01_hash(q)
  THEN RAISE EXCEPTION 'IDEMPOTENCY_CONFLICT';END IF;
 SELECT * INTO STRICT r FROM anvil.normal_understanding_read_requests z WHERE z.project_id=p AND z.command_id=cmd.id;
 IF NOT anvil.fn09_normal_understanding_request_complete(p,r.id) OR r.snapshot_json->'request' IS DISTINCT FROM q
  OR r.snapshot_json->'context' IS DISTINCT FROM b->'context' OR r.snapshot_json#>>'{requestedBy,sessionId}' IS DISTINCT FROM s::text
  OR r.snapshot_json->'policyRef' IS DISTINCT FROM policy THEN RAISE EXCEPTION 'NORMAL_UNDERSTANDING_REQUEST_REPLAY_INVALID';END IF;
 -- 원 PENDING 영수증의 역사 재확인이다. 새 기한/선택/등록 요청을 발급하지 않는다.
 RETURN QUERY SELECT r.id,r.content_hash,r.snapshot_json,cmd.result_ref,true;
END;
$$;
CREATE TRIGGER fn09_understanding_request_immutable BEFORE UPDATE OR DELETE ON anvil.normal_understanding_read_requests FOR EACH ROW EXECUTE FUNCTION anvil.fn09_normal_understanding_request_immutable();
CREATE FUNCTION anvil.fn09_normal_understanding_request_final() RETURNS trigger LANGUAGE plpgsql SECURITY DEFINER SET search_path=pg_catalog AS $$
DECLARE p uuid;cid uuid;r record;c anvil.commands;b jsonb;
BEGIN
 IF TG_TABLE_NAME='normal_understanding_read_requests' THEN p=NEW.project_id;cid=NEW.command_id;
 ELSIF TG_TABLE_NAME='commands' THEN p=NEW.project_id;cid=NEW.id;
 ELSE cid=NEW.command_id;SELECT project_id INTO p FROM anvil.commands WHERE id=cid;END IF;
 SELECT * INTO c FROM anvil.commands WHERE id=cid AND project_id=p;
 IF c.operation IS DISTINCT FROM 'readNormalUnderstandingResponse' AND NOT EXISTS(SELECT 1 FROM anvil.normal_understanding_read_requests z WHERE z.project_id=p AND z.command_id=cid) THEN RETURN NULL;END IF;
 SELECT * INTO STRICT r FROM anvil.normal_understanding_read_requests WHERE project_id=p AND command_id=cid;
 IF NOT anvil.fn09_normal_understanding_request_complete(p,r.id) THEN RAISE EXCEPTION 'NORMAL_UNDERSTANDING_REQUEST_INCOMPLETE';END IF;
 b=anvil.fn09_normal_understanding_request_basis((r.snapshot_json#>>'{requestedBy,sessionId}')::uuid,c.actor_id,c.client_id,r.snapshot_json->'request',c.policy_ref,txid_current()::text);
 IF b->'context' IS DISTINCT FROM r.snapshot_json->'context' OR (b->>'expiresAt')::timestamptz<r.expires_at THEN RAISE EXCEPTION 'NORMAL_UNDERSTANDING_REQUEST_CURRENT_CHANGED';END IF;
 IF clock_timestamp()>=r.expires_at THEN RAISE EXCEPTION 'NORMAL_UNDERSTANDING_REQUEST_EXPIRED';END IF;
 RETURN NULL;
END;
$$;
CREATE CONSTRAINT TRIGGER fn09_understanding_request_complete AFTER INSERT ON anvil.normal_understanding_read_requests DEFERRABLE INITIALLY DEFERRED FOR EACH ROW EXECUTE FUNCTION anvil.fn09_normal_understanding_request_final();
CREATE CONSTRAINT TRIGGER fn09_understanding_request_command_complete AFTER INSERT OR UPDATE ON anvil.commands DEFERRABLE INITIALLY DEFERRED FOR EACH ROW EXECUTE FUNCTION anvil.fn09_normal_understanding_request_final();
CREATE CONSTRAINT TRIGGER fn09_understanding_request_authorization_complete AFTER INSERT OR UPDATE ON anvil.authorization_receipts DEFERRABLE INITIALLY DEFERRED FOR EACH ROW EXECUTE FUNCTION anvil.fn09_normal_understanding_request_final();
CREATE CONSTRAINT TRIGGER fn09_understanding_request_audit_complete AFTER INSERT OR UPDATE ON anvil.audit_events DEFERRABLE INITIALLY DEFERRED FOR EACH ROW EXECUTE FUNCTION anvil.fn09_normal_understanding_request_final();

ALTER FUNCTION anvil.fn09_normal_understanding_request_basis(uuid,uuid,uuid,jsonb,jsonb,text) OWNER TO anvil_v3_migrator;
ALTER FUNCTION anvil.fn09_normal_understanding_request_complete(uuid,uuid) OWNER TO anvil_v3_migrator;
ALTER FUNCTION anvil.fn09_normal_understanding_request_insert(uuid,uuid,uuid,jsonb,jsonb,text,jsonb,jsonb,uuid) OWNER TO anvil_v3_migrator;
ALTER FUNCTION anvil.fn09_normal_understanding_request_final() OWNER TO anvil_v3_migrator;
ALTER FUNCTION anvil.fn09_normal_understanding_request_replay(uuid,uuid,uuid,jsonb,jsonb,text) OWNER TO anvil_v3_migrator;
REVOKE ALL ON FUNCTION anvil.fn09_normal_understanding_request_basis(uuid,uuid,uuid,jsonb,jsonb,text),anvil.fn09_normal_understanding_request_complete(uuid,uuid),anvil.fn09_normal_understanding_request_insert(uuid,uuid,uuid,jsonb,jsonb,text,jsonb,jsonb,uuid),anvil.fn09_normal_understanding_request_replay(uuid,uuid,uuid,jsonb,jsonb,text),anvil.fn09_normal_understanding_request_final(),anvil.fn09_normal_understanding_request_immutable() FROM PUBLIC,anvil_v3_app;
GRANT EXECUTE ON FUNCTION anvil.fn09_normal_understanding_request_basis(uuid,uuid,uuid,jsonb,jsonb,text),anvil.fn09_normal_understanding_request_replay(uuid,uuid,uuid,jsonb,jsonb,text),anvil.fn09_normal_understanding_request_insert(uuid,uuid,uuid,jsonb,jsonb,text,jsonb,jsonb,uuid) TO anvil_v3_app;
-- app의 일반 자료 쓰기·nonce 발행·result 수락 권한은 추가하지 않는다. 선택 본문 quota는 후속이다.

-- S3 DISCOVERY acquisition. No FIRST/init/tail or selected-body custody is issued here.
CREATE FUNCTION anvil.fn09_normal_understanding_discovery(token text,b jsonb,signed_request_id uuid,expected jsonb)
RETURNS jsonb LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog AS $$
DECLARE cr record;cur record;r anvil.normal_understanding_read_requests;cmd anvil.commands;basis jsonb;ref jsonb;ends timestamptz;n bigint;
BEGIN
 IF signed_request_id IS NULL OR token !~ '^[0-9a-f]{64}$' OR NOT COALESCE(anvil.execution_json_shape(b,ARRAY['transport','mode','projectId','connectorId','executionId','executionGeneration','grantRef','scopeDigest','credentialGeneration','publicKeyFingerprint']),false)
  OR b->>'transport' IS DISTINCT FROM 'NORMAL_PROTECTED' OR b->>'mode' IS DISTINCT FROM 'EXECUTION' THEN RAISE EXCEPTION 'NORMAL_UNDERSTANDING_DISCOVERY_DENIED';END IF;
 SELECT * INTO STRICT cr FROM anvil.normal_request_credential(token,(b->>'connectorId')::uuid,(b->>'executionId')::uuid,(b#>>'{grantRef,id}')::uuid,
  (b#>>'{grantRef,version}')::bigint,b#>>'{grantRef,contentHash}',(b->>'credentialGeneration')::bigint);
 SELECT * INTO STRICT cur FROM anvil.normal_exchange_current(cr.project_id,(b->>'connectorId')::uuid,(b->>'executionId')::uuid,(b#>>'{grantRef,id}')::uuid,
  (b#>>'{grantRef,version}')::bigint,b#>>'{grantRef,contentHash}',(b->>'credentialGeneration')::bigint);
 IF cr.project_id::text IS DISTINCT FROM b->>'projectId' OR cur.binding IS DISTINCT FROM b THEN RAISE EXCEPTION 'NORMAL_UNDERSTANDING_DISCOVERY_DENIED';END IF;
 SELECT count(*) INTO n FROM anvil.normal_understanding_read_requests z WHERE z.project_id=cr.project_id AND z.execution_id=(b->>'executionId')::uuid AND z.generation=(b->>'executionGeneration')::bigint;
 IF n=0 AND expected='null'::jsonb THEN RETURN jsonb_build_object('status','NONE');END IF;
 IF n<>1 THEN RAISE EXCEPTION 'NORMAL_UNDERSTANDING_DISCOVERY_DENIED';END IF;
 SELECT * INTO STRICT r FROM anvil.normal_understanding_read_requests z WHERE z.project_id=cr.project_id AND z.execution_id=(b->>'executionId')::uuid AND z.generation=(b->>'executionGeneration')::bigint;
 ref=jsonb_build_object('id',r.id,'version',1,'contentHash',r.content_hash);
 IF r.grant_id::text IS DISTINCT FROM b#>>'{grantRef,id}' OR r.grant_version::text IS DISTINCT FROM b#>>'{grantRef,version}'
  OR (expected IS DISTINCT FROM 'null'::jsonb AND expected IS DISTINCT FROM ref) OR NOT anvil.fn09_normal_understanding_request_complete(r.project_id,r.id)
  THEN RAISE EXCEPTION 'NORMAL_UNDERSTANDING_DISCOVERY_DENIED';END IF;
 IF r.expires_at<=clock_timestamp() THEN RAISE EXCEPTION 'NORMAL_UNDERSTANDING_DISCOVERY_EXPIRED';END IF;
 SELECT * INTO STRICT cmd FROM anvil.commands WHERE project_id=r.project_id AND id=r.command_id;
 BEGIN
  basis=anvil.fn09_normal_understanding_request_basis((r.snapshot_json#>>'{requestedBy,sessionId}')::uuid,cmd.actor_id,cmd.client_id,r.snapshot_json->'request',cmd.policy_ref,txid_current()::text);
 EXCEPTION WHEN OTHERS THEN
  IF SQLERRM IN ('PROJECT_CONTROL_REQUIRED','PROJECT_OPERATION_DENIED','REAUTHENTICATION_REQUIRED','FN01_ACTIVE_SESSION_REQUIRED','NORMAL_UNDERSTANDING_REQUEST_CURRENT_REQUIRED') THEN RAISE EXCEPTION 'NORMAL_UNDERSTANDING_DISCOVERY_DENIED';
  ELSIF SQLERRM='NORMAL_UNDERSTANDING_REQUEST_EXPIRED' THEN RAISE EXCEPTION 'NORMAL_UNDERSTANDING_DISCOVERY_EXPIRED';
  ELSE RAISE;END IF;
 END;
 IF basis->'context' IS DISTINCT FROM r.snapshot_json->'context' OR basis#>'{context,grantRef}' IS DISTINCT FROM b->'grantRef'
  OR basis#>'{context,connectorId}' IS DISTINCT FROM b->'connectorId' OR basis#>'{context,credentialGeneration}' IS DISTINCT FROM b->'credentialGeneration'
  THEN RAISE EXCEPTION 'NORMAL_UNDERSTANDING_DISCOVERY_DENIED';END IF;
 -- Reconfirm only the same signed request, never replace its nonce or HUMAN request.
 IF EXISTS(SELECT 1 FROM anvil.execution_challenges x WHERE x.project_id=r.project_id AND x.version=1 AND x.snapshot_json->'understandingRequestRef'->>'id'=r.id::text
  AND (x.request_id IS DISTINCT FROM signed_request_id OR x.snapshot_json->'understandingRequestRef' IS DISTINCT FROM ref)) THEN RAISE EXCEPTION 'NORMAL_UNDERSTANDING_DISCOVERY_DENIED';END IF;
 ends=least(r.expires_at,cr.expires_at,cur.deadline,(basis->>'expiresAt')::timestamptz);
 IF ends<=clock_timestamp() THEN RAISE EXCEPTION 'NORMAL_UNDERSTANDING_DISCOVERY_EXPIRED';END IF;
 RETURN jsonb_build_object('status','REQUEST','requestRef',ref,'snapshot',r.snapshot_json,'deadline',to_char(ends AT TIME ZONE 'UTC','YYYY-MM-DD"T"HH24:MI:SS.MS"Z"'));
END;
$$;
ALTER FUNCTION anvil.fn09_normal_understanding_discovery(text,jsonb,uuid,jsonb) OWNER TO anvil_v3_migrator;
REVOKE ALL ON FUNCTION anvil.fn09_normal_understanding_discovery(text,jsonb,uuid,jsonb) FROM PUBLIC;
GRANT EXECUTE ON FUNCTION anvil.fn09_normal_understanding_discovery(text,jsonb,uuid,jsonb) TO anvil_v3_app;
CREATE UNIQUE INDEX normal_understanding_challenge_request_once ON anvil.execution_challenges(project_id,((snapshot_json->'understandingRequestRef'->>'id')))
 WHERE version=1 AND snapshot_json ? 'understandingRequestRef';

CREATE FUNCTION anvil.fn09_normal_understanding_challenge_valid(n anvil.execution_challenges,deferred_check boolean) RETURNS boolean LANGUAGE plpgsql AS $$
DECLARE s jsonb=n.snapshot_json;b jsonb=s->'binding';r jsonb=s->'request';t jsonb=r->'target';p jsonb=s->'publicChallenge';
 ref jsonb=s->'credentialRef';receipt anvil.execution_receipts%ROWTYPE;cred record;cur record;at_time timestamptz;ends timestamptz;
 total bigint;recent bigint;live bigint;last_seq bigint;discovery jsonb;
BEGIN
 IF n.version<>1 OR n.content_hash IS DISTINCT FROM anvil.execution_json_hash(s) OR octet_length(anvil.execution_authority_canonical(s))>16384
  OR NOT anvil.execution_json_shape(s,ARRAY['sequence','credentialRef','binding','request','requestHash','signedInputHash','serverNonceDigest','publicChallenge','previousRef','consumption','understandingRequestRef'])
  OR s->'previousRef' IS DISTINCT FROM 'null'::jsonb OR s->'consumption' IS DISTINCT FROM 'null'::jsonb OR s->'sequence' IS DISTINCT FROM to_jsonb(n.server_sequence)

  OR NOT anvil.execution_json_shape(r,ARRAY['requestId','purpose','grantRef','credentialGeneration','target','clientNonce','issuedAt'])
  OR r->>'purpose' IS DISTINCT FROM 'EXECUTION_REQUEST' OR r->'grantRef' IS DISTINCT FROM b->'grantRef' OR r->'credentialGeneration' IS DISTINCT FROM b->'credentialGeneration'
  OR jsonb_typeof(r->'requestId') IS DISTINCT FROM 'string' OR r->>'requestId' IS DISTINCT FROM (r->>'requestId')::uuid::text
  OR NOT anvil.execution_json_shape(t,ARRAY['method','path','bodyHash','queryHash']) OR t->>'method' NOT IN ('GET','POST')
  OR t IS DISTINCT FROM jsonb_build_object('method','GET','path','/api/v1/connectors/'||(b->>'connectorId')||'/executions/'||(b->>'executionId')||'/understanding-response-read','bodyHash',anvil.execution_json_hash('null'::jsonb),'queryHash',anvil.execution_json_hash('{}'::jsonb))
  OR NOT COALESCE(anvil.execution_preparation_ref_valid(s->'understandingRequestRef'),false)
  OR jsonb_typeof(t->'queryHash') IS DISTINCT FROM 'string' OR t->>'queryHash' !~ '^[0-9a-f]{64}$'
  OR s->>'requestHash' IS DISTINCT FROM anvil.execution_json_hash(r)
  OR s->>'signedInputHash' IS DISTINCT FROM anvil.execution_json_hash(jsonb_build_object('purpose','EXECUTION_CHALLENGE_REQUEST','request',r))
  OR NOT anvil.execution_nonce_valid(r->'clientNonce') OR NOT anvil.execution_nonce_valid(p->'serverNonce')
  OR s->>'serverNonceDigest' IS DISTINCT FROM encode(sha256(decode(translate(p->>'serverNonce','-_','+/')||'=','base64')),'hex')
  OR NOT anvil.execution_iso_valid(r->'issuedAt') OR NOT anvil.execution_iso_valid(p->'issuedAt') OR NOT anvil.execution_iso_valid(p->'expiresAt')
  OR p IS DISTINCT FROM jsonb_build_object('id',n.id,'requestId',r->'requestId','purpose','EXECUTION_REQUEST','grantRef',b->'grantRef',
   'credentialGeneration',r->'credentialGeneration','scopeDigest',b->'scopeDigest','serverNonce',p->'serverNonce','clientNonce',r->'clientNonce','issuedAt',p->'issuedAt','expiresAt',p->'expiresAt')
 THEN RETURN false;END IF;
 SELECT * INTO receipt FROM anvil.execution_receipts WHERE project_id=n.project_id AND grant_id=n.grant_id AND grant_version=n.grant_version AND id=(ref->>'id')::uuid;
 IF NOT FOUND OR current_setting('anvil.normal_request_verified',true) IS DISTINCT FROM
    txid_current()::text||':'||n.content_hash||':'||(ref->>'contentHash')||':'||(receipt.snapshot_json->>'tokenDigest') THEN RETURN false;END IF;
 SELECT * INTO cred FROM anvil.normal_request_credential(receipt.snapshot_json->>'tokenDigest',(b->>'connectorId')::uuid,(b->>'executionId')::uuid,
  n.grant_id,n.grant_version,b#>>'{grantRef,contentHash}',(r->>'credentialGeneration')::bigint);
 IF NOT FOUND OR cred.credential_ref IS DISTINCT FROM ref OR cred.project_id<>n.project_id OR receipt.snapshot_json->'binding' IS DISTINCT FROM b THEN RETURN false;END IF;
 SELECT * INTO cur FROM anvil.normal_exchange_current(n.project_id,(b->>'connectorId')::uuid,(b->>'executionId')::uuid,n.grant_id,n.grant_version,
  b#>>'{grantRef,contentHash}',(r->>'credentialGeneration')::bigint);
 IF NOT FOUND OR cur.binding IS DISTINCT FROM b THEN RETURN false;END IF;
 discovery=anvil.fn09_normal_understanding_discovery(receipt.snapshot_json->>'tokenDigest',b,(r->>'requestId')::uuid,s->'understandingRequestRef');
 IF discovery->>'status' IS DISTINCT FROM 'REQUEST' OR (p->>'expiresAt')::timestamptz>(discovery->>'deadline')::timestamptz THEN RETURN false;END IF;
 at_time=(p->>'issuedAt')::timestamptz;ends=(p->>'expiresAt')::timestamptz;
 IF at_time>cur.observed_at OR abs(extract(epoch FROM (r->>'issuedAt')::timestamptz-at_time))>30
  OR ends<=clock_timestamp() OR ends>least(at_time+interval '30 seconds',cred.expires_at,cur.deadline) THEN RETURN false;END IF;
 SELECT count(*) FILTER(WHERE v.version=1),coalesce(max(v.server_sequence),0),
  count(*) FILTER(WHERE v.version=1 AND v.snapshot_json->'credentialRef'=ref AND v.snapshot_json#>>'{publicChallenge,purpose}'='EXECUTION_REQUEST'
    AND (v.snapshot_json#>>'{publicChallenge,issuedAt}')::timestamptz>at_time-interval '1 minute'),
  count(*) FILTER(WHERE v.version=1 AND v.snapshot_json->'credentialRef'=ref AND v.snapshot_json#>>'{publicChallenge,purpose}'='EXECUTION_REQUEST'
    AND (v.snapshot_json#>>'{publicChallenge,expiresAt}')::timestamptz>at_time AND NOT EXISTS(SELECT 1 FROM anvil.execution_challenges used WHERE used.project_id=v.project_id AND used.id=v.id AND used.version=2))
 INTO total,last_seq,recent,live FROM anvil.execution_challenges v WHERE v.project_id=n.project_id AND v.grant_id=n.grant_id AND v.grant_version=n.grant_version
  AND (NOT deferred_check OR v.server_sequence<n.server_sequence);
 RETURN total<10000 AND recent<60 AND live=0 AND n.server_sequence=last_seq+1;
END;
$$;

ALTER FUNCTION anvil.normal_request_challenge_valid(anvil.execution_challenges,boolean) RENAME TO normal_request_challenge_valid_pre0102;
CREATE FUNCTION anvil.normal_request_challenge_valid(n anvil.execution_challenges,deferred_check boolean) RETURNS boolean LANGUAGE plpgsql AS $$
BEGIN
 IF n.snapshot_json ? 'understandingRequestRef' OR n.snapshot_json#>>'{request,target,path}' LIKE '%/understanding-response-read%' THEN
  RETURN anvil.fn09_normal_understanding_challenge_valid(n,deferred_check);
 END IF;
 RETURN anvil.normal_request_challenge_valid_pre0102(n,deferred_check);
END;
$$;

CREATE FUNCTION anvil.fn09_normal_understanding_consumption_valid(v anvil.execution_challenges,deferred_check boolean)
RETURNS boolean LANGUAGE plpgsql AS $$
DECLARE old anvil.execution_challenges%ROWTYPE;s jsonb=v.snapshot_json;u jsonb=s->'consumption';seq bigint;discovery jsonb;
BEGIN
 SELECT * INTO old FROM anvil.execution_challenges WHERE project_id=v.project_id AND id=v.id AND version=1;
 IF NOT FOUND OR v.version<>2 OR old.grant_id<>v.grant_id OR old.grant_version<>v.grant_version
  OR old.snapshot_json#>>'{publicChallenge,purpose}' IS DISTINCT FROM 'EXECUTION_REQUEST'
  OR old.snapshot_json#>>'{binding,transport}' IS DISTINCT FROM 'NORMAL_PROTECTED'
  OR old.content_hash IS DISTINCT FROM anvil.execution_json_hash(old.snapshot_json) OR v.content_hash IS DISTINCT FROM anvil.execution_json_hash(s)
  OR NOT anvil.execution_json_shape(u,ARRAY['resultRef','consumedAt','packetHash'])
  OR NOT anvil.execution_json_shape(u->'resultRef',ARRAY['id','version','contentHash']) OR u#>'{resultRef,version}' IS DISTINCT FROM '1'::jsonb
  OR NOT anvil.execution_iso_valid(u->'consumedAt') OR jsonb_typeof(u->'packetHash') IS DISTINCT FROM 'string' OR u->>'packetHash' !~ '^[0-9a-f]{64}$'
  OR s IS DISTINCT FROM (old.snapshot_json || jsonb_build_object('sequence',v.server_sequence,'previousRef',
    jsonb_build_object('id',old.id,'version',1,'contentHash',old.content_hash),'consumption',u))
  OR (u->>'consumedAt')::timestamptz NOT BETWEEN (s#>>'{publicChallenge,issuedAt}')::timestamptz AND clock_timestamp()
  OR clock_timestamp()>=(s#>>'{publicChallenge,expiresAt}')::timestamptz
  OR split_part(current_setting('anvil.normal_page_verified',true),':',1) IS DISTINCT FROM txid_current()::text
  OR split_part(current_setting('anvil.normal_page_verified',true),':',2) IS DISTINCT FROM u#>>'{resultRef,contentHash}'
 THEN RETURN false;END IF;
 IF old.snapshot_json#>'{request,target}' IS DISTINCT FROM jsonb_build_object('method','GET','path','/api/v1/connectors/'||(s#>>'{binding,connectorId}')||'/executions/'||(s#>>'{binding,executionId}')||'/understanding-response-read','bodyHash',anvil.execution_json_hash('null'::jsonb),'queryHash',anvil.execution_json_hash('{}'::jsonb)) THEN RETURN false;END IF;
 discovery=anvil.fn09_normal_understanding_discovery(split_part(current_setting('anvil.normal_page_verified',true),':',3),s->'binding',(s#>>'{request,requestId}')::uuid,s->'understandingRequestRef');
 IF discovery->>'status' IS DISTINCT FROM 'REQUEST' THEN RETURN false;END IF;
 SELECT coalesce(max(server_sequence),0)+1 INTO seq FROM anvil.execution_challenges WHERE project_id=v.project_id
  AND grant_id=v.grant_id AND grant_version=v.grant_version AND (NOT deferred_check OR server_sequence<v.server_sequence);
 RETURN seq=v.server_sequence AND (NOT deferred_check OR EXISTS(SELECT 1 FROM anvil.execution_receipts r
  WHERE r.project_id=v.project_id AND r.challenge_id=v.id AND r.id=(u#>>'{resultRef,id}')::uuid AND r.content_hash=u#>>'{resultRef,contentHash}'
   AND r.snapshot_json->>'kind'='NORMAL_UNDERSTANDING_DISCOVERY_ACQUIRED' AND r.snapshot_json->'understandingRequestRef'=s->'understandingRequestRef' AND r.snapshot_json->'packetHash'=u->'packetHash'));
END;
$$;

ALTER FUNCTION anvil.normal_command_consumption_valid(anvil.execution_challenges,boolean) RENAME TO normal_command_consumption_valid_pre0102;
CREATE FUNCTION anvil.normal_command_consumption_valid(v anvil.execution_challenges,deferred_check boolean) RETURNS boolean LANGUAGE plpgsql AS $$
BEGIN
 IF v.snapshot_json ? 'understandingRequestRef' OR v.snapshot_json#>>'{request,target,path}' LIKE '%/understanding-response-read%' THEN
  RETURN anvil.fn09_normal_understanding_consumption_valid(v,deferred_check);
 END IF;
 RETURN anvil.normal_command_consumption_valid_pre0102(v,deferred_check);
END;
$$;
CREATE FUNCTION anvil.fn09_normal_understanding_acquisition_valid(r anvil.execution_receipts) RETURNS boolean LANGUAGE plpgsql AS $$
DECLARE v anvil.execution_challenges;s jsonb=r.snapshot_json;b jsonb=s->'binding';d jsonb;cr record;cur record;
 marker text=current_setting('anvil.normal_page_verified',true);observed timestamptz;expires timestamptz;
BEGIN
 SELECT * INTO v FROM anvil.execution_challenges WHERE project_id=r.project_id AND id=r.challenge_id AND version=2;
 IF NOT FOUND OR r.grant_id<>v.grant_id OR r.grant_version<>v.grant_version OR r.version<>1 OR r.challenge_version<>1
  OR NOT anvil.execution_json_shape(s,ARRAY['kind','binding','credentialRef','challengeRef','packetHash','target','requestId','understandingRequestRef','context','observedAt','expiresAt'])
  OR s->>'kind' IS DISTINCT FROM 'NORMAL_UNDERSTANDING_DISCOVERY_ACQUIRED' OR r.content_hash IS DISTINCT FROM anvil.execution_json_hash(s)
  OR marker IS NULL OR marker IS DISTINCT FROM txid_current()::text||':'||r.content_hash||':'||split_part(marker,':',3)
  OR s->'challengeRef' IS DISTINCT FROM v.snapshot_json->'previousRef' OR b IS DISTINCT FROM v.snapshot_json->'binding'
  OR s->'target' IS DISTINCT FROM v.snapshot_json#>'{request,target}' OR s->'requestId' IS DISTINCT FROM v.snapshot_json#>'{request,requestId}'
  OR s->'credentialRef' IS DISTINCT FROM v.snapshot_json->'credentialRef' OR s->'understandingRequestRef' IS DISTINCT FROM v.snapshot_json->'understandingRequestRef'
  OR v.snapshot_json->'consumption' IS DISTINCT FROM jsonb_build_object('resultRef',jsonb_build_object('id',r.id,'version',1,'contentHash',r.content_hash),'packetHash',s->'packetHash','consumedAt',s->'observedAt')
  OR NOT anvil.execution_iso_valid(s->'observedAt') OR NOT anvil.execution_iso_valid(s->'expiresAt') THEN RETURN false;END IF;
 d=anvil.fn09_normal_understanding_discovery(split_part(marker,':',3),b,(s->>'requestId')::uuid,s->'understandingRequestRef');
 IF d->>'status' IS DISTINCT FROM 'REQUEST' OR s->'context' IS DISTINCT FROM d#>'{snapshot,context}' THEN RETURN false;END IF;
 SELECT * INTO STRICT cr FROM anvil.normal_request_credential(split_part(marker,':',3),(b->>'connectorId')::uuid,(b->>'executionId')::uuid,r.grant_id,r.grant_version,b#>>'{grantRef,contentHash}',(b->>'credentialGeneration')::bigint);
 SELECT * INTO STRICT cur FROM anvil.normal_exchange_current(r.project_id,(b->>'connectorId')::uuid,(b->>'executionId')::uuid,r.grant_id,r.grant_version,b#>>'{grantRef,contentHash}',(b->>'credentialGeneration')::bigint);
 observed=(s->>'observedAt')::timestamptz;expires=(s->>'expiresAt')::timestamptz;
 RETURN cur.binding=b AND cr.credential_ref=s->'credentialRef' AND cr.project_id=r.project_id
  AND observed>=(v.snapshot_json#>>'{publicChallenge,issuedAt}')::timestamptz AND observed<=cur.observed_at AND expires>observed AND expires>clock_timestamp()
  AND expires<=least(cur.deadline,cr.expires_at,(d->>'deadline')::timestamptz,(v.snapshot_json#>>'{publicChallenge,expiresAt}')::timestamptz);
END;
$$;
CREATE FUNCTION anvil.guard_fn09_normal_understanding_acquisition() RETURNS trigger LANGUAGE plpgsql AS $$
BEGIN
 IF NOT COALESCE(anvil.fn09_normal_understanding_acquisition_valid(NEW::anvil.execution_receipts),false) THEN RAISE EXCEPTION 'NORMAL_UNDERSTANDING_DISCOVERY_DENIED';END IF;
 RETURN NEW;
END;
$$;

DROP TRIGGER synthetic_execution_receipt_guard ON anvil.execution_receipts;
DROP TRIGGER synthetic_execution_receipt_complete ON anvil.execution_receipts;
CREATE TRIGGER synthetic_execution_receipt_guard BEFORE INSERT ON anvil.execution_receipts FOR EACH ROW
 WHEN (NEW.snapshot_json->>'kind' IS DISTINCT FROM 'NORMAL_CREDENTIAL_ISSUED' AND NEW.snapshot_json->>'kind' IS DISTINCT FROM 'NORMAL_COMMAND_PAGE'
  AND NEW.snapshot_json->>'kind' IS DISTINCT FROM 'NORMAL_START_MATERIAL' AND NEW.snapshot_json->>'kind' IS DISTINCT FROM 'NORMAL_START_PERMIT'
  AND NEW.snapshot_json->>'kind' IS DISTINCT FROM 'NORMAL_OBSERVATIONS' AND NEW.snapshot_json->>'kind' IS DISTINCT FROM 'NORMAL_INSTRUCTION_MATERIAL' AND NEW.snapshot_json->>'kind' IS DISTINCT FROM 'NORMAL_INSTRUCTION_PERMIT' AND NEW.snapshot_json->>'kind' IS DISTINCT FROM 'NORMAL_UNDERSTANDING_DISCOVERY_ACQUIRED') EXECUTE FUNCTION anvil.guard_synthetic_execution_receipt();
CREATE CONSTRAINT TRIGGER synthetic_execution_receipt_complete AFTER INSERT ON anvil.execution_receipts DEFERRABLE INITIALLY DEFERRED FOR EACH ROW
 WHEN (NEW.snapshot_json->>'kind' IS DISTINCT FROM 'NORMAL_CREDENTIAL_ISSUED' AND NEW.snapshot_json->>'kind' IS DISTINCT FROM 'NORMAL_COMMAND_PAGE'
  AND NEW.snapshot_json->>'kind' IS DISTINCT FROM 'NORMAL_START_MATERIAL' AND NEW.snapshot_json->>'kind' IS DISTINCT FROM 'NORMAL_START_PERMIT'
  AND NEW.snapshot_json->>'kind' IS DISTINCT FROM 'NORMAL_OBSERVATIONS' AND NEW.snapshot_json->>'kind' IS DISTINCT FROM 'NORMAL_INSTRUCTION_MATERIAL' AND NEW.snapshot_json->>'kind' IS DISTINCT FROM 'NORMAL_INSTRUCTION_PERMIT' AND NEW.snapshot_json->>'kind' IS DISTINCT FROM 'NORMAL_UNDERSTANDING_DISCOVERY_ACQUIRED') EXECUTE FUNCTION anvil.guard_execution_challenge_complete();

CREATE TRIGGER normal_understanding_acquisition_guard BEFORE INSERT ON anvil.execution_receipts FOR EACH ROW
 WHEN(NEW.snapshot_json->>'kind'='NORMAL_UNDERSTANDING_DISCOVERY_ACQUIRED') EXECUTE FUNCTION anvil.guard_fn09_normal_understanding_acquisition();
CREATE CONSTRAINT TRIGGER normal_understanding_acquisition_complete AFTER INSERT ON anvil.execution_receipts DEFERRABLE INITIALLY DEFERRED FOR EACH ROW
 WHEN(NEW.snapshot_json->>'kind'='NORMAL_UNDERSTANDING_DISCOVERY_ACQUIRED') EXECUTE FUNCTION anvil.guard_fn09_normal_understanding_acquisition();
REVOKE ALL ON FUNCTION anvil.normal_request_challenge_valid(anvil.execution_challenges,boolean),anvil.normal_command_consumption_valid(anvil.execution_challenges,boolean),
 anvil.fn09_normal_understanding_challenge_valid(anvil.execution_challenges,boolean),anvil.fn09_normal_understanding_consumption_valid(anvil.execution_challenges,boolean),
 anvil.fn09_normal_understanding_acquisition_valid(anvil.execution_receipts),anvil.guard_fn09_normal_understanding_acquisition() FROM PUBLIC;
GRANT EXECUTE ON FUNCTION anvil.normal_request_challenge_valid(anvil.execution_challenges,boolean),anvil.normal_command_consumption_valid(anvil.execution_challenges,boolean),
 anvil.fn09_normal_understanding_challenge_valid(anvil.execution_challenges,boolean),anvil.fn09_normal_understanding_consumption_valid(anvil.execution_challenges,boolean),
 anvil.fn09_normal_understanding_acquisition_valid(anvil.execution_receipts),anvil.guard_fn09_normal_understanding_acquisition() TO anvil_v3_app;
-- S3 결과 custody의 내부 조회 선행만 제공한다. POST 발행/소비/결과 저장·선택 권위는 여전히 없다.
-- GET-only 단일성의 signed_request_id는 아래 원 GET에서 읽는다. fresh POST identity로 대체하지 않는다.
CREATE FUNCTION anvil.fn09_normal_understanding_result_basis(token text,b jsonb,expected_request jsonb,expected_acquisition jsonb)
RETURNS jsonb LANGUAGE plpgsql VOLATILE SECURITY INVOKER SET search_path=pg_catalog AS $$
DECLARE r anvil.execution_receipts;g anvil.execution_challenges;u anvil.execution_challenges;cr record;cur record;d jsonb;s jsonb;ends timestamptz;get_ref jsonb;
BEGIN
 IF token IS NULL OR token !~ '^[0-9a-f]{64}$'
  OR NOT COALESCE(anvil.execution_json_shape(b,ARRAY['transport','mode','projectId','connectorId','executionId','executionGeneration','grantRef','scopeDigest','credentialGeneration','publicKeyFingerprint']),false)
  OR b->>'transport' IS DISTINCT FROM 'NORMAL_PROTECTED' OR b->>'mode' IS DISTINCT FROM 'EXECUTION'
  OR NOT COALESCE(anvil.execution_preparation_ref_valid(expected_request),false) OR expected_request->'version' IS DISTINCT FROM '1'::jsonb
  OR NOT COALESCE(anvil.execution_preparation_ref_valid(expected_acquisition),false) OR expected_acquisition->'version' IS DISTINCT FROM '1'::jsonb
 THEN RAISE EXCEPTION 'NORMAL_UNDERSTANDING_RESULT_DENIED';END IF;
 SELECT * INTO STRICT cr FROM anvil.normal_request_credential(token,(b->>'connectorId')::uuid,(b->>'executionId')::uuid,
  (b#>>'{grantRef,id}')::uuid,(b#>>'{grantRef,version}')::bigint,b#>>'{grantRef,contentHash}',(b->>'credentialGeneration')::bigint);
 SELECT * INTO STRICT cur FROM anvil.normal_exchange_current(cr.project_id,(b->>'connectorId')::uuid,(b->>'executionId')::uuid,
  (b#>>'{grantRef,id}')::uuid,(b#>>'{grantRef,version}')::bigint,b#>>'{grantRef,contentHash}',(b->>'credentialGeneration')::bigint);
 IF cr.project_id::text IS DISTINCT FROM b->>'projectId' OR cur.binding IS DISTINCT FROM b THEN RAISE EXCEPTION 'NORMAL_UNDERSTANDING_RESULT_DENIED';END IF;
 SELECT * INTO STRICT r FROM anvil.execution_receipts WHERE project_id=cr.project_id AND id=(expected_acquisition->>'id')::uuid AND version=1;
 s=r.snapshot_json;
 SELECT * INTO STRICT g FROM anvil.execution_challenges WHERE project_id=r.project_id AND id=r.challenge_id AND version=1;
 SELECT * INTO STRICT u FROM anvil.execution_challenges WHERE project_id=r.project_id AND id=r.challenge_id AND version=2;
 get_ref=jsonb_build_object('id',g.id,'version',1,'contentHash',g.content_hash);
 IF r.content_hash IS DISTINCT FROM expected_acquisition->>'contentHash' OR r.content_hash IS DISTINCT FROM anvil.execution_json_hash(s)
  OR r.grant_id::text IS DISTINCT FROM b#>>'{grantRef,id}' OR r.grant_version::text IS DISTINCT FROM b#>>'{grantRef,version}' OR r.challenge_version<>1
  OR NOT COALESCE(anvil.execution_json_shape(s,ARRAY['kind','binding','credentialRef','challengeRef','packetHash','target','requestId','understandingRequestRef','context','observedAt','expiresAt']),false)
  OR s->>'kind' IS DISTINCT FROM 'NORMAL_UNDERSTANDING_DISCOVERY_ACQUIRED' OR s->'binding' IS DISTINCT FROM b
  OR s->'credentialRef' IS DISTINCT FROM cr.credential_ref OR s->'challengeRef' IS DISTINCT FROM get_ref
  OR s->'understandingRequestRef' IS DISTINCT FROM expected_request
  OR g.grant_id<>r.grant_id OR g.grant_version<>r.grant_version OR u.grant_id<>r.grant_id OR u.grant_version<>r.grant_version
  OR g.content_hash IS DISTINCT FROM anvil.execution_json_hash(g.snapshot_json) OR u.content_hash IS DISTINCT FROM anvil.execution_json_hash(u.snapshot_json)
  OR g.snapshot_json->'binding' IS DISTINCT FROM b OR g.snapshot_json->'credentialRef' IS DISTINCT FROM cr.credential_ref
  OR g.snapshot_json->'understandingRequestRef' IS DISTINCT FROM expected_request
  OR g.snapshot_json#>>'{publicChallenge,purpose}' IS DISTINCT FROM 'EXECUTION_REQUEST'
  OR g.snapshot_json#>'{request,requestId}' IS DISTINCT FROM s->'requestId'
  OR g.snapshot_json#>'{publicChallenge,requestId}' IS DISTINCT FROM s->'requestId'
  OR g.snapshot_json#>'{request,target}' IS DISTINCT FROM s->'target'
  OR s->'target' IS DISTINCT FROM jsonb_build_object('method','GET','path','/api/v1/connectors/'||(b->>'connectorId')||'/executions/'||(b->>'executionId')||'/understanding-response-read',
    'bodyHash',anvil.execution_json_hash('null'::jsonb),'queryHash',anvil.execution_json_hash('{}'::jsonb))
  OR g.snapshot_json->'previousRef' IS DISTINCT FROM 'null'::jsonb OR g.snapshot_json->'consumption' IS DISTINCT FROM 'null'::jsonb
  OR u.server_sequence<=g.server_sequence
  OR u.snapshot_json IS DISTINCT FROM (g.snapshot_json||jsonb_build_object('sequence',u.server_sequence,'previousRef',get_ref,
    'consumption',jsonb_build_object('resultRef',expected_acquisition,'packetHash',s->'packetHash','consumedAt',s->'observedAt')))
  OR NOT COALESCE(anvil.execution_iso_valid(s->'observedAt'),false) OR NOT COALESCE(anvil.execution_iso_valid(s->'expiresAt'),false)
  OR jsonb_typeof(s->'packetHash') IS DISTINCT FROM 'string' OR s->>'packetHash' !~ '^[0-9a-f]{64}$'
 THEN RAISE EXCEPTION 'NORMAL_UNDERSTANDING_RESULT_DENIED';END IF;
 -- 원 HUMAN 인증·OWNER/client/control/policy 및 정상 등록/예산/회수를 같은 거래에서 다시 조회한다.
 d=anvil.fn09_normal_understanding_discovery(token,b,(s->>'requestId')::uuid,expected_request);
 IF d->>'status' IS DISTINCT FROM 'REQUEST' OR d->'requestRef' IS DISTINCT FROM expected_request OR s->'context' IS DISTINCT FROM d#>'{snapshot,context}'
  OR (s->>'observedAt')::timestamptz<(g.snapshot_json#>>'{publicChallenge,issuedAt}')::timestamptz
  OR (s->>'observedAt')::timestamptz>cur.observed_at OR (s->>'expiresAt')::timestamptz<=(s->>'observedAt')::timestamptz
  OR (s->>'expiresAt')::timestamptz>least(cr.expires_at,cur.deadline,(d->>'deadline')::timestamptz,(g.snapshot_json#>>'{publicChallenge,expiresAt}')::timestamptz)
 THEN RAISE EXCEPTION 'NORMAL_UNDERSTANDING_RESULT_DENIED';END IF;
 ends=least(cr.expires_at,cur.deadline,(d->>'deadline')::timestamptz,(s->>'expiresAt')::timestamptz);
 IF ends<=clock_timestamp() THEN RAISE EXCEPTION 'NORMAL_UNDERSTANDING_RESULT_DENIED';END IF;
 RETURN jsonb_build_object('requestRef',expected_request,'snapshot',d->'snapshot','acquisitionRef',expected_acquisition,'receipt',s,
  'getChallenge',jsonb_build_object('id',g.id,'content_hash',g.content_hash,'snapshot_json',g.snapshot_json),
  'getConsumed',jsonb_build_object('ref',jsonb_build_object('id',u.id,'version',2,'contentHash',u.content_hash),'snapshot',u.snapshot_json),
  'deadline',to_char(ends AT TIME ZONE 'UTC','YYYY-MM-DD"T"HH24:MI:SS.MS"Z"'));
END;
$$;
ALTER FUNCTION anvil.fn09_normal_understanding_result_basis(text,jsonb,jsonb,jsonb) OWNER TO anvil_v3_migrator;
REVOKE ALL ON FUNCTION anvil.fn09_normal_understanding_result_basis(text,jsonb,jsonb,jsonb) FROM PUBLIC,anvil_v3_app;
GRANT EXECUTE ON FUNCTION anvil.fn09_normal_understanding_result_basis(text,jsonb,jsonb,jsonb) TO anvil_v3_app;
COMMIT;
