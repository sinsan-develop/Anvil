-- FN09 A: 첫 HUMAN 메타 탐색 요청만. 미적용; 실제 PG/ACL/동시성 NOT_RUN.
-- FIRST/slot/init/tail, 획득/result receipt, 선택 원문/정산, normal 검토는 아직 미연결.
-- 기존 0090/0097 nonce/receipt/일반 명령과 S1의 503은 변경하지 않는다.
BEGIN;
CREATE TABLE anvil.normal_understanding_read_requests(
 project_id uuid NOT NULL, id uuid NOT NULL, execution_id uuid NOT NULL,generation bigint NOT NULL,
 grant_id uuid NOT NULL,grant_version bigint NOT NULL,command_id uuid NOT NULL,
 content_hash text NOT NULL CHECK(content_hash~'^[0-9a-f]{64}$'),snapshot_json jsonb NOT NULL,
 created_at timestamptz NOT NULL,expires_at timestamptz NOT NULL,
 PRIMARY KEY(project_id,id),UNIQUE(project_id,command_id),
 FOREIGN KEY(project_id,execution_id,generation) REFERENCES anvil.executions(project_id,id,generation),
 FOREIGN KEY(project_id,grant_id,grant_version) REFERENCES anvil.execution_grants(project_id,id,version),
 FOREIGN KEY(project_id,command_id) REFERENCES anvil.commands(project_id,id),
 CHECK(expires_at>created_at AND expires_at<=created_at+interval '30 seconds'),
 CHECK(octet_length(anvil.fn01_json(snapshot_json))<=8192),
 CHECK(snapshot_json->>'state'='PENDING_SOURCE' AND snapshot_json->'sourceScope'='null'::jsonb)
);
ALTER TABLE anvil.normal_understanding_read_requests OWNER TO anvil_v3_migrator;
REVOKE ALL ON anvil.normal_understanding_read_requests FROM PUBLIC,anvil_v3_app;
-- 본문 없는 메타데이터도 일반 SELECT/INSERT/UPDATE/DELETE를 열지 않는다.

CREATE FUNCTION anvil.fn09_normal_understanding_request_basis(s uuid,a uuid,c uuid,q jsonb,policy jsonb,expected_tx text)
RETURNS jsonb LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog AS $$
DECLARE p uuid;eid uuid;gen bigint;pc anvil.project_control;m anvil.project_members;hs anvil.auth_sessions;
 pv anvil.permission_policy_versions;g anvil.execution_grants;x anvil.execution_commands;f jsonb;rule jsonb;cur record;
 allowed boolean=false;until_at timestamptz;at timestamptz;ctx jsonb;
BEGIN
 IF expected_tx IS DISTINCT FROM txid_current()::text OR NOT COALESCE(anvil.execution_json_shape(q,ARRAY['schemaVersion','projectId','commandId','clientId','controlGeneration','operation','targetId','expectedVersion','baselineRefs','approvalRef','payload']),false)
  OR q->'schemaVersion' IS DISTINCT FROM '1'::jsonb OR q->>'operation' IS DISTINCT FROM 'readNormalUnderstandingResponse'
  OR q->>'clientId' IS DISTINCT FROM c::text OR q->'baselineRefs' IS DISTINCT FROM '[]'::jsonb OR q->'approvalRef' IS DISTINCT FROM 'null'::jsonb
  OR NOT COALESCE(anvil.execution_json_shape(q->'payload',ARRAY['assignmentRef','preparationRef']),false)
  OR NOT COALESCE(anvil.execution_preparation_ref_valid(q#>'{payload,assignmentRef}'),false)
  OR NOT COALESCE(anvil.execution_preparation_ref_valid(q#>'{payload,preparationRef}'),false)
  OR octet_length(anvil.fn01_json(q))>8192 THEN RAISE EXCEPTION 'NORMAL_UNDERSTANDING_REQUEST_INVALID';END IF;
 p=(q->>'projectId')::uuid;eid=(q->>'targetId')::uuid;gen=(q->>'expectedVersion')::bigint;
 IF gen IS NULL OR gen<1 OR gen>9007199254740991 OR q->'expectedVersion' IS DISTINCT FROM to_jsonb(gen) OR q->'controlGeneration' IS DISTINCT FROM to_jsonb((q->>'controlGeneration')::bigint) OR (q->>'commandId')::uuid IS NULL THEN RAISE EXCEPTION 'NORMAL_UNDERSTANDING_REQUEST_INVALID';END IF;
 PERFORM anvil.fn01_active(s,a,c);
 SELECT * INTO hs FROM anvil.auth_sessions WHERE id=s AND user_id=a AND client_id=c;
 PERFORM id FROM anvil.projects WHERE id=p AND archived_at IS NULL FOR UPDATE;
 IF NOT FOUND THEN RAISE EXCEPTION 'NOT_FOUND';END IF;
 SELECT * INTO m FROM anvil.project_members WHERE project_id=p AND user_id=a AND revoked_at IS NULL FOR SHARE;
 SELECT * INTO pc FROM anvil.project_control WHERE project_id=p FOR UPDATE;
 IF m.participation IS DISTINCT FROM 'OWNER' OR pc.actor_id IS DISTINCT FROM a OR pc.client_id IS DISTINCT FROM c OR pc.revoked_at IS NOT NULL
  OR pc.generation::text IS DISTINCT FROM q->>'controlGeneration' THEN RAISE EXCEPTION 'PROJECT_CONTROL_REQUIRED';END IF;
 SELECT v.* INTO pv FROM anvil.permission_policies h JOIN anvil.permission_policy_versions v
  ON v.project_id=h.project_id AND v.policy_id=h.id AND v.version=h.head_version WHERE h.project_id=p FOR SHARE OF h;
 IF pv.policy_id IS NULL OR policy IS DISTINCT FROM jsonb_build_object('id',pv.policy_id,'version',pv.version,'contentHash',pv.content_hash)
  OR pv.content_hash IS DISTINCT FROM anvil.fn01_hash(jsonb_build_object('rules',pv.rules_json,'reason',pv.reason,'reviewRefs',pv.review_refs))
  THEN RAISE EXCEPTION 'POLICY_INTEGRITY_FAILED';END IF;
 at=clock_timestamp();IF hs.reauth_until IS NULL OR hs.reauth_until<=at THEN RAISE EXCEPTION 'REAUTHENTICATION_REQUIRED';END IF;until_at=least(hs.idle_expires_at,hs.absolute_expires_at,hs.reauth_until);
 FOR rule IN SELECT value FROM jsonb_array_elements(pv.rules_json) LOOP
  -- 일반 DENY/REQUIRE_APPROVAL을 좁은 AUTO보다 먼저 보존한다. 복수 project scope도 매칭 후 거절한다.
  IF rule#>>'{subjectRef,kind}'='HUMAN' AND rule#>>'{subjectRef,userId}'=a::text AND rule->'operations' ? 'readNormalUnderstandingResponse'
   AND EXISTS(SELECT 1 FROM jsonb_array_elements(rule->'targetScopes') t WHERE t->>'kind'='PROJECT' AND t->>'projectId'=p::text)
   AND (rule->>'expiresAt')::timestamptz>at THEN
   IF rule->>'disposition' IS DISTINCT FROM 'AUTO' OR rule->'subjectRef' IS DISTINCT FROM jsonb_build_object('kind','HUMAN','userId',a)
    OR rule->'targetScopes' IS DISTINCT FROM jsonb_build_array(jsonb_build_object('kind','PROJECT','projectId',p)) OR rule->'limitPolicyRef' IS DISTINCT FROM 'null'::jsonb
    THEN RAISE EXCEPTION 'PROJECT_OPERATION_DENIED';END IF;
   allowed=true;until_at=least(until_at,(rule->>'expiresAt')::timestamptz);
  END IF;
 END LOOP;
 IF NOT allowed THEN RAISE EXCEPTION 'PROJECT_OPERATION_DENIED';END IF;
 -- 탐색 입력은 exact assignment/preparation일 뿐 출력 부모/최초 FIRST를 주장하지 않는다.
 SELECT * INTO STRICT g FROM anvil.execution_grants z WHERE z.project_id=p AND z.execution_id=eid AND z.generation=gen
  AND z.snapshot_json->>'transport'='NORMAL_PROTECTED' AND z.snapshot_json#>>'{binding,intent,mode}'='CONTEXT_REVIEW'
  AND z.snapshot_json#>'{binding,intent,assignmentRef}'=q#>'{payload,assignmentRef}' AND z.snapshot_json#>'{binding,preparationRef}'=q#>'{payload,preparationRef}';
 f=g.snapshot_json->'binding';
 IF f#>>'{subject,userId}' IS DISTINCT FROM a::text OR f#>>'{subject,clientId}' IS DISTINCT FROM c::text
  OR f#>>'{subject,humanSessionId}' IS DISTINCT FROM s::text OR f#>>'{subject,credentialGeneration}' IS DISTINCT FROM hs.credential_generation::text
  OR EXISTS(SELECT 1 FROM anvil.executions newer WHERE newer.project_id=p AND newer.id=eid AND newer.generation>gen)
  OR NOT anvil.normal_start_material_complete(p,g.command_id) THEN RAISE EXCEPTION 'NORMAL_UNDERSTANDING_REQUEST_CURRENT_REQUIRED';END IF;
 SELECT * INTO STRICT cur FROM anvil.normal_exchange_current(p,(f#>>'{registration,connectorId}')::uuid,eid,g.id,g.version,g.content_hash,(f#>>'{executionCredentialReservation,generation}')::bigint);
 SELECT * INTO STRICT x FROM anvil.execution_commands z WHERE z.project_id=p AND z.created_command_id=g.command_id
  AND z.execution_id=eid AND z.generation=gen AND z.grant_id=g.id AND z.grant_version=g.version AND z.snapshot_json->>'operation'='START_SESSION';
 IF x.content_hash IS DISTINCT FROM anvil.execution_json_hash(x.snapshot_json-'envelope') OR x.envelope_hash IS DISTINCT FROM anvil.execution_json_hash((x.snapshot_json->'envelope')-'envelopeHash')
  OR x.snapshot_json#>>'{envelope,envelopeHash}' IS DISTINCT FROM x.envelope_hash THEN RAISE EXCEPTION 'NORMAL_UNDERSTANDING_REQUEST_SOURCE_INVALID';END IF;
 until_at=least(until_at,cur.deadline);at=clock_timestamp();IF until_at<=at THEN RAISE EXCEPTION 'NORMAL_UNDERSTANDING_REQUEST_EXPIRED';END IF;
 ctx=jsonb_build_object('projectId',p,'executionId',eid,'executionGeneration',gen,'grantRef',jsonb_build_object('id',g.id,'version',g.version,'contentHash',g.content_hash),
  'registrationRef',f#>'{registration,ref}','connectorId',f#>'{registration,connectorId}','credentialGeneration',f#>'{executionCredentialReservation,generation}',
  'startCommandId',x.snapshot_json#>'{envelope,commandId}','startCommandRef',jsonb_build_object('id',x.id,'version',x.version,'contentHash',x.content_hash),
  'assignmentRef',f#>'{intent,assignmentRef}','preparationRef',f->'preparationRef','contextBundleRef',f#>'{intent,contextBundleRef}','sessionBindingRef',f#>'{agentSession,sessionRef}');
 RETURN jsonb_build_object('context',ctx,'observedAt',to_char(at AT TIME ZONE 'UTC','YYYY-MM-DD"T"HH24:MI:SS.MS"Z"'),
  'expiresAt',to_char(until_at AT TIME ZONE 'UTC','YYYY-MM-DD"T"HH24:MI:SS.MS"Z"'));
END;
$$;

CREATE FUNCTION anvil.fn09_normal_understanding_request_complete(p uuid,rid uuid) RETURNS boolean
LANGUAGE plpgsql STABLE SECURITY DEFINER SET search_path=pg_catalog AS $$
DECLARE r anvil.normal_understanding_read_requests;c anvil.commands;s jsonb;q jsonb;ref jsonb;scope_hash text;
BEGIN
 SELECT * INTO r FROM anvil.normal_understanding_read_requests WHERE project_id=p AND id=rid;IF NOT FOUND THEN RETURN false;END IF;
 s=r.snapshot_json;q=s->'request';ref=jsonb_build_object('id',r.id,'version',1,'contentHash',r.content_hash);
 IF r.content_hash IS DISTINCT FROM anvil.fn01_hash(s) OR NOT COALESCE(anvil.execution_json_shape(s,ARRAY['schemaVersion','purpose','request','context','requestedBy','policyRef','state','sourceScope','createdAt','expiresAt']),false)
  OR s->>'purpose' IS DISTINCT FROM 'NORMAL_UNDERSTANDING_METADATA_DISCOVERY' OR s->'schemaVersion' IS DISTINCT FROM '1'::jsonb
  OR s->>'state' IS DISTINCT FROM 'PENDING_SOURCE' OR s->'sourceScope' IS DISTINCT FROM 'null'::jsonb
  OR q->>'operation' IS DISTINCT FROM 'readNormalUnderstandingResponse' OR q->>'projectId' IS DISTINCT FROM p::text
  OR s#>>'{context,projectId}' IS DISTINCT FROM p::text OR s#>>'{context,executionId}' IS DISTINCT FROM r.execution_id::text
  OR s#>>'{context,executionGeneration}' IS DISTINCT FROM r.generation::text OR s#>>'{context,grantRef,id}' IS DISTINCT FROM r.grant_id::text
  OR s#>>'{context,grantRef,version}' IS DISTINCT FROM r.grant_version::text
  OR (s->>'createdAt')::timestamptz IS DISTINCT FROM r.created_at OR (s->>'expiresAt')::timestamptz IS DISTINCT FROM r.expires_at THEN RETURN false;END IF;
 SELECT * INTO c FROM anvil.commands WHERE project_id=p AND id=r.command_id;
 IF c.id IS NULL OR c.scope_kind IS DISTINCT FROM 'PROJECT' OR c.scope_id IS DISTINCT FROM p OR c.operation IS DISTINCT FROM 'readNormalUnderstandingResponse' OR c.state IS DISTINCT FROM 'APPLIED'
  OR c.command_id::text IS DISTINCT FROM q->>'commandId' OR c.request_hash IS DISTINCT FROM anvil.fn01_hash(q)
  OR c.actor_id::text IS DISTINCT FROM s#>>'{requestedBy,userId}' OR c.client_id::text IS DISTINCT FROM s#>>'{requestedBy,clientId}'
  OR c.client_id::text IS DISTINCT FROM q->>'clientId' OR c.control_generation::text IS DISTINCT FROM q->>'controlGeneration'
  OR c.expected_version::text IS DISTINCT FROM q->>'expectedVersion' OR c.policy_ref IS DISTINCT FROM s->'policyRef'
  OR c.approval_consumption_id IS NOT NULL OR c.payload_ref IS NOT NULL OR q->'approvalRef' IS DISTINCT FROM 'null'::jsonb
  OR c.result_ref->>'status' IS DISTINCT FROM 'APPLIED' OR c.result_ref->>'projectId' IS DISTINCT FROM p::text OR c.result_ref->>'commandId' IS DISTINCT FROM c.command_id::text
  OR c.result_ref->>'targetId' IS DISTINCT FROM rid::text OR c.result_ref->'version' IS DISTINCT FROM '1'::jsonb
  OR c.result_ref->'data' IS DISTINCT FROM jsonb_build_object('ref',ref,'status','NORMAL_UNDERSTANDING_METADATA_REQUESTED','requestRef',ref,'state','PENDING_SOURCE',
   'sourceAvailable',false,'selectionAvailable',false,'expiresAt',s->'expiresAt') THEN RETURN false;END IF;
 scope_hash=anvil.fn01_hash(jsonb_build_object('projectId',p,'actorId',c.actor_id,'clientId',c.client_id,'controlGeneration',c.control_generation,'requestHash',c.request_hash,'policyRef',c.policy_ref,'targetRef',ref));
 IF (SELECT count(*) FROM anvil.authorization_receipts ar WHERE ar.id=c.authorization_receipt_id AND ar.command_id=c.id AND ar.scope_kind='PROJECT' AND ar.scope_id=p
  AND ar.subject_ref=jsonb_build_object('kind','HUMAN','userId',c.actor_id,'clientId',c.client_id) AND ar.policy_ref=c.policy_ref AND ar.scope_digest=scope_hash AND ar.approval_decision_ref IS NULL)<>1
  OR (SELECT count(*) FROM anvil.audit_events au WHERE au.project_id=p AND au.command_id=c.id AND au.operation_id=c.operation_id
  AND au.actor_ref=jsonb_build_object('kind','HUMAN','userId',c.actor_id) AND au.client_ref=c.client_id AND au.target_ref=ref AND au.policy_ref=c.policy_ref
  AND au.approval_ref IS NULL AND au.scope_digest=scope_hash AND au.outcome='APPLIED' AND au.source_kind='HUMAN_COMMAND' AND au.reason_code='EXPLICIT_NORMAL_UNDERSTANDING_METADATA_REQUEST')<>1 THEN RETURN false;END IF;
 RETURN true;
EXCEPTION WHEN OTHERS THEN RETURN false;
END;
$$;

CREATE FUNCTION anvil.fn09_normal_understanding_request_insert(s uuid,a uuid,c uuid,q jsonb,policy jsonb,expected_tx text,ref jsonb,snapshot jsonb,cid uuid)
RETURNS jsonb LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog AS $$
DECLARE b jsonb;p uuid;at timestamptz;created timestamptz;until_at timestamptz;g jsonb;hs anvil.auth_sessions;
BEGIN
 b=anvil.fn09_normal_understanding_request_basis(s,a,c,q,policy,expected_tx);p=(q->>'projectId')::uuid;at=clock_timestamp();
 SELECT * INTO hs FROM anvil.auth_sessions WHERE id=s;
 IF NOT COALESCE(anvil.execution_preparation_ref_valid(ref),false) OR ref->'version' IS DISTINCT FROM '1'::jsonb
  OR ref->>'contentHash' IS DISTINCT FROM anvil.fn01_hash(snapshot) OR octet_length(anvil.fn01_json(snapshot))>8192
  OR NOT COALESCE(anvil.execution_json_shape(snapshot,ARRAY['schemaVersion','purpose','request','context','requestedBy','policyRef','state','sourceScope','createdAt','expiresAt']),false)
  OR snapshot->'schemaVersion' IS DISTINCT FROM '1'::jsonb OR snapshot->>'purpose' IS DISTINCT FROM 'NORMAL_UNDERSTANDING_METADATA_DISCOVERY'
  OR snapshot->'request' IS DISTINCT FROM q OR snapshot->'context' IS DISTINCT FROM b->'context' OR snapshot->'policyRef' IS DISTINCT FROM policy
  OR snapshot->>'state' IS DISTINCT FROM 'PENDING_SOURCE' OR snapshot->'sourceScope' IS DISTINCT FROM 'null'::jsonb
  OR snapshot->'requestedBy' IS DISTINCT FROM jsonb_build_object('kind','HUMAN','userId',a,'clientId',c,'sessionId',s,'credentialGeneration',hs.credential_generation,'controlGeneration',(q->>'controlGeneration')::bigint)
  THEN RAISE EXCEPTION 'NORMAL_UNDERSTANDING_REQUEST_INVALID';END IF;
 created=(snapshot->>'createdAt')::timestamptz;until_at=(snapshot->>'expiresAt')::timestamptz;g=b#>'{context,grantRef}';
 IF created>at OR created<transaction_timestamp()-interval '30 seconds' OR until_at<=at OR until_at>created+interval '30 seconds' OR until_at>(b->>'expiresAt')::timestamptz
  THEN RAISE EXCEPTION 'NORMAL_UNDERSTANDING_REQUEST_EXPIRED';END IF;
 -- project lock는 basis에서 유지된다. 불명/만료 요청은 자동 삭제·재발급하지 않는다.
 IF (SELECT count(*) FROM anvil.normal_understanding_read_requests r WHERE r.project_id=p AND r.execution_id=(q->>'targetId')::uuid AND r.generation=(q->>'expectedVersion')::bigint)>=1000
  THEN RAISE EXCEPTION 'NORMAL_UNDERSTANDING_REQUEST_LIMIT';END IF;
 IF EXISTS(SELECT 1 FROM anvil.normal_understanding_read_requests r WHERE r.project_id=p AND r.execution_id=(q->>'targetId')::uuid AND r.generation=(q->>'expectedVersion')::bigint)
  THEN RAISE EXCEPTION 'NORMAL_UNDERSTANDING_REQUEST_PENDING';END IF;
 INSERT INTO anvil.normal_understanding_read_requests(project_id,id,execution_id,generation,grant_id,grant_version,command_id,content_hash,snapshot_json,created_at,expires_at)
 VALUES(p,(ref->>'id')::uuid,(q->>'targetId')::uuid,(q->>'expectedVersion')::bigint,(g->>'id')::uuid,(g->>'version')::bigint,cid,ref->>'contentHash',snapshot,created,until_at);
 IF NOT anvil.fn09_normal_understanding_request_complete(p,(ref->>'id')::uuid) THEN RAISE EXCEPTION 'NORMAL_UNDERSTANDING_REQUEST_INCOMPLETE';END IF;
 RETURN ref;
END;
$$;

CREATE FUNCTION anvil.fn09_normal_understanding_request_immutable() RETURNS trigger LANGUAGE plpgsql SET search_path=pg_catalog AS $$
BEGIN RAISE EXCEPTION 'NORMAL_UNDERSTANDING_REQUEST_IMMUTABLE';END;
$$;
CREATE FUNCTION anvil.fn09_normal_understanding_request_replay(s uuid,a uuid,c uuid,q jsonb,policy jsonb,expected_tx text)
RETURNS TABLE(id uuid,content_hash text,snapshot_json jsonb,result_ref jsonb,complete boolean)
LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog AS $$
DECLARE b jsonb;r anvil.normal_understanding_read_requests;cmd anvil.commands;p uuid;
BEGIN
 b=anvil.fn09_normal_understanding_request_basis(s,a,c,q,policy,expected_tx);p=(q->>'projectId')::uuid;
 SELECT * INTO cmd FROM anvil.commands z WHERE z.project_id=p AND z.actor_id=a AND z.command_id=(q->>'commandId')::uuid;
 IF NOT FOUND THEN RETURN;END IF;
 IF cmd.client_id IS DISTINCT FROM c OR cmd.operation IS DISTINCT FROM 'readNormalUnderstandingResponse' OR cmd.request_hash IS DISTINCT FROM anvil.fn01_hash(q)
  THEN RAISE EXCEPTION 'IDEMPOTENCY_CONFLICT';END IF;
 SELECT * INTO STRICT r FROM anvil.normal_understanding_read_requests z WHERE z.project_id=p AND z.command_id=cmd.id;
 IF NOT anvil.fn09_normal_understanding_request_complete(p,r.id) OR r.snapshot_json->'request' IS DISTINCT FROM q
  OR r.snapshot_json->'context' IS DISTINCT FROM b->'context' OR r.snapshot_json#>>'{requestedBy,sessionId}' IS DISTINCT FROM s::text
  OR r.snapshot_json->'policyRef' IS DISTINCT FROM policy THEN RAISE EXCEPTION 'NORMAL_UNDERSTANDING_REQUEST_REPLAY_INVALID';END IF;
 -- 원 PENDING 영수증의 역사 재확인이다. 새 기한/선택/등록 요청을 발급하지 않는다.
 RETURN QUERY SELECT r.id,r.content_hash,r.snapshot_json,cmd.result_ref,true;
END;
$$;
CREATE TRIGGER fn09_understanding_request_immutable BEFORE UPDATE OR DELETE ON anvil.normal_understanding_read_requests FOR EACH ROW EXECUTE FUNCTION anvil.fn09_normal_understanding_request_immutable();
CREATE FUNCTION anvil.fn09_normal_understanding_request_final() RETURNS trigger LANGUAGE plpgsql SECURITY DEFINER SET search_path=pg_catalog AS $$
DECLARE p uuid;cid uuid;r record;c anvil.commands;b jsonb;
BEGIN
 IF TG_TABLE_NAME='normal_understanding_read_requests' THEN p=NEW.project_id;cid=NEW.command_id;
 ELSIF TG_TABLE_NAME='commands' THEN p=NEW.project_id;cid=NEW.id;
 ELSE cid=NEW.command_id;SELECT project_id INTO p FROM anvil.commands WHERE id=cid;END IF;
 SELECT * INTO c FROM anvil.commands WHERE id=cid AND project_id=p;
 IF c.operation IS DISTINCT FROM 'readNormalUnderstandingResponse' AND NOT EXISTS(SELECT 1 FROM anvil.normal_understanding_read_requests z WHERE z.project_id=p AND z.command_id=cid) THEN RETURN NULL;END IF;
 SELECT * INTO STRICT r FROM anvil.normal_understanding_read_requests WHERE project_id=p AND command_id=cid;
 IF NOT anvil.fn09_normal_understanding_request_complete(p,r.id) THEN RAISE EXCEPTION 'NORMAL_UNDERSTANDING_REQUEST_INCOMPLETE';END IF;
 b=anvil.fn09_normal_understanding_request_basis((r.snapshot_json#>>'{requestedBy,sessionId}')::uuid,c.actor_id,c.client_id,r.snapshot_json->'request',c.policy_ref,txid_current()::text);
 IF b->'context' IS DISTINCT FROM r.snapshot_json->'context' OR (b->>'expiresAt')::timestamptz<r.expires_at THEN RAISE EXCEPTION 'NORMAL_UNDERSTANDING_REQUEST_CURRENT_CHANGED';END IF;
 IF clock_timestamp()>=r.expires_at THEN RAISE EXCEPTION 'NORMAL_UNDERSTANDING_REQUEST_EXPIRED';END IF;
 RETURN NULL;
END;
$$;
CREATE CONSTRAINT TRIGGER fn09_understanding_request_complete AFTER INSERT ON anvil.normal_understanding_read_requests DEFERRABLE INITIALLY DEFERRED FOR EACH ROW EXECUTE FUNCTION anvil.fn09_normal_understanding_request_final();
CREATE CONSTRAINT TRIGGER fn09_understanding_request_command_complete AFTER INSERT OR UPDATE ON anvil.commands DEFERRABLE INITIALLY DEFERRED FOR EACH ROW EXECUTE FUNCTION anvil.fn09_normal_understanding_request_final();
CREATE CONSTRAINT TRIGGER fn09_understanding_request_authorization_complete AFTER INSERT OR UPDATE ON anvil.authorization_receipts DEFERRABLE INITIALLY DEFERRED FOR EACH ROW EXECUTE FUNCTION anvil.fn09_normal_understanding_request_final();
CREATE CONSTRAINT TRIGGER fn09_understanding_request_audit_complete AFTER INSERT OR UPDATE ON anvil.audit_events DEFERRABLE INITIALLY DEFERRED FOR EACH ROW EXECUTE FUNCTION anvil.fn09_normal_understanding_request_final();

ALTER FUNCTION anvil.fn09_normal_understanding_request_basis(uuid,uuid,uuid,jsonb,jsonb,text) OWNER TO anvil_v3_migrator;
ALTER FUNCTION anvil.fn09_normal_understanding_request_complete(uuid,uuid) OWNER TO anvil_v3_migrator;
ALTER FUNCTION anvil.fn09_normal_understanding_request_insert(uuid,uuid,uuid,jsonb,jsonb,text,jsonb,jsonb,uuid) OWNER TO anvil_v3_migrator;
ALTER FUNCTION anvil.fn09_normal_understanding_request_final() OWNER TO anvil_v3_migrator;
ALTER FUNCTION anvil.fn09_normal_understanding_request_replay(uuid,uuid,uuid,jsonb,jsonb,text) OWNER TO anvil_v3_migrator;
REVOKE ALL ON FUNCTION anvil.fn09_normal_understanding_request_basis(uuid,uuid,uuid,jsonb,jsonb,text),anvil.fn09_normal_understanding_request_complete(uuid,uuid),anvil.fn09_normal_understanding_request_insert(uuid,uuid,uuid,jsonb,jsonb,text,jsonb,jsonb,uuid),anvil.fn09_normal_understanding_request_replay(uuid,uuid,uuid,jsonb,jsonb,text),anvil.fn09_normal_understanding_request_final(),anvil.fn09_normal_understanding_request_immutable() FROM PUBLIC,anvil_v3_app;
GRANT EXECUTE ON FUNCTION anvil.fn09_normal_understanding_request_basis(uuid,uuid,uuid,jsonb,jsonb,text),anvil.fn09_normal_understanding_request_replay(uuid,uuid,uuid,jsonb,jsonb,text),anvil.fn09_normal_understanding_request_insert(uuid,uuid,uuid,jsonb,jsonb,text,jsonb,jsonb,uuid) TO anvil_v3_app;
-- app의 일반 자료 쓰기·nonce 발행·result 수락 권한은 추가하지 않는다. 선택 본문 quota는 후속이다.
COMMIT;
