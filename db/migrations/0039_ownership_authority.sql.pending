-- FN06 D1 SOURCE-ONLY, NOT IN ANY EXECUTION MANIFEST. DO NOT APPLY.
-- This is a NEW ownership journal/anchor/head schema, not a rename/retry of rejected 0038.
-- Runtime authority/permission guards are INCOMPLETE. All application DML is denied below.
-- Existing SQL, roles, policies and services are untouched. PostgreSQL execution/syntax is UNVERIFIED.
CREATE TABLE anvil.execution_ownership_events (
 project_id uuid NOT NULL REFERENCES anvil.projects(id),execution_id uuid NOT NULL,execution_generation bigint NOT NULL CHECK(execution_generation BETWEEN 1 AND 9007199254740991),
 event_id uuid NOT NULL,version bigint NOT NULL DEFAULT 1 CHECK(version=1),sequence bigint NOT NULL CHECK(sequence BETWEEN 1 AND 9007199254740991),
 project_sequence bigint NOT NULL CHECK(project_sequence BETWEEN 1 AND 9007199254740991),
 content_hash text NOT NULL CHECK(content_hash~'^[0-9a-f]{64}$'),snapshot_json jsonb NOT NULL CHECK(jsonb_typeof(snapshot_json)='object'),
 candidate_anchor_json jsonb,request_id uuid,
 kind text GENERATED ALWAYS AS(snapshot_json->>'kind') STORED,
 previous_event_id uuid GENERATED ALWAYS AS((snapshot_json->'previousRef'->>'id')::uuid) STORED,
 previous_event_version bigint GENERATED ALWAYS AS((snapshot_json->'previousRef'->>'version')::bigint) STORED,
 previous_event_hash text GENERATED ALWAYS AS(snapshot_json->'previousRef'->>'contentHash') STORED,
 PRIMARY KEY(project_id,event_id,version),UNIQUE(project_id,execution_id,execution_generation,sequence),UNIQUE(project_id,project_sequence),
 UNIQUE(project_id,execution_id,execution_generation,event_id,version,content_hash),
 CHECK(kind IN('PREPARATION_GRANTED','OBSERVATION_REQUESTED','OBSERVATION_ACCEPTED','ANCHOR_ADOPTED','BINDING_RECORDED','REVOKED','EXPIRED','UNKNOWN')),
 CHECK((sequence=1 AND snapshot_json->'previousRef'='null'::jsonb) OR (sequence>1 AND previous_event_id IS NOT NULL AND previous_event_version=1 AND previous_event_hash~'^[0-9a-f]{64}$')),
 CHECK((kind='OBSERVATION_ACCEPTED' AND request_id IS NOT NULL AND request_id::text=snapshot_json->'payload'->'requestRef'->>'id') OR (kind<>'OBSERVATION_ACCEPTED' AND request_id IS NULL)),
 CHECK(candidate_anchor_json IS NULL OR (kind='OBSERVATION_REQUESTED' AND jsonb_typeof(candidate_anchor_json)='object')),
 FOREIGN KEY(project_id,execution_id,execution_generation,previous_event_id,previous_event_version,previous_event_hash)
  REFERENCES anvil.execution_ownership_events(project_id,execution_id,execution_generation,event_id,version,content_hash) DEFERRABLE INITIALLY DEFERRED
);
CREATE UNIQUE INDEX ownership_accepted_request_once ON anvil.execution_ownership_events(project_id,request_id) WHERE kind='OBSERVATION_ACCEPTED';

CREATE TABLE anvil.execution_ownership_observations (
 project_id uuid NOT NULL,execution_id uuid NOT NULL,execution_generation bigint NOT NULL CHECK(execution_generation BETWEEN 1 AND 9007199254740991),
 observation_id uuid NOT NULL,version bigint NOT NULL DEFAULT 1 CHECK(version=1),request_id uuid NOT NULL,
 content_hash text NOT NULL CHECK(content_hash~'^[0-9a-f]{64}$'),snapshot_json jsonb NOT NULL CHECK(jsonb_typeof(snapshot_json)='object'),
 accepted_event_ref jsonb NOT NULL CHECK(jsonb_typeof(accepted_event_ref)='object'),nonce_digest text NOT NULL CHECK(nonce_digest~'^[0-9a-f]{64}$'),
 request_version bigint GENERATED ALWAYS AS((snapshot_json->'report'->'requestRef'->>'version')::bigint) STORED,
 request_hash text GENERATED ALWAYS AS(snapshot_json->'report'->'requestRef'->>'contentHash') STORED,
 accepted_event_id uuid GENERATED ALWAYS AS((accepted_event_ref->>'id')::uuid) STORED,
 accepted_event_version bigint GENERATED ALWAYS AS((accepted_event_ref->>'version')::bigint) STORED,
 accepted_event_hash text GENERATED ALWAYS AS(accepted_event_ref->>'contentHash') STORED,
 PRIMARY KEY(project_id,observation_id,version),UNIQUE(project_id,request_id),
 UNIQUE(project_id,execution_id,execution_generation,observation_id,version,content_hash),
 CHECK(request_id::text=snapshot_json->'report'->'requestRef'->>'id' AND request_version=1 AND request_hash~'^[0-9a-f]{64}$'),
 FOREIGN KEY(project_id,execution_id,execution_generation,request_id,request_version,request_hash)
  REFERENCES anvil.execution_ownership_events(project_id,execution_id,execution_generation,event_id,version,content_hash) DEFERRABLE INITIALLY DEFERRED,
 FOREIGN KEY(project_id,execution_id,execution_generation,accepted_event_id,accepted_event_version,accepted_event_hash)
  REFERENCES anvil.execution_ownership_events(project_id,execution_id,execution_generation,event_id,version,content_hash) DEFERRABLE INITIALLY DEFERRED
);

CREATE TABLE anvil.execution_ownership_anchors (
 project_id uuid NOT NULL,execution_id uuid NOT NULL,execution_generation bigint NOT NULL CHECK(execution_generation BETWEEN 1 AND 9007199254740991),
 anchor_id uuid NOT NULL,version bigint NOT NULL DEFAULT 1 CHECK(version=1),content_hash text NOT NULL CHECK(content_hash~'^[0-9a-f]{64}$'),
 snapshot_json jsonb NOT NULL CHECK(jsonb_typeof(snapshot_json)='object'),preparation_event_ref jsonb NOT NULL,adoption_event_ref jsonb NOT NULL,
 preparation_event_id uuid GENERATED ALWAYS AS((preparation_event_ref->>'id')::uuid) STORED,
 preparation_event_version bigint GENERATED ALWAYS AS((preparation_event_ref->>'version')::bigint) STORED,
 preparation_event_hash text GENERATED ALWAYS AS(preparation_event_ref->>'contentHash') STORED,
 adoption_event_id uuid GENERATED ALWAYS AS((adoption_event_ref->>'id')::uuid) STORED,
 adoption_event_version bigint GENERATED ALWAYS AS((adoption_event_ref->>'version')::bigint) STORED,
 adoption_event_hash text GENERATED ALWAYS AS(adoption_event_ref->>'contentHash') STORED,
 PRIMARY KEY(project_id,anchor_id,version),UNIQUE(project_id,execution_id,execution_generation,anchor_id),
 UNIQUE(project_id,execution_id,execution_generation,anchor_id,version,content_hash),
 FOREIGN KEY(project_id,execution_id,execution_generation,preparation_event_id,preparation_event_version,preparation_event_hash)
  REFERENCES anvil.execution_ownership_events(project_id,execution_id,execution_generation,event_id,version,content_hash) DEFERRABLE INITIALLY DEFERRED,
 FOREIGN KEY(project_id,execution_id,execution_generation,adoption_event_id,adoption_event_version,adoption_event_hash)
  REFERENCES anvil.execution_ownership_events(project_id,execution_id,execution_generation,event_id,version,content_hash) DEFERRABLE INITIALLY DEFERRED
);

CREATE TABLE anvil.execution_ownership_bindings (
 project_id uuid NOT NULL,execution_id uuid NOT NULL,execution_generation bigint NOT NULL CHECK(execution_generation BETWEEN 1 AND 9007199254740991),
 binding_id uuid NOT NULL,version bigint NOT NULL DEFAULT 1 CHECK(version=1),command_id uuid NOT NULL,anchor_ref jsonb NOT NULL,attempt_ref jsonb NOT NULL,permit_ref jsonb NOT NULL,binding_event_ref jsonb NOT NULL,
 content_hash text NOT NULL CHECK(content_hash~'^[0-9a-f]{64}$'),snapshot_json jsonb NOT NULL CHECK(jsonb_typeof(snapshot_json)='object'),
 anchor_id uuid GENERATED ALWAYS AS((anchor_ref->>'id')::uuid) STORED,anchor_version bigint GENERATED ALWAYS AS((anchor_ref->>'version')::bigint) STORED,anchor_hash text GENERATED ALWAYS AS(anchor_ref->>'contentHash') STORED,
 attempt_id uuid GENERATED ALWAYS AS((attempt_ref->>'id')::uuid) STORED,attempt_version bigint GENERATED ALWAYS AS((attempt_ref->>'version')::bigint) STORED,
 permit_id uuid GENERATED ALWAYS AS((permit_ref->>'id')::uuid) STORED,permit_version bigint GENERATED ALWAYS AS((permit_ref->>'version')::bigint) STORED,
 binding_event_id uuid GENERATED ALWAYS AS((binding_event_ref->>'id')::uuid) STORED,binding_event_version bigint GENERATED ALWAYS AS((binding_event_ref->>'version')::bigint) STORED,binding_event_hash text GENERATED ALWAYS AS(binding_event_ref->>'contentHash') STORED,
 PRIMARY KEY(project_id,binding_id,version),UNIQUE(project_id,execution_id,execution_generation,command_id,attempt_id,attempt_version,permit_id,permit_version),
 FOREIGN KEY(project_id,execution_id,execution_generation,anchor_id,anchor_version,anchor_hash)
  REFERENCES anvil.execution_ownership_anchors(project_id,execution_id,execution_generation,anchor_id,version,content_hash) DEFERRABLE INITIALLY DEFERRED,
 FOREIGN KEY(project_id,execution_id,execution_generation,binding_event_id,binding_event_version,binding_event_hash)
  REFERENCES anvil.execution_ownership_events(project_id,execution_id,execution_generation,event_id,version,content_hash) DEFERRABLE INITIALLY DEFERRED
);

CREATE TABLE anvil.execution_ownership_heads (
 project_id uuid NOT NULL,execution_id uuid NOT NULL,execution_generation bigint NOT NULL CHECK(execution_generation BETWEEN 1 AND 9007199254740991),
 id uuid NOT NULL,head_generation bigint NOT NULL CHECK(head_generation BETWEEN 1 AND 9007199254740991),
 content_hash text NOT NULL CHECK(content_hash~'^[0-9a-f]{64}$'),snapshot_json jsonb NOT NULL CHECK(jsonb_typeof(snapshot_json)='object'),
 anchor_id uuid GENERATED ALWAYS AS((snapshot_json->'anchorRef'->>'id')::uuid) STORED,anchor_version bigint GENERATED ALWAYS AS((snapshot_json->'anchorRef'->>'version')::bigint) STORED,anchor_hash text GENERATED ALWAYS AS(snapshot_json->'anchorRef'->>'contentHash') STORED,
 current_event_id uuid GENERATED ALWAYS AS((snapshot_json->'currentEventRef'->>'id')::uuid) STORED,current_event_version bigint GENERATED ALWAYS AS((snapshot_json->'currentEventRef'->>'version')::bigint) STORED,current_event_hash text GENERATED ALWAYS AS(snapshot_json->'currentEventRef'->>'contentHash') STORED,
 PRIMARY KEY(project_id,execution_id,execution_generation),UNIQUE(project_id,id),
 FOREIGN KEY(project_id,execution_id,execution_generation,anchor_id,anchor_version,anchor_hash)
  REFERENCES anvil.execution_ownership_anchors(project_id,execution_id,execution_generation,anchor_id,version,content_hash) DEFERRABLE INITIALLY DEFERRED,
 FOREIGN KEY(project_id,execution_id,execution_generation,current_event_id,current_event_version,current_event_hash)
  REFERENCES anvil.execution_ownership_events(project_id,execution_id,execution_generation,event_id,version,content_hash) DEFERRABLE INITIALLY DEFERRED
);

ALTER TABLE anvil.execution_ownership_events
 ADD COLUMN observation_id uuid GENERATED ALWAYS AS((snapshot_json->'payload'->'observationRef'->>'id')::uuid) STORED,
 ADD COLUMN observation_version bigint GENERATED ALWAYS AS((snapshot_json->'payload'->'observationRef'->>'version')::bigint) STORED,
 ADD COLUMN observation_hash text GENERATED ALWAYS AS(snapshot_json->'payload'->'observationRef'->>'contentHash') STORED,
 ADD CONSTRAINT ownership_event_observation_fk FOREIGN KEY(project_id,execution_id,execution_generation,observation_id,observation_version,observation_hash)
  REFERENCES anvil.execution_ownership_observations(project_id,execution_id,execution_generation,observation_id,version,content_hash) DEFERRABLE INITIALLY DEFERRED;

CREATE FUNCTION anvil.ownership_content_hash(v jsonb) RETURNS text LANGUAGE sql IMMUTABLE STRICT AS $$
 SELECT encode(digest(convert_to(anvil.execution_authority_canonical(v),'UTF8'),'sha256'),'hex')
$$;

-- SOURCE-ONLY shape checks, not authenticated authority or signature validation.
-- Reuse existing 0017 JSON/canonical contracts; do not replace existing functions.
CREATE FUNCTION anvil.ownership_uuid_valid(v jsonb) RETURNS boolean LANGUAGE sql IMMUTABLE AS $$
 SELECT COALESCE(jsonb_typeof(v)='string' AND v#>>'{}' ~ '^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$',false)
$$;
CREATE FUNCTION anvil.ownership_positive_valid(v jsonb) RETURNS boolean LANGUAGE plpgsql IMMUTABLE AS $$
BEGIN
 IF jsonb_typeof(v) IS DISTINCT FROM 'number' THEN RETURN false;END IF;
 RETURN (v#>>'{}')::numeric BETWEEN 1 AND 9007199254740991 AND trunc((v#>>'{}')::numeric)=(v#>>'{}')::numeric;
EXCEPTION WHEN OTHERS THEN RETURN false;END;$$;
CREATE FUNCTION anvil.ownership_ref_valid(v jsonb) RETURNS boolean LANGUAGE sql IMMUTABLE AS $$
 SELECT COALESCE(anvil.execution_json_shape(v,ARRAY['id','version','contentHash']) AND anvil.ownership_uuid_valid(v->'id')
  AND anvil.ownership_positive_valid(v->'version') AND jsonb_typeof(v->'contentHash')='string' AND v->>'contentHash' ~ '^[0-9a-f]{64}$',false)
$$;
CREATE FUNCTION anvil.ownership_process_shape(v jsonb) RETURNS boolean LANGUAGE sql IMMUTABLE AS $$
 SELECT COALESCE(anvil.execution_json_shape(v,ARRAY['runId','generation','jobId','pid','startTicks','executableHash'])
  AND anvil.ownership_uuid_valid(v->'runId') AND anvil.ownership_uuid_valid(v->'jobId')
  AND anvil.ownership_positive_valid(v->'generation') AND anvil.ownership_positive_valid(v->'pid')
  AND jsonb_typeof(v->'startTicks')='string' AND v->>'startTicks' ~ '^[1-9][0-9]{16,19}$'
  AND jsonb_typeof(v->'executableHash')='string' AND v->>'executableHash' ~ '^[0-9a-f]{64}$',false)
$$;
CREATE FUNCTION anvil.ownership_record_shape_guard() RETURNS trigger LANGUAGE plpgsql AS $$
DECLARE r jsonb=to_jsonb(NEW);s jsonb=NEW.snapshot_json;sc jsonb;p jsonb;q jsonb;k text;fields text[];
BEGIN
 IF jsonb_typeof(s) IS DISTINCT FROM 'object' OR octet_length(convert_to(anvil.execution_authority_canonical(s),'UTF8'))>262144
  OR s->'schemaVersion' IS DISTINCT FROM '1'::jsonb OR NEW.content_hash IS DISTINCT FROM anvil.ownership_content_hash(s)
 THEN RAISE EXCEPTION 'OWNERSHIP_ROW_SHAPE_REQUIRED' USING ERRCODE='42501';END IF;
 CASE TG_TABLE_NAME
 WHEN 'execution_ownership_events' THEN
  IF NOT anvil.execution_json_shape(s,ARRAY['schemaVersion','purpose','scope','sequence','previousRef','kind','subject','registrationRef','commandRef','authorizationReceiptRef','auditRef','payload','at','expiresAt'])
   OR s->>'purpose' IS DISTINCT FROM 'OWNERSHIP_EVENT' OR s->'sequence' IS DISTINCT FROM r->'sequence'
   OR COALESCE(s->>'kind','') NOT IN('PREPARATION_GRANTED','OBSERVATION_REQUESTED','OBSERVATION_ACCEPTED','ANCHOR_ADOPTED','BINDING_RECORDED','REVOKED','EXPIRED','UNKNOWN')
   OR NOT anvil.execution_json_shape(s->'subject',ARRAY['userId','clientId','humanSessionId','controlGeneration','credentialGeneration'])
  THEN RAISE EXCEPTION 'OWNERSHIP_EVENT_SHAPE_REQUIRED' USING ERRCODE='42501';END IF;
  FOREACH k IN ARRAY ARRAY['userId','clientId','humanSessionId'] LOOP
   IF NOT anvil.ownership_uuid_valid(s->'subject'->k) THEN RAISE EXCEPTION 'OWNERSHIP_EVENT_SUBJECT_REQUIRED' USING ERRCODE='42501';END IF;
  END LOOP;
  IF NOT anvil.ownership_positive_valid(s->'subject'->'controlGeneration') OR NOT anvil.ownership_positive_valid(s->'subject'->'credentialGeneration')
   OR (NEW.sequence=1 AND s->'previousRef' IS DISTINCT FROM 'null'::jsonb)
   OR (NEW.sequence>1 AND NOT anvil.ownership_ref_valid(s->'previousRef'))
   OR s->'previousRef'->>'id'=NEW.event_id::text
  THEN RAISE EXCEPTION 'OWNERSHIP_EVENT_CHAIN_SHAPE_REQUIRED' USING ERRCODE='42501';END IF;
  FOREACH k IN ARRAY ARRAY['registrationRef','commandRef','authorizationReceiptRef','auditRef'] LOOP
   IF NOT anvil.ownership_ref_valid(s->k) THEN RAISE EXCEPTION 'OWNERSHIP_EVENT_REF_REQUIRED' USING ERRCODE='42501';END IF;
  END LOOP;
  IF NOT anvil.execution_iso_valid(s->'at') OR NOT anvil.execution_iso_valid(s->'expiresAt') OR jsonb_typeof(s->'payload') IS DISTINCT FROM 'object'
   OR (s->>'kind' NOT IN('REVOKED','EXPIRED','UNKNOWN') AND (s->>'expiresAt')::timestamptz<=(s->>'at')::timestamptz)
  THEN RAISE EXCEPTION 'OWNERSHIP_EVENT_TIME_REQUIRED' USING ERRCODE='42501';END IF;
  sc=s->'scope';
 WHEN 'execution_ownership_heads' THEN
  IF NOT anvil.execution_json_shape(s,ARRAY['schemaVersion','purpose','scope','anchorRef','generation','previousHeadRef','currentEventRef','state','updatedAt','expiresAt'])
   OR s->>'purpose' IS DISTINCT FROM 'OWNERSHIP_HEAD' OR s->'generation' IS DISTINCT FROM r->'head_generation'
   OR COALESCE(s->>'state','') NOT IN('ACTIVE','REVOKED','EXPIRED','UNKNOWN')
   OR NOT anvil.ownership_ref_valid(s->'anchorRef') OR NOT anvil.ownership_ref_valid(s->'currentEventRef')
   OR (NEW.head_generation=1 AND s->'previousHeadRef' IS DISTINCT FROM 'null'::jsonb)
   OR (NEW.head_generation>1 AND NOT anvil.ownership_ref_valid(s->'previousHeadRef'))
   OR NOT anvil.execution_iso_valid(s->'updatedAt') OR NOT anvil.execution_iso_valid(s->'expiresAt')
  THEN RAISE EXCEPTION 'OWNERSHIP_HEAD_SHAPE_REQUIRED' USING ERRCODE='42501';END IF;
  sc=s->'scope';
 WHEN 'execution_ownership_anchors' THEN
  IF NOT anvil.execution_json_shape(s,ARRAY['schemaVersion','purpose','transport','scope','processRef','observerRef','recordedAt','expiresAt','state','fileSandboxVerified','executionAuthorized','dispatchPerformed'])
   OR s->>'purpose' IS DISTINCT FROM 'PROCESS_OWNERSHIP_ANCHOR' OR s->>'state' IS DISTINCT FROM 'BOUND'
   OR s->'fileSandboxVerified' IS DISTINCT FROM 'false'::jsonb OR NOT anvil.ownership_process_shape(s->'processRef') OR NOT anvil.ownership_ref_valid(s->'observerRef')
   OR NOT anvil.ownership_ref_valid(NEW.preparation_event_ref) OR NOT anvil.ownership_ref_valid(NEW.adoption_event_ref)
  THEN RAISE EXCEPTION 'OWNERSHIP_ANCHOR_SHAPE_REQUIRED' USING ERRCODE='42501';END IF;
  sc=s->'scope';
 WHEN 'execution_ownership_bindings' THEN
  IF NOT anvil.execution_json_shape(s,ARRAY['schemaVersion','purpose','transport','ownershipEvidenceRef','scope','commandId','envelopeHash','parentThreadClaimRef','attemptRef','permitRef','instructionContentHash','preSendBindingHash','recordedAt','expiresAt'])
   OR s->>'purpose' IS DISTINCT FROM 'SENT_PROCESS_BINDING' OR s->'commandId' IS DISTINCT FROM r->'command_id'
   OR s->'ownershipEvidenceRef' IS DISTINCT FROM NEW.anchor_ref OR s->'attemptRef' IS DISTINCT FROM NEW.attempt_ref OR s->'permitRef' IS DISTINCT FROM NEW.permit_ref
   OR NOT anvil.ownership_ref_valid(NEW.binding_event_ref)
  THEN RAISE EXCEPTION 'OWNERSHIP_BINDING_SHAPE_REQUIRED' USING ERRCODE='42501';END IF;
  FOREACH k IN ARRAY ARRAY['ownershipEvidenceRef','parentThreadClaimRef','attemptRef','permitRef'] LOOP
   IF NOT anvil.ownership_ref_valid(s->k) THEN RAISE EXCEPTION 'OWNERSHIP_BINDING_REF_REQUIRED' USING ERRCODE='42501';END IF;
  END LOOP;
  FOREACH k IN ARRAY ARRAY['envelopeHash','instructionContentHash','preSendBindingHash'] LOOP
   IF (jsonb_typeof(s->k)='string' AND s->>k ~ '^[0-9a-f]{64}$') IS NOT TRUE THEN RAISE EXCEPTION 'OWNERSHIP_BINDING_HASH_REQUIRED' USING ERRCODE='42501';END IF;
  END LOOP;
  sc=s->'scope';
 WHEN 'execution_ownership_observations' THEN
  IF NOT anvil.execution_json_shape(s,ARRAY['schemaVersion','purpose','report','signature','facts']) OR s->>'purpose' IS DISTINCT FROM 'OWNERSHIP_OBSERVATION_RECORD'
   OR (jsonb_typeof(s->'signature')='string' AND s->>'signature' ~ '^[A-Za-z0-9_-]{85}[AQgw]$') IS NOT TRUE
   OR NOT anvil.ownership_ref_valid(NEW.accepted_event_ref)
  THEN RAISE EXCEPTION 'OWNERSHIP_OBSERVATION_SHAPE_REQUIRED' USING ERRCODE='42501';END IF;
  q=s->'report';
  IF NOT anvil.execution_json_shape(q,ARRAY['protocolVersion','purpose','installationId','projectId','executionId','executionGeneration','registrationRef','publicKeyFingerprint','observerRef','anchorRef','preparationRef','requestRef','phase','expectedHeadRef','nonce','requestedAt','expiresAt','factsHash','observedAt'])
   OR q->'protocolVersion' IS DISTINCT FROM '1'::jsonb OR q->>'purpose' IS DISTINCT FROM 'OWNERSHIP_OBSERVATION' OR NOT anvil.execution_nonce_valid(q->'nonce')
   OR NOT anvil.execution_iso_valid(q->'requestedAt') OR NOT anvil.execution_iso_valid(q->'observedAt') OR NOT anvil.execution_iso_valid(q->'expiresAt')
   OR (q->>'observedAt')::timestamptz<(q->>'requestedAt')::timestamptz OR (q->>'observedAt')::timestamptz>=(q->>'expiresAt')::timestamptz
   OR (q->>'expiresAt')::timestamptz>(q->>'requestedAt')::timestamptz+interval '10 seconds'
   OR NOT anvil.ownership_process_shape(s->'facts'->'processRef')
  THEN RAISE EXCEPTION 'OWNERSHIP_OBSERVATION_REPORT_REQUIRED' USING ERRCODE='42501';END IF;
  FOREACH k IN ARRAY ARRAY['registrationRef','observerRef','anchorRef','preparationRef','requestRef'] LOOP
   IF NOT anvil.ownership_ref_valid(q->k) THEN RAISE EXCEPTION 'OWNERSHIP_OBSERVATION_REF_REQUIRED' USING ERRCODE='42501';END IF;
  END LOOP;
  FOREACH k IN ARRAY ARRAY['publicKeyFingerprint','factsHash'] LOOP
   IF (jsonb_typeof(q->k)='string' AND q->>k ~ '^[0-9a-f]{64}$') IS NOT TRUE THEN RAISE EXCEPTION 'OWNERSHIP_OBSERVATION_HASH_REQUIRED' USING ERRCODE='42501';END IF;
  END LOOP;
  IF (q->>'phase'='BOOTSTRAP_PREPARED' AND q->'expectedHeadRef'='null'::jsonb OR q->>'phase'='CURRENT' AND anvil.ownership_ref_valid(q->'expectedHeadRef')) IS NOT TRUE
  THEN RAISE EXCEPTION 'OWNERSHIP_OBSERVATION_PHASE_REQUIRED' USING ERRCODE='42501';END IF;
  sc=jsonb_build_object('installationId',q->'installationId','projectId',q->'projectId','executionId',q->'executionId','executionGeneration',q->'executionGeneration');
 ELSE RAISE EXCEPTION 'OWNERSHIP_TABLE_NOT_SUPPORTED' USING ERRCODE='42501';
 END CASE;
 IF sc->'projectId' IS DISTINCT FROM r->'project_id' OR sc->'executionId' IS DISTINCT FROM r->'execution_id'
  OR sc->'executionGeneration' IS DISTINCT FROM r->'execution_generation' OR NOT anvil.ownership_uuid_valid(sc->'projectId')
  OR NOT anvil.ownership_uuid_valid(sc->'executionId') OR NOT anvil.ownership_positive_valid(sc->'executionGeneration')
 THEN RAISE EXCEPTION 'OWNERSHIP_ROW_SCOPE_REQUIRED' USING ERRCODE='42501';END IF;
 IF TG_TABLE_NAME IN('execution_ownership_anchors','execution_ownership_bindings') THEN
  IF NOT anvil.execution_json_shape(sc,ARRAY['projectId','executionId','executionGeneration','sessionBindingRef','roleBindingRef','executorRegistrationRef'])
   OR s->>'transport' IS DISTINCT FROM 'SYNTHETIC_ONLY' OR NOT anvil.execution_iso_valid(s->'recordedAt') OR NOT anvil.execution_iso_valid(s->'expiresAt')
   OR (s->>'expiresAt')::timestamptz<=(s->>'recordedAt')::timestamptz
  THEN RAISE EXCEPTION 'OWNERSHIP_RECORDED_SCOPE_REQUIRED' USING ERRCODE='42501';END IF;
  FOREACH k IN ARRAY ARRAY['sessionBindingRef','roleBindingRef','executorRegistrationRef'] LOOP
   IF NOT anvil.ownership_ref_valid(sc->k) THEN RAISE EXCEPTION 'OWNERSHIP_SCOPE_REF_REQUIRED' USING ERRCODE='42501';END IF;
  END LOOP;
  IF TG_TABLE_NAME='execution_ownership_anchors' AND (s->'executionAuthorized' IS DISTINCT FROM 'false'::jsonb OR s->'dispatchPerformed' IS DISTINCT FROM 'false'::jsonb)
  THEN RAISE EXCEPTION 'OWNERSHIP_FALSE_AUTHORITY_REQUIRED' USING ERRCODE='42501';END IF;
 ELSE
  IF NOT anvil.execution_json_shape(sc,ARRAY['installationId','projectId','executionId','executionGeneration']) OR NOT anvil.ownership_uuid_valid(sc->'installationId')
  THEN RAISE EXCEPTION 'OWNERSHIP_INSTALLATION_SCOPE_REQUIRED' USING ERRCODE='42501';END IF;
 END IF;
 RETURN NEW;
EXCEPTION WHEN OTHERS THEN RAISE EXCEPTION 'OWNERSHIP_ROW_SHAPE_REQUIRED' USING ERRCODE='42501';
END;$$;
DO $$DECLARE t text;BEGIN
 FOREACH t IN ARRAY ARRAY['execution_ownership_events','execution_ownership_observations','execution_ownership_anchors','execution_ownership_bindings','execution_ownership_heads'] LOOP
  EXECUTE format('CREATE TRIGGER ownership_row_shape BEFORE INSERT OR UPDATE ON anvil.%I FOR EACH ROW EXECUTE FUNCTION anvil.ownership_record_shape_guard()',t);
 END LOOP;
END;$$;
-- This partial shape layer does not validate every kind payload, current HUMAN/policy/registration,
-- cryptographic signature or COMMIT-time authority. The unconditional denial below MUST remain.
CREATE FUNCTION anvil.ownership_observation_links_guard() RETURNS trigger LANGUAGE plpgsql AS $$
DECLARE accepted anvil.execution_ownership_events%ROWTYPE;requested anvil.execution_ownership_events%ROWTYPE;self_ref jsonb;request_ref jsonb;report jsonb;
BEGIN
 self_ref=jsonb_build_object('id',NEW.observation_id,'version',NEW.version,'contentHash',NEW.content_hash);
 report=NEW.snapshot_json->'report';request_ref=report->'requestRef';
 SELECT * INTO accepted FROM anvil.execution_ownership_events
  WHERE project_id=NEW.project_id AND execution_id=NEW.execution_id AND execution_generation=NEW.execution_generation
   AND event_id=NEW.accepted_event_id AND version=NEW.accepted_event_version AND content_hash=NEW.accepted_event_hash;
 SELECT * INTO requested FROM anvil.execution_ownership_events
  WHERE project_id=NEW.project_id AND execution_id=NEW.execution_id AND execution_generation=NEW.execution_generation
   AND event_id=NEW.request_id AND version=NEW.request_version AND content_hash=NEW.request_hash;
 IF accepted.event_id IS NULL OR requested.event_id IS NULL OR accepted.kind<>'OBSERVATION_ACCEPTED' OR requested.kind<>'OBSERVATION_REQUESTED'
  OR accepted.snapshot_json->'payload'->'observationRef' IS DISTINCT FROM self_ref
  OR accepted.snapshot_json->'payload'->'requestRef' IS DISTINCT FROM request_ref
  OR report-'factsHash'-'observedAt' IS DISTINCT FROM (requested.snapshot_json->'payload'->'request')||jsonb_build_object('requestRef',request_ref)
  OR report->'factsHash' IS DISTINCT FROM to_jsonb(anvil.ownership_content_hash(NEW.snapshot_json->'facts'))
  OR NEW.content_hash IS DISTINCT FROM anvil.ownership_content_hash(NEW.snapshot_json)
  OR NEW.nonce_digest IS DISTINCT FROM encode(digest(decode(translate(report->>'nonce','-_','+/')||'=','base64'),'sha256'),'hex')
  OR (report->>'expiresAt')::timestamptz<=clock_timestamp()
  OR (report->>'observedAt')::timestamptz>(accepted.snapshot_json->>'at')::timestamptz
  OR (accepted.snapshot_json->>'at')::timestamptz>=(report->>'expiresAt')::timestamptz
 THEN RAISE EXCEPTION 'OWNERSHIP_OBSERVATION_EXACT_LINK_REQUIRED' USING ERRCODE='42501';END IF;
 RETURN NEW;
END;$$;
CREATE CONSTRAINT TRIGGER ownership_observation_links AFTER INSERT ON anvil.execution_ownership_observations DEFERRABLE INITIALLY DEFERRED FOR EACH ROW EXECUTE FUNCTION anvil.ownership_observation_links_guard();

CREATE FUNCTION anvil.ownership_anchor_links_guard() RETURNS trigger LANGUAGE plpgsql AS $$
DECLARE prep anvil.execution_ownership_events%ROWTYPE;adopt anvil.execution_ownership_events%ROWTYPE;accepted anvil.execution_ownership_events%ROWTYPE;requested anvil.execution_ownership_events%ROWTYPE;self_ref jsonb;accepted_ref jsonb;request_ref jsonb;
BEGIN
 self_ref=jsonb_build_object('id',NEW.anchor_id,'version',NEW.version,'contentHash',NEW.content_hash);
 SELECT * INTO prep FROM anvil.execution_ownership_events WHERE project_id=NEW.project_id AND execution_id=NEW.execution_id AND execution_generation=NEW.execution_generation
  AND event_id=NEW.preparation_event_id AND version=NEW.preparation_event_version AND content_hash=NEW.preparation_event_hash;
 SELECT * INTO adopt FROM anvil.execution_ownership_events WHERE project_id=NEW.project_id AND execution_id=NEW.execution_id AND execution_generation=NEW.execution_generation
  AND event_id=NEW.adoption_event_id AND version=NEW.adoption_event_version AND content_hash=NEW.adoption_event_hash;
 accepted_ref=adopt.snapshot_json->'payload'->'observationEventRef';
 SELECT * INTO accepted FROM anvil.execution_ownership_events WHERE project_id=NEW.project_id AND execution_id=NEW.execution_id AND execution_generation=NEW.execution_generation
  AND event_id=(accepted_ref->>'id')::uuid AND version=(accepted_ref->>'version')::bigint AND content_hash=accepted_ref->>'contentHash';
 request_ref=accepted.snapshot_json->'payload'->'requestRef';
 SELECT * INTO requested FROM anvil.execution_ownership_events WHERE project_id=NEW.project_id AND execution_id=NEW.execution_id AND execution_generation=NEW.execution_generation
  AND event_id=(request_ref->>'id')::uuid AND version=(request_ref->>'version')::bigint AND content_hash=request_ref->>'contentHash';
 IF prep.event_id IS NULL OR adopt.event_id IS NULL OR accepted.event_id IS NULL OR requested.event_id IS NULL
  OR prep.kind<>'PREPARATION_GRANTED' OR adopt.kind<>'ANCHOR_ADOPTED' OR accepted.kind<>'OBSERVATION_ACCEPTED' OR requested.kind<>'OBSERVATION_REQUESTED'
  OR accepted.snapshot_json->'payload'->>'phase' IS DISTINCT FROM 'BOOTSTRAP_PREPARED'
  OR adopt.snapshot_json->'payload'->'anchorRef' IS DISTINCT FROM self_ref
  OR adopt.snapshot_json->'payload'->'preparationRef' IS DISTINCT FROM NEW.preparation_event_ref
  OR requested.candidate_anchor_json IS DISTINCT FROM jsonb_build_object('ref',self_ref,'snapshot',NEW.snapshot_json)
  OR NEW.content_hash IS DISTINCT FROM anvil.ownership_content_hash(NEW.snapshot_json)
 THEN RAISE EXCEPTION 'OWNERSHIP_ANCHOR_EXACT_LINK_REQUIRED' USING ERRCODE='42501';END IF;
 RETURN NEW;
END;$$;
CREATE CONSTRAINT TRIGGER ownership_anchor_links AFTER INSERT ON anvil.execution_ownership_anchors DEFERRABLE INITIALLY DEFERRED FOR EACH ROW EXECUTE FUNCTION anvil.ownership_anchor_links_guard();

-- Both directions use auxiliary row references: neither event hash nor anchor/observation hash contains its future self.
CREATE FUNCTION anvil.ownership_record_immutable() RETURNS trigger LANGUAGE plpgsql AS $$
BEGIN RAISE EXCEPTION 'OWNERSHIP_APPEND_ONLY' USING ERRCODE='42501'; END;$$;
CREATE FUNCTION anvil.ownership_head_cas_guard() RETURNS trigger LANGUAGE plpgsql AS $$
BEGIN
 IF TG_OP='UPDATE' THEN
  IF (NEW.project_id,NEW.execution_id,NEW.execution_generation,NEW.id) IS DISTINCT FROM (OLD.project_id,OLD.execution_id,OLD.execution_generation,OLD.id)
   OR NEW.head_generation<>OLD.head_generation+1
   OR NEW.snapshot_json->'previousHeadRef' IS DISTINCT FROM jsonb_build_object('id',OLD.id,'version',OLD.head_generation,'contentHash',OLD.content_hash)
   OR NEW.snapshot_json->'anchorRef' IS DISTINCT FROM OLD.snapshot_json->'anchorRef'
   OR (NEW.snapshot_json->>'expiresAt')::timestamptz>(OLD.snapshot_json->>'expiresAt')::timestamptz
   OR (OLD.snapshot_json->>'state' IN('REVOKED','EXPIRED'))
   OR (OLD.snapshot_json->>'state'='UNKNOWN' AND NEW.snapshot_json->>'state' NOT IN('REVOKED','EXPIRED'))
  THEN RAISE EXCEPTION 'OWNERSHIP_HEAD_CAS_REQUIRED' USING ERRCODE='42501'; END IF;
 ELSIF NEW.head_generation<>1 OR NEW.snapshot_json->'previousHeadRef' IS DISTINCT FROM 'null'::jsonb THEN
  RAISE EXCEPTION 'OWNERSHIP_INITIAL_HEAD_REQUIRED' USING ERRCODE='42501';
 END IF;
 RETURN NEW;
END;$$;
CREATE TRIGGER ownership_head_cas BEFORE INSERT OR UPDATE ON anvil.execution_ownership_heads FOR EACH ROW EXECUTE FUNCTION anvil.ownership_head_cas_guard();

-- Deliberately fail closed until a complete reviewed HUMAN/current-policy/receipt/registration guard exists.
-- No role flag, set_config switch, SECURITY DEFINER escape hatch, grant or implicit activation is provided.
CREATE FUNCTION anvil.ownership_authority_unavailable() RETURNS trigger LANGUAGE plpgsql AS $$
BEGIN RAISE EXCEPTION 'OWNERSHIP_AUTHORITY_NOT_ACTIVATED' USING ERRCODE='42501'; END;$$;
DO $$DECLARE t text;BEGIN
 FOREACH t IN ARRAY ARRAY['execution_ownership_events','execution_ownership_observations','execution_ownership_anchors','execution_ownership_bindings','execution_ownership_heads'] LOOP
  EXECUTE format('ALTER TABLE anvil.%I ENABLE ROW LEVEL SECURITY',t);
  EXECUTE format('ALTER TABLE anvil.%I FORCE ROW LEVEL SECURITY',t);
  EXECUTE format('REVOKE ALL ON anvil.%I FROM PUBLIC,anvil_v3_app',t);
  EXECUTE format('CREATE POLICY ownership_unavailable ON anvil.%I USING(false) WITH CHECK(false)',t);
  EXECUTE format('CREATE TRIGGER ownership_unavailable BEFORE INSERT OR UPDATE OR DELETE ON anvil.%I FOR EACH ROW EXECUTE FUNCTION anvil.ownership_authority_unavailable()',t);
  EXECUTE format('CREATE TRIGGER ownership_no_truncate BEFORE TRUNCATE ON anvil.%I FOR EACH STATEMENT EXECUTE FUNCTION anvil.ownership_record_immutable()',t);
  IF t<>'execution_ownership_heads' THEN
   EXECUTE format('CREATE TRIGGER ownership_immutable BEFORE UPDATE OR DELETE ON anvil.%I FOR EACH ROW EXECUTE FUNCTION anvil.ownership_record_immutable()',t);
  ELSE
   EXECUTE format('CREATE TRIGGER ownership_no_delete BEFORE DELETE ON anvil.%I FOR EACH ROW EXECUTE FUNCTION anvil.ownership_record_immutable()',t);
  END IF;
 END LOOP;
END;$$;
-- Missing complete authenticated activation/row-shape/event/head/binding guards remain D1 work; the implemented reverse/deadline guards are NOT PG-verified.
-- This candidate intentionally cannot be used as an operational permission provider or a successful PG verification.
