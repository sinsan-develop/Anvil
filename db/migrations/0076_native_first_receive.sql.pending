-- FN06 직접 채택 source-only forward. 실제 적용·권한 부여는 미실행이다.
-- 작성 중: profile/receive 실제 producer와 역완결·collector 접합을 같은 forward에서 닫는다.
BEGIN;
DO $$BEGIN IF current_user<>'anvil_v3_migrator' OR session_user<>'anvil_v3_migrator' THEN RAISE EXCEPTION 'NATIVE_RECEIVE_MIGRATOR_REQUIRED' USING ERRCODE='42501';END IF;END;$$;
CREATE TABLE anvil.native_channel_profile_versions(
 project_id uuid NOT NULL REFERENCES anvil.projects(id) ON DELETE RESTRICT,installation_id uuid NOT NULL,record_kind text NOT NULL CHECK(record_kind IN('PROFILE','HEAD')),
 id uuid NOT NULL,version bigint NOT NULL CHECK(version BETWEEN 1 AND 9007199254740991),content_hash text NOT NULL CHECK(content_hash~'^[a-f0-9]{64}$'),
 profile_id uuid NOT NULL,profile_version bigint NOT NULL CHECK(profile_version BETWEEN 1 AND 9007199254740991),profile_content_hash text NOT NULL CHECK(profile_content_hash~'^[a-f0-9]{64}$'),
 state text NULL CHECK(state IN('ACTIVE','REVOKED')),generation bigint NULL CHECK(generation BETWEEN 1 AND 9007199254740991),
 previous_head_id uuid NULL,previous_head_version bigint NULL,previous_head_hash text NULL,
 anchor_canonical text NOT NULL,anchor_hash text NOT NULL CHECK(anchor_hash~'^[a-f0-9]{64}$'),package_manifest_hash text NOT NULL CHECK(package_manifest_hash~'^[a-f0-9]{64}$'),
 snapshot_canonical text NOT NULL,snapshot_json jsonb NOT NULL,created_at timestamptz NOT NULL DEFAULT transaction_timestamp(),
 PRIMARY KEY(project_id,id,version),UNIQUE(project_id,id,version,content_hash),
 CHECK((record_kind='PROFILE' AND id=profile_id AND version=profile_version AND content_hash=profile_content_hash AND state IS NULL AND generation IS NULL AND previous_head_id IS NULL AND previous_head_version IS NULL AND previous_head_hash IS NULL) OR
 (record_kind='HEAD' AND version=1 AND state IS NOT NULL AND generation IS NOT NULL AND ((generation=1 AND previous_head_id IS NULL AND previous_head_version IS NULL AND previous_head_hash IS NULL) OR (generation>1 AND previous_head_id IS NOT NULL AND previous_head_version IS NOT NULL AND previous_head_hash IS NOT NULL AND previous_head_version=1 AND previous_head_hash~'^[a-f0-9]{64}$')))),
 FOREIGN KEY(project_id,profile_id,profile_version,profile_content_hash) REFERENCES anvil.native_channel_profile_versions(project_id,id,version,content_hash) ON DELETE RESTRICT DEFERRABLE INITIALLY DEFERRED,
 FOREIGN KEY(project_id,previous_head_id,previous_head_version,previous_head_hash) REFERENCES anvil.native_channel_profile_versions(project_id,id,version,content_hash) ON DELETE RESTRICT DEFERRABLE INITIALLY DEFERRED
);
CREATE UNIQUE INDEX fn76_profile_generation ON anvil.native_channel_profile_versions(project_id,installation_id,profile_id,generation) WHERE record_kind='HEAD';
CREATE TABLE anvil.native_channel_profile_heads(
 project_id uuid NOT NULL REFERENCES anvil.projects(id) ON DELETE RESTRICT,installation_id uuid NOT NULL,profile_id uuid NOT NULL,generation bigint NOT NULL CHECK(generation BETWEEN 1 AND 9007199254740991),
 current_profile_version bigint NOT NULL CHECK(current_profile_version BETWEEN 1 AND 9007199254740991),current_profile_hash text NOT NULL CHECK(current_profile_hash~'^[a-f0-9]{64}$'),
 current_head_id uuid NOT NULL,current_head_version bigint NOT NULL CHECK(current_head_version=1),current_head_hash text NOT NULL CHECK(current_head_hash~'^[a-f0-9]{64}$'),
 minimum_profile_version bigint NOT NULL CHECK(minimum_profile_version BETWEEN 1 AND 9007199254740991),anchor_hash text NOT NULL CHECK(anchor_hash~'^[a-f0-9]{64}$'),package_manifest_hash text NOT NULL CHECK(package_manifest_hash~'^[a-f0-9]{64}$'),created_at timestamptz NOT NULL DEFAULT transaction_timestamp(),updated_at timestamptz NOT NULL,
 PRIMARY KEY(project_id,installation_id),UNIQUE(project_id,profile_id),
 FOREIGN KEY(project_id,profile_id,current_profile_version,current_profile_hash) REFERENCES anvil.native_channel_profile_versions(project_id,id,version,content_hash) ON DELETE RESTRICT DEFERRABLE INITIALLY DEFERRED,
 FOREIGN KEY(project_id,current_head_id,current_head_version,current_head_hash) REFERENCES anvil.native_channel_profile_versions(project_id,id,version,content_hash) ON DELETE RESTRICT DEFERRABLE INITIALLY DEFERRED
);
CREATE TABLE anvil.native_receive_heads(
 project_id uuid NOT NULL REFERENCES anvil.projects(id) ON DELETE RESTRICT,window_id uuid NOT NULL,original_session_id uuid NOT NULL REFERENCES anvil.auth_sessions(id) ON DELETE RESTRICT,
 actor_id uuid NOT NULL,client_id uuid NOT NULL,credential_generation bigint NOT NULL CHECK(credential_generation BETWEEN 1 AND 9007199254740991),control_generation bigint NOT NULL CHECK(control_generation BETWEEN 1 AND 9007199254740991),
 registration_id uuid NOT NULL,registration_version bigint NOT NULL CHECK(registration_version BETWEEN 1 AND 9007199254740991),registration_hash text NOT NULL CHECK(registration_hash~'^[a-f0-9]{64}$'),connector_id uuid NOT NULL,connector_version bigint NOT NULL CHECK(connector_version BETWEEN 1 AND 9007199254740991),connector_hash text NOT NULL CHECK(connector_hash~'^[a-f0-9]{64}$'),
 profile_id uuid NOT NULL,profile_version bigint NOT NULL CHECK(profile_version BETWEEN 1 AND 9007199254740991),profile_hash text NOT NULL CHECK(profile_hash~'^[a-f0-9]{64}$'),local_attempt_id uuid NOT NULL,
 phase text NOT NULL CHECK(phase IN('WINDOW_PREPARED','OPENED','STREAMING','OFFERED','ARMED','BOUND','ATTEMPTED','CONFIRMED','UNCONFIRMED','CLOSED')),revision bigint NOT NULL CHECK(revision BETWEEN 1 AND 9007199254740991),
 broker_instance_id uuid NULL,operation_fence uuid NULL,stream_owned boolean NOT NULL,session_record_id uuid NULL,offer_record_id uuid NULL,arm_record_id uuid NULL,binding_record_id uuid NULL,delivery_record_id uuid NULL,ack_record_id uuid NULL,terminal_record_id uuid NULL,
 created_at timestamptz NOT NULL DEFAULT transaction_timestamp(),expires_at timestamptz NOT NULL,settled_at timestamptz NULL,
 PRIMARY KEY(project_id,window_id),FOREIGN KEY(actor_id,client_id) REFERENCES anvil.clients(user_id,id) ON DELETE RESTRICT,
 FOREIGN KEY(project_id,registration_id) REFERENCES anvil.connector_registrations(project_id,id) ON DELETE RESTRICT,
 FOREIGN KEY(project_id,connector_id) REFERENCES anvil.connectors(project_id,id) ON DELETE RESTRICT,
 FOREIGN KEY(project_id,profile_id,profile_version,profile_hash) REFERENCES anvil.native_channel_profile_versions(project_id,id,version,content_hash) ON DELETE RESTRICT DEFERRABLE INITIALLY DEFERRED,
 CHECK(expires_at>created_at AND expires_at<=created_at+interval '120 seconds'),CHECK((broker_instance_id IS NULL)=(operation_fence IS NULL)),
 CHECK((phase IN('CONFIRMED','UNCONFIRMED','CLOSED'))=(settled_at IS NOT NULL))
);
CREATE UNIQUE INDEX fn76_single_receive ON anvil.native_receive_heads(project_id,registration_id) WHERE phase NOT IN('CONFIRMED','UNCONFIRMED','CLOSED');
CREATE TABLE anvil.native_receive_records(
 project_id uuid NOT NULL,record_id uuid NOT NULL,record_kind text NOT NULL CHECK(record_kind IN('WINDOW','SESSION','OFFER','ARM','BINDING','DELIVERY','ACK','TERMINAL','CHALLENGE','ISSUE_EVIDENCE','ISSUE_REPLAY','PROOF_EVIDENCE','CONSUME_REPLAY','HUMAN_DENIAL_OUTCOME')),version smallint NOT NULL CHECK(version=1),window_id uuid NOT NULL,
 profile_id uuid NOT NULL,profile_version bigint NOT NULL,profile_hash text NOT NULL,
 ticket_phase text NULL CHECK(ticket_phase IN('OPEN','STREAM','ARM','ACK','STATE','CLOSE')),ticket_occurrence smallint NULL,human_operation text NULL CHECK(human_operation IN('offerNativeReceiveCommand','closeNativeReceiveWindow')),external_command_id uuid NULL,request_hash text NULL CHECK(request_hash~'^[a-f0-9]{64}$'),
 content_hash text NOT NULL CHECK(content_hash~'^[a-f0-9]{64}$'),record_canonical text NOT NULL,record_json jsonb NOT NULL,receive_credential_digest text NULL,accounting_version smallint NOT NULL CHECK(accounting_version=1),created_at timestamptz NOT NULL DEFAULT transaction_timestamp(),
 session_record_id uuid NULL,offer_record_id uuid NULL,arm_record_id uuid NULL,binding_record_id uuid NULL,delivery_record_id uuid NULL,ack_record_id uuid NULL,challenge_record_id uuid NULL,issue_evidence_record_id uuid NULL,proof_evidence_record_id uuid NULL,result_record_id uuid NULL,terminal_record_id uuid NULL,
 native_authority_id uuid NULL,native_event_id uuid NULL,native_event_version smallint NULL,native_command_id uuid NULL REFERENCES anvil.commands(id) ON DELETE RESTRICT,authorization_receipt_id uuid NULL REFERENCES anvil.authorization_receipts(id) ON DELETE RESTRICT,audit_event_id uuid NULL REFERENCES anvil.audit_events(event_id) ON DELETE RESTRICT,
 PRIMARY KEY(project_id,record_id),UNIQUE(project_id,record_id,version,content_hash),UNIQUE(project_id,record_id,record_kind),
 FOREIGN KEY(project_id,window_id) REFERENCES anvil.native_receive_heads(project_id,window_id) ON DELETE RESTRICT DEFERRABLE INITIALLY DEFERRED,
 FOREIGN KEY(project_id,profile_id,profile_version,profile_hash) REFERENCES anvil.native_channel_profile_versions(project_id,id,version,content_hash) ON DELETE RESTRICT DEFERRABLE INITIALLY DEFERRED,
 FOREIGN KEY(project_id,native_authority_id) REFERENCES anvil.native_preparation_authorities(project_id,id) ON DELETE RESTRICT DEFERRABLE INITIALLY DEFERRED,
 FOREIGN KEY(project_id,native_event_id,native_event_version) REFERENCES anvil.native_preparation_authority_events(project_id,id,version) ON DELETE RESTRICT DEFERRABLE INITIALLY DEFERRED,
 CHECK((record_kind='SESSION' AND receive_credential_digest IS NOT NULL AND receive_credential_digest~'^[0-9a-f]{64}$') OR (record_kind<>'SESSION' AND receive_credential_digest IS NULL)),
 CHECK((ticket_phase IS NULL)=(ticket_occurrence IS NULL)),CHECK((native_event_id IS NULL)=(native_event_version IS NULL)),
 CHECK((record_kind='HUMAN_DENIAL_OUTCOME')=(human_operation IS NOT NULL))
);
CREATE UNIQUE INDEX fn76_record_domain ON anvil.native_receive_records(project_id,window_id,record_kind) WHERE record_kind IN('WINDOW','SESSION','OFFER','ARM','BINDING','DELIVERY','ACK','TERMINAL');
CREATE UNIQUE INDEX fn76_record_ticket ON anvil.native_receive_records(project_id,window_id,record_kind,ticket_phase,ticket_occurrence) WHERE record_kind IN('CHALLENGE','ISSUE_EVIDENCE','ISSUE_REPLAY','PROOF_EVIDENCE','CONSUME_REPLAY');
CREATE UNIQUE INDEX fn76_record_denial ON anvil.native_receive_records(project_id,window_id,human_operation) WHERE record_kind='HUMAN_DENIAL_OUTCOME';
CREATE TABLE anvil.native_receive_tickets(
 project_id uuid NOT NULL,window_id uuid NOT NULL,phase text NOT NULL CHECK(phase IN('OPEN','STREAM','ARM','ACK','STATE','CLOSE')),occurrence smallint NOT NULL,ticket_id uuid NOT NULL,
 stage text NOT NULL CHECK(stage IN('UNUSED','CHALLENGE_ISSUED','CONSUMED','REJECTED')),issue_request_id uuid NULL,issue_request_hash text NULL CHECK(issue_request_hash~'^[a-f0-9]{64}$'),consume_request_id uuid NULL,consume_request_hash text NULL CHECK(consume_request_hash~'^[a-f0-9]{64}$'),
 challenge_record_id uuid NULL,issue_evidence_record_id uuid NULL,issue_replay_record_id uuid NULL,proof_evidence_record_id uuid NULL,consume_replay_record_id uuid NULL,created_at timestamptz NOT NULL DEFAULT transaction_timestamp(),finished_at timestamptz NULL,
 PRIMARY KEY(project_id,window_id,phase,occurrence),UNIQUE(project_id,ticket_id),
 FOREIGN KEY(project_id,window_id) REFERENCES anvil.native_receive_heads(project_id,window_id) ON DELETE RESTRICT DEFERRABLE INITIALLY DEFERRED,
 CHECK((phase='STATE' AND occurrence IN(1,2)) OR (phase<>'STATE' AND occurrence=1)),CHECK((stage IN('CONSUMED','REJECTED'))=(finished_at IS NOT NULL))
);
ALTER TABLE anvil.native_receive_records ADD CONSTRAINT fn76_record_ticket_fk FOREIGN KEY(project_id,window_id,ticket_phase,ticket_occurrence) REFERENCES anvil.native_receive_tickets(project_id,window_id,phase,occurrence) ON DELETE RESTRICT DEFERRABLE INITIALLY DEFERRED;
CREATE TABLE anvil.native_receive_storage_reservations(
 project_id uuid NOT NULL,window_id uuid NOT NULL,plan_version smallint NOT NULL CHECK(plan_version=1),plan_json jsonb NOT NULL,plan_hash text NOT NULL CHECK(plan_hash~'^[a-f0-9]{64}$'),
 n_reserved_bytes bigint NOT NULL,n_actual_bytes bigint NOT NULL,n_reserved_slots smallint NOT NULL,n_actual_slots smallint NOT NULL,
 r_reserved_bytes bigint NOT NULL,r_actual_bytes bigint NOT NULL,r_reserved_slots smallint NOT NULL,r_actual_slots smallint NOT NULL,
 l_reserved_bytes bigint NOT NULL,l_actual_bytes bigint NOT NULL,l_reserved_slots smallint NOT NULL,l_actual_slots smallint NOT NULL,
 phase text NOT NULL CHECK(phase IN('HELD','SETTLED')),created_at timestamptz NOT NULL DEFAULT transaction_timestamp(),settled_at timestamptz NULL,
 PRIMARY KEY(project_id,window_id),FOREIGN KEY(project_id,window_id) REFERENCES anvil.native_receive_heads(project_id,window_id) ON DELETE RESTRICT DEFERRABLE INITIALLY DEFERRED,
 CHECK(n_actual_bytes BETWEEN 0 AND n_reserved_bytes AND n_reserved_bytes<=10737418240 AND n_actual_slots BETWEEN 0 AND n_reserved_slots AND n_reserved_slots<=7),
 CHECK(r_actual_bytes BETWEEN 0 AND r_reserved_bytes AND r_reserved_bytes<=10737418240 AND r_actual_slots BETWEEN 0 AND r_reserved_slots AND r_reserved_slots<=53),
 CHECK(l_actual_bytes BETWEEN 0 AND l_reserved_bytes AND l_reserved_bytes<=10737418240 AND l_actual_slots BETWEEN 0 AND l_reserved_slots AND l_reserved_slots<=23),CHECK((phase='SETTLED')=(settled_at IS NOT NULL))
);
CREATE TABLE anvil.native_receive_security_aggregates(
 project_id uuid NOT NULL,registration_id uuid NOT NULL,actor_id uuid NOT NULL,client_id uuid NOT NULL,accounting_version smallint NOT NULL CHECK(accounting_version=1),
 pre_window_denials bigint NOT NULL CHECK(pre_window_denials BETWEEN 0 AND 9007199254740991),phase_denials bigint NOT NULL CHECK(phase_denials BETWEEN 0 AND 9007199254740991),request_conflicts bigint NOT NULL CHECK(request_conflicts BETWEEN 0 AND 9007199254740991),ticket_exhausted bigint NOT NULL CHECK(ticket_exhausted BETWEEN 0 AND 9007199254740991),owner_unavailable bigint NOT NULL CHECK(owner_unavailable BETWEEN 0 AND 9007199254740991),audit_capacity_failures bigint NOT NULL CHECK(audit_capacity_failures BETWEEN 0 AND 9007199254740991),unknown_observations bigint NOT NULL CHECK(unknown_observations BETWEEN 0 AND 9007199254740991),other_denials bigint NOT NULL CHECK(other_denials BETWEEN 0 AND 9007199254740991),
 saturated_mask smallint NOT NULL CHECK(saturated_mask BETWEEN 0 AND 255),first_seen_at timestamptz NULL,last_seen_at timestamptz NULL,first_class text NULL CHECK(first_class IN('PRE_WINDOW_DENIALS','PHASE_DENIALS','REQUEST_CONFLICTS','TICKET_EXHAUSTED','OWNER_UNAVAILABLE','AUDIT_CAPACITY_FAILURES','UNKNOWN_OBSERVATIONS','OTHER_DENIALS')),last_class text NULL CHECK(last_class IN('PRE_WINDOW_DENIALS','PHASE_DENIALS','REQUEST_CONFLICTS','TICKET_EXHAUSTED','OWNER_UNAVAILABLE','AUDIT_CAPACITY_FAILURES','UNKNOWN_OBSERVATIONS','OTHER_DENIALS')),created_at timestamptz NOT NULL DEFAULT transaction_timestamp(),
 PRIMARY KEY(project_id,registration_id),FOREIGN KEY(project_id,registration_id) REFERENCES anvil.connector_registrations(project_id,id) ON DELETE RESTRICT,FOREIGN KEY(actor_id,client_id) REFERENCES anvil.clients(user_id,id) ON DELETE RESTRICT,
 CHECK((first_seen_at IS NULL)=(last_seen_at IS NULL)),CHECK((first_seen_at IS NULL)=(first_class IS NULL)),CHECK((first_seen_at IS NULL)=(last_class IS NULL)),CHECK(last_seen_at>=first_seen_at)
);
DO $$DECLARE col text;BEGIN
 FOREACH col IN ARRAY ARRAY['window_id','session_record_id','offer_record_id','arm_record_id','binding_record_id','delivery_record_id','ack_record_id','terminal_record_id'] LOOP
 EXECUTE format('ALTER TABLE anvil.native_receive_heads ADD FOREIGN KEY(project_id,%I) REFERENCES anvil.native_receive_records(project_id,record_id) ON DELETE RESTRICT DEFERRABLE INITIALLY DEFERRED',col);END LOOP;
 FOREACH col IN ARRAY ARRAY['session_record_id','offer_record_id','arm_record_id','binding_record_id','delivery_record_id','ack_record_id','challenge_record_id','issue_evidence_record_id','proof_evidence_record_id','result_record_id','terminal_record_id'] LOOP
 EXECUTE format('ALTER TABLE anvil.native_receive_records ADD FOREIGN KEY(project_id,%I) REFERENCES anvil.native_receive_records(project_id,record_id) ON DELETE RESTRICT DEFERRABLE INITIALLY DEFERRED',col);END LOOP;
 FOREACH col IN ARRAY ARRAY['challenge_record_id','issue_evidence_record_id','issue_replay_record_id','proof_evidence_record_id','consume_replay_record_id'] LOOP
 EXECUTE format('ALTER TABLE anvil.native_receive_tickets ADD FOREIGN KEY(project_id,%I) REFERENCES anvil.native_receive_records(project_id,record_id) ON DELETE RESTRICT DEFERRABLE INITIALLY DEFERRED',col);END LOOP;
END;$$;
ALTER TABLE anvil.native_channel_profile_versions ENABLE ROW LEVEL SECURITY;
ALTER TABLE anvil.native_channel_profile_versions FORCE ROW LEVEL SECURITY;
REVOKE ALL ON anvil.native_channel_profile_versions FROM PUBLIC,anvil_v3_app;
CREATE POLICY fn76_native_channel_profile_versions_migrator ON anvil.native_channel_profile_versions FOR ALL TO anvil_v3_migrator USING(true) WITH CHECK(true);

ALTER TABLE anvil.native_channel_profile_heads ENABLE ROW LEVEL SECURITY;
ALTER TABLE anvil.native_channel_profile_heads FORCE ROW LEVEL SECURITY;
REVOKE ALL ON anvil.native_channel_profile_heads FROM PUBLIC,anvil_v3_app;
CREATE POLICY fn76_native_channel_profile_heads_migrator ON anvil.native_channel_profile_heads FOR ALL TO anvil_v3_migrator USING(true) WITH CHECK(true);

ALTER TABLE anvil.native_receive_heads ENABLE ROW LEVEL SECURITY;
ALTER TABLE anvil.native_receive_heads FORCE ROW LEVEL SECURITY;
REVOKE ALL ON anvil.native_receive_heads FROM PUBLIC,anvil_v3_app;
CREATE POLICY fn76_native_receive_heads_migrator ON anvil.native_receive_heads FOR ALL TO anvil_v3_migrator USING(true) WITH CHECK(true);

ALTER TABLE anvil.native_receive_records ENABLE ROW LEVEL SECURITY;
ALTER TABLE anvil.native_receive_records FORCE ROW LEVEL SECURITY;
REVOKE ALL ON anvil.native_receive_records FROM PUBLIC,anvil_v3_app;
CREATE POLICY fn76_native_receive_records_migrator ON anvil.native_receive_records FOR ALL TO anvil_v3_migrator USING(true) WITH CHECK(true);

ALTER TABLE anvil.native_receive_tickets ENABLE ROW LEVEL SECURITY;
ALTER TABLE anvil.native_receive_tickets FORCE ROW LEVEL SECURITY;
REVOKE ALL ON anvil.native_receive_tickets FROM PUBLIC,anvil_v3_app;
