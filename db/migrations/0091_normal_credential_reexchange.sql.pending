-- 같은 grant/예약 세대, 만료된 token 다음의 비중첩 발급만 허용한다. 미적용 source.
-- 0085의 소비/발급/current/불변 guard 및 tokenDigest UNIQUE는 그대로 둔다.
BEGIN;
DROP INDEX anvil.normal_credential_issued_once;

CREATE FUNCTION anvil.guard_normal_credential_reexchange() RETURNS trigger LANGUAGE plpgsql AS $$
DECLARE starts timestamptz; ends timestamptz; other anvil.execution_receipts%ROWTYPE; total bigint=0;
BEGIN
 -- 잠금 대기 뒤 선행 발급을 새 statement snapshot으로 읽는 격리만 지원한다.
 IF current_setting('transaction_isolation') IS DISTINCT FROM 'read committed'
 THEN RAISE EXCEPTION 'NORMAL_CREDENTIAL_ISOLATION_INVALID' USING ERRCODE='42501';END IF;
 -- normal_exchange_current의 project→grant 순서와 맞춰 직접 INSERT도 직렬화한다.
 PERFORM id FROM anvil.projects WHERE id=NEW.project_id FOR UPDATE;
 IF NOT FOUND THEN RAISE EXCEPTION 'NORMAL_CREDENTIAL_INTERVAL_CONFLICT' USING ERRCODE='42501';END IF;
 PERFORM id FROM anvil.execution_grants WHERE project_id=NEW.project_id AND id=NEW.grant_id AND version=NEW.grant_version FOR UPDATE;
 IF NOT FOUND OR NEW.snapshot_json->>'kind' IS DISTINCT FROM 'NORMAL_CREDENTIAL_ISSUED'
  OR NOT anvil.execution_iso_valid(NEW.snapshot_json->'issuedAt') OR NOT anvil.execution_iso_valid(NEW.snapshot_json->'expiresAt')
 THEN RAISE EXCEPTION 'NORMAL_CREDENTIAL_INTERVAL_CONFLICT' USING ERRCODE='42501';END IF;
 starts=(NEW.snapshot_json->>'issuedAt')::timestamptz; ends=(NEW.snapshot_json->>'expiresAt')::timestamptz;
 IF starts>=ends THEN RAISE EXCEPTION 'NORMAL_CREDENTIAL_INTERVAL_CONFLICT' USING ERRCODE='42501';END IF;
 FOR other IN SELECT * FROM anvil.execution_receipts WHERE project_id=NEW.project_id AND grant_id=NEW.grant_id AND grant_version=NEW.grant_version
  AND id<>NEW.id AND snapshot_json->>'kind'='NORMAL_CREDENTIAL_ISSUED' LOOP
  total=total+1;
  IF total>=10000 OR other.content_hash IS DISTINCT FROM anvil.execution_json_hash(other.snapshot_json)
   OR other.snapshot_json->'binding' IS DISTINCT FROM NEW.snapshot_json->'binding'
   OR other.snapshot_json->'reservationRef' IS DISTINCT FROM NEW.snapshot_json->'reservationRef'
   OR NOT anvil.execution_iso_valid(other.snapshot_json->'issuedAt') OR NOT anvil.execution_iso_valid(other.snapshot_json->'expiresAt')
   OR (other.snapshot_json->>'issuedAt')::timestamptz>=(other.snapshot_json->>'expiresAt')::timestamptz
   OR (TG_WHEN='BEFORE' AND (other.snapshot_json->>'expiresAt')::timestamptz>starts)
   OR ((other.snapshot_json->>'issuedAt')::timestamptz<ends AND (other.snapshot_json->>'expiresAt')::timestamptz>starts)
  THEN RAISE EXCEPTION 'NORMAL_CREDENTIAL_INTERVAL_CONFLICT' USING ERRCODE='42501';END IF;
 END LOOP;
 RETURN NEW;
END;
$$;
-- 기존 normal_credential_receipt_guard/complete 검산에 추가한다. 원 함수/ACL/owner/security mode는 불변이다.
CREATE TRIGGER normal_credential_z_nonoverlap_guard BEFORE INSERT ON anvil.execution_receipts FOR EACH ROW
 WHEN (NEW.snapshot_json->>'kind'='NORMAL_CREDENTIAL_ISSUED') EXECUTE FUNCTION anvil.guard_normal_credential_reexchange();
CREATE CONSTRAINT TRIGGER normal_credential_z_nonoverlap_complete AFTER INSERT ON anvil.execution_receipts DEFERRABLE INITIALLY DEFERRED FOR EACH ROW
 WHEN (NEW.snapshot_json->>'kind'='NORMAL_CREDENTIAL_ISSUED') EXECUTE FUNCTION anvil.guard_normal_credential_reexchange();
REVOKE ALL ON FUNCTION anvil.guard_normal_credential_reexchange() FROM PUBLIC;
GRANT EXECUTE ON FUNCTION anvil.guard_normal_credential_reexchange() TO anvil_v3_app;
COMMIT;
