GRANT SELECT(project_id) ON anvil.context_items TO anvil_v3_fn15_reader_owner;
CREATE POLICY fn15_absence_scope_select ON anvil.context_items FOR SELECT TO anvil_v3_fn15_reader_owner USING(true);
