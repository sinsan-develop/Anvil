GRANT SELECT(project_id) ON anvil.role_bindings TO anvil_v3_fn15_reader_owner;
CREATE POLICY fn15_absence_scope_select ON anvil.role_bindings FOR SELECT TO anvil_v3_fn15_reader_owner USING(true);
GRANT SELECT(project_id) ON anvil.execution_material_manifests TO anvil_v3_fn15_reader_owner;
