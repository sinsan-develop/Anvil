-- FN08 두 namespace 내부 연결 복구. 미적용 source이며 새 예약/권한/공개 필드·과거 행 변경은 없다.
-- CREATE OR REPLACE로 원 signature/owner/ACL/기존 trigger 호출선을 유지한다.
CREATE OR REPLACE FUNCTION anvil.material_binding_complete(pid uuid,rid uuid) RETURNS boolean LANGUAGE plpgsql AS $$
DECLARE b anvil.execution_material_proof_bindings%ROWTYPE;m anvil.execution_materials%ROWTYPE;d anvil.execution_material_manifests%ROWTYPE;r anvil.execution_receipts%ROWTYPE;c anvil.execution_challenges%ROWTYPE;v anvil.execution_challenges%ROWTYPE;sc jsonb;target jsonb;g anvil.execution_grants%ROWTYPE;ec anvil.execution_credentials%ROWTYPE;
BEGIN
 SELECT * INTO b FROM anvil.execution_material_proof_bindings WHERE project_id=pid AND proof_result_id=rid AND proof_result_version=1;
 IF b.proof_result_id IS NULL THEN RETURN false;END IF;
 SELECT * INTO m FROM anvil.execution_materials WHERE project_id=pid AND id=b.material_id AND version=1;
 SELECT * INTO d FROM anvil.execution_material_manifests WHERE project_id=pid AND id=m.manifest_id AND version=1;
 SELECT * INTO r FROM anvil.execution_receipts WHERE project_id=pid AND id=rid AND version=1;
 SELECT * INTO c FROM anvil.execution_challenges WHERE project_id=pid AND id=r.challenge_id AND version=1;
 SELECT * INTO v FROM anvil.execution_challenges WHERE project_id=pid AND id=r.challenge_id AND version=2;
 IF m.id IS NULL OR d.id IS NULL OR r.id IS NULL OR c.id IS NULL OR v.id IS NULL OR NOT COALESCE(anvil.material_registration_complete(pid,m.created_command_id),false) THEN RETURN false;END IF;
 sc=d.snapshot_json->'scope';target=jsonb_build_object('method','GET','path','/api/v1/connectors/'||(sc->>'connectorId')||'/executions/'||d.execution_id::text||'/commands/'||d.command_id::text||'/materials/'||m.id::text,'queryHash',anvil.execution_json_hash('{}'::jsonb),'bodyHash',anvil.execution_json_hash('null'::jsonb));
 SELECT * INTO g FROM anvil.execution_grants WHERE project_id=pid AND id=d.grant_id AND version=d.grant_version;
 SELECT * INTO ec FROM anvil.execution_credentials WHERE project_id=pid AND grant_id=d.grant_id AND grant_version=d.grant_version AND credential_generation=1;
 -- 원 H는 저장 grant에서, E는 같은 grant의 기존 예약에서만 읽는다. 역사 완결은 새 current/시각을 발급하지 않는다.
 IF g.id IS NULL OR ec.id IS NULL OR (SELECT count(*) FROM anvil.execution_credentials WHERE project_id=pid AND grant_id=d.grant_id AND grant_version=d.grant_version AND credential_generation=1)<>1
 OR g.execution_id IS DISTINCT FROM d.execution_id OR g.generation IS DISTINCT FROM d.generation
 OR g.content_hash IS DISTINCT FROM anvil.execution_json_hash(g.snapshot_json)
 OR sc->'grantRef' IS DISTINCT FROM jsonb_build_object('id',g.id,'version',g.version,'contentHash',g.content_hash)
 OR g.snapshot_json->>'kind' IS DISTINCT FROM 'EXECUTION' OR g.snapshot_json->>'state' IS DISTINCT FROM 'SYNTHETIC_PLAN'
 OR g.snapshot_json->>'transport' IS DISTINCT FROM 'SYNTHETIC_ONLY'
 OR g.snapshot_json->'executionAuthorized' IS DISTINCT FROM 'false'::jsonb OR g.snapshot_json->'dispatchPerformed' IS DISTINCT FROM 'false'::jsonb
 OR g.snapshot_json->>'factHash' IS DISTINCT FROM anvil.execution_json_hash(g.snapshot_json->'binding')
 OR sc->>'projectId' IS DISTINCT FROM pid::text OR sc->>'connectorId' IS DISTINCT FROM g.snapshot_json->'binding'->'registration'->>'connectorId'
 OR sc->>'executionId' IS DISTINCT FROM g.execution_id::text OR sc->'executionGeneration' IS DISTINCT FROM to_jsonb(g.generation)
 OR sc->'credentialGeneration' IS DISTINCT FROM g.snapshot_json->'binding'->'subject'->'credentialGeneration'
 OR sc->'credentialGeneration' IS DISTINCT FROM to_jsonb(d.credential_generation)
 OR ec.credential_generation<>1 OR ec.content_hash IS DISTINCT FROM anvil.execution_json_hash(ec.snapshot_json)
 OR NOT COALESCE(anvil.execution_json_shape(ec.snapshot_json,ARRAY['transport','state','grantRef','credentialGeneration','reservedAt','credentialIssued','executionAuthorized','dispatchPerformed']),false)
 OR ec.snapshot_json->>'transport' IS DISTINCT FROM 'SYNTHETIC_ONLY' OR ec.snapshot_json->>'state' IS DISTINCT FROM 'SYNTHETIC_RESERVED_NO_TOKEN'
 OR ec.snapshot_json->'grantRef' IS DISTINCT FROM sc->'grantRef' OR ec.snapshot_json->'credentialGeneration' IS DISTINCT FROM to_jsonb(ec.credential_generation)
 OR ec.snapshot_json->'credentialIssued' IS DISTINCT FROM 'false'::jsonb OR ec.snapshot_json->'executionAuthorized' IS DISTINCT FROM 'false'::jsonb OR ec.snapshot_json->'dispatchPerformed' IS DISTINCT FROM 'false'::jsonb
 OR NOT COALESCE(anvil.execution_iso_valid(ec.snapshot_json->'reservedAt'),false)
 OR c.snapshot_json->'binding'->'credentialGeneration' IS DISTINCT FROM to_jsonb(ec.credential_generation)
 OR c.snapshot_json->'publicChallenge'->'credentialGeneration' IS DISTINCT FROM to_jsonb(ec.credential_generation)
 OR c.snapshot_json->'request'->'credentialGeneration' IS DISTINCT FROM to_jsonb(ec.credential_generation)
 OR c.snapshot_json->'request'->'grantRef' IS DISTINCT FROM sc->'grantRef'
 OR c.snapshot_json->'publicChallenge'->'grantRef' IS DISTINCT FROM sc->'grantRef'
 OR c.snapshot_json->'binding'->>'scopeDigest' IS DISTINCT FROM g.snapshot_json->>'scopeDigest'
 OR c.snapshot_json->'binding'->>'publicKeyFingerprint' IS DISTINCT FROM g.snapshot_json->'binding'->'registration'->>'hostPublicKeyFingerprint'
 OR NOT COALESCE(anvil.execution_iso_valid(c.snapshot_json->'publicChallenge'->'issuedAt'),false)
 OR (ec.snapshot_json->>'reservedAt')::timestamptz>(c.snapshot_json->'publicChallenge'->>'issuedAt')::timestamptz THEN RETURN false;END IF;
 IF b.snapshot_json IS DISTINCT FROM jsonb_build_object('scope',sc,'proofResultRef',jsonb_build_object('id',r.id,'version',r.version,'contentHash',r.content_hash),'target',target,'materialRef',jsonb_build_object('id',m.id,'version',m.version,'contentHash',m.content_hash),'contentHash',m.snapshot_json->'contentHash')
 OR b.content_hash IS DISTINCT FROM anvil.execution_json_hash(b.snapshot_json)
 OR b.execution_id IS DISTINCT FROM d.execution_id OR b.generation IS DISTINCT FROM d.generation OR b.grant_id IS DISTINCT FROM d.grant_id OR b.grant_version IS DISTINCT FROM d.grant_version OR b.credential_generation IS DISTINCT FROM d.credential_generation
 OR r.grant_id IS DISTINCT FROM b.grant_id OR r.grant_version IS DISTINCT FROM b.grant_version OR r.content_hash IS DISTINCT FROM anvil.execution_json_hash(r.snapshot_json)
 OR c.content_hash IS DISTINCT FROM anvil.execution_json_hash(c.snapshot_json) OR v.content_hash IS DISTINCT FROM anvil.execution_json_hash(v.snapshot_json)
 OR c.grant_id IS DISTINCT FROM b.grant_id OR c.grant_version IS DISTINCT FROM b.grant_version OR v.grant_id IS DISTINCT FROM b.grant_id OR v.grant_version IS DISTINCT FROM b.grant_version
 OR r.snapshot_json->>'kind' IS DISTINCT FROM 'SYNTHETIC_PROOF_RESULT' OR r.snapshot_json->'challengeRef' IS DISTINCT FROM jsonb_build_object('id',c.id,'version',1,'contentHash',c.content_hash)
 OR r.snapshot_json->'requestId' IS DISTINCT FROM c.snapshot_json->'request'->'requestId' OR c.snapshot_json->'request'->'target' IS DISTINCT FROM target
 OR NOT COALESCE((c.snapshot_json->'binding'-'credentialGeneration') @> (sc-'credentialGeneration'),false) OR v.snapshot_json->'binding' IS DISTINCT FROM c.snapshot_json->'binding'
 OR v.snapshot_json->'request' IS DISTINCT FROM c.snapshot_json->'request' OR v.snapshot_json->'previousRef' IS DISTINCT FROM r.snapshot_json->'challengeRef'
 OR v.snapshot_json->'consumption'->'resultRef' IS DISTINCT FROM b.snapshot_json->'proofResultRef' OR v.snapshot_json->'consumption'->'proofHash' IS DISTINCT FROM r.snapshot_json->'proofHash' THEN RETURN false;END IF;
 RETURN true;
EXCEPTION WHEN OTHERS THEN RETURN false;
END;$$;
