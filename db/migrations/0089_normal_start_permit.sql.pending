-- FN08 normal START 일회 실행 허가(permit) 계약 r1(docs/contracts/FN08_NORMAL_START_PERMIT_CONTRACT_20261113.md) §6.
-- permit 행·영수증·nonce 소비를 같은 거래에서 결박한다. 합성 permit guard 본문은 바꾸지 않는다.
-- 이 파일은 미적용 source이며 실제 PostgreSQL에서 실행·검증하지 않았다(D1 1단계 P2 적용 대상).
BEGIN;
-- normal permit 영수증. nonce 소비(v2)와 같은 거래에서만, 서버가 남긴 marker와 정확히 같은 영수증을 받는다.
CREATE FUNCTION anvil.normal_start_permit_receipt_valid(r anvil.execution_receipts) RETURNS boolean LANGUAGE plpgsql AS $$
DECLARE v anvil.execution_challenges%ROWTYPE;old anvil.execution_challenges%ROWTYPE;s jsonb=r.snapshot_json;b jsonb=s->'binding';
 marker text=current_setting('anvil.normal_permit_verified',true);
BEGIN
 SELECT * INTO v FROM anvil.execution_challenges WHERE project_id=r.project_id AND id=r.challenge_id AND version=2;
 SELECT * INTO old FROM anvil.execution_challenges WHERE project_id=r.project_id AND id=r.challenge_id AND version=1;
 IF v.id IS NULL OR old.id IS NULL OR r.version<>1 OR r.challenge_version<>1 OR r.grant_id<>v.grant_id OR r.grant_version<>v.grant_version
  OR NOT anvil.execution_json_shape(s,ARRAY['kind','binding','credentialRef','challengeRef','packetHash','target','requestId','commandRef','envelopeHash','requestHash','observedAt','expiresAt'])
  OR s->>'kind' IS DISTINCT FROM 'NORMAL_START_PERMIT' OR r.content_hash IS DISTINCT FROM anvil.execution_json_hash(s)
  OR marker IS NULL OR split_part(marker,':',1) IS DISTINCT FROM txid_current()::text OR split_part(marker,':',2) IS DISTINCT FROM r.content_hash OR split_part(marker,':',3) !~ '^[0-9a-f]{64}$'
  OR b IS DISTINCT FROM old.snapshot_json->'binding' OR b->>'transport' IS DISTINCT FROM 'NORMAL_PROTECTED'
  OR s->'credentialRef' IS DISTINCT FROM old.snapshot_json->'credentialRef'
  OR s->'challengeRef' IS DISTINCT FROM jsonb_build_object('id',old.id,'version',1,'contentHash',old.content_hash)
  OR s->'target' IS DISTINCT FROM old.snapshot_json#>'{request,target}' OR s->'target'->>'method' IS DISTINCT FROM 'POST'
  OR s->'target'->>'path' !~ '/permit$' OR s->>'requestId' IS DISTINCT FROM old.snapshot_json#>>'{request,requestId}'
  OR v.snapshot_json#>'{consumption,resultRef}' IS DISTINCT FROM jsonb_build_object('id',r.id,'version',1,'contentHash',r.content_hash)
  OR v.snapshot_json#>'{consumption,packetHash}' IS DISTINCT FROM s->'packetHash'
  OR NOT anvil.execution_iso_valid(s->'observedAt') OR NOT anvil.execution_iso_valid(s->'expiresAt')
  OR (s->>'expiresAt')::timestamptz<=(s->>'observedAt')::timestamptz OR (s->>'expiresAt')::timestamptz>(s->>'observedAt')::timestamptz+interval '30 seconds'
 THEN RETURN false;END IF;
 RETURN true;
END;
$$;
REVOKE ALL ON FUNCTION anvil.normal_start_permit_receipt_valid(anvil.execution_receipts) FROM PUBLIC;
GRANT EXECUTE ON FUNCTION anvil.normal_start_permit_receipt_valid(anvil.execution_receipts) TO anvil_v3_app;
CREATE FUNCTION anvil.guard_normal_start_permit_receipt() RETURNS trigger LANGUAGE plpgsql AS $$
BEGIN
 IF coalesce(anvil.normal_start_permit_receipt_valid(NEW::anvil.execution_receipts),false) THEN RETURN NEW;END IF;
 RAISE EXCEPTION 'NORMAL_START_PERMIT_RECEIPT_REQUIRED' USING ERRCODE='42501';
END;
$$;
-- normal permit 행. 합성 guard 본문은 바꾸지 않고, state로 trigger를 나눈다.
CREATE FUNCTION anvil.guard_normal_start_permit() RETURNS trigger LANGUAGE plpgsql AS $$
DECLARE s jsonb=NEW.snapshot_json;sc jsonb=s->'scope';req jsonb=s->'request';f jsonb=s->'currentFact';g anvil.execution_grants%ROWTYPE;c anvil.execution_commands%ROWTYPE;
 r anvil.execution_receipts%ROWTYPE;ch anvil.execution_challenges%ROWTYPE;cur record;source_refs jsonb;at_time timestamptz=clock_timestamp();
BEGIN
 IF TG_OP<>'INSERT' THEN RAISE EXCEPTION 'EXECUTION_START_PERMIT_IMMUTABLE' USING ERRCODE='42501';END IF;
 SELECT * INTO g FROM anvil.execution_grants WHERE project_id=NEW.project_id AND id=(sc->'grantRef'->>'id')::uuid AND version=(sc->'grantRef'->>'version')::bigint;
 SELECT * INTO c FROM anvil.execution_commands WHERE project_id=NEW.project_id AND execution_id=NEW.execution_id AND generation=NEW.generation AND snapshot_json->'envelope'->>'commandId'=s->>'commandId';
 SELECT * INTO r FROM anvil.execution_receipts WHERE project_id=NEW.project_id AND id=NEW.proof_result_id AND version=NEW.proof_result_version;
 SELECT * INTO ch FROM anvil.execution_challenges WHERE project_id=r.project_id AND id=r.challenge_id AND version=1;
 SELECT * INTO cur FROM anvil.normal_exchange_current(NEW.project_id,(sc->>'connectorId')::uuid,NEW.execution_id,g.id,g.version,g.content_hash,(sc->>'credentialGeneration')::bigint);
 SELECT jsonb_agg(u.ref ORDER BY u.pos) INTO source_refs FROM(SELECT source->'observationRef' AS ref,min(pos) AS pos FROM jsonb_array_elements(f->'intent'->'sourceScopes') WITH ORDINALITY AS x(source,pos) GROUP BY source->'observationRef')u;
 IF NEW.version IS DISTINCT FROM 1 OR NEW.proof_result_version IS DISTINCT FROM 1 OR g.id IS NULL OR c.id IS NULL OR r.id IS NULL OR ch.id IS NULL OR cur.binding IS NULL
  OR g.snapshot_json->>'transport' IS DISTINCT FROM 'NORMAL_PROTECTED' OR g.execution_id IS DISTINCT FROM NEW.execution_id OR g.generation IS DISTINCT FROM NEW.generation
  OR r.grant_id IS DISTINCT FROM g.id OR r.grant_version IS DISTINCT FROM g.version OR r.snapshot_json->>'kind' IS DISTINCT FROM 'NORMAL_START_PERMIT'
  OR NOT anvil.execution_json_shape(s,ARRAY['scope','commandId','commandRef','request','requestHash','proofRef','bindingHash','currentFact','state','issuedAt','expiresAt','executionAuthorized','dispatchPerformed'])
  OR NOT anvil.execution_json_shape(sc,ARRAY['mode','projectId','connectorId','executionId','executionGeneration','grantRef','credentialGeneration'])
  OR sc->>'mode' IS DISTINCT FROM 'EXECUTION' OR sc->'projectId' IS DISTINCT FROM to_jsonb(NEW.project_id) OR sc->'executionId' IS DISTINCT FROM to_jsonb(NEW.execution_id)
  OR sc->'executionGeneration' IS DISTINCT FROM to_jsonb(NEW.generation) OR sc->'credentialGeneration' IS DISTINCT FROM cur.binding->'credentialGeneration'
  OR sc->'connectorId' IS DISTINCT FROM cur.binding->'connectorId' OR sc->'grantRef' IS DISTINCT FROM jsonb_build_object('id',g.id,'version',g.version,'contentHash',g.content_hash)
  OR NEW.content_hash IS DISTINCT FROM anvil.execution_json_hash(s) OR s->>'state' IS DISTINCT FROM 'NORMAL_START_PERMITTED'
  OR s->'executionAuthorized' IS DISTINCT FROM 'true'::jsonb OR s->'dispatchPerformed' IS DISTINCT FROM 'false'::jsonb
  OR s->'commandRef' IS DISTINCT FROM jsonb_build_object('id',c.id,'version',c.version,'contentHash',c.content_hash) OR r.snapshot_json->'commandRef' IS DISTINCT FROM s->'commandRef'
  OR c.grant_id IS DISTINCT FROM g.id OR c.grant_version IS DISTINCT FROM g.version OR c.snapshot_json->'envelope'->>'operation' IS DISTINCT FROM 'START_SESSION'
  OR s->'proofRef' IS DISTINCT FROM jsonb_build_object('id',r.id,'version',r.version,'contentHash',r.content_hash)
  OR jsonb_typeof(s->'bindingHash') IS DISTINCT FROM 'string' OR s->>'bindingHash' !~ '^[0-9a-f]{64}$'
  -- 현재 사실은 원 START grant binding과 같고 확인 시각·검사·만료·writer만 다를 수 있다.
  OR f->>'transport' IS DISTINCT FROM 'NORMAL_PROTECTED' OR f-'checkedAt'-'checks'-'expires'-'writerState' IS DISTINCT FROM (g.snapshot_json->'binding')-'checkedAt'-'checks'-'expires'-'writerState'
  OR f->>'writerState' IS DISTINCT FROM 'OWNED' OR NOT anvil.execution_iso_valid(f->'checkedAt')
  OR NOT anvil.execution_json_shape(f->'checks',ARRAY['subject','session','registration','permissionPolicy','basis','context','capability','source','osFence','budget','storage','understanding'])
  OR EXISTS(SELECT 1 FROM jsonb_each(f->'checks') AS chk(name,value) WHERE NOT anvil.execution_json_shape(chk.value,ARRAY['state','evidenceRefs'])
   OR (chk.name<>'understanding' AND chk.value->>'state' IS DISTINCT FROM 'VERIFIED_CURRENT')
   OR jsonb_typeof(chk.value->'evidenceRefs') IS DISTINCT FROM 'array' OR EXISTS(SELECT 1 FROM jsonb_array_elements(chk.value->'evidenceRefs') AS e(value) WHERE NOT anvil.execution_preparation_ref_valid(e.value)))
  OR f->'intent'->>'mode'='WORK' AND (f->'understandingReviewRef'='null'::jsonb OR f->'checks'->'understanding'->>'state' IS DISTINCT FROM 'VERIFIED_CURRENT')
  OR s->>'bindingHash' IS DISTINCT FROM anvil.execution_json_hash(jsonb_build_object('scope',sc,'commandRef',s->'commandRef','authorizationReceiptRef',c.snapshot_json->'envelope'->'context'->'authorizationReceiptRef','fact',f-'checkedAt'))
  OR NOT anvil.execution_json_shape(req,ARRAY['envelopeHash','localAttemptRef','sourceObservationRefs','osOwnershipRef'])
  OR NOT anvil.execution_preparation_ref_valid(req->'localAttemptRef') OR NOT anvil.execution_preparation_ref_valid(req->'osOwnershipRef')
  OR req->>'envelopeHash' IS DISTINCT FROM c.envelope_hash OR r.snapshot_json->>'envelopeHash' IS DISTINCT FROM c.envelope_hash OR req->'sourceObservationRefs' IS DISTINCT FROM source_refs
  OR NOT(f->'checks'->'osFence'->'evidenceRefs' @> jsonb_build_array(req->'osOwnershipRef'))
  OR s->>'requestHash' IS DISTINCT FROM anvil.execution_json_hash(req) OR r.snapshot_json->>'requestHash' IS DISTINCT FROM s->>'requestHash'
  OR ch.snapshot_json->'request'->>'purpose' IS DISTINCT FROM 'EXECUTION_REQUEST' OR ch.snapshot_json->'request'->'target'->>'method' IS DISTINCT FROM 'POST'
  OR ch.snapshot_json->'request'->'target'->>'path' IS DISTINCT FROM '/api/v1/connectors/'||(sc->>'connectorId')||'/executions/'||NEW.execution_id::text||'/commands/'||(s->>'commandId')||'/permit'
  OR ch.snapshot_json->'request'->'target'->>'queryHash' IS DISTINCT FROM anvil.execution_json_hash('{}'::jsonb)
  OR ch.snapshot_json->'request'->'target'->>'bodyHash' IS DISTINCT FROM anvil.execution_json_hash(req)
  OR NOT anvil.execution_iso_valid(s->'issuedAt') OR NOT anvil.execution_iso_valid(s->'expiresAt')
  OR (s->>'issuedAt')::timestamptz>at_time OR (s->>'issuedAt')::timestamptz<at_time-interval '30 seconds'
  OR (f->>'checkedAt')::timestamptz>(s->>'issuedAt')::timestamptz OR (f->>'checkedAt')::timestamptz<(s->>'issuedAt')::timestamptz-interval '30 seconds'
  OR (s->>'expiresAt')::timestamptz<=(s->>'issuedAt')::timestamptz OR (s->>'expiresAt')::timestamptz>(s->>'issuedAt')::timestamptz+interval '30 seconds'
  OR NOT anvil.execution_json_shape(f->'expires',ARRAY['humanSession','permissionPolicy','registration','budget','automaticScope'])
  OR EXISTS(SELECT 1 FROM jsonb_each(f->'expires') AS ex(name,value) WHERE NOT anvil.execution_iso_valid(ex.value))
  OR (s->>'expiresAt')::timestamptz>(SELECT min(value::timestamptz) FROM jsonb_each_text(f->'expires'))
  OR (s->>'expiresAt')::timestamptz>LEAST(cur.deadline,(c.snapshot_json->'envelope'->>'expiresAt')::timestamptz,(ch.snapshot_json->'publicChallenge'->>'expiresAt')::timestamptz)
  OR (s->>'expiresAt')::timestamptz<=at_time THEN RAISE EXCEPTION 'NORMAL_START_PERMIT_EXACT_BINDING_REQUIRED' USING ERRCODE='42501';END IF;
 RETURN NEW;
EXCEPTION WHEN OTHERS THEN RAISE EXCEPTION 'NORMAL_START_PERMIT_EXACT_BINDING_REQUIRED' USING ERRCODE='42501';
END;
$$;
CREATE FUNCTION anvil.guard_normal_start_permit_complete() RETURNS trigger LANGUAGE plpgsql AS $$
BEGIN
 IF clock_timestamp()>=(NEW.snapshot_json->>'expiresAt')::timestamptz
  OR NOT EXISTS(SELECT 1 FROM anvil.execution_receipts r JOIN anvil.execution_challenges c ON c.project_id=r.project_id AND c.id=r.challenge_id AND c.version=2
   WHERE r.project_id=NEW.project_id AND r.id=NEW.proof_result_id AND r.version=NEW.proof_result_version AND r.snapshot_json->>'kind'='NORMAL_START_PERMIT'
    AND c.snapshot_json->'consumption'->'resultRef'=NEW.snapshot_json->'proofRef') THEN RAISE EXCEPTION 'NORMAL_START_PERMIT_PROOF_ATOMIC_REQUIRED' USING ERRCODE='42501';END IF;
 RETURN NULL;
END;
$$;
-- 알 수 없는 state는 어느 trigger에도 걸리지 않으므로 표 제약으로 막는다.
ALTER TABLE anvil.execution_start_permits ADD CONSTRAINT execution_start_permit_state_known
 CHECK (coalesce(snapshot_json->>'state','') IN ('SYNTHETIC_CONSUMED_NO_AUTHORITY','NORMAL_START_PERMITTED'));
DROP TRIGGER execution_start_permit_guard ON anvil.execution_start_permits;
DROP TRIGGER execution_start_permit_complete ON anvil.execution_start_permits;
-- 합성 행은 기존 guard 본문 그대로. 수정·삭제는 state와 무관하게 기존 guard가 첫 줄에서 거절한다.
CREATE TRIGGER execution_start_permit_guard BEFORE INSERT ON anvil.execution_start_permits FOR EACH ROW
 WHEN (NEW.snapshot_json->>'state'='SYNTHETIC_CONSUMED_NO_AUTHORITY') EXECUTE FUNCTION anvil.guard_execution_start_permit();
CREATE TRIGGER execution_start_permit_immutable BEFORE UPDATE OR DELETE ON anvil.execution_start_permits FOR EACH ROW EXECUTE FUNCTION anvil.guard_execution_start_permit();
CREATE CONSTRAINT TRIGGER execution_start_permit_complete AFTER INSERT ON anvil.execution_start_permits DEFERRABLE INITIALLY DEFERRED FOR EACH ROW
 WHEN (NEW.snapshot_json->>'state'='SYNTHETIC_CONSUMED_NO_AUTHORITY') EXECUTE FUNCTION anvil.guard_execution_start_permit_complete();
CREATE TRIGGER normal_start_permit_guard BEFORE INSERT ON anvil.execution_start_permits FOR EACH ROW
 WHEN (NEW.snapshot_json->>'state'='NORMAL_START_PERMITTED') EXECUTE FUNCTION anvil.guard_normal_start_permit();
CREATE CONSTRAINT TRIGGER normal_start_permit_complete AFTER INSERT ON anvil.execution_start_permits DEFERRABLE INITIALLY DEFERRED FOR EACH ROW
 WHEN (NEW.snapshot_json->>'state'='NORMAL_START_PERMITTED') EXECUTE FUNCTION anvil.guard_normal_start_permit_complete();
-- 영수증 trigger: 합성 검사에서 NORMAL_START_PERMIT을 빼고 전용 검사로 보낸다.
DROP TRIGGER synthetic_execution_receipt_guard ON anvil.execution_receipts;
DROP TRIGGER synthetic_execution_receipt_complete ON anvil.execution_receipts;
CREATE TRIGGER synthetic_execution_receipt_guard BEFORE INSERT ON anvil.execution_receipts FOR EACH ROW
 WHEN (NEW.snapshot_json->>'kind' IS DISTINCT FROM 'NORMAL_CREDENTIAL_ISSUED' AND NEW.snapshot_json->>'kind' IS DISTINCT FROM 'NORMAL_COMMAND_PAGE'
  AND NEW.snapshot_json->>'kind' IS DISTINCT FROM 'NORMAL_START_MATERIAL' AND NEW.snapshot_json->>'kind' IS DISTINCT FROM 'NORMAL_START_PERMIT') EXECUTE FUNCTION anvil.guard_synthetic_execution_receipt();
CREATE CONSTRAINT TRIGGER synthetic_execution_receipt_complete AFTER INSERT ON anvil.execution_receipts DEFERRABLE INITIALLY DEFERRED FOR EACH ROW
 WHEN (NEW.snapshot_json->>'kind' IS DISTINCT FROM 'NORMAL_CREDENTIAL_ISSUED' AND NEW.snapshot_json->>'kind' IS DISTINCT FROM 'NORMAL_COMMAND_PAGE'
  AND NEW.snapshot_json->>'kind' IS DISTINCT FROM 'NORMAL_START_MATERIAL' AND NEW.snapshot_json->>'kind' IS DISTINCT FROM 'NORMAL_START_PERMIT') EXECUTE FUNCTION anvil.guard_execution_challenge_complete();
CREATE TRIGGER normal_start_permit_receipt_guard BEFORE INSERT ON anvil.execution_receipts FOR EACH ROW
 WHEN (NEW.snapshot_json->>'kind'='NORMAL_START_PERMIT') EXECUTE FUNCTION anvil.guard_normal_start_permit_receipt();
-- 아래 두 함수는 0088의 정의를 그대로 옮기고 표시한 곳만 바꿨다.
-- (0088) 요청 challenge 대상에 permit POST 추가
CREATE OR REPLACE FUNCTION anvil.normal_request_challenge_valid(n anvil.execution_challenges,deferred_check boolean) RETURNS boolean LANGUAGE plpgsql AS $$
DECLARE s jsonb=n.snapshot_json;b jsonb=s->'binding';r jsonb=s->'request';t jsonb=r->'target';p jsonb=s->'publicChallenge';
 ref jsonb=s->'credentialRef';receipt anvil.execution_receipts%ROWTYPE;cred record;cur record;at_time timestamptz;ends timestamptz;
 total bigint;recent bigint;live bigint;last_seq bigint;
BEGIN
 IF n.version<>1 OR n.content_hash IS DISTINCT FROM anvil.execution_json_hash(s) OR octet_length(anvil.execution_authority_canonical(s))>16384
  OR NOT anvil.execution_json_shape(s,ARRAY['sequence','credentialRef','binding','request','requestHash','signedInputHash','serverNonceDigest','publicChallenge','previousRef','consumption'])
  OR s->'previousRef' IS DISTINCT FROM 'null'::jsonb OR s->'consumption' IS DISTINCT FROM 'null'::jsonb OR s->'sequence' IS DISTINCT FROM to_jsonb(n.server_sequence)

  OR NOT anvil.execution_json_shape(r,ARRAY['requestId','purpose','grantRef','credentialGeneration','target','clientNonce','issuedAt'])
  OR r->>'purpose' IS DISTINCT FROM 'EXECUTION_REQUEST' OR r->'grantRef' IS DISTINCT FROM b->'grantRef' OR r->'credentialGeneration' IS DISTINCT FROM b->'credentialGeneration'
  OR jsonb_typeof(r->'requestId') IS DISTINCT FROM 'string' OR r->>'requestId' IS DISTINCT FROM (r->>'requestId')::uuid::text
  OR NOT anvil.execution_json_shape(t,ARRAY['method','path','bodyHash','queryHash']) OR t->>'method' NOT IN ('GET','POST')
  -- (0089 변경) GET: 명령 조회 또는 그 명령에 등록된 자료 한 부분(본문 null). POST: 그 명령의 일회 실행 허가(permit, query 없음·본문 hash).
  OR NOT coalesce(t->>'method'='GET' AND t->>'bodyHash'=anvil.execution_json_hash('null'::jsonb) AND (t->>'path'='/api/v1/connectors/'||(b->>'connectorId')||'/executions/'||(b->>'executionId')||'/commands'
    OR t->>'path' ~ ('^'||'/api/v1/connectors/'||(b->>'connectorId')||'/executions/'||(b->>'executionId')||'/commands'||'/[0-9a-f-]{36}/materials/[0-9a-f-]{36}$') AND t->>'queryHash'=anvil.execution_json_hash('{}'::jsonb))
   OR t->>'method'='POST' AND t->>'path' ~ ('^'||'/api/v1/connectors/'||(b->>'connectorId')||'/executions/'||(b->>'executionId')||'/commands'||'/[0-9a-f-]{36}/permit$')
    AND t->>'queryHash'=anvil.execution_json_hash('{}'::jsonb) AND t->>'bodyHash'~'^[0-9a-f]{64}$' AND t->>'bodyHash'<>anvil.execution_json_hash('null'::jsonb),false)
  OR jsonb_typeof(t->'queryHash') IS DISTINCT FROM 'string' OR t->>'queryHash' !~ '^[0-9a-f]{64}$'
  OR s->>'requestHash' IS DISTINCT FROM anvil.execution_json_hash(r)
  OR s->>'signedInputHash' IS DISTINCT FROM anvil.execution_json_hash(jsonb_build_object('purpose','EXECUTION_CHALLENGE_REQUEST','request',r))
  OR NOT anvil.execution_nonce_valid(r->'clientNonce') OR NOT anvil.execution_nonce_valid(p->'serverNonce')
  OR s->>'serverNonceDigest' IS DISTINCT FROM encode(sha256(decode(translate(p->>'serverNonce','-_','+/')||'=','base64')),'hex')
  OR NOT anvil.execution_iso_valid(r->'issuedAt') OR NOT anvil.execution_iso_valid(p->'issuedAt') OR NOT anvil.execution_iso_valid(p->'expiresAt')
  OR p IS DISTINCT FROM jsonb_build_object('id',n.id,'requestId',r->'requestId','purpose','EXECUTION_REQUEST','grantRef',b->'grantRef',
   'credentialGeneration',r->'credentialGeneration','scopeDigest',b->'scopeDigest','serverNonce',p->'serverNonce','clientNonce',r->'clientNonce','issuedAt',p->'issuedAt','expiresAt',p->'expiresAt')
 THEN RETURN false;END IF;
 SELECT * INTO receipt FROM anvil.execution_receipts WHERE project_id=n.project_id AND grant_id=n.grant_id AND grant_version=n.grant_version AND id=(ref->>'id')::uuid;
 IF NOT FOUND OR current_setting('anvil.normal_request_verified',true) IS DISTINCT FROM
    txid_current()::text||':'||n.content_hash||':'||(ref->>'contentHash')||':'||(receipt.snapshot_json->>'tokenDigest') THEN RETURN false;END IF;
 SELECT * INTO cred FROM anvil.normal_request_credential(receipt.snapshot_json->>'tokenDigest',(b->>'connectorId')::uuid,(b->>'executionId')::uuid,
  n.grant_id,n.grant_version,b#>>'{grantRef,contentHash}',(r->>'credentialGeneration')::bigint);
 IF NOT FOUND OR cred.credential_ref IS DISTINCT FROM ref OR cred.project_id<>n.project_id OR receipt.snapshot_json->'binding' IS DISTINCT FROM b THEN RETURN false;END IF;
 SELECT * INTO cur FROM anvil.normal_exchange_current(n.project_id,(b->>'connectorId')::uuid,(b->>'executionId')::uuid,n.grant_id,n.grant_version,
  b#>>'{grantRef,contentHash}',(r->>'credentialGeneration')::bigint);
 IF NOT FOUND OR cur.binding IS DISTINCT FROM b THEN RETURN false;END IF;
 at_time=(p->>'issuedAt')::timestamptz;ends=(p->>'expiresAt')::timestamptz;
 IF at_time>cur.observed_at OR abs(extract(epoch FROM (r->>'issuedAt')::timestamptz-at_time))>30
  OR ends<=clock_timestamp() OR ends>least(at_time+interval '30 seconds',cred.expires_at,cur.deadline) THEN RETURN false;END IF;
 SELECT count(*) FILTER(WHERE v.version=1),coalesce(max(v.server_sequence),0),
  count(*) FILTER(WHERE v.version=1 AND v.snapshot_json->'credentialRef'=ref AND v.snapshot_json#>>'{publicChallenge,purpose}'='EXECUTION_REQUEST'
    AND (v.snapshot_json#>>'{publicChallenge,issuedAt}')::timestamptz>at_time-interval '1 minute'),
  count(*) FILTER(WHERE v.version=1 AND v.snapshot_json->'credentialRef'=ref AND v.snapshot_json#>>'{publicChallenge,purpose}'='EXECUTION_REQUEST'
    AND (v.snapshot_json#>>'{publicChallenge,expiresAt}')::timestamptz>at_time AND NOT EXISTS(SELECT 1 FROM anvil.execution_challenges used WHERE used.project_id=v.project_id AND used.id=v.id AND used.version=2))
 INTO total,last_seq,recent,live FROM anvil.execution_challenges v WHERE v.project_id=n.project_id AND v.grant_id=n.grant_id AND v.grant_version=n.grant_version
  AND (NOT deferred_check OR v.server_sequence<n.server_sequence);
 RETURN total<10000 AND recent<60 AND live=0 AND n.server_sequence=last_seq+1;
END;
$$;
-- (0088) nonce 소비가 가리킬 수 있는 영수증에 NORMAL_START_PERMIT 추가
CREATE OR REPLACE FUNCTION anvil.normal_command_consumption_valid(v anvil.execution_challenges,deferred_check boolean)
RETURNS boolean LANGUAGE plpgsql AS $$
DECLARE old anvil.execution_challenges%ROWTYPE;s jsonb=v.snapshot_json;u jsonb=s->'consumption';seq bigint;
BEGIN
 SELECT * INTO old FROM anvil.execution_challenges WHERE project_id=v.project_id AND id=v.id AND version=1;
 IF NOT FOUND OR v.version<>2 OR old.grant_id<>v.grant_id OR old.grant_version<>v.grant_version
  OR old.snapshot_json#>>'{publicChallenge,purpose}' IS DISTINCT FROM 'EXECUTION_REQUEST'
  OR old.snapshot_json#>>'{binding,transport}' IS DISTINCT FROM 'NORMAL_PROTECTED'
  OR old.content_hash IS DISTINCT FROM anvil.execution_json_hash(old.snapshot_json) OR v.content_hash IS DISTINCT FROM anvil.execution_json_hash(s)
  OR NOT anvil.execution_json_shape(u,ARRAY['resultRef','consumedAt','packetHash'])
  OR NOT anvil.execution_json_shape(u->'resultRef',ARRAY['id','version','contentHash']) OR u#>'{resultRef,version}' IS DISTINCT FROM '1'::jsonb
  OR NOT anvil.execution_iso_valid(u->'consumedAt') OR jsonb_typeof(u->'packetHash') IS DISTINCT FROM 'string' OR u->>'packetHash' !~ '^[0-9a-f]{64}$'
  OR s IS DISTINCT FROM (old.snapshot_json || jsonb_build_object('sequence',v.server_sequence,'previousRef',
    jsonb_build_object('id',old.id,'version',1,'contentHash',old.content_hash),'consumption',u))
  OR (u->>'consumedAt')::timestamptz NOT BETWEEN (s#>>'{publicChallenge,issuedAt}')::timestamptz AND clock_timestamp()
  OR clock_timestamp()>=(s#>>'{publicChallenge,expiresAt}')::timestamptz
  OR split_part(current_setting('anvil.normal_page_verified',true),':',1) IS DISTINCT FROM txid_current()::text
  OR split_part(current_setting('anvil.normal_page_verified',true),':',2) IS DISTINCT FROM u#>>'{resultRef,contentHash}'
 THEN RETURN false;END IF;
 SELECT coalesce(max(server_sequence),0)+1 INTO seq FROM anvil.execution_challenges WHERE project_id=v.project_id
  AND grant_id=v.grant_id AND grant_version=v.grant_version AND (NOT deferred_check OR server_sequence<v.server_sequence);
 RETURN seq=v.server_sequence AND (NOT deferred_check OR EXISTS(SELECT 1 FROM anvil.execution_receipts r
  WHERE r.project_id=v.project_id AND r.challenge_id=v.id AND r.id=(u#>>'{resultRef,id}')::uuid AND r.content_hash=u#>>'{resultRef,contentHash}'
   AND r.snapshot_json->>'kind' IN ('NORMAL_COMMAND_PAGE','NORMAL_START_MATERIAL','NORMAL_START_PERMIT') AND r.snapshot_json->'packetHash'=u->'packetHash'));
END;
$$;
COMMIT;
