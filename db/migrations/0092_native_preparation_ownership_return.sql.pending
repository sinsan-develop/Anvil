-- 준비 반환 v2. 미적용 source; 기존 v1의 부모/승인/소비/완결 검산을 보존한다.
BEGIN;
CREATE OR REPLACE FUNCTION anvil.native_preparation_authority_complete(p uuid,a uuid) RETURNS boolean LANGUAGE plpgsql SECURITY DEFINER SET search_path=pg_catalog AS $$
DECLARE v anvil.native_preparation_authorities;g jsonb;i jsonb;s jsonb;c anvil.commands;r anvil.authorization_receipts;au anvil.audit_events;w anvil.project_writer_authority_events;created anvil.native_preparation_authority_events;cmd jsonb;target jsonb;digest text;head jsonb;count_states bigint;used anvil.approval_consumptions;approval jsonb;
BEGIN
 SELECT * INTO v FROM anvil.native_preparation_authorities WHERE project_id=p AND id=a;IF v.id IS NULL THEN RETURN false;END IF;g=v.snapshot_json;i=v.intent_json;s=i->'scope';
 IF NOT anvil.execution_json_shape(i,ARRAY['schemaVersion','purpose','intentId','scope','subject','sourceScopes','expectedWriterHeadRef','policyRef','at','expiresAt','codingAgentExecutionAuthorized','agentDispatchPerformed']) OR i->'schemaVersion'<>'1'::jsonb OR i->>'purpose'<>'NATIVE_BOUNDARY_PREPARATION_INTENT' OR i->>'intentId'<>v.intent_id::text OR anvil.ownership_content_hash(i)<>v.intent_hash OR i->'codingAgentExecutionAuthorized'<>'false'::jsonb OR i->'agentDispatchPerformed'<>'false'::jsonb OR anvil.native_preparation_json_bytes(i)>2097152 THEN RETURN false;END IF;
 IF NOT anvil.execution_json_shape(s,ARRAY['installationId','projectId','executionId','executionGeneration','authorityEpoch','leaseId','registrationRef','nativeFactoryRef','sourceScopeHash']) OR s->>'projectId'<>p::text OR s->>'leaseId'<>v.lease_id::text OR s->>'sourceScopeHash'<>anvil.ownership_content_hash(i->'sourceScopes') OR NOT anvil.writer_authority_ref(i->'expectedWriterHeadRef') OR NOT anvil.writer_authority_ref(s->'registrationRef') OR NOT anvil.writer_authority_ref(s->'nativeFactoryRef') THEN RETURN false;END IF;
 IF NOT anvil.execution_json_shape(g,ARRAY['schemaVersion','purpose','authorityId','credentialId','credentialGeneration','scope','subject','parent','policyRef','channelProfileRef','allowedOperations','issuedAt','expiresAt','codingAgentExecutionAuthorized','agentDispatchPerformed']) OR NOT ((g->'schemaVersion'='1'::jsonb AND g->'allowedOperations'='["CHECK_NATIVE_PREPARATION_CURRENT","CONSUME_NATIVE_PREPARATION"]'::jsonb) OR (g->'schemaVersion'='2'::jsonb AND g->'allowedOperations'='["CHECK_NATIVE_PREPARATION_CURRENT","CONSUME_NATIVE_PREPARATION","RETURN_NATIVE_PREPARATION_OWNERSHIP"]'::jsonb)) OR g->>'purpose'<>'NATIVE_PREPARATION_AUTHORITY' OR g->>'authorityId'<>v.id::text OR anvil.ownership_content_hash(g)<>v.content_hash OR g->'codingAgentExecutionAuthorized'<>'false'::jsonb OR g->'agentDispatchPerformed'<>'false'::jsonb OR g->'subject' IS DISTINCT FROM i->'subject' OR g->'policyRef' IS DISTINCT FROM i->'policyRef' OR NOT anvil.writer_authority_ref(g->'channelProfileRef') OR anvil.native_preparation_json_bytes(g)>2097152 THEN RETURN false;END IF;
 IF NOT anvil.execution_json_shape(g->'scope',ARRAY['installationId','projectId','executionId','executionGeneration','authorityEpoch','leaseId','registrationRef','nativeFactoryRef','sourceScopeHash','writerHeadRef','preparationRef','hostPublicKeyFingerprint']) OR ((g->'scope')-'writerHeadRef'-'preparationRef'-'hostPublicKeyFingerprint') IS DISTINCT FROM s OR g->'scope'->'preparationRef' IS DISTINCT FROM jsonb_build_object('id',v.intent_id,'version',1,'contentHash',v.intent_hash) OR NOT anvil.writer_authority_ref(g->'scope'->'writerHeadRef') OR NOT anvil.writer_authority_ref(g->'parent'->'commandRef') OR NOT anvil.writer_authority_ref(g->'parent'->'authorizationReceiptRef') OR NOT anvil.writer_authority_ref(g->'parent'->'auditRef') THEN RETURN false;END IF;
 IF NOT anvil.execution_iso_valid(i->'at') OR NOT anvil.execution_iso_valid(i->'expiresAt') OR NOT anvil.execution_iso_valid(g->'issuedAt') OR NOT anvil.execution_iso_valid(g->'expiresAt') OR (i->>'expiresAt')::timestamptz<=(i->>'at')::timestamptz OR (i->>'expiresAt')::timestamptz>(i->>'at')::timestamptz+interval '120 seconds' OR (g->>'expiresAt')::timestamptz>(i->>'expiresAt')::timestamptz OR (g->>'expiresAt')::timestamptz<=(g->>'issuedAt')::timestamptz THEN RETURN false;END IF;
 SELECT * INTO c FROM anvil.commands WHERE project_id=p AND id=v.server_command_id;IF c.id IS NULL OR c.operation<>'prepareNativeBoundary' OR c.scope_kind<>'PROJECT' OR c.scope_id<>p OR c.state<>'APPLIED' OR c.actor_id::text<>i->'subject'->>'userId' OR c.client_id::text<>i->'subject'->>'clientId' THEN RETURN false;END IF;
 cmd=c.result_ref->'data'->'commandSnapshot';target=jsonb_build_object('id',v.intent_id,'version',1,'contentHash',v.intent_hash);
 IF NOT anvil.execution_json_shape(cmd,ARRAY['schemaVersion','projectId','commandId','clientId','controlGeneration','operation','targetId','expectedVersion','baselineRefs','approvalRef','payload']) OR cmd->'schemaVersion'<>'1'::jsonb OR cmd->>'operation'<>'prepareNativeBoundary' OR cmd->>'projectId'<>p::text OR cmd->>'commandId'<>c.command_id::text OR cmd->>'clientId'<>c.client_id::text OR cmd->'controlGeneration' IS DISTINCT FROM to_jsonb(c.control_generation) OR cmd->>'targetId'<>i->'expectedWriterHeadRef'->>'id' OR cmd->'expectedVersion' IS DISTINCT FROM i->'expectedWriterHeadRef'->'version' OR cmd->'baselineRefs' IS DISTINCT FROM jsonb_build_array(i->'expectedWriterHeadRef') OR anvil.ownership_content_hash(cmd)<>c.request_hash OR NOT anvil.execution_json_shape(cmd->'payload',ARRAY['registrationRef','nativeFactoryRef','sourceScopes','expectedWriterHeadRef','reason']) OR cmd->'payload'->'registrationRef' IS DISTINCT FROM s->'registrationRef' OR cmd->'payload'->'nativeFactoryRef' IS DISTINCT FROM s->'nativeFactoryRef' OR cmd->'payload'->'sourceScopes' IS DISTINCT FROM i->'sourceScopes' OR cmd->'payload'->'expectedWriterHeadRef' IS DISTINCT FROM i->'expectedWriterHeadRef' THEN RETURN false;END IF;
 IF NOT anvil.execution_json_shape(c.result_ref->'data',ARRAY['ref','status','preparationIntent','commandSnapshot','codingAgentExecutionAuthorized','agentDispatchPerformed']) OR c.result_ref->'data'->>'status'<>'NATIVE_BOUNDARY_PREPARATION_RECORDED' OR c.result_ref->'data'->'preparationIntent' IS DISTINCT FROM i OR c.result_ref->'data'->'ref' IS DISTINCT FROM target OR c.result_ref->'data'->'codingAgentExecutionAuthorized'<>'false'::jsonb OR c.result_ref->'data'->'agentDispatchPerformed'<>'false'::jsonb OR c.result_ref->>'status'<>'APPLIED' OR c.result_ref->>'targetId'<>v.intent_id::text OR c.result_ref->'version'<>'1'::jsonb OR c.policy_ref IS DISTINCT FROM i->'policyRef' THEN RETURN false;END IF;
 digest=anvil.ownership_content_hash(jsonb_build_object('projectId',p,'actorId',c.actor_id,'clientId',c.client_id,'controlGeneration',c.control_generation,'requestHash',c.request_hash,'policyRef',c.policy_ref,'targetRef',target));
 SELECT * INTO r FROM anvil.authorization_receipts WHERE command_id=c.id AND id=c.authorization_receipt_id;
 IF r.id IS NULL OR r.scope_kind<>'PROJECT' OR r.scope_id<>p OR r.scope_digest<>digest OR r.subject_ref IS DISTINCT FROM jsonb_build_object('kind','HUMAN','userId',c.actor_id,'clientId',c.client_id) OR r.policy_ref IS DISTINCT FROM c.policy_ref OR g->'parent'->'commandRef' IS DISTINCT FROM jsonb_build_object('id',c.id,'version',1,'contentHash',c.request_hash) OR g->'parent'->'authorizationReceiptRef' IS DISTINCT FROM jsonb_build_object('id',r.id,'version',1,'contentHash',digest) THEN RETURN false;END IF;
 IF (SELECT count(*) FROM anvil.audit_events WHERE project_id=p AND command_id=c.id)<>1 THEN RETURN false;END IF;
 SELECT * INTO au FROM anvil.audit_events WHERE project_id=p AND command_id=c.id;
 approval=NULLIF(cmd->'approvalRef','null'::jsonb);
 IF au.operation_id<>c.operation_id OR au.actor_ref IS DISTINCT FROM jsonb_build_object('kind','HUMAN','userId',c.actor_id) OR au.client_ref<>c.client_id OR au.target_ref IS DISTINCT FROM target OR au.policy_ref IS DISTINCT FROM c.policy_ref OR au.approval_ref IS DISTINCT FROM approval OR au.scope_digest<>digest OR au.outcome<>'APPLIED' OR au.reason_code<>'EXPLICIT_NATIVE_BOUNDARY_PREPARATION' OR au.source_kind<>'HUMAN_COMMAND' OR au.correction_of IS NOT NULL THEN RETURN false;END IF;
 IF g->'parent'->'auditRef' IS DISTINCT FROM jsonb_build_object('id',au.event_id,'version',1,'contentHash',anvil.ownership_content_hash(jsonb_build_object('projectId',p,'serverSequence',au.server_sequence,'eventId',au.event_id,'actorRef',au.actor_ref,'clientRef',au.client_ref,'commandId',au.command_id,'operationId',au.operation_id,'targetRef',au.target_ref,'policyRef',au.policy_ref,'approvalRef',au.approval_ref,'outcome',au.outcome,'reasonCode',au.reason_code,'scopeDigest',au.scope_digest,'recordedAt',to_char(au.recorded_at AT TIME ZONE 'UTC','YYYY-MM-DD"T"HH24:MI:SS.MS"Z"'),'sourceKind',au.source_kind,'correctionOf',au.correction_of))) THEN RETURN false;END IF;
 IF approval IS NULL THEN IF c.approval_consumption_id IS NOT NULL OR r.approval_decision_ref IS NOT NULL OR c.payload_ref IS NOT NULL THEN RETURN false;END IF;
 ELSE SELECT * INTO used FROM anvil.approval_consumptions WHERE project_id=p AND id=c.approval_consumption_id;IF used.id IS NULL OR used.command_id<>c.id OR used.decision_id::text<>approval->>'decisionId' OR used.scope_digest<>approval->>'scopeDigest' OR r.approval_decision_ref<>used.decision_id OR c.payload_ref IS DISTINCT FROM jsonb_build_object('kind','ONE_TIME_APPROVAL_SCOPE','payloadHash',anvil.ownership_content_hash(cmd->'payload'),'scopeDigest',used.scope_digest) OR NOT EXISTS(SELECT 1 FROM anvil.approval_decisions d JOIN anvil.approval_requests ar ON ar.project_id=d.project_id AND ar.id=d.request_id WHERE d.project_id=p AND d.id=used.decision_id AND d.decision='APPROVE' AND ar.id::text=approval->>'requestId' AND ar.candidate_command_id=c.command_id AND ar.scope_digest=used.scope_digest AND ar.status='CONSUMED' AND ar.action_scope_json->>'operation'='prepareNativeBoundary' AND ar.action_scope_json->'baselineRefs'=cmd->'baselineRefs') THEN RETURN false;END IF;END IF;
 SELECT * INTO w FROM anvil.project_writer_authority_events WHERE project_id=p AND kind='RESERVED' AND lease_id=v.lease_id;
 IF w.id IS NULL OR w.execution_id::text<>s->>'executionId' OR to_jsonb(w.execution_generation) IS DISTINCT FROM s->'executionGeneration' OR to_jsonb(w.authority_epoch) IS DISTINCT FROM s->'authorityEpoch' OR w.command_ref IS DISTINCT FROM g->'parent'->'commandRef' OR w.authorization_receipt_ref IS DISTINCT FROM g->'parent'->'authorizationReceiptRef' OR w.audit_ref IS DISTINCT FROM g->'parent'->'auditRef' OR w.subject_json IS DISTINCT FROM i->'subject' OR w.registration_ref IS DISTINCT FROM s->'registrationRef' OR w.source_scopes_json IS DISTINCT FROM i->'sourceScopes' OR w.payload_json->'preparationRef' IS DISTINCT FROM target OR w.payload_json->'nativeFactoryRef' IS DISTINCT FROM s->'nativeFactoryRef' OR w.payload_json->'expectedHeadRef' IS DISTINCT FROM i->'expectedWriterHeadRef' THEN RETURN false;END IF;
 SELECT count(*) INTO count_states FROM anvil.project_writer_authority_events x WHERE x.project_id=p AND (x.authority_epoch<w.authority_epoch OR x.authority_epoch=w.authority_epoch AND x.sequence<=w.sequence) AND kind IN('BOUNDARY_ESTABLISHED','RESERVED','ACTIVATED','REVOKE_REQUESTED','RECLAIM_CONFIRMED','EXPIRED','UNKNOWN');
 head=jsonb_build_object('schemaVersion',1,'purpose','PROJECT_WRITER_AUTHORITY_HEAD','headId',g->'scope'->'writerHeadRef'->'id','projectId',p,'authorityEpoch',w.authority_epoch,'headGeneration',count_states,'currentEventRef',jsonb_build_object('id',w.id,'version',1,'contentHash',w.content_hash),'phase','RESERVED','leaseId',w.lease_id,'executionId',w.execution_id,'executionGeneration',w.execution_generation,'registrationRef',w.registration_ref,'scopeHash',w.scope_hash,'expiresAt',to_char(w.expires_at AT TIME ZONE 'UTC','YYYY-MM-DD"T"HH24:MI:SS.MS"Z"'));
 IF g->'scope'->'writerHeadRef' IS DISTINCT FROM jsonb_build_object('id',head->'headId','version',count_states,'contentHash',anvil.ownership_content_hash(head)) OR (g->>'expiresAt')::timestamptz>w.expires_at THEN RETURN false;END IF;
 IF (SELECT count(*) FROM anvil.native_preparation_authority_events WHERE project_id=p AND authority_id=a AND kind='AUTHORITY_CREATED')<>1 THEN RETURN false;END IF;
 SELECT * INTO created FROM anvil.native_preparation_authority_events WHERE project_id=p AND authority_id=a AND kind='AUTHORITY_CREATED';
 IF created.snapshot_json->'payload' IS DISTINCT FROM jsonb_build_object('preparationRef',target,'writerHeadRef',g->'scope'->'writerHeadRef','commandRef',g->'parent'->'commandRef','authorizationReceiptRef',g->'parent'->'authorizationReceiptRef','auditRef',g->'parent'->'auditRef') OR created.snapshot_json->'actor' IS DISTINCT FROM jsonb_build_object('kind','HUMAN','subject',i->'subject') THEN RETURN false;END IF;
 RETURN anvil.native_preparation_event_history_valid(p,a);
EXCEPTION WHEN OTHERS THEN RETURN false;
END;$$;
-- 아래 저장 모형은 미적용이다. 기존 app 역할/RLS를 활성화하지 않는다.
-- 실제 인증된 DB 진입 함수 및 retained OS 공급자는 별도 연결 검증이 필요하다.
-- 서명은 기존 서버 P-256 검증기가 검증하며 SQL은 그 원문/부모/원자적 저장 관계를 검산한다.
CREATE TABLE anvil.native_preparation_ownership_bindings (
 project_id uuid NOT NULL REFERENCES anvil.projects(id),execution_id uuid NOT NULL,execution_generation bigint NOT NULL CHECK(execution_generation BETWEEN 1 AND 9007199254740991),
 id uuid NOT NULL,authority_id uuid NOT NULL,consume_receipt_id uuid NOT NULL,request_id uuid NOT NULL,
 content_hash text NOT NULL CHECK(content_hash~'^[0-9a-f]{64}$'),snapshot_json jsonb NOT NULL,plan_json jsonb NOT NULL,
 created_transaction bigint NOT NULL DEFAULT txid_current(),
 PRIMARY KEY(project_id,id),UNIQUE(project_id,authority_id),UNIQUE(project_id,consume_receipt_id),UNIQUE(project_id,request_id),
 UNIQUE(project_id,execution_id,execution_generation),UNIQUE(project_id,execution_id,execution_generation,id,content_hash),
 FOREIGN KEY(project_id,authority_id) REFERENCES anvil.native_preparation_authorities(project_id,id) DEFERRABLE INITIALLY DEFERRED,
 CHECK(anvil.native_preparation_json_bytes(plan_json)<=131072)
);
CREATE TABLE anvil.native_preparation_ownership_results (
 project_id uuid NOT NULL,binding_id uuid NOT NULL,id uuid NOT NULL,
 packet_hash text NOT NULL CHECK(packet_hash~'^[0-9a-f]{64}$'),content_hash text NOT NULL CHECK(content_hash~'^[0-9a-f]{64}$'),snapshot_json jsonb NOT NULL,
 created_transaction bigint NOT NULL DEFAULT txid_current(),PRIMARY KEY(project_id,id),UNIQUE(project_id,binding_id),
 FOREIGN KEY(project_id,binding_id) REFERENCES anvil.native_preparation_ownership_bindings(project_id,id) DEFERRABLE INITIALLY DEFERRED,
 CHECK(anvil.native_preparation_json_bytes(snapshot_json)<=16384)
);
ALTER TABLE anvil.execution_ownership_anchors
 ALTER COLUMN preparation_event_ref DROP NOT NULL,
 ADD COLUMN native_return_binding_ref jsonb,
 ADD COLUMN native_return_binding_id uuid GENERATED ALWAYS AS((native_return_binding_ref->>'id')::uuid) STORED,
 ADD COLUMN native_return_binding_hash text GENERATED ALWAYS AS(native_return_binding_ref->>'contentHash') STORED,
 ADD CONSTRAINT native_return_anchor_parent_xor CHECK(
  (native_return_binding_ref IS NULL AND preparation_event_ref IS NOT NULL AND snapshot_json->'schemaVersion'='1'::jsonb)
  OR (native_return_binding_ref IS NOT NULL AND preparation_event_ref IS NULL AND snapshot_json->'schemaVersion'='2'::jsonb
   AND anvil.ownership_ref_valid(native_return_binding_ref) AND native_return_binding_ref->'version'='1'::jsonb)),
 ADD CONSTRAINT native_return_anchor_parent_fk FOREIGN KEY(project_id,execution_id,execution_generation,native_return_binding_id,native_return_binding_hash)
  REFERENCES anvil.native_preparation_ownership_bindings(project_id,execution_id,execution_generation,id,content_hash) DEFERRABLE INITIALLY DEFERRED;
-- 기존 preparation/adoption FK는 제거하지 않는다. native 부모와 동시에 존재할 수 없다.
DO $$DECLARE t text;BEGIN
 FOREACH t IN ARRAY ARRAY['execution_ownership_events','execution_ownership_observations','execution_ownership_anchors','execution_ownership_heads'] LOOP
  EXECUTE format('ALTER TABLE anvil.%I ADD COLUMN native_return_transaction bigint NOT NULL DEFAULT txid_current()',t);
 END LOOP;
END;$$;

CREATE FUNCTION anvil.native_return_ref(i uuid,h text) RETURNS jsonb LANGUAGE sql IMMUTABLE STRICT SET search_path=pg_catalog AS $$
 SELECT jsonb_build_object('id',i,'version',1,'contentHash',h)
$$;

-- historical 완결 검산: 새 수용 시각 검사는 별도 BEFORE/DEFERRED guard에 한정한다.
CREATE FUNCTION anvil.native_return_parent_valid(p uuid,bid uuid) RETURNS boolean LANGUAGE plpgsql SECURITY DEFINER SET search_path=pg_catalog AS $$
DECLARE b anvil.native_preparation_ownership_bindings;a anvil.native_preparation_authorities;c anvil.native_preparation_authority_events;
 g jsonb;s jsonb;plan jsonb;i jsonb;basis jsonb;receipt jsonb;scope jsonb;anchor jsonb;aref jsonb;req jsonb;ev jsonb;br jsonb;ar jsonb;at_time timestamptz;expiry timestamptz;
BEGIN
 SELECT * INTO b FROM anvil.native_preparation_ownership_bindings WHERE project_id=p AND id=bid;
 IF b.id IS NULL THEN RETURN false;END IF;
 SELECT * INTO a FROM anvil.native_preparation_authorities WHERE project_id=p AND id=b.authority_id;
 IF a.id IS NULL OR NOT anvil.native_preparation_authority_complete(p,a.id) OR a.snapshot_json->'schemaVersion' IS DISTINCT FROM '2'::jsonb THEN RETURN false;END IF;
 g=a.snapshot_json;s=b.snapshot_json;plan=b.plan_json;i=plan->'input';basis=plan->'basis';br=anvil.native_return_ref(b.id,b.content_hash);ar=anvil.native_return_ref(a.id,a.content_hash);
 SELECT * INTO c FROM anvil.native_preparation_authority_events WHERE project_id=p AND authority_id=a.id AND snapshot_json->>'kind'='CONSUME_COMMITTED';
 IF c.id IS NULL OR (SELECT count(*) FROM anvil.native_preparation_authority_events WHERE project_id=p AND authority_id=a.id AND snapshot_json->>'kind'='CONSUME_COMMITTED')<>1 THEN RETURN false;END IF;
 receipt=c.snapshot_json->'payload'->'receipt';
 IF NOT anvil.execution_json_shape(plan,ARRAY['authority','consumeReceipt','consumeRecordRef','input','basis','requestEvent','binding','response'])
  OR plan->'authority' IS DISTINCT FROM g OR plan->'consumeReceipt' IS DISTINCT FROM receipt
  OR plan->'consumeRecordRef' IS DISTINCT FROM anvil.native_return_ref(c.id,c.content_hash)
  OR plan->'binding' IS DISTINCT FROM jsonb_build_object('ref',br,'snapshot',s)
  OR b.content_hash<>anvil.ownership_content_hash(s)
  OR NOT anvil.execution_json_shape(i,ARRAY['schemaVersion','requestId','authorityRef','consumeReceiptRef','localAttemptRef','processRef'])
  OR i->'schemaVersion' IS DISTINCT FROM '1'::jsonb OR i->'authorityRef' IS DISTINCT FROM ar
  OR i->'consumeReceiptRef' IS DISTINCT FROM receipt->'ref' OR i->'localAttemptRef' IS DISTINCT FROM receipt->'snapshot'->'localAttemptRef'
  OR i->>'requestId' IS DISTINCT FROM b.request_id::text OR i->'consumeReceiptRef'->>'id' IS DISTINCT FROM b.consume_receipt_id::text
  OR NOT anvil.ownership_process_shape(i->'processRef') THEN RETURN false;END IF;
 scope=jsonb_build_object('installationId',g->'scope'->'installationId','projectId',p,'executionId',b.execution_id,'executionGeneration',b.execution_generation);
 IF g->'scope'->>'executionId' IS DISTINCT FROM b.execution_id::text OR g->'scope'->'executionGeneration' IS DISTINCT FROM to_jsonb(b.execution_generation)
  OR NOT anvil.execution_json_shape(basis,ARRAY['authorityRef','consumeReceiptRef','nativeFactoryRef','registrationRef','sourceScopeHash','observerRef','runId','processGeneration','workerHash','checkedAt','expiresAt'])
  OR basis->'authorityRef' IS DISTINCT FROM ar OR basis->'consumeReceiptRef' IS DISTINCT FROM receipt->'ref'
  OR basis->'nativeFactoryRef' IS DISTINCT FROM g->'scope'->'nativeFactoryRef' OR basis->'registrationRef' IS DISTINCT FROM g->'scope'->'registrationRef'
  OR basis->'sourceScopeHash' IS DISTINCT FROM g->'scope'->'sourceScopeHash' OR NOT anvil.ownership_ref_valid(basis->'observerRef')
  OR basis->'runId' IS DISTINCT FROM i->'processRef'->'runId' OR basis->'processGeneration' IS DISTINCT FROM i->'processRef'->'generation'
  OR basis->'workerHash' IS DISTINCT FROM i->'processRef'->'executableHash'
  OR NOT anvil.execution_iso_valid(basis->'checkedAt') OR NOT anvil.execution_iso_valid(basis->'expiresAt')
  OR NOT anvil.execution_iso_valid(s->'at') OR NOT anvil.execution_iso_valid(s->'expiresAt') THEN RETURN false;END IF;
 at_time=(s->>'at')::timestamptz;expiry=(s->>'expiresAt')::timestamptz;
 IF at_time<(g->>'issuedAt')::timestamptz OR at_time<(receipt->'snapshot'->>'at')::timestamptz
  OR (basis->>'checkedAt')::timestamptz>at_time OR at_time-(basis->>'checkedAt')::timestamptz>interval '1 second'
  OR expiry<=at_time OR expiry>LEAST(at_time+interval '10 seconds',(g->>'expiresAt')::timestamptz,(receipt->'snapshot'->>'expiresAt')::timestamptz,(basis->>'expiresAt')::timestamptz) THEN RETURN false;END IF;
 anchor=jsonb_build_object('schemaVersion',2,'purpose','PROCESS_OWNERSHIP_ANCHOR','transport','NATIVE_PREPARATION_RETURN',
  'scope',scope||jsonb_build_object('executorRegistrationRef',g->'scope'->'registrationRef'),
  'parent',jsonb_build_object('authorityRef',ar,'consumeReceiptRef',receipt->'ref','localAttemptRef',i->'localAttemptRef'),
  'processRef',i->'processRef','observerRef',basis->'observerRef','recordedAt',s->'at','expiresAt',s->'expiresAt',
  'state','BOUND','fileSandboxVerified',false,'executionAuthorized',false,'dispatchPerformed',false);
 aref=plan->'response'->'candidateAnchor'->'ref';
 IF NOT anvil.ownership_ref_valid(aref) OR aref->'version' IS DISTINCT FROM '1'::jsonb OR aref->>'contentHash' IS DISTINCT FROM anvil.ownership_content_hash(anchor)
  OR plan->'response'->'candidateAnchor' IS DISTINCT FROM jsonb_build_object('ref',aref,'snapshot',anchor) THEN RETURN false;END IF;
 req=(plan->'response'->'request')-'requestRef';
 IF NOT anvil.execution_json_shape(req,ARRAY['protocolVersion','purpose','installationId','projectId','executionId','executionGeneration','registrationRef','publicKeyFingerprint','observerRef','anchorRef','preparationRef','phase','expectedHeadRef','nonce','requestedAt','expiresAt'])
  OR req IS DISTINCT FROM scope||jsonb_build_object('protocolVersion',1,'purpose','OWNERSHIP_OBSERVATION','registrationRef',g->'scope'->'registrationRef',
   'publicKeyFingerprint',g->'scope'->'hostPublicKeyFingerprint','observerRef',basis->'observerRef','anchorRef',aref,'preparationRef',g->'scope'->'preparationRef',
   'phase','BOOTSTRAP_PREPARED','expectedHeadRef',NULL,'nonce',req->'nonce','requestedAt',s->'at','expiresAt',s->'expiresAt')
  OR jsonb_typeof(req->'nonce') IS DISTINCT FROM 'string' OR req->>'nonce'!~'^[A-Za-z0-9_-]{43}$'
  OR rtrim(translate(encode(decode(translate(req->>'nonce','-_','+/')||'=','base64'),'base64'),'+/','-_'),'=')<>req->>'nonce' THEN RETURN false;END IF;
 ev=jsonb_build_object('schemaVersion',1,'purpose','OWNERSHIP_EVENT','scope',scope,'sequence',1,'previousRef',NULL,'kind','OBSERVATION_REQUESTED',
  'subject',g->'subject','registrationRef',g->'scope'->'registrationRef','payload',jsonb_build_object('request',req,'processRef',i->'processRef'),'at',s->'at','expiresAt',s->'expiresAt')||(g->'parent');
 IF NOT anvil.ownership_ref_valid(plan->'requestEvent'->'ref') OR plan->'requestEvent'->'ref'->'version' IS DISTINCT FROM '1'::jsonb
  OR plan->'requestEvent'->'ref'->>'contentHash' IS DISTINCT FROM anvil.ownership_content_hash(ev)
  OR plan->'requestEvent'->'snapshot' IS DISTINCT FROM ev
  OR plan->'response' IS DISTINCT FROM jsonb_build_object('bindingRef',br,'request',req||jsonb_build_object('requestRef',plan->'requestEvent'->'ref'),'candidateAnchor',jsonb_build_object('ref',aref,'snapshot',anchor)) THEN RETURN false;END IF;
 RETURN s=jsonb_build_object('schemaVersion',1,'purpose','NATIVE_PREPARATION_OWNERSHIP_BINDING','scope',scope,'authorityRef',ar,
  'consumeRecordRef',anvil.native_return_ref(c.id,c.content_hash),'consumeReceiptRef',receipt->'ref','localAttemptRef',i->'localAttemptRef',
  'requestId',b.request_id,'requestInputHash',anvil.ownership_content_hash(i),'requestInput',i,'requestRef',plan->'requestEvent'->'ref','candidateAnchorRef',aref,'basis',basis,'at',s->'at','expiresAt',s->'expiresAt');
EXCEPTION WHEN OTHERS THEN RETURN false;
END;$$;

CREATE FUNCTION anvil.native_return_graph_valid(p uuid,bid uuid) RETURNS boolean LANGUAGE plpgsql SECURITY DEFINER SET search_path=pg_catalog AS $$
DECLARE b anvil.native_preparation_ownership_bindings;r anvil.native_preparation_ownership_results;
 q anvil.execution_ownership_events;accepted anvil.execution_ownership_events;adopted anvil.execution_ownership_events;
 o anvil.execution_ownership_observations;a anvil.execution_ownership_anchors;h anvil.execution_ownership_heads;
 scope jsonb;qr jsonb;orr jsonb;acref jsonb;adref jsonb;ar jsonb;hr jsonb;packet jsonb;s jsonb;expect jsonb;count_events bigint;
BEGIN
 IF NOT anvil.native_return_parent_valid(p,bid) THEN RETURN false;END IF;
 SELECT * INTO b FROM anvil.native_preparation_ownership_bindings WHERE project_id=p AND id=bid;
 scope=b.snapshot_json->'scope';qr=b.plan_json->'requestEvent'->'ref';ar=b.plan_json->'response'->'candidateAnchor'->'ref';
 SELECT * INTO q FROM anvil.execution_ownership_events WHERE project_id=p AND execution_id=b.execution_id AND execution_generation=b.execution_generation AND sequence=1;
 IF q.event_id IS NULL OR anvil.native_return_ref(q.event_id,q.content_hash) IS DISTINCT FROM qr OR q.snapshot_json IS DISTINCT FROM b.plan_json->'requestEvent'->'snapshot'
  OR q.candidate_anchor_json IS DISTINCT FROM b.plan_json->'response'->'candidateAnchor' OR q.native_return_transaction<>b.created_transaction THEN RETURN false;END IF;
 SELECT count(*) INTO count_events FROM anvil.execution_ownership_events WHERE project_id=p AND execution_id=b.execution_id AND execution_generation=b.execution_generation;
 SELECT * INTO r FROM anvil.native_preparation_ownership_results WHERE project_id=p AND binding_id=b.id;
 IF r.id IS NULL THEN
  RETURN count_events=1 AND NOT EXISTS(SELECT 1 FROM anvil.execution_ownership_observations WHERE project_id=p AND execution_id=b.execution_id AND execution_generation=b.execution_generation)
   AND NOT EXISTS(SELECT 1 FROM anvil.execution_ownership_anchors WHERE project_id=p AND execution_id=b.execution_id AND execution_generation=b.execution_generation)
   AND NOT EXISTS(SELECT 1 FROM anvil.execution_ownership_heads WHERE project_id=p AND execution_id=b.execution_id AND execution_generation=b.execution_generation);
 END IF;
 SELECT * INTO accepted FROM anvil.execution_ownership_events WHERE project_id=p AND execution_id=b.execution_id AND execution_generation=b.execution_generation AND sequence=2;
 SELECT * INTO adopted FROM anvil.execution_ownership_events WHERE project_id=p AND execution_id=b.execution_id AND execution_generation=b.execution_generation AND sequence=3;
 SELECT * INTO o FROM anvil.execution_ownership_observations WHERE project_id=p AND request_id=q.event_id;
 SELECT * INTO a FROM anvil.execution_ownership_anchors WHERE project_id=p AND execution_id=b.execution_id AND execution_generation=b.execution_generation;
 SELECT * INTO h FROM anvil.execution_ownership_heads WHERE project_id=p AND execution_id=b.execution_id AND execution_generation=b.execution_generation;
 IF count_events<>3 OR accepted.event_id IS NULL OR adopted.event_id IS NULL OR o.observation_id IS NULL OR a.anchor_id IS NULL OR h.id IS NULL
  OR (SELECT count(*) FROM anvil.execution_ownership_observations WHERE project_id=p AND execution_id=b.execution_id AND execution_generation=b.execution_generation)<>1
  OR accepted.native_return_transaction<>r.created_transaction OR adopted.native_return_transaction<>r.created_transaction OR o.native_return_transaction<>r.created_transaction
  OR a.native_return_transaction<>r.created_transaction OR h.native_return_transaction<>r.created_transaction
  OR accepted.project_sequence>=adopted.project_sequence OR q.project_sequence>=accepted.project_sequence THEN RETURN false;END IF;
 orr=anvil.native_return_ref(o.observation_id,o.content_hash);acref=anvil.native_return_ref(accepted.event_id,accepted.content_hash);adref=anvil.native_return_ref(adopted.event_id,adopted.content_hash);hr=anvil.native_return_ref(h.id,h.content_hash);s=r.snapshot_json;
 IF r.content_hash<>anvil.ownership_content_hash(s) OR s IS DISTINCT FROM jsonb_build_object('schemaVersion',1,'purpose','NATIVE_PREPARATION_OWNERSHIP_RECEIPT',
  'bindingRef',anvil.native_return_ref(b.id,b.content_hash),'packetHash',r.packet_hash,'observationRef',orr,'headRef',hr,'acceptedAt',s->'acceptedAt','executionAuthorized',false,'dispatchPerformed',false)
  OR NOT anvil.execution_iso_valid(s->'acceptedAt') OR (s->>'acceptedAt')::timestamptz<(b.snapshot_json->>'at')::timestamptz
  OR (s->>'acceptedAt')::timestamptz>=(b.snapshot_json->>'expiresAt')::timestamptz THEN RETURN false;END IF;
 expect=q.snapshot_json||jsonb_build_object('sequence',2,'previousRef',qr,'kind','OBSERVATION_ACCEPTED','at',s->'acceptedAt','payload',jsonb_build_object('requestRef',qr,'observationRef',orr,'phase','BOOTSTRAP_PREPARED','expectedHeadRef',NULL,'anchorRef',ar,'preparationRef',b.plan_json->'authority'->'scope'->'preparationRef'));
 IF accepted.snapshot_json IS DISTINCT FROM expect OR accepted.content_hash<>anvil.ownership_content_hash(expect) OR accepted.request_id<>q.event_id OR accepted.candidate_anchor_json IS NOT NULL THEN RETURN false;END IF;
 expect=expect||jsonb_build_object('sequence',3,'previousRef',acref,'kind','ANCHOR_ADOPTED','payload',jsonb_build_object('anchorRef',ar,'preparationRef',b.plan_json->'authority'->'scope'->'preparationRef','observationEventRef',acref,'expectedHeadRef',NULL));
 IF adopted.snapshot_json IS DISTINCT FROM expect OR adopted.content_hash<>anvil.ownership_content_hash(expect) OR adopted.request_id IS NOT NULL OR adopted.candidate_anchor_json IS NOT NULL THEN RETURN false;END IF;
 IF a.preparation_event_ref IS NOT NULL OR a.native_return_binding_ref IS DISTINCT FROM anvil.native_return_ref(b.id,b.content_hash)
  OR anvil.native_return_ref(a.anchor_id,a.content_hash) IS DISTINCT FROM ar OR a.snapshot_json IS DISTINCT FROM b.plan_json->'response'->'candidateAnchor'->'snapshot'
  OR a.adoption_event_ref IS DISTINCT FROM adref OR a.content_hash<>anvil.ownership_content_hash(a.snapshot_json) THEN RETURN false;END IF;
 expect=jsonb_build_object('schemaVersion',1,'purpose','OWNERSHIP_HEAD','scope',scope,'anchorRef',ar,'generation',1,'previousHeadRef',NULL,'currentEventRef',adref,'state','ACTIVE','updatedAt',s->'acceptedAt','expiresAt',b.snapshot_json->'expiresAt');
 IF h.head_generation<>1 OR h.snapshot_json IS DISTINCT FROM expect OR h.content_hash<>anvil.ownership_content_hash(expect) THEN RETURN false;END IF;
 IF o.content_hash<>anvil.ownership_content_hash(o.snapshot_json) OR o.accepted_event_ref IS DISTINCT FROM acref
  OR o.snapshot_json->'report'-'factsHash'-'observedAt' IS DISTINCT FROM b.plan_json->'response'->'request'
  OR o.snapshot_json->'report'->>'factsHash' IS DISTINCT FROM anvil.ownership_content_hash(o.snapshot_json->'facts')
  OR o.snapshot_json->'facts'->'processRef' IS DISTINCT FROM b.plan_json->'input'->'processRef'
  OR o.snapshot_json->'facts'->>'state' IS DISTINCT FROM 'PREPARED' OR o.snapshot_json->'facts'->'everResumed' IS DISTINCT FROM 'false'::jsonb
  OR (o.snapshot_json->'report'->>'observedAt')::timestamptz<(b.snapshot_json->>'at')::timestamptz
  OR (o.snapshot_json->'report'->>'observedAt')::timestamptz>(s->>'acceptedAt')::timestamptz
  OR o.nonce_digest<>encode(pg_catalog.sha256(decode(translate(b.plan_json->'response'->'request'->>'nonce','-_','+/')||'=','base64')),'hex') THEN RETURN false;END IF;
 packet=jsonb_build_object('schemaVersion',1,'authorityRef',b.snapshot_json->'authorityRef','consumeReceiptRef',b.snapshot_json->'consumeReceiptRef','localAttemptRef',b.snapshot_json->'localAttemptRef',
  'bindingRef',anvil.native_return_ref(b.id,b.content_hash),'report',o.snapshot_json->'report','facts',o.snapshot_json->'facts','signature',o.snapshot_json->'signature');
 RETURN r.packet_hash=anvil.ownership_content_hash(packet);
EXCEPTION WHEN OTHERS THEN RETURN false;
END;$$;

CREATE FUNCTION anvil.native_return_insert_guard() RETURNS trigger LANGUAGE plpgsql SECURITY DEFINER SET search_path=pg_catalog AS $$
DECLARE b anvil.native_preparation_ownership_bindings;g jsonb;bid uuid;
BEGIN
 IF TG_OP<>'INSERT' OR current_setting('transaction_isolation')<>'read committed' THEN RAISE EXCEPTION 'NATIVE_RETURN_APPEND_ONLY';END IF;
 PERFORM 1 FROM anvil.projects WHERE id=NEW.project_id FOR UPDATE;
 IF TG_TABLE_NAME='native_preparation_ownership_bindings' THEN
  IF NEW.created_transaction<>txid_current() OR NEW.content_hash<>anvil.ownership_content_hash(NEW.snapshot_json) THEN RAISE EXCEPTION 'NATIVE_RETURN_PARENT_INVALID';END IF;
  bid=NEW.id;g=NEW.plan_json->'authority';
 ELSE
  SELECT * INTO b FROM anvil.native_preparation_ownership_bindings WHERE project_id=NEW.project_id AND id=NEW.binding_id;
  IF b.id IS NULL OR NOT anvil.native_return_parent_valid(b.project_id,b.id) OR NEW.created_transaction<>txid_current() THEN RAISE EXCEPTION 'NATIVE_RETURN_PARENT_INVALID';END IF;g=b.plan_json->'authority';
 END IF;
 IF (g->>'expiresAt')::timestamptz<=clock_timestamp() OR NOT EXISTS(SELECT 1 FROM anvil.project_writer_authority_heads h WHERE h.project_id=NEW.project_id
  AND h.id::text=g->'scope'->'writerHeadRef'->>'id' AND h.head_generation::text=g->'scope'->'writerHeadRef'->>'version' AND h.content_hash=g->'scope'->'writerHeadRef'->>'contentHash' AND h.phase='RESERVED')
  OR NOT anvil.connector_basis_current((g->'scope'->'registrationRef'->>'id')::uuid,false)
 THEN RAISE EXCEPTION 'NATIVE_RETURN_CURRENT_REQUIRED';END IF;
 RETURN NEW;
END;$$;

CREATE FUNCTION anvil.native_return_final() RETURNS trigger LANGUAGE plpgsql SECURITY DEFINER SET search_path=pg_catalog AS $$
DECLARE b anvil.native_preparation_ownership_bindings;row_json jsonb=to_jsonb(NEW);expiry timestamptz;
BEGIN
 IF TG_TABLE_NAME='native_preparation_ownership_bindings' THEN SELECT * INTO b FROM anvil.native_preparation_ownership_bindings WHERE project_id=NEW.project_id AND id=NEW.id;
 ELSIF TG_TABLE_NAME='native_preparation_ownership_results' THEN SELECT * INTO b FROM anvil.native_preparation_ownership_bindings WHERE project_id=NEW.project_id AND id=NEW.binding_id;
 ELSE SELECT * INTO b FROM anvil.native_preparation_ownership_bindings WHERE project_id=NEW.project_id AND execution_id=NEW.execution_id AND execution_generation=NEW.execution_generation;END IF;
 IF b.id IS NULL OR NOT anvil.native_return_graph_valid(b.project_id,b.id) THEN RAISE EXCEPTION 'NATIVE_RETURN_GRAPH_INCOMPLETE';END IF;
 expiry=(b.snapshot_json->>'expiresAt')::timestamptz;
 IF expiry<=clock_timestamp() OR NOT anvil.connector_basis_current((b.plan_json->'authority'->'scope'->'registrationRef'->>'id')::uuid,false)
  OR NOT EXISTS(SELECT 1 FROM anvil.project_writer_authority_heads h WHERE h.project_id=b.project_id AND h.id::text=b.plan_json->'authority'->'scope'->'writerHeadRef'->>'id'
   AND h.head_generation::text=b.plan_json->'authority'->'scope'->'writerHeadRef'->>'version' AND h.content_hash=b.plan_json->'authority'->'scope'->'writerHeadRef'->>'contentHash' AND h.phase='RESERVED')
 THEN RAISE EXCEPTION 'NATIVE_RETURN_CURRENT_REQUIRED';END IF;
 RETURN NULL;
END;$$;

DO $$DECLARE t text;BEGIN
 FOREACH t IN ARRAY ARRAY['native_preparation_ownership_bindings','native_preparation_ownership_results'] LOOP
  EXECUTE format('ALTER TABLE anvil.%I ENABLE ROW LEVEL SECURITY',t);
  EXECUTE format('ALTER TABLE anvil.%I FORCE ROW LEVEL SECURITY',t);
  EXECUTE format('CREATE POLICY native_return_closed ON anvil.%I USING(false) WITH CHECK(false)',t);
  EXECUTE format('REVOKE ALL ON anvil.%I FROM PUBLIC,anvil_v3_app',t);
  EXECUTE format('CREATE TRIGGER native_return_append BEFORE INSERT OR UPDATE OR DELETE ON anvil.%I FOR EACH ROW EXECUTE FUNCTION anvil.native_return_insert_guard()',t);
  EXECUTE format('CREATE TRIGGER native_return_no_truncate BEFORE TRUNCATE ON anvil.%I FOR EACH STATEMENT EXECUTE FUNCTION anvil.ownership_record_immutable()',t);
 END LOOP;
 FOREACH t IN ARRAY ARRAY['native_preparation_ownership_bindings','native_preparation_ownership_results','execution_ownership_events','execution_ownership_observations','execution_ownership_anchors','execution_ownership_heads'] LOOP
  EXECUTE format('CREATE CONSTRAINT TRIGGER native_return_complete AFTER INSERT ON anvil.%I DEFERRABLE INITIALLY DEFERRED FOR EACH ROW EXECUTE FUNCTION anvil.native_return_final()',t);
 END LOOP;
END;$$;
REVOKE ALL ON FUNCTION anvil.native_return_ref(uuid,text),anvil.native_return_parent_valid(uuid,uuid),anvil.native_return_graph_valid(uuid,uuid),anvil.native_return_insert_guard(),anvil.native_return_final() FROM PUBLIC,anvil_v3_app;
CREATE OR REPLACE FUNCTION anvil.ownership_record_shape_guard() RETURNS trigger LANGUAGE plpgsql AS $$
DECLARE r jsonb=to_jsonb(NEW);s jsonb=NEW.snapshot_json;sc jsonb;p jsonb;q jsonb;k text;fields text[];
BEGIN
 /* NATIVE_RETURN_BRANCH_BEGIN */
 IF TG_TABLE_NAME='execution_ownership_anchors' AND r->'native_return_binding_ref' IS DISTINCT FROM 'null'::jsonb THEN
  IF NEW.preparation_event_ref IS NOT NULL OR NOT anvil.ownership_ref_valid(NEW.native_return_binding_ref) OR NEW.native_return_binding_ref->'version' IS DISTINCT FROM '1'::jsonb
   OR NOT EXISTS(SELECT 1 FROM anvil.native_preparation_ownership_bindings b WHERE b.project_id=NEW.project_id AND b.execution_id=NEW.execution_id AND b.execution_generation=NEW.execution_generation
    AND b.id=NEW.native_return_binding_id AND b.content_hash=NEW.native_return_binding_hash
    AND anvil.native_return_parent_valid(b.project_id,b.id)
    AND b.plan_json->'response'->'candidateAnchor'=jsonb_build_object('ref',anvil.native_return_ref(NEW.anchor_id,NEW.content_hash),'snapshot',NEW.snapshot_json))
  THEN RAISE EXCEPTION 'NATIVE_RETURN_ANCHOR_PARENT_INVALID' USING ERRCODE='42501';END IF;
  RETURN NEW;
 END IF;
 /* NATIVE_RETURN_BRANCH_END */
 IF jsonb_typeof(s) IS DISTINCT FROM 'object' OR octet_length(convert_to(anvil.execution_authority_canonical(s),'UTF8'))>262144
  OR s->'schemaVersion' IS DISTINCT FROM '1'::jsonb OR NEW.content_hash IS DISTINCT FROM anvil.ownership_content_hash(s)
 THEN RAISE EXCEPTION 'OWNERSHIP_ROW_SHAPE_REQUIRED' USING ERRCODE='42501';END IF;
 CASE TG_TABLE_NAME
 WHEN 'execution_ownership_events' THEN
  IF NOT anvil.execution_json_shape(s,ARRAY['schemaVersion','purpose','scope','sequence','previousRef','kind','subject','registrationRef','commandRef','authorizationReceiptRef','auditRef','payload','at','expiresAt'])
   OR s->>'purpose' IS DISTINCT FROM 'OWNERSHIP_EVENT' OR s->'sequence' IS DISTINCT FROM r->'sequence'
   OR COALESCE(s->>'kind','') NOT IN('PREPARATION_GRANTED','OBSERVATION_REQUESTED','OBSERVATION_ACCEPTED','ANCHOR_ADOPTED','BINDING_RECORDED','REVOKED','EXPIRED','UNKNOWN')
   OR NOT anvil.execution_json_shape(s->'subject',ARRAY['userId','clientId','humanSessionId','controlGeneration','credentialGeneration'])
  THEN RAISE EXCEPTION 'OWNERSHIP_EVENT_SHAPE_REQUIRED' USING ERRCODE='42501';END IF;
  FOREACH k IN ARRAY ARRAY['userId','clientId','humanSessionId'] LOOP
   IF NOT anvil.ownership_uuid_valid(s->'subject'->k) THEN RAISE EXCEPTION 'OWNERSHIP_EVENT_SUBJECT_REQUIRED' USING ERRCODE='42501';END IF;
  END LOOP;
  IF NOT anvil.ownership_positive_valid(s->'subject'->'controlGeneration') OR NOT anvil.ownership_positive_valid(s->'subject'->'credentialGeneration')
   OR (NEW.sequence=1 AND s->'previousRef' IS DISTINCT FROM 'null'::jsonb)
   OR (NEW.sequence>1 AND NOT anvil.ownership_ref_valid(s->'previousRef'))
   OR s->'previousRef'->>'id'=NEW.event_id::text
  THEN RAISE EXCEPTION 'OWNERSHIP_EVENT_CHAIN_SHAPE_REQUIRED' USING ERRCODE='42501';END IF;
  FOREACH k IN ARRAY ARRAY['registrationRef','commandRef','authorizationReceiptRef','auditRef'] LOOP
   IF NOT anvil.ownership_ref_valid(s->k) THEN RAISE EXCEPTION 'OWNERSHIP_EVENT_REF_REQUIRED' USING ERRCODE='42501';END IF;
  END LOOP;
  IF NOT anvil.execution_iso_valid(s->'at') OR NOT anvil.execution_iso_valid(s->'expiresAt') OR jsonb_typeof(s->'payload') IS DISTINCT FROM 'object'
   OR (s->>'kind' NOT IN('REVOKED','EXPIRED','UNKNOWN') AND (s->>'expiresAt')::timestamptz<=(s->>'at')::timestamptz)
  THEN RAISE EXCEPTION 'OWNERSHIP_EVENT_TIME_REQUIRED' USING ERRCODE='42501';END IF;
  sc=s->'scope';
 WHEN 'execution_ownership_heads' THEN
  IF NOT anvil.execution_json_shape(s,ARRAY['schemaVersion','purpose','scope','anchorRef','generation','previousHeadRef','currentEventRef','state','updatedAt','expiresAt'])
   OR s->>'purpose' IS DISTINCT FROM 'OWNERSHIP_HEAD' OR s->'generation' IS DISTINCT FROM r->'head_generation'
   OR COALESCE(s->>'state','') NOT IN('ACTIVE','REVOKED','EXPIRED','UNKNOWN')
   OR NOT anvil.ownership_ref_valid(s->'anchorRef') OR NOT anvil.ownership_ref_valid(s->'currentEventRef')
   OR (NEW.head_generation=1 AND s->'previousHeadRef' IS DISTINCT FROM 'null'::jsonb)
   OR (NEW.head_generation>1 AND NOT anvil.ownership_ref_valid(s->'previousHeadRef'))
   OR NOT anvil.execution_iso_valid(s->'updatedAt') OR NOT anvil.execution_iso_valid(s->'expiresAt')
  THEN RAISE EXCEPTION 'OWNERSHIP_HEAD_SHAPE_REQUIRED' USING ERRCODE='42501';END IF;
  sc=s->'scope';
 WHEN 'execution_ownership_anchors' THEN
  IF NOT anvil.execution_json_shape(s,ARRAY['schemaVersion','purpose','transport','scope','processRef','observerRef','recordedAt','expiresAt','state','fileSandboxVerified','executionAuthorized','dispatchPerformed'])
   OR s->>'purpose' IS DISTINCT FROM 'PROCESS_OWNERSHIP_ANCHOR' OR s->>'state' IS DISTINCT FROM 'BOUND'
   OR s->'fileSandboxVerified' IS DISTINCT FROM 'false'::jsonb OR NOT anvil.ownership_process_shape(s->'processRef') OR NOT anvil.ownership_ref_valid(s->'observerRef')
   OR NOT anvil.ownership_ref_valid(NEW.preparation_event_ref) OR NOT anvil.ownership_ref_valid(NEW.adoption_event_ref)
  THEN RAISE EXCEPTION 'OWNERSHIP_ANCHOR_SHAPE_REQUIRED' USING ERRCODE='42501';END IF;
  sc=s->'scope';
 WHEN 'execution_ownership_bindings' THEN
  IF NOT anvil.execution_json_shape(s,ARRAY['schemaVersion','purpose','transport','ownershipEvidenceRef','scope','commandId','envelopeHash','parentThreadClaimRef','attemptRef','permitRef','instructionContentHash','preSendBindingHash','recordedAt','expiresAt'])
   OR s->>'purpose' IS DISTINCT FROM 'SENT_PROCESS_BINDING' OR s->'commandId' IS DISTINCT FROM r->'command_id'
   OR s->'ownershipEvidenceRef' IS DISTINCT FROM NEW.anchor_ref OR s->'attemptRef' IS DISTINCT FROM NEW.attempt_ref OR s->'permitRef' IS DISTINCT FROM NEW.permit_ref
   OR NOT anvil.ownership_ref_valid(NEW.binding_event_ref)
  THEN RAISE EXCEPTION 'OWNERSHIP_BINDING_SHAPE_REQUIRED' USING ERRCODE='42501';END IF;
  FOREACH k IN ARRAY ARRAY['ownershipEvidenceRef','parentThreadClaimRef','attemptRef','permitRef'] LOOP
   IF NOT anvil.ownership_ref_valid(s->k) THEN RAISE EXCEPTION 'OWNERSHIP_BINDING_REF_REQUIRED' USING ERRCODE='42501';END IF;
  END LOOP;
  FOREACH k IN ARRAY ARRAY['envelopeHash','instructionContentHash','preSendBindingHash'] LOOP
   IF (jsonb_typeof(s->k)='string' AND s->>k ~ '^[0-9a-f]{64}$') IS NOT TRUE THEN RAISE EXCEPTION 'OWNERSHIP_BINDING_HASH_REQUIRED' USING ERRCODE='42501';END IF;
  END LOOP;
  sc=s->'scope';
 WHEN 'execution_ownership_observations' THEN
  IF NOT anvil.execution_json_shape(s,ARRAY['schemaVersion','purpose','report','signature','facts']) OR s->>'purpose' IS DISTINCT FROM 'OWNERSHIP_OBSERVATION_RECORD'
   OR (jsonb_typeof(s->'signature')='string' AND s->>'signature' ~ '^[A-Za-z0-9_-]{85}[AQgw]$') IS NOT TRUE
   OR NOT anvil.ownership_ref_valid(NEW.accepted_event_ref)
  THEN RAISE EXCEPTION 'OWNERSHIP_OBSERVATION_SHAPE_REQUIRED' USING ERRCODE='42501';END IF;
  q=s->'report';
  IF NOT anvil.execution_json_shape(q,ARRAY['protocolVersion','purpose','installationId','projectId','executionId','executionGeneration','registrationRef','publicKeyFingerprint','observerRef','anchorRef','preparationRef','requestRef','phase','expectedHeadRef','nonce','requestedAt','expiresAt','factsHash','observedAt'])
   OR q->'protocolVersion' IS DISTINCT FROM '1'::jsonb OR q->>'purpose' IS DISTINCT FROM 'OWNERSHIP_OBSERVATION' OR NOT anvil.execution_nonce_valid(q->'nonce')
   OR NOT anvil.execution_iso_valid(q->'requestedAt') OR NOT anvil.execution_iso_valid(q->'observedAt') OR NOT anvil.execution_iso_valid(q->'expiresAt')
   OR (q->>'observedAt')::timestamptz<(q->>'requestedAt')::timestamptz OR (q->>'observedAt')::timestamptz>=(q->>'expiresAt')::timestamptz
   OR (q->>'expiresAt')::timestamptz>(q->>'requestedAt')::timestamptz+interval '10 seconds'
   OR NOT anvil.ownership_process_shape(s->'facts'->'processRef')
  THEN RAISE EXCEPTION 'OWNERSHIP_OBSERVATION_REPORT_REQUIRED' USING ERRCODE='42501';END IF;
  FOREACH k IN ARRAY ARRAY['registrationRef','observerRef','anchorRef','preparationRef','requestRef'] LOOP
   IF NOT anvil.ownership_ref_valid(q->k) THEN RAISE EXCEPTION 'OWNERSHIP_OBSERVATION_REF_REQUIRED' USING ERRCODE='42501';END IF;
  END LOOP;
  FOREACH k IN ARRAY ARRAY['publicKeyFingerprint','factsHash'] LOOP
   IF (jsonb_typeof(q->k)='string' AND q->>k ~ '^[0-9a-f]{64}$') IS NOT TRUE THEN RAISE EXCEPTION 'OWNERSHIP_OBSERVATION_HASH_REQUIRED' USING ERRCODE='42501';END IF;
  END LOOP;
  IF (q->>'phase'='BOOTSTRAP_PREPARED' AND q->'expectedHeadRef'='null'::jsonb OR q->>'phase'='CURRENT' AND anvil.ownership_ref_valid(q->'expectedHeadRef')) IS NOT TRUE
  THEN RAISE EXCEPTION 'OWNERSHIP_OBSERVATION_PHASE_REQUIRED' USING ERRCODE='42501';END IF;
  sc=jsonb_build_object('installationId',q->'installationId','projectId',q->'projectId','executionId',q->'executionId','executionGeneration',q->'executionGeneration');
 ELSE RAISE EXCEPTION 'OWNERSHIP_TABLE_NOT_SUPPORTED' USING ERRCODE='42501';
 END CASE;
 IF sc->'projectId' IS DISTINCT FROM r->'project_id' OR sc->'executionId' IS DISTINCT FROM r->'execution_id'
  OR sc->'executionGeneration' IS DISTINCT FROM r->'execution_generation' OR NOT anvil.ownership_uuid_valid(sc->'projectId')
  OR NOT anvil.ownership_uuid_valid(sc->'executionId') OR NOT anvil.ownership_positive_valid(sc->'executionGeneration')
 THEN RAISE EXCEPTION 'OWNERSHIP_ROW_SCOPE_REQUIRED' USING ERRCODE='42501';END IF;
 IF TG_TABLE_NAME IN('execution_ownership_anchors','execution_ownership_bindings') THEN
  IF NOT anvil.execution_json_shape(sc,ARRAY['projectId','executionId','executionGeneration','sessionBindingRef','roleBindingRef','executorRegistrationRef'])
   OR s->>'transport' IS DISTINCT FROM 'SYNTHETIC_ONLY' OR NOT anvil.execution_iso_valid(s->'recordedAt') OR NOT anvil.execution_iso_valid(s->'expiresAt')
   OR (s->>'expiresAt')::timestamptz<=(s->>'recordedAt')::timestamptz
  THEN RAISE EXCEPTION 'OWNERSHIP_RECORDED_SCOPE_REQUIRED' USING ERRCODE='42501';END IF;
  FOREACH k IN ARRAY ARRAY['sessionBindingRef','roleBindingRef','executorRegistrationRef'] LOOP
   IF NOT anvil.ownership_ref_valid(sc->k) THEN RAISE EXCEPTION 'OWNERSHIP_SCOPE_REF_REQUIRED' USING ERRCODE='42501';END IF;
  END LOOP;
  IF TG_TABLE_NAME='execution_ownership_anchors' AND (s->'executionAuthorized' IS DISTINCT FROM 'false'::jsonb OR s->'dispatchPerformed' IS DISTINCT FROM 'false'::jsonb)
  THEN RAISE EXCEPTION 'OWNERSHIP_FALSE_AUTHORITY_REQUIRED' USING ERRCODE='42501';END IF;
 ELSE
  IF NOT anvil.execution_json_shape(sc,ARRAY['installationId','projectId','executionId','executionGeneration']) OR NOT anvil.ownership_uuid_valid(sc->'installationId')
  THEN RAISE EXCEPTION 'OWNERSHIP_INSTALLATION_SCOPE_REQUIRED' USING ERRCODE='42501';END IF;
 END IF;
 RETURN NEW;
EXCEPTION WHEN OTHERS THEN RAISE EXCEPTION 'OWNERSHIP_ROW_SHAPE_REQUIRED' USING ERRCODE='42501';
END;$$;
CREATE OR REPLACE FUNCTION anvil.ownership_anchor_links_guard() RETURNS trigger LANGUAGE plpgsql AS $$
DECLARE prep anvil.execution_ownership_events%ROWTYPE;adopt anvil.execution_ownership_events%ROWTYPE;accepted anvil.execution_ownership_events%ROWTYPE;requested anvil.execution_ownership_events%ROWTYPE;self_ref jsonb;accepted_ref jsonb;request_ref jsonb;
BEGIN
 /* NATIVE_RETURN_BRANCH_BEGIN */
 IF NEW.native_return_binding_ref IS NOT NULL THEN
  IF NEW.preparation_event_ref IS NOT NULL OR NOT anvil.native_return_graph_valid(NEW.project_id,NEW.native_return_binding_id)
  THEN RAISE EXCEPTION 'NATIVE_RETURN_ANCHOR_EXACT_LINK_REQUIRED' USING ERRCODE='42501';END IF;
  RETURN NEW;
 END IF;
 /* NATIVE_RETURN_BRANCH_END */
 self_ref=jsonb_build_object('id',NEW.anchor_id,'version',NEW.version,'contentHash',NEW.content_hash);
 SELECT * INTO prep FROM anvil.execution_ownership_events WHERE project_id=NEW.project_id AND execution_id=NEW.execution_id AND execution_generation=NEW.execution_generation
  AND event_id=NEW.preparation_event_id AND version=NEW.preparation_event_version AND content_hash=NEW.preparation_event_hash;
 SELECT * INTO adopt FROM anvil.execution_ownership_events WHERE project_id=NEW.project_id AND execution_id=NEW.execution_id AND execution_generation=NEW.execution_generation
  AND event_id=NEW.adoption_event_id AND version=NEW.adoption_event_version AND content_hash=NEW.adoption_event_hash;
 accepted_ref=adopt.snapshot_json->'payload'->'observationEventRef';
 SELECT * INTO accepted FROM anvil.execution_ownership_events WHERE project_id=NEW.project_id AND execution_id=NEW.execution_id AND execution_generation=NEW.execution_generation
  AND event_id=(accepted_ref->>'id')::uuid AND version=(accepted_ref->>'version')::bigint AND content_hash=accepted_ref->>'contentHash';
 request_ref=accepted.snapshot_json->'payload'->'requestRef';
 SELECT * INTO requested FROM anvil.execution_ownership_events WHERE project_id=NEW.project_id AND execution_id=NEW.execution_id AND execution_generation=NEW.execution_generation
  AND event_id=(request_ref->>'id')::uuid AND version=(request_ref->>'version')::bigint AND content_hash=request_ref->>'contentHash';
 IF prep.event_id IS NULL OR adopt.event_id IS NULL OR accepted.event_id IS NULL OR requested.event_id IS NULL
  OR prep.kind<>'PREPARATION_GRANTED' OR adopt.kind<>'ANCHOR_ADOPTED' OR accepted.kind<>'OBSERVATION_ACCEPTED' OR requested.kind<>'OBSERVATION_REQUESTED'
  OR accepted.snapshot_json->'payload'->>'phase' IS DISTINCT FROM 'BOOTSTRAP_PREPARED'
  OR adopt.snapshot_json->'payload'->'anchorRef' IS DISTINCT FROM self_ref
  OR adopt.snapshot_json->'payload'->'preparationRef' IS DISTINCT FROM NEW.preparation_event_ref
  OR requested.candidate_anchor_json IS DISTINCT FROM jsonb_build_object('ref',self_ref,'snapshot',NEW.snapshot_json)
  OR NEW.content_hash IS DISTINCT FROM anvil.ownership_content_hash(NEW.snapshot_json)
 THEN RAISE EXCEPTION 'OWNERSHIP_ANCHOR_EXACT_LINK_REQUIRED' USING ERRCODE='42501';END IF;
 RETURN NEW;
END;$$;
CREATE OR REPLACE FUNCTION anvil.ownership_authority_unavailable() RETURNS trigger LANGUAGE plpgsql AS $$
BEGIN RAISE EXCEPTION 'OWNERSHIP_AUTHORITY_NOT_ACTIVATED' USING ERRCODE='42501'; END;$$;
COMMIT;
