-- FN02 미적용 검토 후보. runner 등록/격리 PG 실행/정식 적용은 이 파일 작성과 별개다.
-- 기존 0011 초기 생성 함수와 과거 SQL 파일은 수정하지 않는다. 새 기능/정책/권한 부여 없음.
-- 실제 SQL 구문·COMMIT·경합·기존 흐름 검증 전 사용 금지. READ COMMITTED 경계도 검수 대상이다.

ALTER TABLE anvil.project_methodologies ADD COLUMN application_command_id uuid UNIQUE
 REFERENCES anvil.commands(id) ON DELETE RESTRICT;

-- 현재 제품 graph/form/command의 객체 필드는 ASCII다. 기존 assignment canonical은
-- 소수 그래프를 위한 함수가 아니므로 재사용/교체하지 않는다. 새 함수도 PG/JS 교차 검수 전이다.
CREATE FUNCTION anvil.fn02_canonical(value jsonb,depth integer DEFAULT 0) RETURNS text
 LANGUAGE plpgsql IMMUTABLE STRICT SET extra_float_digits=1 AS $$
DECLARE encoded text;n double precision;s text;exponent integer;
BEGIN
 IF depth>64 THEN RAISE EXCEPTION 'FN02_CANONICAL_DEPTH';END IF;
 CASE jsonb_typeof(value)
 WHEN 'object' THEN
  IF EXISTS(SELECT 1 FROM jsonb_object_keys(value) k WHERE k !~ '^[ -~]*$') THEN
   RAISE EXCEPTION 'FN02_CANONICAL_KEY_UNSUPPORTED';
  END IF;
  SELECT '{'||COALESCE(string_agg(to_jsonb(k)::text||':'||anvil.fn02_canonical(v,depth+1),',' ORDER BY k COLLATE "C"),'')||'}'
   INTO encoded FROM jsonb_each(value) item(k,v);
 WHEN 'array' THEN
  SELECT '['||COALESCE(string_agg(anvil.fn02_canonical(v,depth+1),',' ORDER BY ordinal),'')||']'
   INTO encoded FROM jsonb_array_elements(value) WITH ORDINALITY item(v,ordinal);
 WHEN 'number' THEN
  n=(value::text)::double precision;
  IF n::text IN('Infinity','-Infinity','NaN') OR (trunc(n)=n AND abs(n)>9007199254740991) THEN
   RAISE EXCEPTION 'FN02_CANONICAL_NUMBER_UNSUPPORTED';
  END IF;
  IF n=0 THEN RETURN '0';END IF;
  s=lower(n::text);
  IF abs(n)>=0.000001 AND abs(n)<1e21 THEN
   encoded=trim_scale(s::numeric)::text;
  ELSE
   IF position('e' IN s)>0 THEN
    exponent=split_part(s,'e',2)::integer;
    encoded=split_part(s,'e',1)||'e'||CASE WHEN exponent>=0 THEN '+' ELSE '' END||exponent::text;
   ELSE encoded=s;END IF;
  END IF;
 ELSE encoded=value::text;
 END CASE;
 RETURN encoded;
END;
$$;
CREATE FUNCTION anvil.fn02_hash(value jsonb) RETURNS text LANGUAGE sql IMMUTABLE STRICT AS $$
 SELECT encode(sha256(convert_to(anvil.fn02_canonical(value),'UTF8')),'hex');
$$;
CREATE FUNCTION anvil.fn02_js_length(value text) RETURNS bigint LANGUAGE sql IMMUTABLE STRICT AS $$
 SELECT length(value)+count(*) FILTER(WHERE ascii(c)>65535) FROM regexp_split_to_table(value,'') c;
$$;
CREATE FUNCTION anvil.fn02_method_criteria() RETURNS jsonb LANGUAGE sql IMMUTABLE AS $$
 SELECT jsonb_build_object('criteriaVersion',1,'items',jsonb_build_array(
  jsonb_build_object('criterionId','METHOD_PURPOSE_SCOPE','title','방법론의 목적과 단계별 작업 범위가 분명한가'),
  jsonb_build_object('criterionId','METHOD_FLOW_CONTROL','title','순서·분기·합류·재작업이 의도한 절차인가'),
  jsonb_build_object('criterionId','METHOD_INPUT_OUTPUT','title','입력·산출물과 양식의 연결이 충분한가'),
  jsonb_build_object('criterionId','METHOD_COMPLETION_APPROVAL','title','완료 기준·검수·사람 승인 경계가 충분한가'),
  jsonb_build_object('criterionId','METHOD_RECORD_LIMITS','title','담당·작업 기록·한도와 미연결 사항을 분명히 했는가')));
$$;

CREATE FUNCTION anvil.fn02_keys(value jsonb,allowed text[],required text[]) RETURNS boolean LANGUAGE plpgsql IMMUTABLE AS $$
BEGIN
 IF jsonb_typeof(value) IS DISTINCT FROM 'object' THEN RETURN false;END IF;
 RETURN value ?& required AND NOT EXISTS(SELECT 1 FROM jsonb_object_keys(value) k WHERE NOT k=ANY(allowed));
END;
$$;
CREATE FUNCTION anvil.fn02_text(value jsonb) RETURNS boolean LANGUAGE sql IMMUTABLE AS $$
 SELECT COALESCE(jsonb_typeof(value)='string' AND length(btrim(value#>>'{}',
  E' \t\r\n\f'||chr(11)||chr(160)||chr(5760)||chr(8192)||chr(8193)||chr(8194)||chr(8195)||chr(8196)||chr(8197)||chr(8198)||chr(8199)||chr(8200)||chr(8201)||chr(8202)||chr(8232)||chr(8233)||chr(8239)||chr(8287)||chr(12288)||chr(65279)))>0,false);
$$;
CREATE FUNCTION anvil.fn02_texts(value jsonb,nonempty boolean DEFAULT false) RETURNS boolean LANGUAGE plpgsql IMMUTABLE AS $$
BEGIN
 IF jsonb_typeof(value) IS DISTINCT FROM 'array' THEN RETURN false;END IF;
 RETURN NOT EXISTS(SELECT 1 FROM jsonb_array_elements(value) item
  WHERE jsonb_typeof(item)<>'string' OR (nonempty AND NOT anvil.fn02_text(item)));
END;
$$;
CREATE FUNCTION anvil.fn02_ref(value jsonb) RETURNS boolean LANGUAGE plpgsql IMMUTABLE AS $$
BEGIN
 RETURN COALESCE(anvil.fn02_keys(value,ARRAY['id','version','contentHash'],ARRAY['id','version','contentHash'])
  AND jsonb_typeof(value->'id')='string' AND value->>'id' ~ '^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$'
  AND jsonb_typeof(value->'version')='number' AND (value->>'version')::numeric BETWEEN 1 AND 9007199254740991
  AND trunc((value->>'version')::numeric)=(value->>'version')::numeric
  AND jsonb_typeof(value->'contentHash')='string' AND value->>'contentHash' ~ '^[0-9a-f]{64}$',false);
EXCEPTION WHEN OTHERS THEN RETURN false;
END;
$$;
CREATE FUNCTION anvil.fn02_condition_valid(value jsonb,graph jsonb) RETURNS boolean LANGUAGE plpgsql IMMUTABLE AS $$
DECLARE item jsonb;source jsonb;field text;op text;
BEGIN
 IF anvil.fn02_keys(value,ARRAY['all'],ARRAY['all']) OR anvil.fn02_keys(value,ARRAY['any'],ARRAY['any']) THEN
  item=COALESCE(value->'all',value->'any');
  IF jsonb_typeof(item) IS DISTINCT FROM 'array' OR jsonb_array_length(item)=0 THEN RETURN false;END IF;
  FOR source IN SELECT * FROM jsonb_array_elements(item) LOOP
   IF anvil.fn02_condition_valid(source,graph) IS NOT TRUE THEN RETURN false;END IF;
  END LOOP;
  RETURN true;
 END IF;
 IF anvil.fn02_keys(value,ARRAY['not'],ARRAY['not']) THEN RETURN anvil.fn02_condition_valid(value->'not',graph);END IF;
 IF NOT anvil.fn02_keys(value,ARRAY['fieldRef','operator','value'],ARRAY['fieldRef','operator','value'])
  OR NOT anvil.fn02_keys(value->'fieldRef',ARRAY['nodeId','field'],ARRAY['nodeId','field']) THEN RETURN false;END IF;
 field=value->'fieldRef'->>'field';op=value->>'operator';
 SELECT n INTO source FROM jsonb_array_elements(graph->'nodes') n WHERE n->'nodeId'=value->'fieldRef'->'nodeId';
 IF source IS NULL OR field NOT IN('REVIEW_OUTCOME','USER_DECISION') OR field IS NULL
  OR (field='USER_DECISION' AND (source->>'role'<>'USER' OR source->>'kind' NOT IN('HUMAN','DECISION'))) THEN RETURN false;END IF;
 IF op='IS_PRESENT' THEN RETURN value->'value'='null'::jsonb;END IF;
 IF op IN('EQ','NE') THEN item=jsonb_build_array(value->'value');
 ELSIF op='IN' AND jsonb_typeof(value->'value')='array' AND jsonb_array_length(value->'value')>0 THEN item=value->'value';
 ELSE RETURN false;END IF;
 RETURN NOT EXISTS(SELECT 1 FROM jsonb_array_elements(item) v WHERE NOT anvil.fn02_text(v)
  OR (field='REVIEW_OUTCOME' AND v#>>'{}' NOT IN('ACCEPTED','REWORK','BLOCKED')));
EXCEPTION WHEN OTHERS THEN RETURN false;
END;
$$;
CREATE FUNCTION anvil.fn02_graph_valid(graph jsonb) RETURNS boolean LANGUAGE plpgsql IMMUTABLE AS $$
DECLARE n jsonb;e jsonb;item jsonb;ids text[]='{}';edge_ids text[]='{}';item_ids text[];kind text;node_id text;required text[];
BEGIN
 IF octet_length(anvil.fn02_canonical(graph))>2097152
  OR NOT anvil.fn02_keys(graph,ARRAY['nodes','edges','entryNodeId','terminalNodeIds'],ARRAY['nodes','edges','entryNodeId','terminalNodeIds'])
  OR jsonb_typeof(graph->'nodes') IS DISTINCT FROM 'array' OR jsonb_array_length(graph->'nodes')=0
  OR jsonb_typeof(graph->'edges') IS DISTINCT FROM 'array' OR NOT anvil.fn02_texts(graph->'terminalNodeIds')
  OR jsonb_array_length(graph->'terminalNodeIds')=0 OR jsonb_typeof(graph->'entryNodeId') IS DISTINCT FROM 'string' THEN RETURN false;END IF;
 required=ARRAY['nodeId','name','purpose','kind','position','role','inputs','outputs','taskScope','completionCriteria','approvalBoundary','mode','limitPolicyRef','recordRequirements'];
 FOR n IN SELECT * FROM jsonb_array_elements(graph->'nodes') LOOP
  node_id=n->>'nodeId';kind=n->>'kind';item_ids='{}';
  IF NOT anvil.fn02_keys(n,required||ARRAY['requirements','joinRule'],required)
   OR NOT anvil.fn02_text(n->'nodeId') OR node_id=ANY(ids) OR NOT anvil.fn02_text(n->'name') OR NOT anvil.fn02_text(n->'purpose')
   OR COALESCE(kind IN('HUMAN','AGENT','DECISION','JOIN'),false)=false OR COALESCE(n->>'role' IN('USER','COORDINATOR','STAGE_OWNER'),false)=false
   OR COALESCE(n->>'mode' IN('AUTO','CASE_BY_CASE'),false)=false
   OR NOT anvil.fn02_keys(n->'position',ARRAY['x','y'],ARRAY['x','y'])
   OR jsonb_typeof(n->'position'->'x') IS DISTINCT FROM 'number' OR jsonb_typeof(n->'position'->'y') IS DISTINCT FROM 'number'
   OR NOT anvil.fn02_keys(n->'taskScope',ARRAY['included','excluded'],ARRAY['included','excluded'])
   OR NOT anvil.fn02_texts(n->'taskScope'->'included',true) OR jsonb_array_length(n->'taskScope'->'included')=0
   OR NOT anvil.fn02_texts(n->'taskScope'->'excluded') OR NOT anvil.fn02_texts(n->'completionCriteria',true) OR jsonb_array_length(n->'completionCriteria')=0
   OR NOT anvil.fn02_texts(n->'approvalBoundary') OR NOT anvil.fn02_texts(n->'recordRequirements',true) OR jsonb_array_length(n->'recordRequirements')=0
   OR (n->'limitPolicyRef'<>'null'::jsonb AND NOT anvil.fn02_ref(n->'limitPolicyRef'))
   OR jsonb_typeof(n->'inputs') IS DISTINCT FROM 'array' OR jsonb_typeof(n->'outputs') IS DISTINCT FROM 'array'
   OR (kind='HUMAN' AND n->>'role'<>'USER') OR (kind='AGENT' AND n->>'role'='USER') THEN RETURN false;END IF;
  ids=array_append(ids,node_id);
  IF n ? 'requirements' THEN
   IF NOT anvil.fn02_keys(n->'requirements',ARRAY['capabilities','environment'],ARRAY['capabilities','environment'])
    OR NOT anvil.fn02_texts(n->'requirements'->'capabilities') OR NOT anvil.fn02_texts(n->'requirements'->'environment') THEN RETURN false;END IF;
  END IF;
  IF kind='AGENT' AND (NOT n ? 'requirements' OR jsonb_array_length(n->'requirements'->'capabilities')=0 OR jsonb_array_length(n->'requirements'->'environment')=0) THEN RETURN false;END IF;
  IF n ? 'joinRule' THEN
   IF kind<>'JOIN' OR NOT anvil.fn02_keys(n->'joinRule',ARRAY['mode','condition'],ARRAY['mode'])
    OR COALESCE(n->'joinRule'->>'mode' IN('ALL','DECLARED_CONDITION'),false)=false
    OR (n->'joinRule' ? 'condition' AND anvil.fn02_condition_valid(n->'joinRule'->'condition',graph) IS NOT TRUE) THEN RETURN false;END IF;
  END IF;
  IF kind='JOIN' AND (NOT n ? 'joinRule' OR (n->'joinRule'->>'mode'='DECLARED_CONDITION' AND NOT n->'joinRule' ? 'condition')) THEN RETURN false;END IF;
  FOR item IN SELECT * FROM jsonb_array_elements((n->'inputs')||(n->'outputs')) LOOP
   IF NOT anvil.fn02_keys(item,ARRAY['itemId','formRef','required','sourceNodeId','reviewCriteria'],ARRAY['itemId','formRef','required','reviewCriteria'])
    OR NOT anvil.fn02_text(item->'itemId') OR item->>'itemId'=ANY(item_ids) OR NOT anvil.fn02_ref(item->'formRef')
    OR jsonb_typeof(item->'required') IS DISTINCT FROM 'boolean' OR NOT anvil.fn02_texts(item->'reviewCriteria',true)
    OR jsonb_array_length(item->'reviewCriteria')=0 OR (item ? 'sourceNodeId' AND jsonb_typeof(item->'sourceNodeId')<>'string') THEN RETURN false;END IF;
   item_ids=array_append(item_ids,item->>'itemId');
  END LOOP;
 END LOOP;
 IF NOT graph->>'entryNodeId'=ANY(ids) OR EXISTS(SELECT 1 FROM jsonb_array_elements_text(graph->'terminalNodeIds') id WHERE NOT id=ANY(ids))
  OR (SELECT count(*)<>count(DISTINCT id) FROM jsonb_array_elements_text(graph->'terminalNodeIds') id) THEN RETURN false;END IF;
 FOR e IN SELECT * FROM jsonb_array_elements(graph->'edges') LOOP
  IF NOT anvil.fn02_keys(e,ARRAY['edgeId','fromNodeId','toNodeId','kind','condition','reason','retryPolicy'],ARRAY['edgeId','fromNodeId','toNodeId','kind','condition','reason'])
   OR NOT anvil.fn02_text(e->'edgeId') OR e->>'edgeId'=ANY(edge_ids)
   OR jsonb_typeof(e->'fromNodeId') IS DISTINCT FROM 'string' OR NOT e->>'fromNodeId'=ANY(ids)
   OR jsonb_typeof(e->'toNodeId') IS DISTINCT FROM 'string' OR NOT e->>'toNodeId'=ANY(ids)
   OR COALESCE(e->>'kind' IN('SEQUENCE','BRANCH','JOIN','REWORK'),false)=false OR jsonb_typeof(e->'reason') IS DISTINCT FROM 'string'
   OR (e->'condition'<>'null'::jsonb AND anvil.fn02_condition_valid(e->'condition',graph) IS NOT TRUE) THEN RETURN false;END IF;
  edge_ids=array_append(edge_ids,e->>'edgeId');
  IF e->>'kind'='REWORK' THEN
   IF e->'condition'='null'::jsonb OR NOT anvil.fn02_text(e->'reason')
    OR NOT anvil.fn02_keys(e->'retryPolicy',ARRAY['maxAttempts','onExhausted','counting'],ARRAY['maxAttempts','onExhausted','counting'])
    OR jsonb_typeof(e->'retryPolicy'->'maxAttempts') IS DISTINCT FROM 'number'
    OR (e->'retryPolicy'->>'maxAttempts')::numeric<1 OR trunc((e->'retryPolicy'->>'maxAttempts')::numeric)<>(e->'retryPolicy'->>'maxAttempts')::numeric
    OR e->'retryPolicy'->>'onExhausted' IS DISTINCT FROM 'USER_DECISION' OR e->'retryPolicy'->>'counting' IS DISTINCT FROM 'SAME_FAILURE_FINGERPRINT' THEN RETURN false;END IF;
  ELSIF e ? 'retryPolicy' OR (e->>'kind'='BRANCH' AND e->'condition'='null'::jsonb) THEN RETURN false;END IF;
 END LOOP;
 -- 정상 edge만의 유한 closure. UNION이 방문 쌍을 중복 제거하므로 cycle 입력도 종료한다.
 IF EXISTS(WITH RECURSIVE reach(f,t) AS (
  SELECT edge_row.value->>'fromNodeId',edge_row.value->>'toNodeId' FROM jsonb_array_elements(graph->'edges') edge_row(value) WHERE edge_row.value->>'kind'<>'REWORK'
  UNION SELECT r.f,edge_row.value->>'toNodeId' FROM reach r JOIN jsonb_array_elements(graph->'edges') edge_row(value)
   ON edge_row.value->>'fromNodeId'=r.t AND edge_row.value->>'kind'<>'REWORK') SELECT 1 FROM reach WHERE f=t) THEN RETURN false;END IF;
 FOR n IN SELECT * FROM jsonb_array_elements(graph->'nodes') LOOP
  node_id=n->>'nodeId';
  IF node_id<>graph->>'entryNodeId' AND NOT EXISTS(WITH RECURSIVE reach(id) AS (
   SELECT graph->>'entryNodeId' UNION SELECT edge_row.value->>'toNodeId' FROM reach r JOIN jsonb_array_elements(graph->'edges') edge_row(value)
    ON edge_row.value->>'fromNodeId'=r.id AND edge_row.value->>'kind'<>'REWORK') SELECT 1 FROM reach WHERE id=node_id) THEN RETURN false;END IF;
  IF (n->>'kind'='JOIN' AND (SELECT count(*) FROM jsonb_array_elements(graph->'edges') edge_row(value) WHERE edge_row.value->>'toNodeId'=node_id AND edge_row.value->>'kind'<>'REWORK')<2)
   OR ((graph->'terminalNodeIds') ? node_id)=EXISTS(SELECT 1 FROM jsonb_array_elements(graph->'edges') edge_row(value) WHERE edge_row.value->>'fromNodeId'=node_id AND edge_row.value->>'kind'<>'REWORK') THEN RETURN false;END IF;
  FOR item IN SELECT * FROM jsonb_array_elements(n->'inputs') LOOP
   IF item ? 'sourceNodeId' AND item->>'sourceNodeId'<>'' THEN
    IF item->>'sourceNodeId'=node_id OR NOT EXISTS(WITH RECURSIVE reach(id) AS (
     SELECT item->>'sourceNodeId' WHERE item->>'sourceNodeId'=ANY(ids)
     UNION SELECT edge_row.value->>'toNodeId' FROM reach r JOIN jsonb_array_elements(graph->'edges') edge_row(value) ON edge_row.value->>'fromNodeId'=r.id AND edge_row.value->>'kind'<>'REWORK')
     SELECT 1 FROM reach WHERE id=node_id) THEN RETURN false;END IF;
   END IF;
  END LOOP;
  IF EXISTS(SELECT 1 FROM jsonb_array_elements((n->'inputs')||(n->'outputs')) doc_row(value)
   WHERE COALESCE(doc_row.value->>'sourceNodeId','')<>'' AND NOT doc_row.value->>'sourceNodeId'=ANY(ids)) THEN RETURN false;END IF;
 END LOOP;
 RETURN true;
EXCEPTION WHEN OTHERS THEN RETURN false;
END;
$$;
CREATE FUNCTION anvil.fn02_accepted_items(items jsonb) RETURNS boolean LANGUAGE plpgsql IMMUTABLE AS $$
DECLARE item jsonb;seen text[]='{}';expected text[]=ARRAY['METHOD_PURPOSE_SCOPE','METHOD_FLOW_CONTROL','METHOD_INPUT_OUTPUT','METHOD_COMPLETION_APPROVAL','METHOD_RECORD_LIMITS'];
BEGIN
 IF jsonb_typeof(items) IS DISTINCT FROM 'array' OR jsonb_array_length(items)<>5 THEN RETURN false;END IF;
 FOR item IN SELECT * FROM jsonb_array_elements(items) LOOP
  IF NOT anvil.fn02_keys(item,ARRAY['criterionId','outcome','evidenceRefs','reason'],ARRAY['criterionId','outcome','evidenceRefs','reason'])
   OR COALESCE(item->>'criterionId'=ANY(expected),false)=false OR item->>'criterionId'=ANY(seen)
   OR item->>'outcome' IS DISTINCT FROM 'ACCEPTED' OR item->'evidenceRefs' IS DISTINCT FROM '[]'::jsonb
   OR NOT anvil.fn02_text(item->'reason') OR anvil.fn02_js_length(item->>'reason')>20000 THEN RETURN false;END IF;
  seen=array_append(seen,item->>'criterionId');
 END LOOP;
 RETURN true;
EXCEPTION WHEN OTHERS THEN RETURN false;
END;
$$;

CREATE FUNCTION anvil.fn02_lock_project(pid uuid) RETURNS void LANGUAGE plpgsql VOLATILE AS $$
BEGIN
 -- RR의 과거 snapshot을 잠금 뒤 최신 상태로 간주하지 않는다. 기존 앱은 BEGIN을 사용한다.
 -- 실제 DB 기본 isolation 관측과 비기본 isolation 거절/기존 정상 흐름 회귀는 별도 검수한다.
 IF current_setting('transaction_isolation')<>'read committed' THEN
  RAISE EXCEPTION 'FN02_READ_COMMITTED_REQUIRED' USING ERRCODE='40001';
 END IF;
 PERFORM 1 FROM anvil.projects WHERE id=pid FOR UPDATE;
 IF NOT FOUND THEN RAISE EXCEPTION 'FN02_PROJECT_REQUIRED' USING ERRCODE='42501';END IF;
END;
$$;
CREATE FUNCTION anvil.fn02_history_empty(pid uuid) RETURNS boolean LANGUAGE sql VOLATILE AS $$
 SELECT NOT (
  EXISTS(SELECT 1 FROM anvil.assignment_drafts WHERE project_id=pid)
  OR EXISTS(SELECT 1 FROM anvil.execution_preparations WHERE project_id=pid)
  OR EXISTS(SELECT 1 FROM anvil.agent_sessions WHERE project_id=pid)
  OR EXISTS(SELECT 1 FROM anvil.executions WHERE project_id=pid)
  OR EXISTS(SELECT 1 FROM anvil.execution_grants WHERE project_id=pid)
  OR EXISTS(SELECT 1 FROM anvil.writer_claims WHERE project_id=pid)
  OR EXISTS(SELECT 1 FROM anvil.execution_commands WHERE project_id=pid));
$$;
CREATE FUNCTION anvil.fn02_is_apply_command() RETURNS boolean LANGUAGE sql VOLATILE AS $$
 SELECT EXISTS(SELECT 1 FROM anvil.commands c WHERE c.id::text=current_setting('anvil.command_id',true)
  AND c.operation='applyMethodology');
$$;
CREATE FUNCTION anvil.fn02_lock_insert() RETURNS trigger LANGUAGE plpgsql AS $$
BEGIN
 IF current_user<>'anvil_v3_app' THEN RETURN NEW;END IF;
 PERFORM anvil.fn02_lock_project(NEW.project_id);
 IF TG_TABLE_NAME='project_methodologies' THEN
  IF anvil.fn02_is_apply_command() THEN
   IF NEW.application_command_id IS NOT NULL AND NEW.application_command_id::text IS DISTINCT FROM current_setting('anvil.command_id',true) THEN
    RAISE EXCEPTION 'FN02_APPLICATION_COMMAND_MISMATCH' USING ERRCODE='42501';
   END IF;
   NEW.application_command_id=current_setting('anvil.command_id',true)::uuid;
  ELSIF NEW.application_command_id IS NOT NULL THEN
   RAISE EXCEPTION 'FN02_APPLICATION_COMMAND_MISMATCH' USING ERRCODE='42501';
  END IF;
 END IF;
 RETURN NEW;
END;
$$;
CREATE TRIGGER aa_fn02_project_lock BEFORE INSERT ON anvil.project_methodologies
 FOR EACH ROW EXECUTE FUNCTION anvil.fn02_lock_insert();
DO $$
DECLARE table_name text;
BEGIN
 FOREACH table_name IN ARRAY ARRAY['assignment_drafts','execution_preparations','agent_sessions',
  'executions','execution_grants','writer_claims','execution_commands'] LOOP
  EXECUTE format('CREATE TRIGGER aa_fn02_project_lock BEFORE INSERT ON anvil.%I FOR EACH ROW EXECUTE FUNCTION anvil.fn02_lock_insert()',table_name);
 END LOOP;
END;
$$;

-- apply 명령인지에 따라 분기하되 기존 초기 guard 함수 자체와 조건은 그대로 소비한다.
DROP TRIGGER initial_project_methodology_guard ON anvil.project_methodologies;
CREATE TRIGGER initial_project_methodology_guard BEFORE INSERT ON anvil.project_methodologies
 FOR EACH ROW WHEN (NOT anvil.fn02_is_apply_command())
 EXECUTE FUNCTION anvil.guard_initial_project_methodology();

CREATE FUNCTION anvil.fn02_assert_application(pid uuid,aid uuid,cid uuid,check_head boolean) RETURNS void
 LANGUAGE plpgsql VOLATILE AS $$
DECLARE a anvil.project_methodologies%ROWTYPE;previous anvil.project_methodologies%ROWTYPE;
 cmd anvil.commands%ROWTYPE;ar anvil.authorization_receipts%ROWTYPE;pv anvil.permission_policy_versions%ROWTYPE;
 mv anvil.methodology_versions%ROWTYPE;confirmed anvil.methodology_reviews%ROWTYPE;latest anvil.content_reviews%ROWTYPE;
 f record;form_ref jsonb;method_ref jsonb;application_ref jsonb;previous_ref jsonb;payload jsonb;request jsonb;scope_hash text;reason text;
BEGIN
 PERFORM anvil.fn02_lock_project(pid);
 -- VOLATILE 함수의 별도 SQL로 lock 대기 후 조회한다. statement 이전 부재 응답을 재사용하지 않는다.
 IF NOT anvil.fn02_history_empty(pid) THEN RAISE EXCEPTION 'EXECUTION_STATE_UNVERIFIED' USING ERRCODE='42501';END IF;
 SELECT * INTO a FROM anvil.project_methodologies WHERE project_id=pid AND id=aid;
 SELECT * INTO cmd FROM anvil.commands WHERE id=cid;
 IF a.id IS NULL OR cmd.id IS NULL OR a.application_command_id IS DISTINCT FROM cmd.id
  OR cmd.scope_kind<>'PROJECT' OR cmd.scope_id IS DISTINCT FROM pid OR cmd.project_id IS DISTINCT FROM pid
  OR cmd.operation<>'applyMethodology' OR cmd.state<>'APPLIED' OR cmd.actor_id IS DISTINCT FROM a.created_by
  OR cmd.expected_version<0 OR cmd.expected_version>=9007199254740991 OR a.application_version<>cmd.expected_version+1
  OR cmd.approval_consumption_id IS NOT NULL OR cmd.payload_ref IS NOT NULL OR cmd.completed_at IS NULL THEN
  RAISE EXCEPTION 'FN02_APPLICATION_COMMAND_REQUIRED' USING ERRCODE='42501';
 END IF;
 IF cmd.actor_id::text IS DISTINCT FROM current_setting('anvil.actor_id',true)
  OR cmd.client_id::text IS DISTINCT FROM current_setting('anvil.client_id',true)
  OR NOT EXISTS(SELECT 1 FROM anvil.project_control pc JOIN anvil.projects p ON p.id=pc.project_id
   JOIN anvil.project_members m ON m.project_id=pc.project_id AND m.user_id=pc.actor_id
   WHERE pc.project_id=pid AND pc.actor_id=cmd.actor_id AND pc.client_id=cmd.client_id AND pc.generation=cmd.control_generation
    AND pc.revoked_at IS NULL AND p.archived_at IS NULL AND m.revoked_at IS NULL AND m.participation='OWNER')
  OR NOT EXISTS(SELECT 1 FROM anvil.auth_sessions s JOIN anvil.users u ON u.id=s.user_id
   JOIN anvil.clients cl ON cl.id=s.client_id AND cl.user_id=s.user_id
   WHERE s.user_id=cmd.actor_id AND s.client_id=cmd.client_id AND s.revoked_at IS NULL AND u.status='ACTIVE'
    AND u.revoked_at IS NULL AND cl.revoked_at IS NULL AND s.credential_generation=u.credential_generation
    AND s.idle_expires_at>clock_timestamp() AND s.absolute_expires_at>clock_timestamp()) THEN
  RAISE EXCEPTION 'FN02_CURRENT_OWNER_REQUIRED' USING ERRCODE='42501';
 END IF;
 SELECT v.* INTO pv FROM anvil.permission_policies p JOIN anvil.permission_policy_versions v
  ON v.project_id=p.project_id AND v.policy_id=p.id AND v.version=p.head_version
  WHERE p.project_id=pid AND p.id::text=cmd.policy_ref->>'id' AND p.head_version::text=cmd.policy_ref->>'version'
   AND v.content_hash=cmd.policy_ref->>'contentHash' FOR SHARE OF p;
 IF pv.policy_id IS NULL OR anvil.fn02_hash(jsonb_build_object('rules',pv.rules_json,'reason',pv.reason,'reviewRefs',pv.review_refs)) IS DISTINCT FROM pv.content_hash
  OR NOT EXISTS(SELECT 1 FROM jsonb_array_elements(pv.rules_json) rule
   WHERE rule->'subjectRef'=jsonb_build_object('kind','HUMAN','userId',cmd.actor_id)
    AND rule->'targetScopes'=jsonb_build_array(jsonb_build_object('kind','PROJECT','projectId',pid))
    AND (rule->'operations') ? 'applyMethodology' AND rule->>'disposition'='AUTO' AND (rule->>'expiresAt')::timestamptz>clock_timestamp())
  OR EXISTS(SELECT 1 FROM jsonb_array_elements(pv.rules_json) rule
   WHERE rule->'subjectRef'=jsonb_build_object('kind','HUMAN','userId',cmd.actor_id)
    AND rule->'targetScopes'=jsonb_build_array(jsonb_build_object('kind','PROJECT','projectId',pid))
    AND (rule->'operations') ? 'applyMethodology' AND rule->>'disposition' IN('DENY','REQUIRE_APPROVAL') AND (rule->>'expiresAt')::timestamptz>clock_timestamp()) THEN
  RAISE EXCEPTION 'FN02_EXPLICIT_POLICY_REQUIRED' USING ERRCODE='42501';
 END IF;
 SELECT v.* INTO mv FROM anvil.methodology_definitions d JOIN anvil.methodology_versions v
  ON v.definition_id=d.id AND v.version=d.head_version WHERE d.id=a.source_definition_id AND d.scope='PROJECT'
   AND d.project_id=pid AND v.version=a.source_version AND v.content_hash=a.source_hash FOR UPDATE OF d;
 method_ref=jsonb_build_object('id',a.source_definition_id,'version',a.source_version,'contentHash',a.source_hash);
 application_ref=jsonb_build_object('id',a.id,'version',a.application_version,'contentHash',a.snapshot_hash);
 IF mv.definition_id IS NULL OR anvil.fn02_graph_valid(mv.graph_json) IS NOT TRUE OR anvil.fn02_hash(mv.graph_json) IS DISTINCT FROM a.source_hash
  OR a.snapshot_json IS DISTINCT FROM jsonb_build_object('name',mv.name,'purpose',mv.purpose,'graph',mv.graph_json,'sourceRef',method_ref)
  OR anvil.fn02_hash(a.snapshot_json) IS DISTINCT FROM a.snapshot_hash THEN
  RAISE EXCEPTION 'FN02_APPLICATION_SNAPSHOT_REQUIRED' USING ERRCODE='42501';
 END IF;
 SELECT * INTO previous FROM anvil.project_methodologies WHERE project_id=pid
  AND application_version<a.application_version ORDER BY application_version DESC LIMIT 1;
 previous_ref=CASE WHEN previous.id IS NULL THEN 'null'::jsonb ELSE
  jsonb_build_object('id',previous.id,'version',previous.application_version,'contentHash',previous.snapshot_hash) END;
 IF COALESCE(previous.application_version,0)<>cmd.expected_version
  OR (previous.id IS NOT NULL AND (anvil.fn02_hash(previous.snapshot_json) IS DISTINCT FROM previous.snapshot_hash
   OR previous.snapshot_json->'sourceRef'=method_ref))
  OR (check_head AND EXISTS(SELECT 1 FROM anvil.project_methodologies WHERE project_id=pid AND application_version>a.application_version)) THEN
  RAISE EXCEPTION 'FN02_APPLICATION_VERSION_CONFLICT' USING ERRCODE='40001';
 END IF;
 -- 확정은 논리 구조 검사 결과와 별도 내용 검토/영수증이 결박되어 있어야 한다.
 SELECT r.* INTO latest FROM anvil.content_reviews r JOIN anvil.audit_events e
  ON e.project_id=r.project_id AND e.command_id=r.command_id
  WHERE r.scope_kind='PROJECT' AND r.project_id=pid AND r.target_kind='METHODOLOGY'
   AND r.target_id=mv.definition_id AND r.target_version=mv.version AND r.target_hash=mv.content_hash
   AND r.criteria_version=1 ORDER BY e.server_sequence DESC LIMIT 1;
 SELECT r.* INTO confirmed FROM anvil.methodology_reviews r JOIN anvil.commands c ON c.id=r.command_id
  JOIN anvil.audit_events e ON e.command_id=c.id AND e.project_id=c.project_id
  WHERE r.project_id=pid AND r.definition_id=mv.definition_id AND r.version=mv.version AND r.target_hash=mv.content_hash
   AND r.decision='CONFIRMED' AND c.operation='confirmMethodology' AND c.state='APPLIED'
   AND c.result_ref->'data'->>'confirmationId'=r.id::text AND c.result_ref->'data'->'reviewRefs'=r.review_refs
   AND c.result_ref->'data'->'validation'=r.validation_json ORDER BY e.server_sequence DESC LIMIT 1;
 IF latest.id IS NULL OR latest.outcome<>'ACCEPTED' OR latest.source_kind<>'HUMAN_REVIEW'
  OR anvil.fn02_accepted_items(latest.items_json) IS NOT TRUE
  OR latest.criteria_snapshot_json IS DISTINCT FROM anvil.fn02_method_criteria()
  OR NOT EXISTS(SELECT 1 FROM anvil.commands c JOIN anvil.authorization_receipts r
   ON r.id=c.authorization_receipt_id AND r.command_id=c.id AND r.scope_kind='PROJECT' AND r.scope_id=pid
   WHERE c.id=latest.command_id AND c.project_id=pid AND c.operation='recordContentReview' AND c.state='APPLIED'
    AND c.actor_id=latest.reviewer_user_id AND c.client_id=latest.client_id
    AND c.result_ref->'data'->'ref'=method_ref AND c.result_ref->'data'->'reviewRef'=jsonb_build_object('id',latest.id,'criteriaVersion',1,'targetRef',method_ref,'outcome','ACCEPTED')
    AND c.result_ref->'data'->'review'=jsonb_build_object('targetKind','METHODOLOGY','targetRef',method_ref,
     'criteriaVersion',1,'items',latest.items_json,'outcome','ACCEPTED','reason',latest.reason)
    AND r.subject_ref=jsonb_build_object('kind','HUMAN','userId',c.actor_id,'clientId',c.client_id))
  OR confirmed.id IS NULL OR confirmed.validation_json->'validForConfirmation' IS DISTINCT FROM 'true'::jsonb
  OR NOT confirmed.review_refs @> jsonb_build_array(jsonb_build_object('id',latest.id,'criteriaVersion',1,'targetRef',method_ref,'outcome','ACCEPTED')) THEN
  RAISE EXCEPTION 'FN02_CONFIRMED_REVIEW_REQUIRED' USING ERRCODE='42501';
 END IF;
 FOR form_ref IN SELECT DISTINCT item->'formRef' FROM jsonb_array_elements(mv.graph_json->'nodes') node
  CROSS JOIN LATERAL jsonb_array_elements((node->'inputs')||(node->'outputs')) item LOOP
  SELECT d.scope,v.definition_json,v.content_hash,v.origin_ref_json INTO f FROM anvil.form_definitions d
   JOIN anvil.form_versions v ON v.definition_id=d.id AND v.version=(form_ref->>'version')::bigint
   WHERE d.id::text=form_ref->>'id' AND (d.scope='SYSTEM' OR d.scope='USER_COMMON' AND d.owner_user_id=cmd.actor_id) FOR SHARE OF d;
  IF NOT FOUND OR f.content_hash IS DISTINCT FROM form_ref->>'contentHash'
   OR anvil.fn02_hash(f.definition_json) IS DISTINCT FROM f.content_hash THEN
   RAISE EXCEPTION 'FN02_PREPARED_FORM_REQUIRED' USING ERRCODE='42501';
  END IF;
  IF f.scope='SYSTEM' THEN
   IF f.origin_ref_json->>'kind' IS DISTINCT FROM 'P01_APPROVED_SOURCE'
    OR f.origin_ref_json->>'sourceHash' IS DISTINCT FROM '622ffc6db4ccc26ae07c785c91b114467019b21571b728a71dea05d206816b13'
    OR f.origin_ref_json->'productAcceptance' IS DISTINCT FROM 'false'::jsonb THEN
    RAISE EXCEPTION 'FN02_PREPARED_FORM_REQUIRED' USING ERRCODE='42501';
   END IF;
  ELSE
   IF NOT EXISTS(SELECT 1 FROM anvil.form_reviews r JOIN anvil.commands c ON c.id=r.command_id
    WHERE r.definition_id::text=form_ref->>'id' AND r.version=(form_ref->>'version')::bigint AND r.target_hash=form_ref->>'contentHash'
     AND r.decision='CONFIRMED' AND c.scope_kind='USER_COMMON' AND c.scope_id=cmd.actor_id)
    OR (SELECT r.outcome FROM anvil.content_reviews r JOIN anvil.user_common_audit_events e
     ON e.owner_user_id=r.scope_id AND e.command_id=r.command_id WHERE r.scope_kind='USER_COMMON' AND r.scope_id=cmd.actor_id
      AND r.target_kind='FORM' AND r.target_id::text=form_ref->>'id' AND r.target_version=(form_ref->>'version')::bigint
      AND r.target_hash=form_ref->>'contentHash' AND r.criteria_version=1 ORDER BY e.server_sequence DESC LIMIT 1) IS DISTINCT FROM 'ACCEPTED' THEN
    RAISE EXCEPTION 'FN02_PREPARED_FORM_REQUIRED' USING ERRCODE='42501';
   END IF;
  END IF;
 END LOOP;
 reason=cmd.result_ref->'data'->>'reason';
 IF NOT anvil.fn02_text(to_jsonb(reason)) OR anvil.fn02_js_length(reason)>20000 THEN
  RAISE EXCEPTION 'FN02_APPLICATION_REASON_REQUIRED' USING ERRCODE='42501';
 END IF;
 payload=jsonb_build_object('methodologyRef',method_ref,'expectedApplicationVersion',cmd.expected_version,'reason',reason);
 request=jsonb_build_object('schemaVersion',1,'projectId',pid,'commandId',cmd.command_id,'clientId',cmd.client_id,
  'controlGeneration',cmd.control_generation,'operation','applyMethodology','targetId',pid,'expectedVersion',cmd.expected_version,
  'baselineRefs','[]'::jsonb,'approvalRef','null'::jsonb,'payload',payload);
 scope_hash=anvil.fn02_hash(jsonb_build_object('projectId',pid,'actorId',cmd.actor_id,'clientId',cmd.client_id,
  'controlGeneration',cmd.control_generation,'requestHash',cmd.request_hash,'policyRef',cmd.policy_ref,'targetRef',application_ref));
 SELECT * INTO ar FROM anvil.authorization_receipts WHERE id=cmd.authorization_receipt_id AND command_id=cmd.id;
 IF cmd.request_hash IS DISTINCT FROM anvil.fn02_hash(request)
  OR cmd.result_ref->'data' IS DISTINCT FROM jsonb_build_object('ref',application_ref,'status','METHODOLOGY_APPLIED',
   'snapshot',a.snapshot_json,'reason',reason,'previousApplicationRef',previous_ref)
  OR cmd.result_ref->>'status' IS DISTINCT FROM 'APPLIED' OR cmd.result_ref->>'commandId' IS DISTINCT FROM cmd.command_id::text
  OR cmd.result_ref->>'operationId' IS DISTINCT FROM cmd.operation_id::text OR cmd.result_ref->>'projectId' IS DISTINCT FROM pid::text
  OR cmd.result_ref->>'targetId' IS DISTINCT FROM aid::text OR cmd.result_ref->'version' IS DISTINCT FROM to_jsonb(a.application_version)
  OR ar.id IS NULL OR ar.scope_kind<>'PROJECT' OR ar.scope_id IS DISTINCT FROM pid OR ar.policy_ref IS DISTINCT FROM cmd.policy_ref
  OR ar.subject_ref IS DISTINCT FROM jsonb_build_object('kind','HUMAN','userId',cmd.actor_id,'clientId',cmd.client_id)
  OR ar.scope_digest IS DISTINCT FROM scope_hash OR ar.approval_decision_ref IS NOT NULL
  OR NOT EXISTS(SELECT 1 FROM anvil.audit_events e WHERE e.project_id=pid AND e.command_id=cmd.id AND e.operation_id=cmd.operation_id
   AND e.actor_ref=jsonb_build_object('kind','HUMAN','userId',cmd.actor_id) AND e.client_ref=cmd.client_id
   AND e.target_ref=application_ref AND e.policy_ref=cmd.policy_ref AND e.approval_ref IS NULL AND e.outcome='APPLIED'
   AND e.reason_code='EXPLICIT_EMPTY_PROJECT_METHODOLOGY_APPLICATION' AND e.source_kind='HUMAN_COMMAND' AND e.scope_digest=scope_hash) THEN
  RAISE EXCEPTION 'FN02_APPLICATION_RECEIPT_MISMATCH' USING ERRCODE='42501';
 END IF;
END;
$$;
CREATE FUNCTION anvil.fn02_application_guard() RETURNS trigger LANGUAGE plpgsql AS $$
DECLARE cmd anvil.commands%ROWTYPE;
BEGIN
 IF current_user<>'anvil_v3_app' THEN RETURN NEW;END IF;
 IF NEW.application_command_id IS NULL THEN RETURN NEW;END IF;
 SELECT * INTO cmd FROM anvil.commands WHERE id=NEW.application_command_id;
 PERFORM anvil.fn02_assert_application(NEW.project_id,NEW.id,cmd.id,true);
 RETURN NEW;
END;
$$;
CREATE TRIGGER fn02_application_guard AFTER INSERT ON anvil.project_methodologies
 FOR EACH ROW EXECUTE FUNCTION anvil.fn02_application_guard();
CREATE FUNCTION anvil.fn02_application_complete() RETURNS trigger LANGUAGE plpgsql AS $$
DECLARE cmd anvil.commands%ROWTYPE;application_id uuid;n bigint;
BEGIN
 IF current_user<>'anvil_v3_app' THEN RETURN NEW;END IF;
 IF TG_TABLE_NAME='commands' THEN
  SELECT * INTO cmd FROM anvil.commands WHERE id=NEW.id;
  IF NEW.operation<>'applyMethodology' THEN RETURN NEW;END IF;
 ELSE
  IF NEW.application_command_id IS NULL THEN RETURN NEW;END IF;
  SELECT * INTO cmd FROM anvil.commands WHERE id=NEW.application_command_id;
 END IF;
 SELECT count(*),min(id::text)::uuid INTO n,application_id FROM anvil.project_methodologies WHERE application_command_id=cmd.id;
 IF n<>1 OR cmd.id IS NULL THEN RAISE EXCEPTION 'FN02_APPLICATION_COMMIT_INCOMPLETE' USING ERRCODE='42501';END IF;
 PERFORM anvil.fn02_assert_application(cmd.project_id,application_id,cmd.id,false);
 RETURN NEW;
END;
$$;
CREATE CONSTRAINT TRIGGER fn02_application_complete AFTER INSERT ON anvil.project_methodologies
 DEFERRABLE INITIALLY DEFERRED FOR EACH ROW EXECUTE FUNCTION anvil.fn02_application_complete();
CREATE CONSTRAINT TRIGGER fn02_command_complete AFTER INSERT ON anvil.commands
 DEFERRABLE INITIALLY DEFERRED FOR EACH ROW EXECUTE FUNCTION anvil.fn02_application_complete();
CREATE FUNCTION anvil.fn02_command_immutable() RETURNS trigger LANGUAGE plpgsql AS $$
BEGIN
 IF current_user='anvil_v3_app' AND (OLD.operation='applyMethodology' OR (TG_OP='UPDATE' AND NEW.operation='applyMethodology')) THEN
  RAISE EXCEPTION 'FN02_APPLICATION_COMMAND_IMMUTABLE' USING ERRCODE='42501';
 END IF;
 IF TG_OP='DELETE' THEN RETURN OLD;END IF;RETURN NEW;
END;
$$;
CREATE TRIGGER fn02_command_immutable BEFORE UPDATE OR DELETE ON anvil.commands
 FOR EACH ROW EXECUTE FUNCTION anvil.fn02_command_immutable();
