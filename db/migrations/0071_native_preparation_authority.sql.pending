-- FN06 native 준비 r2 A. 미적용 source; 실제 권한/정책/공급자 활성화 없음.
BEGIN;
CREATE TABLE anvil.native_preparation_authorities(
 project_id uuid NOT NULL REFERENCES anvil.projects(id),id uuid NOT NULL,version bigint NOT NULL CHECK(version=1),content_hash text NOT NULL CHECK(content_hash~'^[0-9a-f]{64}$'),snapshot_json jsonb NOT NULL,
 intent_id uuid NOT NULL,intent_hash text NOT NULL CHECK(intent_hash~'^[0-9a-f]{64}$'),intent_json jsonb NOT NULL,credential_digest text NOT NULL CHECK(credential_digest~'^[0-9a-f]{64}$'),
 server_command_id uuid NOT NULL,lease_id uuid NOT NULL,canonical_bytes bigint NOT NULL CHECK(canonical_bytes BETWEEN 1 AND 4194304),
 PRIMARY KEY(project_id,id,version),UNIQUE(project_id,id),UNIQUE(project_id,intent_id),UNIQUE(project_id,server_command_id),UNIQUE(project_id,lease_id),
 FOREIGN KEY(project_id,server_command_id) REFERENCES anvil.commands(project_id,id) DEFERRABLE INITIALLY DEFERRED
);
CREATE TABLE anvil.native_preparation_authority_events(
 project_id uuid NOT NULL,id uuid NOT NULL,version bigint NOT NULL CHECK(version=1),authority_id uuid NOT NULL,project_sequence bigint NOT NULL CHECK(project_sequence BETWEEN 1 AND 9007199254740991),sequence bigint NOT NULL CHECK(sequence BETWEEN 1 AND 16),
 previous_ref jsonb NOT NULL,content_hash text NOT NULL CHECK(content_hash~'^[0-9a-f]{64}$'),snapshot_json jsonb NOT NULL,canonical_bytes bigint NOT NULL CHECK(canonical_bytes BETWEEN 1 AND 4194304),
 kind text GENERATED ALWAYS AS(snapshot_json->>'kind') STORED,
 PRIMARY KEY(project_id,id,version),UNIQUE(project_id,project_sequence),UNIQUE(project_id,authority_id,sequence),UNIQUE(project_id,authority_id,id,version,content_hash),
 FOREIGN KEY(project_id,authority_id) REFERENCES anvil.native_preparation_authorities(project_id,id) DEFERRABLE INITIALLY DEFERRED,
 CHECK(kind IN('AUTHORITY_CREATED','DELIVERY_ATTEMPTED','DELIVERY_CONFIRMED','DELIVERY_UNCONFIRMED','CHALLENGE_ISSUED','REQUEST_PROOF_ACCEPTED','CONSUME_COMMITTED','CONTEXT_INVALIDATED'))
);
CREATE UNIQUE INDEX native_authority_single_events ON anvil.native_preparation_authority_events(project_id,authority_id,kind) WHERE kind IN('AUTHORITY_CREATED','DELIVERY_ATTEMPTED','CHALLENGE_ISSUED','REQUEST_PROOF_ACCEPTED','CONSUME_COMMITTED');
CREATE FUNCTION anvil.native_preparation_json_bytes(v jsonb) RETURNS bigint LANGUAGE sql IMMUTABLE STRICT SET search_path=pg_catalog AS $$ SELECT octet_length(convert_to(anvil.execution_authority_canonical(v),'UTF8'))::bigint;$$;
CREATE UNIQUE INDEX native_delivery_single_outcome ON anvil.native_preparation_authority_events(project_id,authority_id) WHERE kind IN('DELIVERY_CONFIRMED','DELIVERY_UNCONFIRMED');
-- 고정 역사 검산이다. 현재 head/정책/사업 기한을 과거 소비에 소급하지 않는다.
CREATE FUNCTION anvil.native_preparation_event_history_valid(p uuid,a uuid) RETURNS boolean LANGUAGE plpgsql SECURITY DEFINER SET search_path=pg_catalog AS $$
DECLARE g jsonb;e anvil.native_preparation_authority_events;previous jsonb='null'::jsonb;n bigint=0;last_at timestamptz;v jsonb;k text;host_actor jsonb;server_actor jsonb;challenge jsonb;challenge_ref jsonb;proof jsonb;proof_ref jsonb;proof_expiry timestamptz;consumed jsonb;receipt jsonb;delivery jsonb;outcome boolean=false;expected jsonb;
BEGIN
 SELECT snapshot_json INTO g FROM anvil.native_preparation_authorities WHERE project_id=p AND id=a;IF g IS NULL THEN RETURN false;END IF;
 host_actor=jsonb_build_object('kind','REGISTERED_HOST','registrationRef',g->'scope'->'registrationRef','credentialId',g->'credentialId','credentialGeneration',g->'credentialGeneration');server_actor=jsonb_build_object('kind','SERVER','channelProfileRef',g->'channelProfileRef');
 FOR e IN SELECT * FROM anvil.native_preparation_authority_events WHERE project_id=p AND authority_id=a ORDER BY sequence LOOP
  n=n+1;v=e.snapshot_json->'payload';k=e.kind;
  IF n>16 OR e.sequence<>n OR e.snapshot_json->'previousRef' IS DISTINCT FROM previous OR (e.snapshot_json->>'at')::timestamptz<(g->>'issuedAt')::timestamptz OR(last_at IS NOT NULL AND(e.snapshot_json->>'at')::timestamptz<last_at) OR(e.snapshot_json->>'expiresAt')::timestamptz>(g->>'expiresAt')::timestamptz THEN RETURN false;END IF;
  IF k='AUTHORITY_CREATED' THEN IF n<>1 THEN RETURN false;END IF;
  ELSIF k='DELIVERY_ATTEMPTED' THEN
   IF delivery IS NOT NULL OR e.snapshot_json->'actor' IS DISTINCT FROM server_actor OR NOT anvil.execution_json_shape(v,ARRAY['deliveryId','channelProfileRef','registrationRef','credentialId','credentialGeneration']) OR (jsonb_typeof(v->'deliveryId') IS DISTINCT FROM 'string' OR(v->>'deliveryId')!~'^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$') OR v->'channelProfileRef' IS DISTINCT FROM g->'channelProfileRef' OR v->'registrationRef' IS DISTINCT FROM g->'scope'->'registrationRef' OR v->'credentialId' IS DISTINCT FROM g->'credentialId' OR v->'credentialGeneration' IS DISTINCT FROM g->'credentialGeneration' THEN RETURN false;END IF;delivery=v;
  ELSIF k IN('DELIVERY_CONFIRMED','DELIVERY_UNCONFIRMED') THEN
   IF delivery IS NULL OR outcome OR e.snapshot_json->'actor' IS DISTINCT FROM server_actor OR v->'deliveryId' IS DISTINCT FROM delivery->'deliveryId' THEN RETURN false;END IF;
   IF k='DELIVERY_CONFIRMED' THEN IF NOT anvil.execution_json_shape(v,ARRAY['deliveryId','ackRef']) OR NOT anvil.writer_authority_ref(v->'ackRef') THEN RETURN false;END IF;
   ELSE IF NOT anvil.execution_json_shape(v,ARRAY['deliveryId','reason']) OR jsonb_typeof(v->'reason') IS DISTINCT FROM 'string' OR v->>'reason' NOT IN('CHANNEL_UNAVAILABLE','DEADLINE','RESPONSE_UNKNOWN','CONTEXT_CHANGED') THEN RETURN false;END IF;END IF;outcome=true;
  ELSIF k='CHALLENGE_ISSUED' THEN
   IF challenge IS NOT NULL OR e.snapshot_json->'actor' IS DISTINCT FROM host_actor OR NOT anvil.execution_json_shape(v,ARRAY['requestId','localAttemptRef','target','serverNonce','nonceDigest','issuedAt','expiresAt']) OR (jsonb_typeof(v->'requestId') IS DISTINCT FROM 'string' OR(v->>'requestId')!~'^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$') OR NOT anvil.writer_authority_ref(v->'localAttemptRef') OR v->'localAttemptRef'->'version' IS DISTINCT FROM '1'::jsonb OR jsonb_typeof(v->'serverNonce') IS DISTINCT FROM 'string' OR(v->>'serverNonce')!~'^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$' OR v->>'nonceDigest' IS DISTINCT FROM encode(sha256(convert_to(v->>'serverNonce','UTF8')),'hex') OR v->'issuedAt' IS DISTINCT FROM e.snapshot_json->'at' OR v->'expiresAt' IS DISTINCT FROM e.snapshot_json->'expiresAt' OR(v->>'expiresAt')::timestamptz>(v->>'issuedAt')::timestamptz+interval '30 seconds' THEN RETURN false;END IF;
   expected=jsonb_build_object('method','POST','path','/api/v1/connector/native-preparations/'||a::text||'/consume','queryHash',anvil.ownership_content_hash('{}'::jsonb),'bodyHash',anvil.ownership_content_hash(jsonb_build_object('schemaVersion',1,'authorityRef',e.snapshot_json->'authorityRef','localAttemptRef',v->'localAttemptRef')));IF v->'target' IS DISTINCT FROM expected THEN RETURN false;END IF;challenge=v;challenge_ref=jsonb_build_object('id',e.id,'version',1,'contentHash',e.content_hash);
  ELSIF k='REQUEST_PROOF_ACCEPTED' THEN
   IF challenge IS NULL OR proof IS NOT NULL OR e.snapshot_json->'actor' IS DISTINCT FROM host_actor OR NOT anvil.execution_json_shape(v,ARRAY['challengeRef','requestId','requestHash','signatureDigest','localAttemptRef']) OR v->'challengeRef' IS DISTINCT FROM challenge_ref OR v->'requestId' IS DISTINCT FROM challenge->'requestId' OR v->'localAttemptRef' IS DISTINCT FROM challenge->'localAttemptRef' OR jsonb_typeof(v->'signatureDigest') IS DISTINCT FROM 'string' OR(v->>'signatureDigest')!~'^[0-9a-f]{64}$' THEN RETURN false;END IF;
   expected=jsonb_build_object('requestId',challenge->'requestId','method',challenge->'target'->'method','path',challenge->'target'->'path','queryHash',challenge->'target'->'queryHash','bodyHash',challenge->'target'->'bodyHash','authorityRef',e.snapshot_json->'authorityRef','credentialGeneration',g->'credentialGeneration','serverNonce',challenge->'serverNonce');IF v->>'requestHash' IS DISTINCT FROM anvil.ownership_content_hash(expected) THEN RETURN false;END IF;IF(e.snapshot_json->>'expiresAt')::timestamptz>(challenge->>'expiresAt')::timestamptz THEN RETURN false;END IF;proof_expiry=(e.snapshot_json->>'expiresAt')::timestamptz;proof=v;proof_ref=jsonb_build_object('id',e.id,'version',1,'contentHash',e.content_hash);
  ELSIF k='CONSUME_COMMITTED' THEN
   IF proof IS NULL OR consumed IS NOT NULL OR(e.snapshot_json->>'at')::timestamptz>=proof_expiry OR(e.snapshot_json->>'expiresAt')::timestamptz>proof_expiry OR e.snapshot_json->'actor' IS DISTINCT FROM host_actor OR NOT anvil.execution_json_shape(v,ARRAY['challengeRef','proofEventRef','requestId','requestHash','localAttemptRef','writerHeadRef','receipt']) OR v->'challengeRef' IS DISTINCT FROM challenge_ref OR v->'proofEventRef' IS DISTINCT FROM proof_ref OR v->'requestId' IS DISTINCT FROM proof->'requestId' OR v->'requestHash' IS DISTINCT FROM proof->'requestHash' OR v->'localAttemptRef' IS DISTINCT FROM proof->'localAttemptRef' OR v->'writerHeadRef' IS DISTINCT FROM g->'scope'->'writerHeadRef' OR previous IS DISTINCT FROM proof_ref THEN RETURN false;END IF;receipt=v->'receipt';
   IF NOT anvil.execution_json_shape(receipt,ARRAY['ref','snapshot']) OR NOT anvil.writer_authority_ref(receipt->'ref') OR receipt->'ref'->'version' IS DISTINCT FROM '1'::jsonb OR receipt->'ref'->>'contentHash' IS DISTINCT FROM anvil.ownership_content_hash(receipt->'snapshot') OR NOT anvil.execution_json_shape(receipt->'snapshot',ARRAY['schemaVersion','purpose','authorityRef','preparationRef','writerHeadRef','requestId','requestHash','challengeRef','proofEventRef','localAttemptRef','at','expiresAt','codingAgentExecutionAuthorized','agentDispatchPerformed']) OR receipt->'snapshot'->'proofEventRef' IS DISTINCT FROM proof_ref THEN RETURN false;END IF;
   expected=jsonb_build_object('schemaVersion',1,'purpose','NATIVE_PREPARATION_CONSUME_RECEIPT','authorityRef',e.snapshot_json->'authorityRef','preparationRef',g->'scope'->'preparationRef','writerHeadRef',g->'scope'->'writerHeadRef','requestId',proof->'requestId','requestHash',proof->'requestHash','challengeRef',challenge_ref,'proofEventRef',proof_ref,'localAttemptRef',proof->'localAttemptRef','at',e.snapshot_json->'at','expiresAt',e.snapshot_json->'expiresAt','codingAgentExecutionAuthorized',false,'agentDispatchPerformed',false);IF receipt->'snapshot' IS DISTINCT FROM expected OR(e.snapshot_json->>'expiresAt')::timestamptz>(challenge->>'expiresAt')::timestamptz OR(e.snapshot_json->>'expiresAt')::timestamptz>(e.snapshot_json->>'at')::timestamptz+interval '30 seconds' THEN RETURN false;END IF;consumed=v;
  ELSIF k='CONTEXT_INVALIDATED' THEN IF e.snapshot_json->'actor' IS DISTINCT FROM server_actor OR NOT anvil.execution_json_shape(v,ARRAY['reason','sourceRef']) OR jsonb_typeof(v->'reason') IS DISTINCT FROM 'string' OR v->>'reason' NOT IN('REGISTRATION_REVOKED','CONTROL_CHANGED','HEAD_CHANGED','EXPIRED') OR NOT anvil.writer_authority_ref(v->'sourceRef') THEN RETURN false;END IF;
  ELSE RETURN false;END IF;
  last_at=(e.snapshot_json->>'at')::timestamptz;previous=jsonb_build_object('id',e.id,'version',1,'contentHash',e.content_hash);
 END LOOP;
 RETURN n>=1 AND((proof IS NULL AND consumed IS NULL) OR(proof IS NOT NULL AND consumed IS NOT NULL));
EXCEPTION WHEN OTHERS THEN RETURN false;END;$$;
REVOKE ALL ON FUNCTION anvil.native_preparation_event_history_valid(uuid,uuid) FROM PUBLIC,anvil_v3_app;
CREATE FUNCTION anvil.native_preparation_authority_complete(p uuid,a uuid) RETURNS boolean LANGUAGE plpgsql SECURITY DEFINER SET search_path=pg_catalog AS $$
DECLARE v anvil.native_preparation_authorities;g jsonb;i jsonb;s jsonb;c anvil.commands;r anvil.authorization_receipts;au anvil.audit_events;w anvil.project_writer_authority_events;created anvil.native_preparation_authority_events;cmd jsonb;target jsonb;digest text;head jsonb;count_states bigint;used anvil.approval_consumptions;approval jsonb;
BEGIN
 SELECT * INTO v FROM anvil.native_preparation_authorities WHERE project_id=p AND id=a;IF v.id IS NULL THEN RETURN false;END IF;g=v.snapshot_json;i=v.intent_json;s=i->'scope';
 IF NOT anvil.execution_json_shape(i,ARRAY['schemaVersion','purpose','intentId','scope','subject','sourceScopes','expectedWriterHeadRef','policyRef','at','expiresAt','codingAgentExecutionAuthorized','agentDispatchPerformed']) OR i->'schemaVersion'<>'1'::jsonb OR i->>'purpose'<>'NATIVE_BOUNDARY_PREPARATION_INTENT' OR i->>'intentId'<>v.intent_id::text OR anvil.ownership_content_hash(i)<>v.intent_hash OR i->'codingAgentExecutionAuthorized'<>'false'::jsonb OR i->'agentDispatchPerformed'<>'false'::jsonb OR anvil.native_preparation_json_bytes(i)>2097152 THEN RETURN false;END IF;
 IF NOT anvil.execution_json_shape(s,ARRAY['installationId','projectId','executionId','executionGeneration','authorityEpoch','leaseId','registrationRef','nativeFactoryRef','sourceScopeHash']) OR s->>'projectId'<>p::text OR s->>'leaseId'<>v.lease_id::text OR s->>'sourceScopeHash'<>anvil.ownership_content_hash(i->'sourceScopes') OR NOT anvil.writer_authority_ref(i->'expectedWriterHeadRef') OR NOT anvil.writer_authority_ref(s->'registrationRef') OR NOT anvil.writer_authority_ref(s->'nativeFactoryRef') THEN RETURN false;END IF;
 IF NOT anvil.execution_json_shape(g,ARRAY['schemaVersion','purpose','authorityId','credentialId','credentialGeneration','scope','subject','parent','policyRef','channelProfileRef','allowedOperations','issuedAt','expiresAt','codingAgentExecutionAuthorized','agentDispatchPerformed']) OR g->'schemaVersion'<>'1'::jsonb OR g->>'purpose'<>'NATIVE_PREPARATION_AUTHORITY' OR g->>'authorityId'<>v.id::text OR anvil.ownership_content_hash(g)<>v.content_hash OR g->'codingAgentExecutionAuthorized'<>'false'::jsonb OR g->'agentDispatchPerformed'<>'false'::jsonb OR g->'allowedOperations'<>'["CHECK_NATIVE_PREPARATION_CURRENT","CONSUME_NATIVE_PREPARATION"]'::jsonb OR g->'subject' IS DISTINCT FROM i->'subject' OR g->'policyRef' IS DISTINCT FROM i->'policyRef' OR NOT anvil.writer_authority_ref(g->'channelProfileRef') OR anvil.native_preparation_json_bytes(g)>2097152 THEN RETURN false;END IF;
 IF NOT anvil.execution_json_shape(g->'scope',ARRAY['installationId','projectId','executionId','executionGeneration','authorityEpoch','leaseId','registrationRef','nativeFactoryRef','sourceScopeHash','writerHeadRef','preparationRef','hostPublicKeyFingerprint']) OR ((g->'scope')-'writerHeadRef'-'preparationRef'-'hostPublicKeyFingerprint') IS DISTINCT FROM s OR g->'scope'->'preparationRef' IS DISTINCT FROM jsonb_build_object('id',v.intent_id,'version',1,'contentHash',v.intent_hash) OR NOT anvil.writer_authority_ref(g->'scope'->'writerHeadRef') OR NOT anvil.writer_authority_ref(g->'parent'->'commandRef') OR NOT anvil.writer_authority_ref(g->'parent'->'authorizationReceiptRef') OR NOT anvil.writer_authority_ref(g->'parent'->'auditRef') THEN RETURN false;END IF;
 IF NOT anvil.execution_iso_valid(i->'at') OR NOT anvil.execution_iso_valid(i->'expiresAt') OR NOT anvil.execution_iso_valid(g->'issuedAt') OR NOT anvil.execution_iso_valid(g->'expiresAt') OR (i->>'expiresAt')::timestamptz<=(i->>'at')::timestamptz OR (i->>'expiresAt')::timestamptz>(i->>'at')::timestamptz+interval '120 seconds' OR (g->>'expiresAt')::timestamptz>(i->>'expiresAt')::timestamptz OR (g->>'expiresAt')::timestamptz<=(g->>'issuedAt')::timestamptz THEN RETURN false;END IF;
 SELECT * INTO c FROM anvil.commands WHERE project_id=p AND id=v.server_command_id;IF c.id IS NULL OR c.operation<>'prepareNativeBoundary' OR c.scope_kind<>'PROJECT' OR c.scope_id<>p OR c.state<>'APPLIED' OR c.actor_id::text<>i->'subject'->>'userId' OR c.client_id::text<>i->'subject'->>'clientId' THEN RETURN false;END IF;
 cmd=c.result_ref->'data'->'commandSnapshot';target=jsonb_build_object('id',v.intent_id,'version',1,'contentHash',v.intent_hash);
 IF NOT anvil.execution_json_shape(cmd,ARRAY['schemaVersion','projectId','commandId','clientId','controlGeneration','operation','targetId','expectedVersion','baselineRefs','approvalRef','payload']) OR cmd->'schemaVersion'<>'1'::jsonb OR cmd->>'operation'<>'prepareNativeBoundary' OR cmd->>'projectId'<>p::text OR cmd->>'commandId'<>c.command_id::text OR cmd->>'clientId'<>c.client_id::text OR cmd->'controlGeneration' IS DISTINCT FROM to_jsonb(c.control_generation) OR cmd->>'targetId'<>i->'expectedWriterHeadRef'->>'id' OR cmd->'expectedVersion' IS DISTINCT FROM i->'expectedWriterHeadRef'->'version' OR cmd->'baselineRefs' IS DISTINCT FROM jsonb_build_array(i->'expectedWriterHeadRef') OR anvil.ownership_content_hash(cmd)<>c.request_hash OR NOT anvil.execution_json_shape(cmd->'payload',ARRAY['registrationRef','nativeFactoryRef','sourceScopes','expectedWriterHeadRef','reason']) OR cmd->'payload'->'registrationRef' IS DISTINCT FROM s->'registrationRef' OR cmd->'payload'->'nativeFactoryRef' IS DISTINCT FROM s->'nativeFactoryRef' OR cmd->'payload'->'sourceScopes' IS DISTINCT FROM i->'sourceScopes' OR cmd->'payload'->'expectedWriterHeadRef' IS DISTINCT FROM i->'expectedWriterHeadRef' THEN RETURN false;END IF;
 IF NOT anvil.execution_json_shape(c.result_ref->'data',ARRAY['ref','status','preparationIntent','commandSnapshot','codingAgentExecutionAuthorized','agentDispatchPerformed']) OR c.result_ref->'data'->>'status'<>'NATIVE_BOUNDARY_PREPARATION_RECORDED' OR c.result_ref->'data'->'preparationIntent' IS DISTINCT FROM i OR c.result_ref->'data'->'ref' IS DISTINCT FROM target OR c.result_ref->'data'->'codingAgentExecutionAuthorized'<>'false'::jsonb OR c.result_ref->'data'->'agentDispatchPerformed'<>'false'::jsonb OR c.result_ref->>'status'<>'APPLIED' OR c.result_ref->>'targetId'<>v.intent_id::text OR c.result_ref->'version'<>'1'::jsonb OR c.policy_ref IS DISTINCT FROM i->'policyRef' THEN RETURN false;END IF;
 digest=anvil.ownership_content_hash(jsonb_build_object('projectId',p,'actorId',c.actor_id,'clientId',c.client_id,'controlGeneration',c.control_generation,'requestHash',c.request_hash,'policyRef',c.policy_ref,'targetRef',target));
 SELECT * INTO r FROM anvil.authorization_receipts WHERE command_id=c.id AND id=c.authorization_receipt_id;
 IF r.id IS NULL OR r.scope_kind<>'PROJECT' OR r.scope_id<>p OR r.scope_digest<>digest OR r.subject_ref IS DISTINCT FROM jsonb_build_object('kind','HUMAN','userId',c.actor_id,'clientId',c.client_id) OR r.policy_ref IS DISTINCT FROM c.policy_ref OR g->'parent'->'commandRef' IS DISTINCT FROM jsonb_build_object('id',c.id,'version',1,'contentHash',c.request_hash) OR g->'parent'->'authorizationReceiptRef' IS DISTINCT FROM jsonb_build_object('id',r.id,'version',1,'contentHash',digest) THEN RETURN false;END IF;
 IF (SELECT count(*) FROM anvil.audit_events WHERE project_id=p AND command_id=c.id)<>1 THEN RETURN false;END IF;
 SELECT * INTO au FROM anvil.audit_events WHERE project_id=p AND command_id=c.id;
 approval=NULLIF(cmd->'approvalRef','null'::jsonb);
 IF au.operation_id<>c.operation_id OR au.actor_ref IS DISTINCT FROM jsonb_build_object('kind','HUMAN','userId',c.actor_id) OR au.client_ref<>c.client_id OR au.target_ref IS DISTINCT FROM target OR au.policy_ref IS DISTINCT FROM c.policy_ref OR au.approval_ref IS DISTINCT FROM approval OR au.scope_digest<>digest OR au.outcome<>'APPLIED' OR au.reason_code<>'EXPLICIT_NATIVE_BOUNDARY_PREPARATION' OR au.source_kind<>'HUMAN_COMMAND' OR au.correction_of IS NOT NULL THEN RETURN false;END IF;
 IF g->'parent'->'auditRef' IS DISTINCT FROM jsonb_build_object('id',au.event_id,'version',1,'contentHash',anvil.ownership_content_hash(jsonb_build_object('projectId',p,'serverSequence',au.server_sequence,'eventId',au.event_id,'actorRef',au.actor_ref,'clientRef',au.client_ref,'commandId',au.command_id,'operationId',au.operation_id,'targetRef',au.target_ref,'policyRef',au.policy_ref,'approvalRef',au.approval_ref,'outcome',au.outcome,'reasonCode',au.reason_code,'scopeDigest',au.scope_digest,'recordedAt',to_char(au.recorded_at AT TIME ZONE 'UTC','YYYY-MM-DD"T"HH24:MI:SS.MS"Z"'),'sourceKind',au.source_kind,'correctionOf',au.correction_of))) THEN RETURN false;END IF;
 IF approval IS NULL THEN IF c.approval_consumption_id IS NOT NULL OR r.approval_decision_ref IS NOT NULL OR c.payload_ref IS NOT NULL THEN RETURN false;END IF;
 ELSE SELECT * INTO used FROM anvil.approval_consumptions WHERE project_id=p AND id=c.approval_consumption_id;IF used.id IS NULL OR used.command_id<>c.id OR used.decision_id::text<>approval->>'decisionId' OR used.scope_digest<>approval->>'scopeDigest' OR r.approval_decision_ref<>used.decision_id OR c.payload_ref IS DISTINCT FROM jsonb_build_object('kind','ONE_TIME_APPROVAL_SCOPE','payloadHash',anvil.ownership_content_hash(cmd->'payload'),'scopeDigest',used.scope_digest) OR NOT EXISTS(SELECT 1 FROM anvil.approval_decisions d JOIN anvil.approval_requests ar ON ar.project_id=d.project_id AND ar.id=d.request_id WHERE d.project_id=p AND d.id=used.decision_id AND d.decision='APPROVE' AND ar.id::text=approval->>'requestId' AND ar.candidate_command_id=c.command_id AND ar.scope_digest=used.scope_digest AND ar.status='CONSUMED' AND ar.action_scope_json->>'operation'='prepareNativeBoundary' AND ar.action_scope_json->'baselineRefs'=cmd->'baselineRefs') THEN RETURN false;END IF;END IF;
 SELECT * INTO w FROM anvil.project_writer_authority_events WHERE project_id=p AND kind='RESERVED' AND lease_id=v.lease_id;
 IF w.id IS NULL OR w.execution_id::text<>s->>'executionId' OR to_jsonb(w.execution_generation) IS DISTINCT FROM s->'executionGeneration' OR to_jsonb(w.authority_epoch) IS DISTINCT FROM s->'authorityEpoch' OR w.command_ref IS DISTINCT FROM g->'parent'->'commandRef' OR w.authorization_receipt_ref IS DISTINCT FROM g->'parent'->'authorizationReceiptRef' OR w.audit_ref IS DISTINCT FROM g->'parent'->'auditRef' OR w.subject_json IS DISTINCT FROM i->'subject' OR w.registration_ref IS DISTINCT FROM s->'registrationRef' OR w.source_scopes_json IS DISTINCT FROM i->'sourceScopes' OR w.payload_json->'preparationRef' IS DISTINCT FROM target OR w.payload_json->'nativeFactoryRef' IS DISTINCT FROM s->'nativeFactoryRef' OR w.payload_json->'expectedHeadRef' IS DISTINCT FROM i->'expectedWriterHeadRef' THEN RETURN false;END IF;
 SELECT count(*) INTO count_states FROM anvil.project_writer_authority_events x WHERE x.project_id=p AND (x.authority_epoch<w.authority_epoch OR x.authority_epoch=w.authority_epoch AND x.sequence<=w.sequence) AND kind IN('BOUNDARY_ESTABLISHED','RESERVED','ACTIVATED','REVOKE_REQUESTED','RECLAIM_CONFIRMED','EXPIRED','UNKNOWN');
 head=jsonb_build_object('schemaVersion',1,'purpose','PROJECT_WRITER_AUTHORITY_HEAD','headId',g->'scope'->'writerHeadRef'->'id','projectId',p,'authorityEpoch',w.authority_epoch,'headGeneration',count_states,'currentEventRef',jsonb_build_object('id',w.id,'version',1,'contentHash',w.content_hash),'phase','RESERVED','leaseId',w.lease_id,'executionId',w.execution_id,'executionGeneration',w.execution_generation,'registrationRef',w.registration_ref,'scopeHash',w.scope_hash,'expiresAt',to_char(w.expires_at AT TIME ZONE 'UTC','YYYY-MM-DD"T"HH24:MI:SS.MS"Z"'));
 IF g->'scope'->'writerHeadRef' IS DISTINCT FROM jsonb_build_object('id',head->'headId','version',count_states,'contentHash',anvil.ownership_content_hash(head)) OR (g->>'expiresAt')::timestamptz>w.expires_at THEN RETURN false;END IF;
 IF (SELECT count(*) FROM anvil.native_preparation_authority_events WHERE project_id=p AND authority_id=a AND kind='AUTHORITY_CREATED')<>1 THEN RETURN false;END IF;
 SELECT * INTO created FROM anvil.native_preparation_authority_events WHERE project_id=p AND authority_id=a AND kind='AUTHORITY_CREATED';
 IF created.snapshot_json->'payload' IS DISTINCT FROM jsonb_build_object('preparationRef',target,'writerHeadRef',g->'scope'->'writerHeadRef','commandRef',g->'parent'->'commandRef','authorizationReceiptRef',g->'parent'->'authorizationReceiptRef','auditRef',g->'parent'->'auditRef') OR created.snapshot_json->'actor' IS DISTINCT FROM jsonb_build_object('kind','HUMAN','subject',i->'subject') THEN RETURN false;END IF;
 RETURN anvil.native_preparation_event_history_valid(p,a);
EXCEPTION WHEN OTHERS THEN RETURN false;
END;$$;
CREATE FUNCTION anvil.native_preparation_capacity(p uuid) RETURNS void LANGUAGE plpgsql SECURITY DEFINER SET search_path=pg_catalog AS $$
DECLARE n bigint;b numeric;x anvil.project_storage_accounts;other_bytes numeric;
BEGIN
 PERFORM 1 FROM anvil.projects WHERE id=p FOR UPDATE;SELECT * INTO x FROM anvil.project_storage_accounts WHERE project_id=p FOR UPDATE;
 IF x.project_id IS NULL OR x.coverage_state<>'VERIFIED' OR NOT anvil.quota_complete(p) THEN RAISE EXCEPTION 'NATIVE_SOURCE_UNAVAILABLE';END IF;
 SELECT count(*),COALESCE(sum(canonical_bytes),0) INTO n,b FROM(SELECT canonical_bytes FROM anvil.native_preparation_authorities WHERE project_id=p UNION ALL SELECT canonical_bytes FROM anvil.native_preparation_authority_events WHERE project_id=p) all_rows;
 SELECT COALESCE((SELECT sum(canonical_bytes) FROM anvil.connection_definition_versions WHERE project_id=p),0)+COALESCE((SELECT sum(canonical_bytes) FROM anvil.definition_capability_reports WHERE project_id=p),0)+COALESCE((SELECT sum(canonical_bytes+evidence_bytes) FROM anvil.environment_configuration_versions WHERE project_id=p),0)+COALESCE((SELECT sum(canonical_bytes) FROM anvil.environment_approval_candidates WHERE project_id=p),0) INTO other_bytes;
 IF n>10000 OR b>67108864 OR x.used_bytes+x.held_bytes+other_bytes+b>10737418240 THEN RAISE EXCEPTION 'NATIVE_CAPACITY_EXCEEDED';END IF;
END;$$;
CREATE FUNCTION anvil.native_preparation_row_guard() RETURNS trigger LANGUAGE plpgsql SECURITY DEFINER SET search_path=pg_catalog AS $$
DECLARE s jsonb;a anvil.native_preparation_authorities;p anvil.native_preparation_authority_events;wrapper jsonb;
BEGIN
 IF TG_OP<>'INSERT' THEN RAISE EXCEPTION 'NATIVE_APPEND_ONLY';END IF;PERFORM 1 FROM anvil.projects WHERE id=NEW.project_id FOR UPDATE;
 IF TG_TABLE_NAME='native_preparation_authorities' THEN
  wrapper=jsonb_build_object('ref',jsonb_build_object('id',NEW.id,'version',1,'contentHash',NEW.content_hash),'snapshot',NEW.snapshot_json,'preparationRef',jsonb_build_object('id',NEW.intent_id,'version',1,'contentHash',NEW.intent_hash),'preparationIntent',NEW.intent_json);
  IF NEW.canonical_bytes<>anvil.native_preparation_json_bytes(wrapper) OR NEW.content_hash<>anvil.ownership_content_hash(NEW.snapshot_json) OR NEW.intent_hash<>anvil.ownership_content_hash(NEW.intent_json) THEN RAISE EXCEPTION 'NATIVE_AUTHORITY_INVALID';END IF;
 ELSE
  s=NEW.snapshot_json;SELECT * INTO a FROM anvil.native_preparation_authorities WHERE project_id=NEW.project_id AND id=NEW.authority_id FOR UPDATE;
  SELECT * INTO p FROM anvil.native_preparation_authority_events WHERE project_id=NEW.project_id AND authority_id=NEW.authority_id ORDER BY sequence DESC LIMIT 1;
  IF a.id IS NULL OR NOT anvil.execution_json_shape(s,ARRAY['schemaVersion','purpose','projectId','authorityRef','sequence','previousRef','kind','actor','payload','at','expiresAt']) OR s->'schemaVersion'<>'1'::jsonb OR s->>'purpose'<>'NATIVE_PREPARATION_AUTHORITY_EVENT' OR s->>'projectId'<>NEW.project_id::text OR s->'authorityRef' IS DISTINCT FROM jsonb_build_object('id',a.id,'version',1,'contentHash',a.content_hash) OR s->'sequence' IS DISTINCT FROM to_jsonb(NEW.sequence) OR s->'previousRef' IS DISTINCT FROM NEW.previous_ref OR (p.id IS NULL AND(NEW.sequence<>1 OR NEW.previous_ref<>'null'::jsonb)) OR(p.id IS NOT NULL AND(NEW.sequence<>p.sequence+1 OR NEW.previous_ref IS DISTINCT FROM jsonb_build_object('id',p.id,'version',1,'contentHash',p.content_hash))) OR NOT anvil.execution_iso_valid(s->'at') OR NOT anvil.execution_iso_valid(s->'expiresAt') OR (s->>'expiresAt')::timestamptz<=(s->>'at')::timestamptz OR (s->>'expiresAt')::timestamptz>(a.snapshot_json->>'expiresAt')::timestamptz THEN RAISE EXCEPTION 'NATIVE_EVENT_INVALID';END IF;
  IF NEW.project_sequence<>(SELECT COALESCE(MAX(project_sequence),0)+1 FROM anvil.native_preparation_authority_events WHERE project_id=NEW.project_id) THEN RAISE EXCEPTION 'NATIVE_PROJECT_SEQUENCE_INVALID';END IF;
  wrapper=jsonb_build_object('ref',jsonb_build_object('id',NEW.id,'version',1,'contentHash',NEW.content_hash),'snapshot',s);
  IF NEW.content_hash<>anvil.ownership_content_hash(s) OR NEW.canonical_bytes<>anvil.native_preparation_json_bytes(wrapper) THEN RAISE EXCEPTION 'NATIVE_EVENT_HASH_INVALID';END IF;
  IF s->>'kind' IN('CHALLENGE_ISSUED','REQUEST_PROOF_ACCEPTED','CONSUME_COMMITTED','DELIVERY_ATTEMPTED') THEN
   IF (s->>'expiresAt')::timestamptz<=clock_timestamp() OR NOT EXISTS(SELECT 1 FROM anvil.project_writer_authority_heads h WHERE h.project_id=NEW.project_id AND h.id::text=a.snapshot_json->'scope'->'writerHeadRef'->>'id' AND h.head_generation::text=a.snapshot_json->'scope'->'writerHeadRef'->>'version' AND h.content_hash=a.snapshot_json->'scope'->'writerHeadRef'->>'contentHash' AND h.phase='RESERVED' AND h.lease_id=a.lease_id) THEN RAISE EXCEPTION 'NATIVE_CONTEXT_CHANGED';END IF;
  END IF;
 END IF;RETURN NEW;
END;$$;
CREATE FUNCTION anvil.native_preparation_final() RETURNS trigger LANGUAGE plpgsql SECURITY DEFINER SET search_path=pg_catalog AS $$
DECLARE p uuid;aid uuid;
BEGIN
 IF TG_TABLE_NAME='commands' THEN p=NEW.project_id;SELECT id INTO aid FROM anvil.native_preparation_authorities WHERE project_id=p AND server_command_id=NEW.id;IF aid IS NULL AND NEW.operation<>'prepareNativeBoundary' THEN RETURN NULL;END IF;
 ELSIF TG_TABLE_NAME='audit_events' THEN p=NEW.project_id;SELECT id INTO aid FROM anvil.native_preparation_authorities WHERE project_id=p AND server_command_id=NEW.command_id;IF aid IS NULL AND NOT EXISTS(SELECT 1 FROM anvil.commands WHERE project_id=p AND id=NEW.command_id AND operation='prepareNativeBoundary') THEN RETURN NULL;END IF;
 ELSE p=NEW.project_id;IF TG_TABLE_NAME='native_preparation_authorities' THEN aid=NEW.id;ELSE aid=NEW.authority_id;END IF;END IF;
 IF aid IS NULL OR NOT anvil.native_preparation_authority_complete(p,aid) THEN RAISE EXCEPTION 'NATIVE_AUTHORITY_INCOMPLETE';END IF;PERFORM anvil.native_preparation_capacity(p);RETURN NULL;
END;$$;
CREATE TRIGGER native_authority_no_truncate BEFORE TRUNCATE ON anvil.native_preparation_authorities FOR EACH STATEMENT EXECUTE FUNCTION anvil.writer_authority_truncate_guard();
CREATE TRIGGER native_authority_events_no_truncate BEFORE TRUNCATE ON anvil.native_preparation_authority_events FOR EACH STATEMENT EXECUTE FUNCTION anvil.writer_authority_truncate_guard();
CREATE TRIGGER native_authority_append BEFORE INSERT OR UPDATE OR DELETE ON anvil.native_preparation_authorities FOR EACH ROW EXECUTE FUNCTION anvil.native_preparation_row_guard();
CREATE TRIGGER native_authority_event_append BEFORE INSERT OR UPDATE OR DELETE ON anvil.native_preparation_authority_events FOR EACH ROW EXECUTE FUNCTION anvil.native_preparation_row_guard();
CREATE CONSTRAINT TRIGGER native_authority_complete AFTER INSERT ON anvil.native_preparation_authorities DEFERRABLE INITIALLY DEFERRED FOR EACH ROW EXECUTE FUNCTION anvil.native_preparation_final();
CREATE CONSTRAINT TRIGGER native_authority_event_complete AFTER INSERT ON anvil.native_preparation_authority_events DEFERRABLE INITIALLY DEFERRED FOR EACH ROW EXECUTE FUNCTION anvil.native_preparation_final();
CREATE CONSTRAINT TRIGGER native_command_complete AFTER INSERT OR UPDATE ON anvil.commands DEFERRABLE INITIALLY DEFERRED FOR EACH ROW EXECUTE FUNCTION anvil.native_preparation_final();
CREATE CONSTRAINT TRIGGER native_audit_complete AFTER INSERT ON anvil.audit_events DEFERRABLE INITIALLY DEFERRED FOR EACH ROW EXECUTE FUNCTION anvil.native_preparation_final();
ALTER TABLE anvil.native_preparation_authorities ENABLE ROW LEVEL SECURITY;ALTER TABLE anvil.native_preparation_authorities FORCE ROW LEVEL SECURITY;
ALTER TABLE anvil.native_preparation_authority_events ENABLE ROW LEVEL SECURITY;ALTER TABLE anvil.native_preparation_authority_events FORCE ROW LEVEL SECURITY;
CREATE POLICY native_authority_closed ON anvil.native_preparation_authorities FOR ALL USING(false) WITH CHECK(false);
CREATE POLICY native_authority_events_closed ON anvil.native_preparation_authority_events FOR ALL USING(false) WITH CHECK(false);
REVOKE ALL ON anvil.native_preparation_authorities,anvil.native_preparation_authority_events FROM PUBLIC,anvil_v3_app;
REVOKE ALL ON FUNCTION anvil.native_preparation_json_bytes(jsonb),anvil.native_preparation_authority_complete(uuid,uuid),anvil.native_preparation_capacity(uuid),anvil.native_preparation_row_guard(),anvil.native_preparation_final() FROM PUBLIC,anvil_v3_app;
CREATE OR REPLACE FUNCTION anvil.connection_definition_capacity(p uuid) RETURNS void LANGUAGE plpgsql SECURITY DEFINER SET search_path=pg_catalog AS $$
DECLARE h bigint;n bigint;b numeric;ac anvil.project_storage_accounts%ROWTYPE;report_count bigint;report_bytes numeric;environment_heads bigint;environment_versions bigint;environment_bytes numeric;approval_count bigint;approval_bytes numeric;
BEGIN
 -- 정의 없는 프로젝트의 기존 예약/조회 의미를 바꾸지 않는다.
 IF NOT EXISTS(SELECT 1 FROM anvil.agent_connections WHERE project_id=p) AND NOT EXISTS(SELECT 1 FROM anvil.environment_configuration_heads WHERE project_id=p) AND NOT EXISTS(SELECT 1 FROM anvil.environment_approval_candidates WHERE project_id=p) AND NOT EXISTS(SELECT 1 FROM anvil.native_preparation_authorities WHERE project_id=p) THEN RETURN;END IF;
 PERFORM id FROM anvil.projects WHERE id=p FOR UPDATE;
 SELECT * INTO ac FROM anvil.project_storage_accounts WHERE project_id=p FOR UPDATE;
 SELECT count(*),COALESCE(sum(canonical_bytes),0) INTO approval_count,approval_bytes FROM anvil.environment_approval_candidates WHERE project_id=p;
 IF ac.project_id IS NULL OR ac.coverage_state<>'VERIFIED' THEN RAISE EXCEPTION 'PROJECT_STORAGE_QUOTA_UNVERIFIED';END IF;
 IF NOT anvil.quota_complete(p) THEN RAISE EXCEPTION 'PROJECT_STORAGE_QUOTA_INTEGRITY_FAILED';END IF;
 SELECT count(*) INTO environment_heads FROM anvil.environment_configuration_heads WHERE project_id=p;
 SELECT count(*),COALESCE(sum(canonical_bytes+evidence_bytes),0) INTO environment_versions,environment_bytes FROM anvil.environment_configuration_versions WHERE project_id=p;
 IF environment_heads>1000 OR environment_versions>10000 OR environment_bytes>67108864 THEN RAISE EXCEPTION 'ENVIRONMENT_STORAGE_LIMIT_REACHED';END IF;
 IF EXISTS(SELECT 1 FROM anvil.environment_configuration_versions v WHERE v.project_id=p AND NOT anvil.environment_configuration_complete(v.command_id)) OR EXISTS(SELECT 1 FROM anvil.environment_configuration_heads x WHERE x.project_id=p AND (NOT EXISTS(SELECT 1 FROM anvil.environment_configuration_versions v WHERE v.project_id=p AND v.kind=x.kind AND v.id=x.id AND v.version=x.head_version) OR (SELECT count(*) FROM anvil.environment_configuration_versions v WHERE v.project_id=p AND v.kind=x.kind AND v.id=x.id)<>x.head_version)) THEN RAISE EXCEPTION 'ENVIRONMENT_INTEGRITY_FAILED';END IF;
 SELECT count(*) INTO h FROM anvil.agent_connections WHERE project_id=p;
 SELECT count(*),COALESCE(sum(canonical_bytes),0) INTO n,b FROM anvil.connection_definition_versions WHERE project_id=p;
 IF EXISTS(SELECT 1 FROM anvil.connection_definition_versions v LEFT JOIN anvil.agent_connections x ON x.project_id=v.project_id AND x.id=v.connection_id WHERE v.project_id=p AND (x.id IS NULL OR x.head_version<>v.version OR NOT anvil.connection_definition_proof(v) OR NOT anvil.connection_definition_valid(v.definition_json) OR v.canonical_json IS DISTINCT FROM anvil.fn01_json(v.definition_json) OR v.content_hash IS DISTINCT FROM anvil.fn01_hash(v.definition_json) OR v.canonical_bytes IS DISTINCT FROM octet_length(convert_to(v.canonical_json,'UTF8')))) OR h<>n THEN RAISE EXCEPTION 'CONNECTION_DEFINITION_INTEGRITY_FAILED';END IF;
 SELECT count(*),COALESCE(sum(canonical_bytes),0) INTO report_count,report_bytes FROM anvil.definition_capability_reports WHERE project_id=p;
 IF EXISTS(SELECT 1 FROM anvil.definition_capability_reports r WHERE r.project_id=p AND (NOT anvil.fn06_definition_report_complete(r.command_id) OR r.canonical_bytes IS DISTINCT FROM anvil.fn06_definition_report_bytes(r.claim_json,r.snapshot_json))) THEN RAISE EXCEPTION 'CAPABILITY_REPORT_INTEGRITY_FAILED';END IF;
 IF report_count>10000 OR report_bytes>67108864 OR ac.used_bytes+ac.held_bytes+b+report_bytes+environment_bytes+approval_bytes>10737418240 THEN RAISE EXCEPTION 'CAPABILITY_REPORT_STORAGE_LIMIT_REACHED';END IF;
 IF approval_count>10000 OR EXISTS(SELECT 1 FROM anvil.environment_approval_candidates x WHERE x.project_id=p AND NOT anvil.environment_approval_complete(p,x.request_id)) THEN RAISE EXCEPTION 'ENVIRONMENT_APPROVAL_INTEGRITY_FAILED';END IF;
 IF environment_bytes+approval_bytes>67108864 THEN RAISE EXCEPTION 'ENVIRONMENT_STORAGE_LIMIT_REACHED';END IF;
 IF h>1000 OR n>10000 OR b>67108864 OR ac.used_bytes+ac.held_bytes+b+report_bytes+environment_bytes>10737418240 THEN RAISE EXCEPTION 'CONNECTION_STORAGE_LIMIT_REACHED';END IF;
 PERFORM anvil.native_preparation_capacity(p);
END;$$;

-- 기존 helper의 다른 연산은 원 wrapper chain에 위임한다.
ALTER FUNCTION anvil.connection_candidate_approval_target_valid(uuid,jsonb) RENAME TO connection_candidate_approval_target_before_native;
CREATE FUNCTION anvil.native_preparation_approval_scope(p uuid,s jsonb) RETURNS boolean LANGUAGE plpgsql SET search_path=pg_catalog AS $$
DECLARE h anvil.project_writer_authority_heads;
BEGIN
 IF NOT anvil.execution_json_shape(s,ARRAY['operation','targetRef','expectedVersion','payloadHash','baselineRefs','environmentRef','sourceScopes','limitsRef','requestedSubjectRef','controlGeneration']) OR s->>'operation'<>'prepareNativeBoundary' OR NOT anvil.writer_authority_ref(s->'targetRef') OR s->'expectedVersion' IS DISTINCT FROM s->'targetRef'->'version' OR s->'baselineRefs' IS DISTINCT FROM jsonb_build_array(s->'targetRef') OR s->'environmentRef'<>'null'::jsonb OR s->'sourceScopes'<>'[]'::jsonb OR s->'limitsRef'<>'null'::jsonb OR s->>'payloadHash'!~'^[0-9a-f]{64}$' THEN RETURN false;END IF;
 SELECT * INTO h FROM anvil.project_writer_authority_heads WHERE project_id=p;
 RETURN h.project_id IS NOT NULL AND h.phase IN('EMPTY_AT','RECLAIMED_AT') AND h.expires_at>clock_timestamp() AND s->'targetRef'=jsonb_build_object('id',h.id,'version',h.head_generation,'contentHash',h.content_hash);
EXCEPTION WHEN OTHERS THEN RETURN false;END;$$;
CREATE FUNCTION anvil.connection_candidate_approval_target_valid(pid uuid,s jsonb) RETURNS boolean LANGUAGE sql SET search_path=pg_catalog AS $$ SELECT CASE WHEN s->>'operation'='prepareNativeBoundary' THEN anvil.native_preparation_approval_scope(pid,s) ELSE anvil.connection_candidate_approval_target_before_native(pid,s) END;$$;
ALTER FUNCTION anvil.one_time_consumption_command_authorized(uuid,uuid,uuid) RENAME TO one_time_consumption_command_before_native;
CREATE FUNCTION anvil.one_time_consumption_command_authorized(pid uuid,cid uuid,did uuid) RETURNS boolean LANGUAGE plpgsql SET search_path=pg_catalog AS $$
DECLARE c anvil.commands;d anvil.approval_decisions;r anvil.approval_requests;cmd jsonb;i jsonb;scope jsonb;
BEGIN
 SELECT * INTO c FROM anvil.commands WHERE project_id=pid AND id=cid;
 IF c.operation IS DISTINCT FROM 'prepareNativeBoundary' THEN RETURN anvil.one_time_consumption_command_before_native(pid,cid,did);END IF;
 SELECT * INTO d FROM anvil.approval_decisions WHERE project_id=pid AND id=did;SELECT * INTO r FROM anvil.approval_requests WHERE project_id=pid AND id=d.request_id;
 cmd=c.result_ref->'data'->'commandSnapshot';i=c.result_ref->'data'->'preparationIntent';scope=r.action_scope_json;
 RETURN COALESCE(c.scope_kind='PROJECT' AND c.scope_id=pid AND c.state='APPLIED' AND d.id IS NOT NULL AND r.id IS NOT NULL AND d.decision='APPROVE' AND d.scope_digest=r.scope_digest AND r.candidate_command_id=c.command_id AND r.created_by=c.actor_id AND r.client_id=c.client_id AND r.policy_ref=c.policy_ref AND scope->>'operation'='prepareNativeBoundary' AND scope->>'payloadHash'=anvil.ownership_content_hash(cmd->'payload') AND scope->'baselineRefs'=cmd->'baselineRefs' AND scope->'targetRef'=cmd->'payload'->'expectedWriterHeadRef' AND scope->'expectedVersion'=cmd->'expectedVersion' AND scope->'controlGeneration'=cmd->'controlGeneration' AND scope->'requestedSubjectRef'=jsonb_build_object('kind','HUMAN','userId',c.actor_id,'clientId',c.client_id) AND cmd->'approvalRef'=jsonb_build_object('requestId',r.id,'decisionId',d.id,'scopeDigest',r.scope_digest) AND anvil.ownership_content_hash(cmd)=c.request_hash AND i->>'purpose'='NATIVE_BOUNDARY_PREPARATION_INTENT' AND i->'expectedWriterHeadRef'=scope->'targetRef' AND i->'policyRef'=c.policy_ref AND i->'codingAgentExecutionAuthorized'='false'::jsonb AND i->'agentDispatchPerformed'='false'::jsonb,false);
EXCEPTION WHEN OTHERS THEN RETURN false;END;$$;
REVOKE ALL ON FUNCTION anvil.native_preparation_approval_scope(uuid,jsonb) FROM PUBLIC,anvil_v3_app;
COMMIT;
