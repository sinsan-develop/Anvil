-- 예약 v1은 불변이다. 소비 v2가 가리키는 발급 영수증만 같은 실행 세대의 ISSUED를 증명한다.
BEGIN;
CREATE UNIQUE INDEX normal_credential_issued_once ON anvil.execution_receipts(project_id,grant_id,grant_version)
 WHERE snapshot_json->>'kind'='NORMAL_CREDENTIAL_ISSUED';
CREATE UNIQUE INDEX normal_credential_digest_once ON anvil.execution_receipts((snapshot_json->>'tokenDigest'))
 WHERE snapshot_json->>'kind'='NORMAL_CREDENTIAL_ISSUED';

CREATE FUNCTION anvil.normal_credential_consumption_valid(v anvil.execution_challenges, deferred_check boolean)
RETURNS boolean LANGUAGE plpgsql AS $$
DECLARE old anvil.execution_challenges%ROWTYPE; s jsonb=v.snapshot_json; u jsonb=s->'consumption'; seq bigint;
BEGIN
 SELECT * INTO old FROM anvil.execution_challenges WHERE project_id=v.project_id AND id=v.id AND version=1;
 IF NOT FOUND OR v.version<>2 OR old.grant_id<>v.grant_id OR old.grant_version<>v.grant_version
  OR old.snapshot_json#>>'{binding,transport}' IS DISTINCT FROM 'NORMAL_PROTECTED'
  OR old.snapshot_json#>>'{publicChallenge,purpose}' IS DISTINCT FROM 'CREDENTIAL_EXCHANGE'
  OR old.content_hash IS DISTINCT FROM anvil.execution_json_hash(old.snapshot_json)
  OR v.content_hash IS DISTINCT FROM anvil.execution_json_hash(s)
  OR s IS DISTINCT FROM (old.snapshot_json || jsonb_build_object('sequence',v.server_sequence,
    'previousRef',jsonb_build_object('id',old.id,'version',1,'contentHash',old.content_hash),'consumption',u))
  OR NOT anvil.execution_json_shape(u,ARRAY['resultRef','consumedAt','packetHash'])
  OR NOT anvil.execution_json_shape(u->'resultRef',ARRAY['id','version','contentHash'])
  OR u#>'{resultRef,version}' IS DISTINCT FROM '1'::jsonb OR u#>>'{resultRef,id}' IS NULL
  OR jsonb_typeof(u#>'{resultRef,contentHash}') IS DISTINCT FROM 'string' OR u#>>'{resultRef,contentHash}' !~ '^[0-9a-f]{64}$'
  OR jsonb_typeof(u->'packetHash') IS DISTINCT FROM 'string' OR u->>'packetHash' !~ '^[0-9a-f]{64}$'
  OR NOT anvil.execution_iso_valid(u->'consumedAt')
  OR (u->>'consumedAt')::timestamptz < (s#>>'{publicChallenge,issuedAt}')::timestamptz
  OR (u->>'consumedAt')::timestamptz > clock_timestamp()
  OR clock_timestamp()>=(s#>>'{publicChallenge,expiresAt}')::timestamptz
  OR current_setting('anvil.normal_credential_verified',true) IS DISTINCT FROM txid_current()::text||':'||(u#>>'{resultRef,contentHash}')
 THEN RETURN false; END IF;
 SELECT coalesce(max(server_sequence),0)+1 INTO seq FROM anvil.execution_challenges WHERE project_id=v.project_id AND grant_id=v.grant_id AND grant_version=v.grant_version
  AND (NOT deferred_check OR server_sequence<v.server_sequence);
 RETURN seq=v.server_sequence AND (NOT deferred_check OR EXISTS(SELECT 1 FROM anvil.execution_receipts r
  WHERE r.project_id=v.project_id AND r.id=(u#>>'{resultRef,id}')::uuid AND r.grant_id=v.grant_id AND r.grant_version=v.grant_version
   AND r.challenge_id=v.id AND r.challenge_version=1 AND r.content_hash=u#>>'{resultRef,contentHash}'
   AND r.snapshot_json->>'kind'='NORMAL_CREDENTIAL_ISSUED' AND r.snapshot_json->'packetHash'=u->'packetHash'));
END;
$$;
CREATE FUNCTION anvil.normal_credential_receipt_valid(r anvil.execution_receipts) RETURNS boolean LANGUAGE plpgsql AS $$
DECLARE s jsonb=r.snapshot_json;b jsonb=s->'binding';cur record;v anvil.execution_challenges%ROWTYPE;
 ec anvil.execution_credentials%ROWTYPE;g anvil.execution_grants%ROWTYPE;issued timestamptz;expires timestamptz;
BEGIN
 SELECT * INTO v FROM anvil.execution_challenges WHERE project_id=r.project_id AND id=r.challenge_id AND version=2;
 IF NOT FOUND OR v.grant_id<>r.grant_id OR v.grant_version<>r.grant_version OR r.version<>1 OR r.challenge_version<>1
  OR r.content_hash IS DISTINCT FROM anvil.execution_json_hash(s)
  OR current_setting('anvil.normal_credential_verified',true) IS DISTINCT FROM txid_current()::text||':'||r.content_hash
  OR NOT anvil.execution_json_shape(s,ARRAY['kind','purpose','binding','reservationRef','challengeRef','requestId','packetHash','tokenDigest','issuedAt','expiresAt','storageEvidenceRefs','storageExpiresAt'])
  OR s->>'purpose' IS DISTINCT FROM 'EXECUTION_DISPATCH_ONLY' OR s->>'kind' IS DISTINCT FROM 'NORMAL_CREDENTIAL_ISSUED'
  OR jsonb_typeof(s->'tokenDigest') IS DISTINCT FROM 'string' OR s->>'tokenDigest' !~ '^[0-9a-f]{64}$'
  OR jsonb_typeof(s->'packetHash') IS DISTINCT FROM 'string' OR s->>'packetHash' !~ '^[0-9a-f]{64}$'
  OR v.snapshot_json->'previousRef' IS DISTINCT FROM s->'challengeRef' OR v.snapshot_json->'binding' IS DISTINCT FROM b
  OR v.snapshot_json#>'{consumption,resultRef}' IS DISTINCT FROM jsonb_build_object('id',r.id,'version',1,'contentHash',r.content_hash)
  OR v.snapshot_json#>'{consumption,packetHash}' IS DISTINCT FROM s->'packetHash'
  OR v.snapshot_json#>'{consumption,consumedAt}' IS DISTINCT FROM s->'issuedAt'
  OR v.snapshot_json#>'{request,requestId}' IS DISTINCT FROM s->'requestId'
  OR NOT anvil.execution_iso_valid(s->'issuedAt') OR NOT anvil.execution_iso_valid(s->'expiresAt') OR NOT anvil.execution_iso_valid(s->'storageExpiresAt')
 THEN RETURN false; END IF;
 SELECT * INTO g FROM anvil.execution_grants WHERE project_id=r.project_id AND id=r.grant_id AND version=r.grant_version;
 IF NOT FOUND OR g.snapshot_json#>>'{binding,checks,storage,state}' IS DISTINCT FROM 'VERIFIED_CURRENT'
  OR jsonb_typeof(s->'storageEvidenceRefs') IS DISTINCT FROM 'array' OR jsonb_array_length(s->'storageEvidenceRefs') NOT BETWEEN 1 AND 128
  OR s->'storageEvidenceRefs' IS DISTINCT FROM g.snapshot_json#>'{binding,checks,storage,evidenceRefs}'
  OR NOT anvil.normal_credential_reservation_valid(r.project_id,r.grant_id,r.grant_version) THEN RETURN false; END IF;
 SELECT * INTO ec FROM anvil.execution_credentials WHERE project_id=r.project_id AND grant_id=r.grant_id AND grant_version=r.grant_version;
 IF NOT FOUND OR s->'reservationRef' IS DISTINCT FROM jsonb_build_object('id',ec.id,'version',ec.version,'contentHash',ec.content_hash)
  OR b->'credentialGeneration' IS DISTINCT FROM to_jsonb(ec.credential_generation) THEN RETURN false; END IF;
 SELECT * INTO cur FROM anvil.normal_exchange_current(r.project_id,(b->>'connectorId')::uuid,g.execution_id,g.id,g.version,g.content_hash,ec.credential_generation);
 IF NOT FOUND OR cur.binding IS DISTINCT FROM b THEN RETURN false; END IF;
 issued=(s->>'issuedAt')::timestamptz; expires=(s->>'expiresAt')::timestamptz;
 RETURN issued<=cur.observed_at AND expires>clock_timestamp() AND clock_timestamp()<(v.snapshot_json#>>'{publicChallenge,expiresAt}')::timestamptz
  AND expires<=least(issued+interval '15 minutes',cur.deadline,(s->>'storageExpiresAt')::timestamptz);
END;
$$;
CREATE FUNCTION anvil.guard_normal_credential_exchange() RETURNS trigger LANGUAGE plpgsql AS $$
BEGIN
 IF TG_TABLE_NAME='execution_challenges' THEN
  IF COALESCE(anvil.normal_credential_consumption_valid(NEW::anvil.execution_challenges,TG_WHEN='AFTER'),false) THEN RETURN NEW; END IF;
 ELSIF COALESCE(anvil.normal_credential_receipt_valid(NEW::anvil.execution_receipts),false) THEN RETURN NEW; END IF;
 RAISE EXCEPTION 'NORMAL_CREDENTIAL_ATOMIC_EXCHANGE_REQUIRED' USING ERRCODE='42501';
END;
$$;
-- 0084의 normal v1과 기존 synthetic 분기를 그대로 유지한다. v2만 새 검사로 보낸다.
DROP TRIGGER normal_exchange_issue_guard ON anvil.execution_challenges;
DROP TRIGGER normal_exchange_issue_complete ON anvil.execution_challenges;
CREATE TRIGGER normal_exchange_issue_guard BEFORE INSERT ON anvil.execution_challenges FOR EACH ROW
 WHEN (NEW.version=1 AND NEW.snapshot_json#>>'{binding,transport}'='NORMAL_PROTECTED') EXECUTE FUNCTION anvil.guard_normal_exchange_issue();
CREATE CONSTRAINT TRIGGER normal_exchange_issue_complete AFTER INSERT ON anvil.execution_challenges DEFERRABLE INITIALLY DEFERRED FOR EACH ROW
 WHEN (NEW.version=1 AND NEW.snapshot_json#>>'{binding,transport}'='NORMAL_PROTECTED') EXECUTE FUNCTION anvil.guard_normal_exchange_issue();
CREATE TRIGGER normal_credential_consumption_guard BEFORE INSERT ON anvil.execution_challenges FOR EACH ROW
 WHEN (NEW.version=2 AND NEW.snapshot_json#>>'{binding,transport}'='NORMAL_PROTECTED') EXECUTE FUNCTION anvil.guard_normal_credential_exchange();
CREATE CONSTRAINT TRIGGER normal_credential_consumption_complete AFTER INSERT ON anvil.execution_challenges DEFERRABLE INITIALLY DEFERRED FOR EACH ROW
 WHEN (NEW.version=2 AND NEW.snapshot_json#>>'{binding,transport}'='NORMAL_PROTECTED') EXECUTE FUNCTION anvil.guard_normal_credential_exchange();
DROP TRIGGER synthetic_execution_receipt_guard ON anvil.execution_receipts;
DROP TRIGGER synthetic_execution_receipt_complete ON anvil.execution_receipts;
CREATE TRIGGER execution_receipt_immutable BEFORE UPDATE OR DELETE ON anvil.execution_receipts FOR EACH ROW EXECUTE FUNCTION anvil.guard_synthetic_execution_receipt();
CREATE TRIGGER synthetic_execution_receipt_guard BEFORE INSERT ON anvil.execution_receipts FOR EACH ROW
 WHEN (NEW.snapshot_json->>'kind' IS DISTINCT FROM 'NORMAL_CREDENTIAL_ISSUED') EXECUTE FUNCTION anvil.guard_synthetic_execution_receipt();
CREATE CONSTRAINT TRIGGER synthetic_execution_receipt_complete AFTER INSERT ON anvil.execution_receipts DEFERRABLE INITIALLY DEFERRED FOR EACH ROW
 WHEN (NEW.snapshot_json->>'kind' IS DISTINCT FROM 'NORMAL_CREDENTIAL_ISSUED') EXECUTE FUNCTION anvil.guard_execution_challenge_complete();
CREATE TRIGGER normal_credential_receipt_guard BEFORE INSERT ON anvil.execution_receipts FOR EACH ROW
 WHEN (NEW.snapshot_json->>'kind'='NORMAL_CREDENTIAL_ISSUED') EXECUTE FUNCTION anvil.guard_normal_credential_exchange();
CREATE CONSTRAINT TRIGGER normal_credential_receipt_complete AFTER INSERT ON anvil.execution_receipts DEFERRABLE INITIALLY DEFERRED FOR EACH ROW
 WHEN (NEW.snapshot_json->>'kind'='NORMAL_CREDENTIAL_ISSUED') EXECUTE FUNCTION anvil.guard_normal_credential_exchange();
REVOKE ALL ON FUNCTION anvil.normal_credential_consumption_valid(anvil.execution_challenges,boolean),anvil.normal_credential_receipt_valid(anvil.execution_receipts),anvil.guard_normal_credential_exchange() FROM PUBLIC;
GRANT EXECUTE ON FUNCTION anvil.normal_credential_consumption_valid(anvil.execution_challenges,boolean),anvil.normal_credential_receipt_valid(anvil.execution_receipts),anvil.guard_normal_credential_exchange() TO anvil_v3_app;
COMMIT;
