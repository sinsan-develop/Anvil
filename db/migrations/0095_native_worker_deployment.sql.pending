-- SOURCE ONLY. 실제 role/DDL/배포 서비스 membership 적용은 별도 실행 범위다.
BEGIN;
DO $$BEGIN
 IF current_user<>'anvil_v3_migrator' OR session_user<>'anvil_v3_migrator' THEN RAISE EXCEPTION 'WORKER_MIGRATOR_REQUIRED';END IF;
 IF EXISTS(SELECT 1 FROM pg_catalog.pg_roles WHERE rolname IN ('worker_owner','worker_publisher')) THEN RAISE EXCEPTION 'WORKER_ROLE_ALREADY_EXISTS';END IF;
END;$$;
CREATE ROLE worker_owner NOLOGIN NOINHERIT NOBYPASSRLS NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION;
CREATE ROLE worker_publisher NOLOGIN NOINHERIT NOBYPASSRLS NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION;
GRANT worker_owner TO anvil_v3_migrator WITH ADMIN OPTION;
GRANT USAGE,CREATE ON SCHEMA anvil TO worker_owner;
GRANT USAGE ON SCHEMA anvil TO worker_publisher;

CREATE FUNCTION anvil.fn95_canonical(v jsonb) RETURNS text LANGUAGE plpgsql IMMUTABLE STRICT SET search_path=pg_catalog AS $$
DECLARE result text;BEGIN
 CASE jsonb_typeof(v)
 WHEN 'object' THEN SELECT '{'||coalesce(string_agg(to_jsonb(key)::text||':'||anvil.fn95_canonical(value),',' ORDER BY key COLLATE "C"),'')||'}' INTO result FROM jsonb_each(v);
 WHEN 'array' THEN SELECT '['||coalesce(string_agg(anvil.fn95_canonical(value),',' ORDER BY ord),'')||']' INTO result FROM jsonb_array_elements(v) WITH ORDINALITY AS a(value,ord);
 ELSE result=v::text;END CASE;RETURN result;END;$$;
CREATE FUNCTION anvil.fn95_hash(v jsonb) RETURNS text LANGUAGE sql IMMUTABLE STRICT SET search_path=pg_catalog AS $$SELECT encode(sha256(convert_to(anvil.fn95_canonical(v),'UTF8')),'hex');$$;
CREATE FUNCTION anvil.fn95_keys(v jsonb,keys text[]) RETURNS boolean LANGUAGE sql IMMUTABLE SET search_path=pg_catalog AS $$SELECT jsonb_typeof(v)='object' AND (SELECT array_agg(key ORDER BY key) FROM jsonb_object_keys(v) key)=(SELECT array_agg(x ORDER BY x) FROM unnest(keys) x);$$;
CREATE FUNCTION anvil.fn95_ref(v jsonb) RETURNS boolean LANGUAGE sql IMMUTABLE SET search_path=pg_catalog AS $$SELECT coalesce(anvil.fn95_keys(v,ARRAY['id','version','contentHash']) AND v->>'id'~'^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$' AND jsonb_typeof(v->'version')='number' AND v->>'version'~'^[1-9][0-9]{0,15}$' AND (v->>'version')::numeric<=9007199254740991 AND v->>'contentHash'~'^[0-9a-f]{64}$',false);$$;
CREATE FUNCTION anvil.fn95_iso(v text) RETURNS boolean LANGUAGE plpgsql IMMUTABLE SET search_path=pg_catalog AS $$BEGIN RETURN v~'^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\.[0-9]{3}Z$' AND to_char(v::timestamptz AT TIME ZONE 'UTC','YYYY-MM-DD"T"HH24:MI:SS.MS"Z"')=v;EXCEPTION WHEN OTHERS THEN RETURN false;END;$$;
CREATE FUNCTION anvil.fn95_bundle(v jsonb) RETURNS boolean LANGUAGE plpgsql IMMUTABLE SET search_path=pg_catalog AS $$
DECLARE d jsonb=v->'descriptor';p jsonb=v->'packageRecord';b jsonb=v->'buildReceipt';s jsonb;h text;BEGIN
 IF NOT coalesce(anvil.fn95_keys(v,ARRAY['descriptor','packageRecord','buildReceipt']),false) OR octet_length(convert_to(anvil.fn95_canonical(v),'UTF8'))>65536 THEN RETURN false;END IF;
 FOREACH s IN ARRAY ARRAY[d,p,b] LOOP
  IF NOT coalesce(anvil.fn95_keys(s,ARRAY['ref','snapshot']) AND anvil.fn95_ref(s->'ref') AND s->'ref'->>'contentHash'=anvil.fn95_hash(s->'snapshot') AND s->'snapshot'->'schemaVersion'='1'::jsonb AND anvil.fn95_iso(s->'snapshot'->>'issuedAt') AND anvil.fn95_iso(s->'snapshot'->>'expiresAt') AND (s->'snapshot'->>'issuedAt')::timestamptz<(s->'snapshot'->>'expiresAt')::timestamptz,false) THEN RETURN false;END IF;
 END LOOP;
 IF NOT coalesce(anvil.fn95_keys(d->'snapshot',ARRAY['schemaVersion','purpose','nativeFactoryRef','packageRef','buildReceiptRef','rootId','relativePath','workerHash','issuedAt','expiresAt']) AND anvil.fn95_keys(p->'snapshot',ARRAY['schemaVersion','purpose','parentExeHash','parentAsarHash','parentHeaderHash','issuedAt','expiresAt']) AND anvil.fn95_keys(b->'snapshot',ARRAY['schemaVersion','purpose','nativeFactoryRef','packageRef','compileInputHash','sourceHash','workerHash','issuedAt','expiresAt']),false) THEN RETURN false;END IF;
 FOREACH h IN ARRAY ARRAY[d->'snapshot'->>'workerHash',p->'snapshot'->>'parentExeHash',p->'snapshot'->>'parentAsarHash',p->'snapshot'->>'parentHeaderHash',b->'snapshot'->>'compileInputHash',b->'snapshot'->>'sourceHash',b->'snapshot'->>'workerHash'] LOOP IF h IS NULL OR h!~'^[0-9a-f]{64}$' OR h=repeat('0',64) THEN RETURN false;END IF;END LOOP;
 RETURN coalesce(d->'snapshot'->>'purpose'='NATIVE_PREPARATION_WORKER_DESCRIPTOR' AND p->'snapshot'->>'purpose'='NATIVE_FACTORY_PACKAGE_BASIS' AND b->'snapshot'->>'purpose'='NATIVE_WORKER_BUILD_RECEIPT'
 AND anvil.fn95_ref(d->'snapshot'->'nativeFactoryRef') AND d->'snapshot'->>'rootId'~'^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$' AND d->'snapshot'->>'relativePath'='OwnershipEvidenceWorker.exe'
 AND d->'ref'->'id'=d->'snapshot'->'nativeFactoryRef'->'id' AND d->'ref'->'version'=d->'snapshot'->'nativeFactoryRef'->'version'
 AND d->'snapshot'->'packageRef'=p->'ref' AND d->'snapshot'->'buildReceiptRef'=b->'ref' AND b->'snapshot'->'packageRef'=p->'ref' AND b->'snapshot'->'nativeFactoryRef'=d->'snapshot'->'nativeFactoryRef' AND b->'snapshot'->'workerHash'=d->'snapshot'->'workerHash'
 AND (d->'snapshot'->>'issuedAt')::timestamptz>=greatest((p->'snapshot'->>'issuedAt')::timestamptz,(b->'snapshot'->>'issuedAt')::timestamptz)
 AND (d->'snapshot'->>'expiresAt')::timestamptz<=least((p->'snapshot'->>'expiresAt')::timestamptz,(b->'snapshot'->>'expiresAt')::timestamptz),false);
 EXCEPTION WHEN OTHERS THEN RETURN false;END;$$;

CREATE TABLE anvil.worker_deployment_bundles(
 factory_ref jsonb PRIMARY KEY CHECK(anvil.fn95_ref(factory_ref)),
 head_id uuid NOT NULL UNIQUE,
 bundle jsonb NOT NULL CHECK(anvil.fn95_bundle(bundle)),
 -- 각 head의 닫힌 형상은 4096 bytes 미만이다. 최초 게시에서 회수 행을 포함한 두 행을 예약한다.
 reserved_bytes bigint NOT NULL CHECK(reserved_bytes=octet_length(convert_to(anvil.fn95_canonical(bundle),'UTF8'))+8192),
 CHECK(factory_ref=bundle->'descriptor'->'snapshot'->'nativeFactoryRef')
);
CREATE TABLE anvil.worker_deployment_heads(
 head_id uuid NOT NULL REFERENCES anvil.worker_deployment_bundles(head_id),
 sequence integer NOT NULL CHECK(sequence IN(1,2)),
 request_id uuid NOT NULL UNIQUE,
 request_hash text NOT NULL CHECK(request_hash~'^[0-9a-f]{64}$'),
 head jsonb NOT NULL CHECK(octet_length(convert_to(anvil.fn95_canonical(head),'UTF8'))<4096),
 PRIMARY KEY(head_id,sequence)
);
CREATE UNIQUE INDEX worker_factory_identity ON anvil.worker_deployment_bundles((factory_ref->>'id'),(factory_ref->>'version'));
ALTER TABLE anvil.worker_deployment_bundles OWNER TO worker_owner;
ALTER TABLE anvil.worker_deployment_heads OWNER TO worker_owner;
ALTER TABLE anvil.worker_deployment_bundles ENABLE ROW LEVEL SECURITY;
ALTER TABLE anvil.worker_deployment_heads ENABLE ROW LEVEL SECURITY;
ALTER TABLE anvil.worker_deployment_bundles FORCE ROW LEVEL SECURITY;
ALTER TABLE anvil.worker_deployment_heads FORCE ROW LEVEL SECURITY;
CREATE POLICY worker_bundle_read ON anvil.worker_deployment_bundles FOR SELECT TO worker_owner USING(true);
CREATE POLICY worker_bundle_insert ON anvil.worker_deployment_bundles FOR INSERT TO worker_owner WITH CHECK(true);
CREATE POLICY worker_head_read ON anvil.worker_deployment_heads FOR SELECT TO worker_owner USING(true);
CREATE POLICY worker_head_insert ON anvil.worker_deployment_heads FOR INSERT TO worker_owner WITH CHECK(true);
REVOKE ALL ON anvil.worker_deployment_bundles FROM PUBLIC, anvil_v3_app, worker_publisher;
REVOKE ALL ON anvil.worker_deployment_heads FROM PUBLIC, anvil_v3_app, worker_publisher;

CREATE FUNCTION anvil.fn95_append_only() RETURNS trigger LANGUAGE plpgsql SET search_path=pg_catalog AS $$BEGIN RAISE EXCEPTION 'WORKER_APPEND_ONLY';END;$$;
CREATE TRIGGER worker_bundle_immutable BEFORE UPDATE OR DELETE OR TRUNCATE ON anvil.worker_deployment_bundles FOR EACH STATEMENT EXECUTE FUNCTION anvil.fn95_append_only();
CREATE TRIGGER worker_head_immutable BEFORE UPDATE OR DELETE OR TRUNCATE ON anvil.worker_deployment_heads FOR EACH STATEMENT EXECUTE FUNCTION anvil.fn95_append_only();
CREATE FUNCTION anvil.fn95_complete() RETURNS trigger LANGUAGE plpgsql SECURITY DEFINER SET search_path=pg_catalog AS $$
DECLARE b anvil.worker_deployment_bundles;h anvil.worker_deployment_heads;s jsonb;prior jsonb;BEGIN
 SELECT * INTO b FROM anvil.worker_deployment_bundles WHERE head_id=NEW.head_id;
 IF b.head_id IS NULL OR NOT EXISTS(SELECT 1 FROM anvil.worker_deployment_heads WHERE head_id=b.head_id AND sequence=1) THEN RAISE EXCEPTION 'WORKER_GRAPH_INCOMPLETE';END IF;
 FOR h IN SELECT * FROM anvil.worker_deployment_heads WHERE head_id=b.head_id ORDER BY sequence LOOP
  s=h.head->'snapshot';
  IF NOT coalesce(anvil.fn95_keys(h.head,ARRAY['ref','snapshot']) AND anvil.fn95_keys(s,ARRAY['schemaVersion','purpose','nativeFactoryRef','descriptorRef','sequence','previousHeadRef','state','updatedAt','expiresAt']) AND anvil.fn95_ref(h.head->'ref') AND h.head->'ref'=jsonb_build_object('id',b.head_id,'version',h.sequence,'contentHash',anvil.fn95_hash(s)) AND s->'schemaVersion'='1'::jsonb AND s->>'purpose'='NATIVE_WORKER_DEPLOYMENT_HEAD' AND s->'nativeFactoryRef'=b.factory_ref AND s->'descriptorRef'=b.bundle->'descriptor'->'ref' AND s->'sequence'=to_jsonb(h.sequence) AND anvil.fn95_iso(s->>'updatedAt') AND s->>'expiresAt'=b.bundle->'descriptor'->'snapshot'->>'expiresAt',false) THEN RAISE EXCEPTION 'WORKER_GRAPH_INVALID';END IF;
  IF h.sequence=1 THEN
   IF s->>'state'<>'ACTIVE' OR s->'previousHeadRef'<>'null'::jsonb OR (s->>'updatedAt')::timestamptz<(b.bundle->'descriptor'->'snapshot'->>'issuedAt')::timestamptz OR (s->>'updatedAt')::timestamptz>=(s->>'expiresAt')::timestamptz OR h.request_hash<>anvil.fn95_hash(b.bundle) THEN RAISE EXCEPTION 'WORKER_HEAD_INVALID';END IF;
  ELSE
   IF s->>'state'<>'REVOKED' OR s->'previousHeadRef' IS DISTINCT FROM prior->'ref' OR (s->>'updatedAt')::timestamptz<(prior->'snapshot'->>'updatedAt')::timestamptz OR h.request_hash<>anvil.fn95_hash(jsonb_build_object('nativeFactoryRef',b.factory_ref,'expectedHeadRef',prior->'ref')) THEN RAISE EXCEPTION 'WORKER_REVOKE_INVALID';END IF;
  END IF;prior=h.head;
 END LOOP;RETURN NULL;END;$$;
CREATE CONSTRAINT TRIGGER worker_bundle_complete AFTER INSERT ON anvil.worker_deployment_bundles DEFERRABLE INITIALLY DEFERRED FOR EACH ROW EXECUTE FUNCTION anvil.fn95_complete();
CREATE CONSTRAINT TRIGGER worker_head_complete AFTER INSERT ON anvil.worker_deployment_heads DEFERRABLE INITIALLY DEFERRED FOR EACH ROW EXECUTE FUNCTION anvil.fn95_complete();

CREATE FUNCTION anvil.worker_deployment_publish(request_id uuid,bundle jsonb) RETURNS jsonb LANGUAGE plpgsql SECURITY DEFINER SET search_path=pg_catalog AS $$
DECLARE old anvil.worker_deployment_heads;f jsonb;hid uuid;stamp text;s jsonb;result jsonb;charge bigint;BEGIN
 IF current_setting('transaction_isolation')<>'read committed' THEN RAISE EXCEPTION 'WORKER_ISOLATION_UNSUPPORTED';END IF;
 IF request_id IS NULL OR NOT anvil.fn95_bundle(bundle) THEN RAISE EXCEPTION 'WORKER_INPUT_INVALID';END IF;
 LOCK TABLE anvil.worker_deployment_bundles IN EXCLUSIVE MODE;
 SELECT * INTO old FROM anvil.worker_deployment_heads h WHERE h.request_id=worker_deployment_publish.request_id;
 IF old.head_id IS NOT NULL THEN IF old.sequence<>1 OR old.request_hash<>anvil.fn95_hash(bundle) THEN RAISE EXCEPTION 'WORKER_REQUEST_CONFLICT';END IF;RETURN old.head;END IF;
 f=bundle->'descriptor'->'snapshot'->'nativeFactoryRef';
 IF EXISTS(SELECT 1 FROM anvil.worker_deployment_bundles b WHERE b.factory_ref=f) THEN RAISE EXCEPTION 'WORKER_FACTORY_ALREADY_PUBLISHED';END IF;
 charge=octet_length(convert_to(anvil.fn95_canonical(bundle),'UTF8'))+8192;
 IF (SELECT count(*) FROM anvil.worker_deployment_bundles)>=1000 OR (SELECT coalesce(sum(reserved_bytes),0) FROM anvil.worker_deployment_bundles)+charge>67108864 THEN RAISE EXCEPTION 'WORKER_CAPACITY';END IF;
 stamp=to_char(clock_timestamp() AT TIME ZONE 'UTC','YYYY-MM-DD"T"HH24:MI:SS.MS"Z"');
 IF stamp::timestamptz<(bundle->'descriptor'->'snapshot'->>'issuedAt')::timestamptz OR stamp::timestamptz>=(bundle->'descriptor'->'snapshot'->>'expiresAt')::timestamptz THEN RAISE EXCEPTION 'WORKER_NOT_CURRENT';END IF;
 hid=gen_random_uuid();s=jsonb_build_object('schemaVersion',1,'purpose','NATIVE_WORKER_DEPLOYMENT_HEAD','nativeFactoryRef',f,'descriptorRef',bundle->'descriptor'->'ref','sequence',1,'previousHeadRef',NULL,'state','ACTIVE','updatedAt',stamp,'expiresAt',bundle->'descriptor'->'snapshot'->>'expiresAt');result=jsonb_build_object('ref',jsonb_build_object('id',hid,'version',1,'contentHash',anvil.fn95_hash(s)),'snapshot',s);
 INSERT INTO anvil.worker_deployment_bundles VALUES(f,hid,bundle,charge);
 INSERT INTO anvil.worker_deployment_heads VALUES(hid,1,request_id,anvil.fn95_hash(bundle),result);
 RETURN result;END;$$;

CREATE FUNCTION anvil.worker_deployment_revoke(request_id uuid,factory jsonb,expected jsonb) RETURNS jsonb LANGUAGE plpgsql SECURITY DEFINER SET search_path=pg_catalog AS $$
DECLARE b anvil.worker_deployment_bundles;old anvil.worker_deployment_heads;prior jsonb;digest text;stamp text;s jsonb;result jsonb;BEGIN
 IF current_setting('transaction_isolation')<>'read committed' THEN RAISE EXCEPTION 'WORKER_ISOLATION_UNSUPPORTED';END IF;
 IF request_id IS NULL OR NOT anvil.fn95_ref(factory) OR NOT anvil.fn95_ref(expected) OR expected->'version'<>'1'::jsonb THEN RAISE EXCEPTION 'WORKER_INPUT_INVALID';END IF;
 LOCK TABLE anvil.worker_deployment_bundles IN EXCLUSIVE MODE;
 digest=anvil.fn95_hash(jsonb_build_object('nativeFactoryRef',factory,'expectedHeadRef',expected));
 SELECT * INTO old FROM anvil.worker_deployment_heads h WHERE h.request_id=worker_deployment_revoke.request_id;
 SELECT * INTO b FROM anvil.worker_deployment_bundles WHERE factory_ref=factory;
 IF old.head_id IS NOT NULL THEN IF old.sequence<>2 OR old.request_hash<>digest OR old.head_id IS DISTINCT FROM b.head_id THEN RAISE EXCEPTION 'WORKER_REQUEST_CONFLICT';END IF;RETURN jsonb_build_object('bundle',b.bundle,'head',old.head);END IF;
 SELECT head INTO prior FROM anvil.worker_deployment_heads WHERE head_id=b.head_id ORDER BY sequence DESC LIMIT 1;
 IF b.head_id IS NULL OR prior->'ref' IS DISTINCT FROM expected OR prior->'snapshot'->>'state'<>'ACTIVE' THEN RAISE EXCEPTION 'WORKER_HEAD_CONFLICT';END IF;
 stamp=to_char(clock_timestamp() AT TIME ZONE 'UTC','YYYY-MM-DD"T"HH24:MI:SS.MS"Z"');IF stamp::timestamptz<(prior->'snapshot'->>'updatedAt')::timestamptz THEN RAISE EXCEPTION 'WORKER_CLOCK_ROLLBACK';END IF;
 s=(prior->'snapshot')||jsonb_build_object('sequence',2,'previousHeadRef',expected,'state','REVOKED','updatedAt',stamp);result=jsonb_build_object('ref',jsonb_build_object('id',b.head_id,'version',2,'contentHash',anvil.fn95_hash(s)),'snapshot',s);
 INSERT INTO anvil.worker_deployment_heads VALUES(b.head_id,2,request_id,digest,result);
 RETURN jsonb_build_object('bundle',b.bundle,'head',result);END;$$;
CREATE FUNCTION anvil.worker_deployment_lookup(request_id uuid,request_hash text) RETURNS jsonb LANGUAGE sql STABLE SECURITY DEFINER SET search_path=pg_catalog AS $$SELECT h.head FROM anvil.worker_deployment_heads h WHERE h.request_id=$1 AND h.request_hash=$2;$$;
CREATE FUNCTION anvil.worker_deployment_read(factory jsonb) RETURNS jsonb LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog AS $$DECLARE result jsonb;BEGIN
 IF NOT anvil.fn95_ref(factory) THEN RAISE EXCEPTION 'WORKER_INPUT_INVALID';END IF;
 SELECT jsonb_build_object('bundle',b.bundle,'head',h.head,'observedAt',to_char(clock_timestamp() AT TIME ZONE 'UTC','YYYY-MM-DD"T"HH24:MI:SS.MS"Z"')) INTO result FROM anvil.worker_deployment_bundles b CROSS JOIN LATERAL(SELECT head FROM anvil.worker_deployment_heads WHERE head_id=b.head_id ORDER BY sequence DESC LIMIT 1) h WHERE b.factory_ref=factory;
 RETURN result;END;$$;

DO $$DECLARE f record;BEGIN
 FOR f IN SELECT p.oid::regprocedure AS signature FROM pg_catalog.pg_proc p JOIN pg_catalog.pg_namespace n ON n.oid=p.pronamespace WHERE n.nspname='anvil' AND (p.proname LIKE 'fn95_%' OR p.proname IN ('worker_deployment_publish','worker_deployment_revoke','worker_deployment_lookup','worker_deployment_read')) LOOP
  EXECUTE format('ALTER FUNCTION %s OWNER TO worker_owner',f.signature);
  EXECUTE format('REVOKE ALL ON FUNCTION %s FROM PUBLIC,anvil_v3_app,worker_publisher',f.signature);
 END LOOP;
END;$$;
GRANT EXECUTE ON FUNCTION anvil.worker_deployment_read(jsonb) TO anvil_v3_app;
GRANT EXECUTE ON FUNCTION anvil.worker_deployment_publish(uuid,jsonb),anvil.worker_deployment_revoke(uuid,jsonb,jsonb),anvil.worker_deployment_lookup(uuid,text) TO worker_publisher;
REVOKE CREATE ON SCHEMA anvil FROM worker_owner;
-- Migrator만 소유 역할을 유지한다. 실제 publisher 서비스 membership은 생성하지 않는다.
COMMIT;
