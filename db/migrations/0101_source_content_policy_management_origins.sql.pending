-- FN03 관리 원문 A안의 미적용 forward 토대. 자동 적용/실행 manifest 등록 없음.
-- 목적 commit/read RPC의 최소 ACL/source caller 미연결: 원문 조회/저장 및 E INSERT는 계속 닫힌다.
-- 실제 PostgreSQL 구문/ACL/COMMIT 검증 아님. 이 파일은 같은 Stage의 후속 RPC 구현으로 이어진다.

-- 이미 존재하는 역할을 신뢰하거나 속성을 고쳐 재사용하지 않는다. 설치는 기존 migration 거래 경계에서 수행해야 한다.
CREATE ROLE anvil_v3_source_content_management_owner NOLOGIN NOINHERIT NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS;
DO $$
BEGIN
 IF pg_catalog.pg_has_role('anvil_v3_app','anvil_v3_source_content_management_owner','MEMBER') THEN
  RAISE EXCEPTION 'SOURCE_CONTENT_MANAGEMENT_ROLE_INVALID' USING ERRCODE='42501';
 END IF;
END;$$;
GRANT USAGE ON SCHEMA anvil TO anvil_v3_source_content_management_owner;

-- 기존 commands.id가 이미 PK이므로 행 의미/원hash를 바꾸지 않는 참조 대상 키다.
ALTER TABLE anvil.commands ADD CONSTRAINT source_content_management_command_hash_identity UNIQUE (project_id,id,request_hash);

CREATE TABLE anvil.source_content_policy_management_origins (
 project_id uuid NOT NULL REFERENCES anvil.projects(id) ON DELETE RESTRICT,
 id uuid NOT NULL,
 version smallint NOT NULL DEFAULT 1 CHECK(version=1),
 management_command_id uuid NOT NULL,
 policy_event_ref jsonb NOT NULL,
 request_json jsonb NOT NULL,
 request_hash text NOT NULL CHECK(request_hash~'^[0-9a-f]{64}$'),
 recorded_at timestamptz NOT NULL,
 content_hash text NOT NULL CHECK(content_hash~'^[0-9a-f]{64}$'),
 PRIMARY KEY (project_id,id,version),
 UNIQUE (project_id,id,version,content_hash),
 UNIQUE (project_id,management_command_id),
 UNIQUE (project_id,policy_event_ref),
 CONSTRAINT source_content_management_origin_command
  FOREIGN KEY (project_id,management_command_id,request_hash)
  REFERENCES anvil.commands(project_id,id,request_hash) ON DELETE RESTRICT DEFERRABLE INITIALLY DEFERRED,
 CONSTRAINT source_content_management_origin_event
  FOREIGN KEY (project_id,management_command_id)
  REFERENCES anvil.source_content_policy_events(project_id,management_command_id) ON DELETE RESTRICT DEFERRABLE INITIALLY DEFERRED,
 CONSTRAINT source_content_management_origin_event_ref CHECK((
  anvil.source_read_ref(policy_event_ref) IS TRUE AND policy_event_ref->'version'='1'::jsonb
 ) IS TRUE),
 CONSTRAINT source_content_management_origin_request CHECK((
  anvil.source_read_exact(request_json,ARRAY['schemaVersion','projectId','commandId','clientId','controlGeneration','operation','targetId','expectedVersion','baselineRefs','approvalRef','payload']) IS TRUE
  AND request_json->'schemaVersion'='1'::jsonb
  AND request_json->>'projectId'=project_id::text
  AND jsonb_typeof(request_json->'commandId')='string'
  AND request_json->>'commandId'~'^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$'
  AND jsonb_typeof(request_json->'clientId')='string'
  AND request_json->>'clientId'~'^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$'
  AND jsonb_typeof(request_json->'controlGeneration')='number'
  AND (request_json->>'controlGeneration')::numeric BETWEEN 1 AND 9007199254740991
  AND trunc((request_json->>'controlGeneration')::numeric)=(request_json->>'controlGeneration')::numeric
  AND request_json->'operation'='"defineSourceContentPolicy"'::jsonb
  AND request_json->'targetId'='null'::jsonb AND request_json->'expectedVersion'='0'::jsonb
  AND request_json->'baselineRefs'='[]'::jsonb AND request_json->'approvalRef'='null'::jsonb
  AND anvil.source_read_exact(request_json->'payload',ARRAY['previousPolicyRef','definition','reason']) IS TRUE
  AND octet_length(convert_to(anvil.source_read_canonical_json(request_json),'UTF8'))<=1048576
  AND request_hash=anvil.source_read_hash(request_json)
 ) IS TRUE),
 CONSTRAINT source_content_management_origin_time CHECK(
  isfinite(recorded_at) AND recorded_at=date_trunc('milliseconds',recorded_at)
 ),
 -- exact10은 도출값이며 별도 물리열/원문 text 복제를 만들지 않는다.
 CONSTRAINT source_content_management_origin_hash CHECK((
  content_hash=anvil.source_read_hash(jsonb_build_object(
   'schemaVersion',1,'purpose','SOURCE_CONTENT_POLICY_MANAGEMENT_ORIGIN','id',id,'version',1,
   'projectId',project_id,'managementCommandId',management_command_id,'policyEventRef',policy_event_ref,
   'originalRequest',request_json,'requestHash',request_hash,'recordedAt',anvil.source_read_iso(recorded_at)))
  AND octet_length(convert_to(anvil.source_read_canonical_json(jsonb_build_object(
   'schemaVersion',1,'purpose','SOURCE_CONTENT_POLICY_MANAGEMENT_ORIGIN','id',id,'version',1,
   'projectId',project_id,'managementCommandId',management_command_id,'policyEventRef',policy_event_ref,
   'originalRequest',request_json,'requestHash',request_hash,'recordedAt',anvil.source_read_iso(recorded_at))),'UTF8'))<=2097152
 ) IS TRUE)
);

ALTER TABLE anvil.source_content_policy_management_origins ENABLE ROW LEVEL SECURITY;
ALTER TABLE anvil.source_content_policy_management_origins FORCE ROW LEVEL SECURITY;
REVOKE ALL ON anvil.source_content_policy_management_origins FROM PUBLIC,anvil_v3_app,anvil_v3_source_content_management_owner;
CREATE POLICY source_content_management_unavailable ON anvil.source_content_policy_management_origins USING(false) WITH CHECK(false);
CREATE TRIGGER source_content_management_unavailable BEFORE INSERT ON anvil.source_content_policy_management_origins
 FOR EACH ROW EXECUTE FUNCTION anvil.source_content_unavailable();
CREATE TRIGGER source_content_management_immutable BEFORE UPDATE OR DELETE ON anvil.source_content_policy_management_origins
 FOR EACH ROW EXECUTE FUNCTION anvil.source_content_append_only();
CREATE TRIGGER source_content_management_no_truncate BEFORE TRUNCATE ON anvil.source_content_policy_management_origins
 FOR EACH STATEMENT EXECUTE FUNCTION anvil.source_content_append_only();

-- 역사 E의 원문 부재는 ORIGIN_ABSENT다. E 전체에 역FK/자료 변환/원문 재생성/역사 완결 스캔을 요구하지 않는다.
-- 새 목적 E->O 역완결은 후속 purpose guard/RPC에서만 구현한다. 위 FK는 관리 command 식별만 고정한다.
-- O.policy_event_ref 전체와 E의 id/version/content_hash, 원 q와 C actor/client/operation,
-- C/A/U 및 R의 정확5행+단일 예약·시각·봉인 plan/hash·정산·새Tx finalguard 대조는 아직 필수 미완료다.
-- 그 DAG/current/role별 EXEC 전이·목적16제약 flush/복원까지 연결하기 전 E의 기존 trigger/RLSfalse는 변경하지 않는다.
-- 새 역할의 표 SELECT/INSERT·잠금열 UPDATE와 private EXECUTE, app의 목적 RPC EXECUTE도 이번 토대에서 발급하지 않는다.

-- 업무B 첫 SQL 검수 단위: 실제 저장행 -> 물리 투영/비용 -> 역사 완결 -> 보호 bundle.
-- 아래 함수는 현재 인가를 발급하지 않으며 app/PUBLIC EXECUTE와 표 권한을 열지 않는다.
-- 16개 지연제약·역완결은 아래에 연결하며 ACL/source caller 검수 전 E/O 쓰기 차단은 그대로다.
CREATE FUNCTION anvil.fn03_management_physical(v jsonb) RETURNS jsonb LANGUAGE plpgsql IMMUTABLE SET search_path=pg_catalog AS $$
DECLARE pair record;t timestamptz;stamp text;
BEGIN
 IF jsonb_typeof(v) IS DISTINCT FROM 'object' THEN RAISE EXCEPTION 'SOURCE_CONTENT_MANAGEMENT_ROW_INVALID';END IF;
 FOR pair IN SELECT key,value FROM jsonb_each(v) LOOP
  IF pair.key~'(_at|_until)$' AND pair.value<>'null'::jsonb THEN
   IF jsonb_typeof(pair.value) IS DISTINCT FROM 'string' THEN RAISE EXCEPTION 'SOURCE_CONTENT_MANAGEMENT_ROW_INVALID';END IF;
   t=(pair.value#>>'{}')::timestamptz;stamp=to_char(t AT TIME ZONE 'UTC','YYYY-MM-DD"T"HH24:MI:SS.US"Z"');
   IF NOT isfinite(t) OR length(stamp)<>27 THEN RAISE EXCEPTION 'SOURCE_CONTENT_MANAGEMENT_ROW_INVALID';END IF;
   v=jsonb_set(v,ARRAY[pair.key],to_jsonb(stamp));
  END IF;
 END LOOP;
 RETURN v;
END;$$;
REVOKE ALL ON FUNCTION anvil.fn03_management_physical(jsonb) FROM PUBLIC,anvil_v3_app;

CREATE FUNCTION anvil.fn03_management_plan_valid(v jsonb) RETURNS boolean LANGUAGE plpgsql STABLE SET search_path=pg_catalog AS $$
DECLARE k text;part jsonb;ids jsonb;n numeric;stamp timestamptz;
BEGIN
 IF anvil.source_read_exact(v,ARRAY['schemaVersion','purpose','projectId','actorId','clientId','authSessionId','credentialGeneration','controlGeneration','operation','externalCommandId','requestHash','permissionPolicyRef','originRef','policyEventRef','ids','coverageGeneration','authorizedUntil','transactionId','parts']) IS NOT TRUE
  OR v->'schemaVersion' IS DISTINCT FROM '1'::jsonb OR v->>'purpose' IS DISTINCT FROM 'SOURCE_CONTENT_POLICY_MANAGEMENT_STORAGE'
  OR v->>'operation' IS DISTINCT FROM 'defineSourceContentPolicy' THEN RETURN false;END IF;
 FOREACH k IN ARRAY ARRAY['projectId','actorId','clientId','authSessionId','externalCommandId'] LOOP
  IF jsonb_typeof(v->k) IS DISTINCT FROM 'string' OR v->>k!~'^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$' THEN RETURN false;END IF;
 END LOOP;
 FOREACH k IN ARRAY ARRAY['credentialGeneration','controlGeneration'] LOOP
  IF jsonb_typeof(v->k) IS DISTINCT FROM 'number' THEN RETURN false;END IF;
  n=(v->>k)::numeric;IF n NOT BETWEEN 1 AND 9007199254740991 OR n<>trunc(n) THEN RETURN false;END IF;
 END LOOP;
 IF jsonb_typeof(v->'coverageGeneration') IS DISTINCT FROM 'string' OR v->>'coverageGeneration'!~'^[1-9][0-9]{0,15}$' THEN RETURN false;END IF;
 IF (v->>'coverageGeneration')::numeric>9007199254740991 THEN RETURN false;END IF;
 IF jsonb_typeof(v->'transactionId') IS DISTINCT FROM 'string' OR v->>'transactionId'!~'^[1-9][0-9]{0,19}$' THEN RETURN false;END IF;
 IF (v->>'transactionId')::numeric>18446744073709551615 THEN RETURN false;END IF;
 IF jsonb_typeof(v->'requestHash') IS DISTINCT FROM 'string' OR v->>'requestHash'!~'^[0-9a-f]{64}$'
  OR anvil.source_read_ref(v->'permissionPolicyRef') IS NOT TRUE OR anvil.source_read_ref(v->'originRef') IS NOT TRUE
  OR anvil.source_read_ref(v->'policyEventRef') IS NOT TRUE OR v->'originRef'->'version' IS DISTINCT FROM '1'::jsonb
  OR v->'policyEventRef'->'version' IS DISTINCT FROM '1'::jsonb THEN RETURN false;END IF;
 IF jsonb_typeof(v->'authorizedUntil') IS DISTINCT FROM 'string' OR v->>'authorizedUntil'!~'^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\.[0-9]{3}Z$' THEN RETURN false;END IF;
 stamp=(v->>'authorizedUntil')::timestamptz;
 IF NOT isfinite(stamp) OR anvil.source_read_iso(stamp) IS DISTINCT FROM v->>'authorizedUntil' THEN RETURN false;END IF;
 ids=v->'ids';
 IF anvil.source_read_exact(ids,ARRAY['serverCommandId','operationId','authorizationReceiptId','auditEventId','policyEventId','originId']) IS NOT TRUE THEN RETURN false;END IF;
 FOR k IN SELECT jsonb_object_keys(ids) LOOP
  IF jsonb_typeof(ids->k) IS DISTINCT FROM 'string' OR ids->>k!~'^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$' THEN RETURN false;END IF;
 END LOOP;
 IF (SELECT count(DISTINCT value) FROM jsonb_each_text(ids))<>6
  OR ids->'originId' IS DISTINCT FROM v->'originRef'->'id' OR ids->'policyEventId' IS DISTINCT FROM v->'policyEventRef'->'id'
  OR jsonb_typeof(v->'parts') IS DISTINCT FROM 'array' THEN RETURN false;END IF;
 IF jsonb_array_length(v->'parts')<>1 THEN RETURN false;END IF;part=v->'parts'->0;
 IF anvil.source_read_exact(part,ARRAY['key','kind','id','contentHash','bytes','reservedBytes','settledBytes']) IS NOT TRUE
  OR part->>'key' IS DISTINCT FROM 'management_origin' OR part->>'kind' IS DISTINCT FROM 'SOURCE_CONTENT_POLICY_MANAGEMENT'
  OR part->'id' IS DISTINCT FROM v->'originRef'->'id' OR part->'contentHash' IS DISTINCT FROM v->'originRef'->'contentHash'
  OR jsonb_typeof(part->'bytes') IS DISTINCT FROM 'string' OR part->>'bytes'!~'^(0|[1-9][0-9]{0,10})$' THEN RETURN false;END IF;
 RETURN ((part->>'bytes')::numeric<=10737418240 AND part->'reservedBytes'=part->'bytes' AND part->'settledBytes'=part->'bytes') IS TRUE;
END;$$;
REVOKE ALL ON FUNCTION anvil.fn03_management_plan_valid(jsonb) FROM PUBLIC,anvil_v3_app;

-- 원 CM definition의 순수 형상. observation scope/실파일/서명·현재 권한을 대신하지 않는다.
CREATE FUNCTION anvil.fn03_management_definition_valid(d jsonb,reason jsonb,actor uuid,at_time timestamptz) RETURNS boolean LANGUAGE plpgsql STABLE SET search_path=pg_catalog AS $$
DECLARE k text;item jsonb;blob jsonb;limits jsonb;ordered jsonb='[]'::jsonb;expires timestamptz;
 path text;folded text;paths text[]='{}';documents text[]='{}';n numeric;total numeric=0;
 caps jsonb='{"maxFiles":200,"maxFileBytes":2097152,"maxTotalBytes":20971520,"maxObservationMs":30000,"maxReportBytes":1048576}'::jsonb;
BEGIN
 IF anvil.source_read_exact(d,ARRAY['protocolVersion','namespace','subjectUserId','disposition','expiresAt','allowedOperations','sourceRootRef','connectorRef','registrationRef','observerRef','targets','limits']) IS NOT TRUE
  OR d->'protocolVersion' IS DISTINCT FROM '1'::jsonb OR d->>'namespace' IS DISTINCT FROM 'SOURCE_DOCUMENT_CONTENT_HASH_V1'
  OR d->>'subjectUserId' IS DISTINCT FROM actor::text OR d->>'disposition' IS NULL OR d->>'disposition' NOT IN('AUTO','DENY','REVOKED')
  OR jsonb_typeof(d->'expiresAt') IS DISTINCT FROM 'string' OR d->>'expiresAt'!~'^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\.[0-9]{3}Z$' THEN RETURN false;END IF;
 expires=(d->>'expiresAt')::timestamptz;
 IF at_time IS NULL OR NOT isfinite(at_time) OR NOT isfinite(expires) OR expires<=at_time OR anvil.source_read_iso(expires) IS DISTINCT FROM d->>'expiresAt' THEN RETURN false;END IF;
 FOREACH k IN ARRAY ARRAY['sourceRootRef','connectorRef','registrationRef','observerRef'] LOOP
  IF anvil.source_read_ref(d->k) IS NOT TRUE THEN RETURN false;END IF;
 END LOOP;
 IF jsonb_typeof(d->'allowedOperations') IS DISTINCT FROM 'array' THEN RETURN false;END IF;
 IF jsonb_array_length(d->'allowedOperations')>3 THEN RETURN false;END IF;
 FOREACH k IN ARRAY ARRAY['linkDocumentSource','requestSourceContentHash','revokeSourceContentHash'] LOOP
  IF d->'allowedOperations' ? k THEN ordered=ordered||jsonb_build_array(k);END IF;
 END LOOP;
 IF ordered IS DISTINCT FROM d->'allowedOperations' OR (d->>'disposition'='AUTO' AND ordered='[]'::jsonb)
  OR (d->>'disposition'<>'AUTO' AND ordered<>'[]'::jsonb) THEN RETURN false;END IF;
 IF jsonb_typeof(reason) IS DISTINCT FROM 'string' OR anvil.source_content_nonblank(reason#>>'{}') IS NOT TRUE
  OR anvil.source_read_utf16_length(reason#>>'{}')>20000 OR regexp_replace(reason#>>'{}',E'[\t\n\r]','','g') COLLATE "C" ~ '[[:cntrl:]]' THEN RETURN false;END IF;
 limits=d->'limits';
 IF anvil.source_read_exact(limits,ARRAY['maxFiles','maxFileBytes','maxTotalBytes','maxObservationMs','maxReportBytes']) IS NOT TRUE THEN RETURN false;END IF;
 FOR k IN SELECT jsonb_object_keys(caps) LOOP
  IF jsonb_typeof(limits->k) IS DISTINCT FROM 'number' THEN RETURN false;END IF;
  n=(limits->>k)::numeric;IF n<=0 OR n<>trunc(n) OR n>(caps->>k)::numeric THEN RETURN false;END IF;
 END LOOP;
 IF jsonb_typeof(d->'targets') IS DISTINCT FROM 'array' THEN RETURN false;END IF;
 IF jsonb_array_length(d->'targets') NOT BETWEEN 1 AND 200 OR jsonb_array_length(d->'targets')>(limits->>'maxFiles')::integer THEN RETURN false;END IF;
 FOR item IN SELECT value FROM jsonb_array_elements(d->'targets') LOOP
  IF anvil.source_read_exact(item,ARRAY['relativePath','documentRef','documentBlobRef']) IS NOT TRUE
   OR jsonb_typeof(item->'relativePath') IS DISTINCT FROM 'string' OR anvil.source_read_ref(item->'documentRef') IS NOT TRUE THEN RETURN false;END IF;
  path=item->>'relativePath';folded=anvil.source_read_uppercase_v1(path);
  IF anvil.source_read_relative_file(path) IS NOT TRUE OR folded COLLATE "C"=ANY(paths) OR item->'documentRef'->>'id'=ANY(documents) THEN RETURN false;END IF;
  paths=array_append(paths,folded);documents=array_append(documents,item->'documentRef'->>'id');blob=item->'documentBlobRef';
  IF anvil.source_read_exact(blob,ARRAY['artifactId','bytes','contentHash','mediaType']) IS NOT TRUE
   OR jsonb_typeof(blob->'artifactId') IS DISTINCT FROM 'string' OR blob->>'artifactId'!~'^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$'
   OR jsonb_typeof(blob->'bytes') IS DISTINCT FROM 'number' OR jsonb_typeof(blob->'contentHash') IS DISTINCT FROM 'string' OR blob->>'contentHash'!~'^[0-9a-f]{64}$'
   OR jsonb_typeof(blob->'mediaType') IS DISTINCT FROM 'string' OR anvil.source_content_nonblank(blob->>'mediaType') IS NOT TRUE
   OR anvil.source_read_utf16_length(blob->>'mediaType')>200 OR (blob->>'mediaType') COLLATE "C" ~ '[[:cntrl:]]' THEN RETURN false;END IF;
  n=(blob->>'bytes')::numeric;total=total+n;
  IF n<0 OR n<>trunc(n) OR n>(limits->>'maxFileBytes')::numeric OR total>(limits->>'maxTotalBytes')::numeric THEN RETURN false;END IF;
 END LOOP;
 RETURN true;
END;$$;
REVOKE ALL ON FUNCTION anvil.fn03_management_definition_valid(jsonb,jsonb,uuid,timestamptz) FROM PUBLIC,anvil_v3_app;

CREATE FUNCTION anvil.fn03_management_rows(p uuid,cid uuid) RETURNS jsonb LANGUAGE plpgsql STABLE SET search_path=pg_catalog AS $$
DECLARE o anvil.source_content_policy_management_origins;e anvil.source_content_policy_events;c anvil.commands;
 a anvil.authorization_receipts;u anvil.audit_events;r anvil.project_storage_reservations;
BEGIN
 SELECT x.* INTO STRICT c FROM anvil.commands x WHERE x.project_id=p AND x.id=cid AND x.operation='defineSourceContentPolicy';
 SELECT x.* INTO STRICT o FROM anvil.source_content_policy_management_origins x WHERE x.project_id=p AND x.management_command_id=cid;
 SELECT x.* INTO STRICT e FROM anvil.source_content_policy_events x WHERE x.project_id=p AND x.management_command_id=cid;
 SELECT x.* INTO STRICT a FROM anvil.authorization_receipts x WHERE x.scope_kind='PROJECT' AND x.scope_id=p AND x.command_id=cid;
 SELECT x.* INTO STRICT u FROM anvil.audit_events x WHERE x.project_id=p AND x.command_id=cid;
 SELECT x.* INTO STRICT r FROM anvil.project_storage_reservations x WHERE x.project_id=p AND x.id=cid;
 RETURN jsonb_build_object('O',anvil.fn03_management_physical(to_jsonb(o)),'E',anvil.fn03_management_physical(to_jsonb(e)),
  'C',anvil.fn03_management_physical(to_jsonb(c)),'A',anvil.fn03_management_physical(to_jsonb(a)),
  'U',anvil.fn03_management_physical(to_jsonb(u))||jsonb_build_object('server_sequence',u.server_sequence::text),
  'R',anvil.fn03_management_physical(to_jsonb(r)));
EXCEPTION WHEN no_data_found OR too_many_rows THEN RAISE EXCEPTION 'SOURCE_CONTENT_MANAGEMENT_ROWS_INCOMPLETE';
END;$$;
REVOKE ALL ON FUNCTION anvil.fn03_management_rows(uuid,uuid) FROM PUBLIC,anvil_v3_app;

CREATE FUNCTION anvil.fn03_management_actual(p uuid,cid uuid) RETURNS bigint LANGUAGE plpgsql STABLE SET search_path=pg_catalog AS $$
DECLARE rows jsonb;kind text;total numeric=0;
BEGIN
 rows=anvil.fn03_management_rows(p,cid);
 FOREACH kind IN ARRAY ARRAY['O','E','C','A','U'] LOOP
  total=total+anvil.fn75_cost(anvil.fn09_registered_cost_projection(rows->kind));
 END LOOP;
 IF total>10737418240 THEN RAISE EXCEPTION 'PROJECT_STORAGE_LIMIT_EXCEEDED';END IF;
 RETURN total::bigint;
END;$$;
REVOKE ALL ON FUNCTION anvil.fn03_management_actual(uuid,uuid) FROM PUBLIC,anvil_v3_app;

-- prepared은 실제 발급된 정확5행 투영이다. 미래 done/U순번만 비용 상계로 치환하며 저장/권위에 사용하지 않는다.
CREATE FUNCTION anvil.fn03_management_maximum(prepared jsonb,template jsonb) RETURNS bigint LANGUAGE plpgsql IMMUTABLE SET search_path=pg_catalog AS $$
DECLARE kind text;row_value jsonb;total numeric=0;stamp text='2000-01-01T00:00:00.000000Z';
BEGIN
 IF anvil.source_read_exact(prepared,ARRAY['O','E','C','A','U']) IS NOT TRUE OR jsonb_typeof(template) IS DISTINCT FROM 'object'
  OR template->>'part_kind' IS DISTINCT FROM 'SOURCE_CONTENT_POLICY_MANAGEMENT' THEN RAISE EXCEPTION 'SOURCE_CONTENT_MANAGEMENT_TEMPLATE_INVALID';END IF;
 FOREACH kind IN ARRAY ARRAY['O','E','C','A','U'] LOOP
  row_value=prepared->kind;
  IF kind='C' THEN row_value=jsonb_set(row_value||jsonb_build_object('completed_at',stamp),'{result_ref,serverReceivedAt}','"2000-01-01T00:00:00.000Z"'::jsonb);
  ELSIF kind='A' THEN row_value=row_value||jsonb_build_object('authorized_at',stamp);
  ELSIF kind='U' THEN row_value=row_value||jsonb_build_object('recorded_at',stamp,'server_sequence','9223372036854775807');END IF;
  total=total+anvil.fn75_cost(anvil.fn09_registered_cost_projection(row_value));
 END LOOP;
 IF total>10737418240 THEN RAISE EXCEPTION 'PROJECT_STORAGE_LIMIT_EXCEEDED';END IF;
 RETURN total::bigint;
END;$$;
REVOKE ALL ON FUNCTION anvil.fn03_management_maximum(jsonb,jsonb) FROM PUBLIC,anvil_v3_app;

-- 기존 R 비용식만 재사용. sealed NULL은 예약 r, supplied r은 불변 PLAN(r)의 정산 s다.
CREATE FUNCTION anvil.fn03_management_fixed_point(base bigint,template jsonb,sealed bigint DEFAULT NULL) RETURNS bigint LANGUAGE plpgsql IMMUTABLE SET search_path=pg_catalog AS $$
DECLARE value bigint;next_value numeric;own bigint;iteration integer;
BEGIN
 IF base IS NULL OR base<0 OR base>10737418240 OR sealed IS NOT NULL AND (sealed<0 OR sealed>10737418240) THEN RAISE EXCEPTION 'PROJECT_STORAGE_LIMIT_EXCEEDED';END IF;
 value=base;
 FOR iteration IN 1..64 LOOP
  IF sealed IS NULL THEN
   own=greatest(anvil.fn09_registered_reservation_cost(template,'RESERVED',value,0),anvil.fn09_registered_reservation_cost(template,'IO_STARTED',value,0),anvil.fn09_registered_reservation_cost(template,'SETTLED',value,value));
  ELSE
   IF value>sealed THEN RAISE EXCEPTION 'PROJECT_STORAGE_LIMIT_EXCEEDED';END IF;
   own=anvil.fn09_registered_reservation_cost(template,'SETTLED',sealed,value);
  END IF;
  next_value=greatest(value::numeric,base::numeric+own::numeric);
  IF next_value>10737418240 OR sealed IS NOT NULL AND next_value>sealed THEN RAISE EXCEPTION 'PROJECT_STORAGE_LIMIT_EXCEEDED';END IF;
  IF next_value=value THEN RETURN value;END IF;value=next_value::bigint;
 END LOOP;
 RAISE EXCEPTION 'SOURCE_CONTENT_MANAGEMENT_FIXED_POINT_UNRESOLVED';
END;$$;
REVOKE ALL ON FUNCTION anvil.fn03_management_fixed_point(bigint,jsonb,bigint) FROM PUBLIC,anvil_v3_app;

CREATE FUNCTION anvil.fn03_management_complete(p uuid,cid uuid) RETURNS boolean LANGUAGE plpgsql STABLE SET search_path=pg_catalog AS $$
DECLARE rows jsonb;plan jsonb;q jsonb;ids jsonb;er jsonb;orr jsonb;digest text;expected_result jsonb;
 o anvil.source_content_policy_management_origins;e anvil.source_content_policy_events;b anvil.source_content_policy_events;
 c anvil.commands;a anvil.authorization_receipts;u anvil.audit_events;r anvil.project_storage_reservations;
 maximum bigint;actual bigint;reserved bigint;settled bigint;
BEGIN
 rows=anvil.fn03_management_rows(p,cid);
 SELECT * INTO o FROM jsonb_populate_record(NULL::anvil.source_content_policy_management_origins,rows->'O');
 SELECT * INTO e FROM jsonb_populate_record(NULL::anvil.source_content_policy_events,rows->'E');
 SELECT * INTO c FROM jsonb_populate_record(NULL::anvil.commands,rows->'C');
 SELECT * INTO a FROM jsonb_populate_record(NULL::anvil.authorization_receipts,rows->'A');
 SELECT * INTO u FROM jsonb_populate_record(NULL::anvil.audit_events,rows->'U');
 SELECT * INTO r FROM jsonb_populate_record(NULL::anvil.project_storage_reservations,rows->'R');
 plan=r.plan_json;q=o.request_json;ids=plan->'ids';
 IF anvil.fn03_management_plan_valid(plan) IS NOT TRUE OR r.plan_hash IS DISTINCT FROM anvil.source_read_hash(plan) THEN RETURN false;END IF;
 IF e.sequence>1 THEN SELECT x.* INTO STRICT b FROM anvil.source_content_policy_events x WHERE x.project_id=p AND x.sequence=e.sequence-1;END IF;
 IF anvil.source_content_policy_lineage_shape(b,e) IS NOT TRUE
  OR anvil.fn03_management_definition_valid(q->'payload'->'definition',q->'payload'->'reason',c.actor_id,e.recorded_at) IS NOT TRUE THEN RETURN false;END IF;
 er=jsonb_build_object('id',e.id,'version',1,'contentHash',e.content_hash);
 orr=jsonb_build_object('id',o.id,'version',1,'contentHash',o.content_hash);
 IF (o.project_id=p AND e.project_id=p AND o.management_command_id=cid AND e.management_command_id=cid
  AND o.policy_event_ref=er AND o.request_hash=anvil.source_read_hash(q) AND o.request_hash=c.request_hash
  AND o.content_hash=anvil.source_read_hash(jsonb_build_object('schemaVersion',1,'purpose','SOURCE_CONTENT_POLICY_MANAGEMENT_ORIGIN','id',o.id,'version',1,'projectId',p,'managementCommandId',cid,'policyEventRef',er,'originalRequest',q,'requestHash',o.request_hash,'recordedAt',anvil.source_read_iso(o.recorded_at)))
  AND q->>'projectId'=p::text AND q->>'commandId'=c.command_id::text AND q->>'clientId'=c.client_id::text
  AND q->'controlGeneration'=to_jsonb(c.control_generation) AND q->>'operation'='defineSourceContentPolicy'
  AND q->'targetId'='null'::jsonb AND q->'expectedVersion'='0'::jsonb AND q->'baselineRefs'='[]'::jsonb AND q->'approvalRef'='null'::jsonb
  AND q->'payload'->'previousPolicyRef'=e.previous_ref AND e.subject_user_id=c.actor_id
  AND e.snapshot_json=(q->'payload'->'definition')||jsonb_build_object('projectId',p,'sequence',e.sequence,'recordedAt',anvil.source_read_iso(e.recorded_at),'reason',q->'payload'->'reason')) IS NOT TRUE THEN RETURN false;END IF;
 IF plan->>'projectId' IS DISTINCT FROM p::text OR plan->>'actorId' IS DISTINCT FROM c.actor_id::text OR plan->>'clientId' IS DISTINCT FROM c.client_id::text
  OR plan->>'externalCommandId' IS DISTINCT FROM c.command_id::text OR plan->>'requestHash' IS DISTINCT FROM c.request_hash
  OR plan->'controlGeneration' IS DISTINCT FROM to_jsonb(c.control_generation) OR plan->'permissionPolicyRef' IS DISTINCT FROM c.policy_ref
  OR plan->'originRef' IS DISTINCT FROM orr OR plan->'policyEventRef' IS DISTINCT FROM er
  OR ids IS DISTINCT FROM jsonb_build_object('serverCommandId',cid,'operationId',c.operation_id,'authorizationReceiptId',a.id,'auditEventId',u.event_id,'policyEventId',e.id,'originId',o.id) THEN RETURN false;END IF;
 digest=anvil.source_read_hash(jsonb_build_object('projectId',p,'actorId',c.actor_id,'clientId',c.client_id,'controlGeneration',c.control_generation,'requestHash',c.request_hash,'policyRef',c.policy_ref,'targetRef',er));
 expected_result=jsonb_build_object('operationId',c.operation_id,'commandId',c.command_id,'projectId',p,'status','APPLIED','targetId',e.id,'version',1,
  'data',jsonb_build_object('ref',er,'status','CONTENT_POLICY_EVENT_RECORDED','policyRef',er,'previousPolicyRef',e.previous_ref,'sequence',e.sequence,'executionAuthorized',false,'agentDispatchPerformed',false,'baselineConfirmed',false,'linkAuthorized',false),
  'evidenceRefs','[]'::jsonb,'warnings','[]'::jsonb,'serverReceivedAt',anvil.source_read_iso(c.completed_at));
 IF (c.scope_kind='PROJECT' AND c.scope_id=p AND c.draft_id IS NULL AND c.state='APPLIED' AND c.expected_version=0
  AND c.authorization_receipt_id=a.id AND c.approval_consumption_id IS NULL AND c.payload_ref IS NULL AND c.result_ref=expected_result
  AND a.subject_ref=jsonb_build_object('kind','HUMAN','userId',c.actor_id,'clientId',c.client_id) AND a.policy_ref=c.policy_ref AND a.scope_digest=digest AND a.approval_decision_ref IS NULL
  AND u.server_sequence BETWEEN 1 AND 9007199254740991 AND u.actor_ref=jsonb_build_object('kind','HUMAN','userId',c.actor_id)
  AND u.client_ref=c.client_id AND u.operation_id=c.operation_id AND u.target_ref=er AND u.policy_ref=c.policy_ref AND u.approval_ref IS NULL
  AND u.outcome='APPLIED' AND u.reason_code='SOURCE_CONTENT_POLICY_EVENT_RECORDED' AND u.scope_digest=digest AND u.source_kind='HUMAN_COMMAND' AND u.correction_of IS NULL
  AND r.actor_id=c.actor_id AND r.client_id=c.client_id AND r.external_command_id=c.command_id AND r.operation=c.operation AND r.command_hash=c.request_hash
  AND r.part_key='management_origin' AND r.part_kind='SOURCE_CONTENT_POLICY_MANAGEMENT' AND r.phase='SETTLED' AND r.start_fence=1
  AND r.server_command_id=cid AND r.authorization_receipt_id=a.id AND r.scope_digest=digest
  AND r.authorized_until=(plan->>'authorizedUntil')::timestamptz AND r.reserved_bytes::text=plan->'parts'->0->>'bytes'
  AND c.completed_at IS NOT NULL AND a.authorized_at=c.completed_at AND u.recorded_at=c.completed_at) IS NOT TRUE THEN RETURN false;END IF;
 -- 물리 시각의 유한/27자 형상은 rows에서 검산했다. E와 O는 별도 실제 관측값이며 같게 덮지 않는다.
 IF e.recorded_at>o.recorded_at OR o.recorded_at>r.created_at OR r.created_at>r.started_at OR r.started_at>c.completed_at
  OR c.received_at>c.completed_at OR c.completed_at>r.settled_at OR r.settled_at>=r.authorized_until THEN RETURN false;END IF;
 maximum=anvil.fn03_management_maximum(rows-'R',rows->'R');actual=anvil.fn03_management_actual(p,cid);
 reserved=anvil.fn03_management_fixed_point(maximum,(rows->'R')||jsonb_build_object('plan_hash',repeat('0',64)));
 settled=anvil.fn03_management_fixed_point(actual,rows->'R',r.reserved_bytes);
 RETURN (actual<=maximum AND reserved=r.reserved_bytes AND settled=r.settled_bytes AND settled<=reserved
  AND actual+anvil.fn75_cost(anvil.fn09_registered_cost_projection(rows->'R'))=settled) IS TRUE;
END;$$;
REVOKE ALL ON FUNCTION anvil.fn03_management_complete(uuid,uuid) FROM PUBLIC,anvil_v3_app;

CREATE FUNCTION anvil.fn03_management_history_bundle(p uuid,cid uuid) RETURNS jsonb LANGUAGE plpgsql STABLE SET search_path=pg_catalog AS $$
DECLARE rows jsonb;previous jsonb='null'::jsonb;b anvil.source_content_policy_events;
BEGIN
 IF anvil.fn03_management_complete(p,cid) IS NOT TRUE THEN RAISE EXCEPTION 'SOURCE_CONTENT_MANAGEMENT_INCOMPLETE';END IF;
 rows=anvil.fn03_management_rows(p,cid);
 IF (rows->'E'->>'sequence')::bigint>1 THEN
  SELECT x.* INTO STRICT b FROM anvil.source_content_policy_events x WHERE x.project_id=p AND x.sequence=(rows->'E'->>'sequence')::bigint-1;
  previous=jsonb_build_object('project_id',b.project_id,'id',b.id,'version',b.version,'sequence',b.sequence,'subject_user_id',b.subject_user_id,'disposition',b.disposition,
   'recorded_at',anvil.source_read_iso(b.recorded_at),'expires_at',anvil.source_read_iso(b.expires_at),'snapshot_json',b.snapshot_json,'content_hash',b.content_hash,'previous_ref',b.previous_ref,'management_command_id',b.management_command_id);
 END IF;
 -- 내부 결과만. 현재 read/replay RPC가 자신의 status/transactionId를 붙이되 원 plan metadata는 불변이다.
 RETURN jsonb_build_object('previousEvent',previous,'rows',rows);
END;$$;
REVOKE ALL ON FUNCTION anvil.fn03_management_history_bundle(uuid,uuid) FROM PUBLIC,anvil_v3_app;

-- 현재 인가와 역사 정착을 분리한다. fn01_active는 DB의 원 행 잠금일 뿐 token/CSRF 소유 proof가 아니다.
-- 진짜 Access callback/같은 query의 소유 검산은 업무C에서 결합한다. GUC나 caller verified flag를 받지 않는다.
-- INVOKER: 목적 역할의 정확 열 SELECT/행잠금 권한·fn01_active EXEC는 전체 저장 DAG 완결 뒤에만 부여한다.
CREATE FUNCTION anvil.fn03_management_context(s uuid,a uuid,c uuid,p uuid,g bigint,op text,policy jsonb,observed_until timestamptz) RETURNS jsonb LANGUAGE plpgsql VOLATILE SET search_path=pg_catalog AS $$
DECLARE auth record;member record;control record;pv record;rule jsonb;matched boolean=false;
 begin_at timestamptz;at_time timestamptz;last_at timestamptz;rule_until timestamptz;until_at timestamptz;
BEGIN
 IF session_user<>'anvil_v3_app' OR current_user<>'anvil_v3_source_content_management_owner'
  OR s IS NULL OR a IS NULL OR c IS NULL OR p IS NULL OR g IS NULL OR g NOT BETWEEN 1 AND 9007199254740991
  OR op IS NULL OR op NOT IN('defineSourceContentPolicy','readSourceContentPolicyManagementOrigin')
  OR anvil.source_read_ref(policy) IS NOT TRUE THEN RAISE EXCEPTION 'SOURCE_CONTENT_MANAGEMENT_CONTEXT_INVALID' USING ERRCODE='42501';END IF;
 IF op='defineSourceContentPolicy' AND observed_until IS NULL OR observed_until IS NOT NULL AND NOT isfinite(observed_until) THEN
  RAISE EXCEPTION 'SOURCE_CONTENT_MANAGEMENT_CONTEXT_INVALID' USING ERRCODE='42501';END IF;
 begin_at=clock_timestamp();
 IF NOT isfinite(begin_at) THEN RAISE EXCEPTION 'SOURCE_CONTENT_MANAGEMENT_CURRENT_REQUIRED' USING ERRCODE='42501';END IF;
 PERFORM anvil.fn01_active(s,a,c);
 SELECT x.id,x.user_id,x.client_id,x.credential_generation,x.idle_expires_at,x.absolute_expires_at,x.reauth_until,x.revoked_at
  INTO auth FROM anvil.auth_sessions x WHERE x.id=s AND x.user_id=a AND x.client_id=c;
 IF auth.id IS NULL OR auth.revoked_at IS NOT NULL OR auth.reauth_until IS NULL
  OR auth.credential_generation NOT BETWEEN 1 AND 9007199254740991 OR NOT isfinite(auth.idle_expires_at)
  OR NOT isfinite(auth.absolute_expires_at) OR NOT isfinite(auth.reauth_until) THEN RAISE EXCEPTION 'SOURCE_CONTENT_MANAGEMENT_CURRENT_REQUIRED' USING ERRCODE='42501';END IF;
 PERFORM x.id FROM anvil.projects x WHERE x.id=p AND x.archived_at IS NULL FOR UPDATE;
 IF NOT FOUND THEN RAISE EXCEPTION 'SOURCE_CONTENT_MANAGEMENT_CURRENT_REQUIRED' USING ERRCODE='42501';END IF;
 SELECT x.project_id,x.user_id,x.participation,x.revoked_at INTO member FROM anvil.project_members x WHERE x.project_id=p AND x.user_id=a FOR UPDATE;
 SELECT x.project_id,x.actor_id,x.client_id,x.generation,x.revoked_at INTO control FROM anvil.project_control x WHERE x.project_id=p FOR UPDATE;
 IF member.project_id IS NULL OR member.participation IS DISTINCT FROM 'OWNER' OR member.revoked_at IS NOT NULL
  OR control.project_id IS NULL OR control.actor_id IS DISTINCT FROM a OR control.client_id IS DISTINCT FROM c
  OR control.generation IS DISTINCT FROM g OR control.revoked_at IS NOT NULL THEN RAISE EXCEPTION 'SOURCE_CONTENT_MANAGEMENT_CURRENT_REQUIRED' USING ERRCODE='42501';END IF;
 SELECT v.project_id,v.policy_id,v.version,v.rules_json,v.reason,v.review_refs,v.content_hash INTO pv
  FROM anvil.permission_policies h JOIN anvil.permission_policy_versions v ON v.project_id=h.project_id AND v.policy_id=h.id AND v.version=h.head_version
  WHERE h.project_id=p FOR SHARE OF h;
 IF pv.policy_id IS NULL OR pv.content_hash IS DISTINCT FROM anvil.fn01_hash(jsonb_build_object('rules',pv.rules_json,'reason',pv.reason,'reviewRefs',pv.review_refs))
  OR policy IS DISTINCT FROM jsonb_build_object('id',pv.policy_id,'version',pv.version,'contentHash',pv.content_hash)
  OR jsonb_typeof(pv.rules_json) IS DISTINCT FROM 'array' THEN RAISE EXCEPTION 'SOURCE_CONTENT_MANAGEMENT_POLICY_INVALID' USING ERRCODE='42501';END IF;
 IF jsonb_array_length(pv.rules_json)>200 THEN RAISE EXCEPTION 'SOURCE_CONTENT_MANAGEMENT_POLICY_INVALID' USING ERRCODE='42501';END IF;
 at_time=clock_timestamp();
 until_at=least(auth.idle_expires_at,auth.absolute_expires_at,auth.reauth_until,observed_until);
 IF NOT isfinite(at_time) OR at_time<begin_at OR at_time>=until_at THEN RAISE EXCEPTION 'SOURCE_CONTENT_MANAGEMENT_CURRENT_REQUIRED' USING ERRCODE='42501';END IF;
 FOR rule IN SELECT value FROM jsonb_array_elements(pv.rules_json) LOOP
  IF anvil.source_read_exact(rule,ARRAY['ruleId','subjectRef','operations','targetScopes','disposition','limitPolicyRef','expiresAt']) IS NOT TRUE
   OR jsonb_typeof(rule->'operations') IS DISTINCT FROM 'array' OR jsonb_typeof(rule->'targetScopes') IS DISTINCT FROM 'array'
   OR jsonb_typeof(rule->'expiresAt') IS DISTINCT FROM 'string' OR rule->>'expiresAt'!~'^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\.[0-9]{3}Z$' THEN
   RAISE EXCEPTION 'SOURCE_CONTENT_MANAGEMENT_POLICY_INVALID' USING ERRCODE='42501';END IF;
  rule_until=(rule->>'expiresAt')::timestamptz;
  IF NOT isfinite(rule_until) OR anvil.source_read_iso(rule_until) IS DISTINCT FROM rule->>'expiresAt' THEN RAISE EXCEPTION 'SOURCE_CONTENT_MANAGEMENT_POLICY_INVALID' USING ERRCODE='42501';END IF;
  -- 기존 대상 매칭으로 먼저 명시 거절을 찾는다. exact AUTO보다 넓은 PROJECT 거절을 건너뛰지 않는다.
  IF rule->'subjectRef'->>'kind'='HUMAN' AND rule->'subjectRef'->>'userId'=a::text AND rule->'operations' ? op
   AND EXISTS(SELECT 1 FROM jsonb_array_elements(rule->'targetScopes') scope WHERE scope->>'kind'='PROJECT' AND scope->>'projectId'=p::text)
   AND rule_until>at_time THEN
   IF rule->>'disposition' IS DISTINCT FROM 'AUTO' THEN RAISE EXCEPTION 'SOURCE_CONTENT_MANAGEMENT_OPERATION_DENIED' USING ERRCODE='42501';END IF;
   IF rule->'subjectRef' IS DISTINCT FROM jsonb_build_object('kind','HUMAN','userId',a)
    OR rule->'targetScopes' IS DISTINCT FROM jsonb_build_array(jsonb_build_object('kind','PROJECT','projectId',p))
    OR rule->'limitPolicyRef' IS DISTINCT FROM 'null'::jsonb THEN RAISE EXCEPTION 'SOURCE_CONTENT_MANAGEMENT_OPERATION_DENIED' USING ERRCODE='42501';END IF;
   matched=true;until_at=least(until_at,rule_until);
  END IF;
 END LOOP;
 IF NOT matched THEN RAISE EXCEPTION 'SOURCE_CONTENT_MANAGEMENT_OPERATION_DENIED' USING ERRCODE='42501';END IF;
 -- 공개 ms 기한은 원 raw 최소기한을 줄일 수만 있다. 과거 R의 시각이나 기한으로 현재 인가를 만들지 않는다.
 until_at=date_trunc('milliseconds',until_at);last_at=clock_timestamp();
 IF NOT isfinite(last_at) OR last_at<at_time OR last_at>=until_at THEN RAISE EXCEPTION 'SOURCE_CONTENT_MANAGEMENT_CURRENT_REQUIRED' USING ERRCODE='42501';END IF;
 RETURN jsonb_build_object('operation',op,'projectId',p,'actorId',a,'clientId',c,'authSessionId',s,'credentialGeneration',auth.credential_generation,
  'controlGeneration',g,'permissionPolicyRef',policy,'transactionId',txid_current()::text,'authorizedUntil',anvil.source_read_iso(until_at));
END;$$;
ALTER FUNCTION anvil.fn03_management_context(uuid,uuid,uuid,uuid,bigint,text,jsonb,timestamptz) OWNER TO anvil_v3_source_content_management_owner;
REVOKE ALL ON FUNCTION anvil.fn03_management_context(uuid,uuid,uuid,uuid,bigint,text,jsonb,timestamptz) FROM PUBLIC,anvil_v3_app;

-- 실제 보호 read의 소스 연결. 아직 app EXEC·필수 표/함수 ACL·E/O SELECT 정책을 부여하지 않았으므로 진입은 비활성이다.
-- 원문은 이 내부 RPC의 보호 bundle만 거쳐 기존 TS inspector로 간다. 일반 files/검색/로그 응답을 만들지 않는다.
CREATE FUNCTION anvil.fn03_source_content_management_read(s uuid,a uuid,c uuid,p uuid,control_generation bigint,policy jsonb,selection jsonb,expected_tx text) RETURNS jsonb LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog AS $$
DECLARE ctx jsonb;final_ctx jsonb;bundle jsonb;origin anvil.source_content_policy_management_origins;
 historical_event anvil.source_content_policy_events;cid uuid;absent boolean=false;
 begin_at timestamptz;at_time timestamptz;until_at timestamptz;last_at timestamptz;
BEGIN
 IF expected_tx IS DISTINCT FROM txid_current()::text THEN RAISE EXCEPTION 'SOURCE_CONTENT_MANAGEMENT_TRANSACTION_INVALID' USING ERRCODE='42501';END IF;
 begin_at=clock_timestamp();
 ctx=anvil.fn03_management_context(s,a,c,p,control_generation,'readSourceContentPolicyManagementOrigin',policy,NULL);
 IF anvil.source_read_exact(selection,ARRAY['originRef','policyEventRef','managementCommandId']) IS NOT TRUE
  OR anvil.source_read_ref(selection->'originRef') IS NOT TRUE OR selection->'originRef'->'version' IS DISTINCT FROM '1'::jsonb
  OR anvil.source_read_ref(selection->'policyEventRef') IS NOT TRUE OR selection->'policyEventRef'->'version' IS DISTINCT FROM '1'::jsonb
  OR jsonb_typeof(selection->'managementCommandId') IS DISTINCT FROM 'string'
  OR selection->>'managementCommandId'!~'^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$'
  OR octet_length(convert_to(anvil.source_read_canonical_json(selection),'UTF8'))>4096 THEN RAISE EXCEPTION 'SOURCE_CONTENT_MANAGEMENT_SELECTION_INVALID' USING ERRCODE='42501';END IF;
 cid=(selection->>'managementCommandId')::uuid;until_at=(ctx->>'authorizedUntil')::timestamptz;at_time=clock_timestamp();
 IF NOT isfinite(begin_at) OR NOT isfinite(at_time) OR at_time<begin_at OR at_time>=until_at THEN RAISE EXCEPTION 'SOURCE_CONTENT_MANAGEMENT_CURRENT_REQUIRED' USING ERRCODE='42501';END IF;
 BEGIN
  -- 관련 O가 하나라도 있으면 잘못된 ref/hash를 부재로 숨기지 않는다. 다중 교차 선택도 STRICT로 거절한다.
  SELECT o.* INTO STRICT origin FROM anvil.source_content_policy_management_origins o WHERE o.project_id=p
   AND (o.id=(selection->'originRef'->>'id')::uuid OR o.management_command_id=cid OR o.policy_event_ref->>'id'=selection->'policyEventRef'->>'id');
 EXCEPTION WHEN no_data_found THEN absent=true;
 END;
 IF absent THEN
  -- 과거 O 부재는 실제 같은 project/command의 검산된 E에 한정한다. 임의 선택이나 변조 E를 부재로 바꾸지 않는다.
  SELECT e.* INTO historical_event FROM anvil.source_content_policy_events e WHERE e.project_id=p AND e.management_command_id=cid;
  IF NOT FOUND OR selection->'policyEventRef' IS DISTINCT FROM jsonb_build_object('id',historical_event.id,'version',historical_event.version,'contentHash',historical_event.content_hash)
   OR anvil.source_content_policy_row_shape(historical_event) IS NOT TRUE THEN
   RAISE EXCEPTION 'SOURCE_CONTENT_MANAGEMENT_SELECTION_MISMATCH' USING ERRCODE='42501';END IF;
 ELSE
  IF selection->'originRef' IS DISTINCT FROM jsonb_build_object('id',origin.id,'version',origin.version,'contentHash',origin.content_hash)
   OR selection->'policyEventRef' IS DISTINCT FROM origin.policy_event_ref OR origin.management_command_id IS DISTINCT FROM cid THEN
   RAISE EXCEPTION 'SOURCE_CONTENT_MANAGEMENT_SELECTION_MISMATCH' USING ERRCODE='42501';END IF;
  bundle=anvil.fn03_management_history_bundle(p,cid);
 END IF;
 -- 부재도 현재 권한·원 Tx·기한을 통과한 상태만 반환한다. 역사 actor/client/plan은 새 주체로 덮지 않는다.
 final_ctx=anvil.fn03_management_context(s,a,c,p,control_generation,'readSourceContentPolicyManagementOrigin',policy,until_at);
 last_at=clock_timestamp();
 IF final_ctx IS DISTINCT FROM ctx OR expected_tx IS DISTINCT FROM txid_current()::text
  OR NOT isfinite(last_at) OR last_at<at_time OR last_at>=until_at THEN RAISE EXCEPTION 'SOURCE_CONTENT_MANAGEMENT_CURRENT_REQUIRED' USING ERRCODE='42501';END IF;
 IF absent THEN RETURN jsonb_build_object('status','ORIGIN_ABSENT','transactionId',expected_tx);END IF;
 RETURN jsonb_build_object('status','FOUND','transactionId',expected_tx)||bundle;
END;$$;
ALTER FUNCTION anvil.fn03_source_content_management_read(uuid,uuid,uuid,uuid,bigint,jsonb,jsonb,text) OWNER TO anvil_v3_source_content_management_owner;
REVOKE ALL ON FUNCTION anvil.fn03_source_content_management_read(uuid,uuid,uuid,uuid,bigint,jsonb,jsonb,text) FROM PUBLIC,anvil_v3_app;

-- 실제 목적 write의 내부 순서. 원 account/현재 head 아래에서만 M/r/s와 정확 물리행을 만든다.
-- R 목적 CHECK/dispatcher·16 지연제약·최종 guard는 아래에 연결하며 ACL/source caller는 아직 미연결이다.
-- 아래 함수만으로 실행을 열지 않는다. 기존 E/O INSERT 거절과 app/PUBLIC EXEC 차단을 보존한다.
CREATE FUNCTION anvil.fn03_source_content_management_commit(s uuid,a uuid,c uuid,p uuid,q jsonb,policy jsonb,ids jsonb,expected_tx text,observed_until timestamptz) RETURNS jsonb LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog AS $$
DECLARE ctx jsonb;final_ctx jsonb;ac anvil.project_storage_accounts;head anvil.source_content_policy_events;
 e anvil.source_content_policy_events;o anvil.source_content_policy_management_origins;cmd anvil.commands;
 receipt anvil.authorization_receipts;audit anvil.audit_events;r anvil.project_storage_reservations;
 previous jsonb='null'::jsonb;er jsonb;orr jsonb;snapshot jsonb;origin_snapshot jsonb;plan jsonb;part jsonb;
 prepared jsonb;template jsonb;bundle jsonb;qh text;digest text;sealed_hash text;k text;cid uuid;g bigint;
 seq bigint=1;audit_seq bigint;used numeric;held numeric;other_bytes numeric;maximum bigint;reserved bigint;actual bigint;settled bigint;
 begin_at timestamptz;last_at timestamptz;at_time timestamptz;e_at timestamptz;o_at timestamptz;done_at timestamptz;
 received_at timestamptz;until_at timestamptz;
BEGIN
 IF expected_tx IS DISTINCT FROM txid_current()::text THEN RAISE EXCEPTION 'SOURCE_CONTENT_MANAGEMENT_TRANSACTION_INVALID' USING ERRCODE='42501';END IF;
 IF anvil.source_read_exact(q,ARRAY['schemaVersion','projectId','commandId','clientId','controlGeneration','operation','targetId','expectedVersion','baselineRefs','approvalRef','payload']) IS NOT TRUE
  OR q->'schemaVersion' IS DISTINCT FROM '1'::jsonb OR q->>'projectId' IS DISTINCT FROM p::text OR q->>'clientId' IS DISTINCT FROM c::text
  OR q->>'operation' IS DISTINCT FROM 'defineSourceContentPolicy' OR q->'targetId' IS DISTINCT FROM 'null'::jsonb
  OR q->'expectedVersion' IS DISTINCT FROM '0'::jsonb OR q->'baselineRefs' IS DISTINCT FROM '[]'::jsonb OR q->'approvalRef' IS DISTINCT FROM 'null'::jsonb
  OR anvil.source_read_exact(q->'payload',ARRAY['definition','previousPolicyRef','reason']) IS NOT TRUE
  OR jsonb_typeof(q->'controlGeneration') IS DISTINCT FROM 'number' OR jsonb_typeof(q->'commandId') IS DISTINCT FROM 'string'
  OR q->>'commandId'!~'^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$'
  OR octet_length(convert_to(anvil.source_read_canonical_json(q),'UTF8'))>1048576 THEN RAISE EXCEPTION 'SOURCE_CONTENT_MANAGEMENT_INPUT_INVALID';END IF;
 IF (q->>'controlGeneration')::numeric NOT BETWEEN 1 AND 9007199254740991
  OR (q->>'controlGeneration')::numeric<>trunc((q->>'controlGeneration')::numeric)
  OR anvil.source_read_exact(ids,ARRAY['serverCommandId','operationId','authorizationReceiptId','auditEventId','policyEventId','originId']) IS NOT TRUE THEN RAISE EXCEPTION 'SOURCE_CONTENT_MANAGEMENT_INPUT_INVALID';END IF;
 FOR k IN SELECT jsonb_object_keys(ids) LOOP
  IF jsonb_typeof(ids->k) IS DISTINCT FROM 'string' OR ids->>k!~'^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$' THEN RAISE EXCEPTION 'SOURCE_CONTENT_MANAGEMENT_INPUT_INVALID';END IF;
 END LOOP;
 IF (SELECT count(DISTINCT value) FROM jsonb_each_text(ids))<>6 THEN RAISE EXCEPTION 'SOURCE_CONTENT_MANAGEMENT_INPUT_INVALID';END IF;
 g=(q->>'controlGeneration')::bigint;cid=(ids->>'serverCommandId')::uuid;qh=anvil.source_read_hash(q);
 received_at=transaction_timestamp();begin_at=clock_timestamp();
 ctx=anvil.fn03_management_context(s,a,c,p,g,'defineSourceContentPolicy',policy,observed_until);
 until_at=(ctx->>'authorizedUntil')::timestamptz;last_at=clock_timestamp();
 IF NOT isfinite(received_at) OR NOT isfinite(begin_at) OR NOT isfinite(last_at) OR last_at<begin_at OR last_at>=until_at THEN RAISE EXCEPTION 'SOURCE_CONTENT_MANAGEMENT_CURRENT_REQUIRED';END IF;
 SELECT x.* INTO STRICT ac FROM anvil.project_storage_accounts x WHERE x.project_id=p FOR UPDATE;
 IF ac.coverage_state IS DISTINCT FROM 'VERIFIED' OR ac.generation NOT BETWEEN 1 AND 9007199254740991
  OR anvil.quota_complete(p) IS NOT TRUE THEN RAISE EXCEPTION 'PROJECT_STORAGE_QUOTA_UNVERIFIED';END IF;
 SELECT COALESCE(sum(x.settled_bytes) FILTER(WHERE x.phase='SETTLED'),0),COALESCE(sum(x.reserved_bytes) FILTER(WHERE x.phase IN('RESERVED','IO_STARTED','UNKNOWN')),0)
  INTO used,held FROM anvil.project_storage_reservations x WHERE x.project_id=p;
 used=used+anvil.fn15_storage_actual(p)+anvil.fn75_project_storage_actual_bytes(p)+anvil.fn76_storage_actual(p);
 held=held+anvil.fn15_storage_future(p)+anvil.fn75_project_storage_future(p)+anvil.fn76_storage_future(p);
 other_bytes=anvil.fn09_registered_other_bytes(p);
 IF used IS NULL OR held IS NULL OR other_bytes IS NULL OR used<0 OR held<0 OR other_bytes<0 OR used+held+other_bytes>10737418240
  OR ac.used_bytes IS DISTINCT FROM used OR ac.held_bytes IS DISTINCT FROM held THEN RAISE EXCEPTION 'PROJECT_STORAGE_QUOTA_INTEGRITY_FAILED';END IF;
 -- project lock는 빈 head도 직렬화한다. 회수/만료된 마지막 E를 필터링하지 않는다.
 SELECT x.* INTO head FROM anvil.source_content_policy_events x WHERE x.project_id=p ORDER BY x.sequence DESC LIMIT 1 FOR UPDATE;
 IF FOUND THEN
  IF anvil.source_content_policy_row_shape(head) IS NOT TRUE OR head.sequence>=9007199254740991 THEN RAISE EXCEPTION 'SOURCE_CONTENT_MANAGEMENT_HEAD_INVALID';END IF;
  previous=jsonb_build_object('id',head.id,'version',head.version,'contentHash',head.content_hash);seq=head.sequence+1;
 END IF;
 IF previous IS DISTINCT FROM q->'payload'->'previousPolicyRef' THEN RAISE EXCEPTION 'SOURCE_CONTENT_MANAGEMENT_HEAD_CONFLICT';END IF;
 -- 이 producer는 신규 동일 명령만 저장한다. replay는 별도 역사 read 검산 없이 성공을 재발급하지 않는다.
 IF EXISTS(SELECT 1 FROM anvil.commands x WHERE x.id=cid OR x.project_id=p AND x.actor_id=a AND x.command_id=(q->>'commandId')::uuid)
  OR EXISTS(SELECT 1 FROM anvil.project_storage_reservations x WHERE x.id=cid OR x.project_id=p AND x.actor_id=a AND x.external_command_id=(q->>'commandId')::uuid)
  OR EXISTS(SELECT 1 FROM anvil.source_content_policy_events x WHERE x.project_id=p AND x.id=(ids->>'policyEventId')::uuid)
  OR EXISTS(SELECT 1 FROM anvil.source_content_policy_management_origins x WHERE x.project_id=p AND x.id=(ids->>'originId')::uuid) THEN RAISE EXCEPTION 'IDEMPOTENCY_CONFLICT';END IF;
 at_time=clock_timestamp();
 IF NOT isfinite(at_time) OR at_time<last_at OR at_time>=until_at OR head.id IS NOT NULL AND at_time<head.recorded_at THEN RAISE EXCEPTION 'SOURCE_CONTENT_MANAGEMENT_CURRENT_REQUIRED';END IF;
 e_at=date_trunc('milliseconds',at_time);last_at=at_time;
 IF anvil.fn03_management_definition_valid(q->'payload'->'definition',q->'payload'->'reason',a,e_at) IS NOT TRUE THEN RAISE EXCEPTION 'SOURCE_CONTENT_MANAGEMENT_INPUT_INVALID';END IF;
 snapshot=(q->'payload'->'definition')||jsonb_build_object('projectId',p,'sequence',seq,'recordedAt',anvil.source_read_iso(e_at),'reason',q->'payload'->'reason');
 IF octet_length(convert_to(anvil.source_read_canonical_json(snapshot),'UTF8'))>1048576 THEN RAISE EXCEPTION 'SOURCE_CONTENT_MANAGEMENT_INPUT_INVALID';END IF;
 er=jsonb_build_object('id',ids->>'policyEventId','version',1,'contentHash',anvil.source_read_hash(snapshot));
 at_time=clock_timestamp();
 IF NOT isfinite(at_time) OR at_time<last_at OR at_time>=until_at THEN RAISE EXCEPTION 'SOURCE_CONTENT_MANAGEMENT_CURRENT_REQUIRED';END IF;
 o_at=date_trunc('milliseconds',at_time);last_at=at_time;
 origin_snapshot=jsonb_build_object('schemaVersion',1,'purpose','SOURCE_CONTENT_POLICY_MANAGEMENT_ORIGIN','id',ids->>'originId','version',1,'projectId',p,
  'managementCommandId',cid,'policyEventRef',er,'originalRequest',q,'requestHash',qh,'recordedAt',anvil.source_read_iso(o_at));
 IF e_at>o_at OR octet_length(convert_to(anvil.source_read_canonical_json(origin_snapshot),'UTF8'))>2097152 THEN RAISE EXCEPTION 'SOURCE_CONTENT_MANAGEMENT_INPUT_INVALID';END IF;
 orr=jsonb_build_object('id',ids->>'originId','version',1,'contentHash',anvil.source_read_hash(origin_snapshot));
 digest=anvil.source_read_hash(jsonb_build_object('projectId',p,'actorId',a,'clientId',c,'controlGeneration',g,'requestHash',qh,'policyRef',policy,'targetRef',er));
 e=jsonb_populate_record(NULL::anvil.source_content_policy_events,jsonb_build_object('project_id',p,'id',ids->>'policyEventId','version',1,'sequence',seq,'subject_user_id',a,
  'disposition',snapshot->>'disposition','snapshot_json',snapshot,'content_hash',er->>'contentHash','previous_ref',previous,'management_command_id',cid,'recorded_at',e_at,'expires_at',snapshot->>'expiresAt',
  'previous_id',previous->>'id','previous_version',previous->'version','previous_hash',previous->>'contentHash'));
 o=jsonb_populate_record(NULL::anvil.source_content_policy_management_origins,jsonb_build_object('project_id',p,'id',ids->>'originId','version',1,'management_command_id',cid,
  'policy_event_ref',er,'request_json',q,'request_hash',qh,'recorded_at',o_at,'content_hash',orr->>'contentHash'));
 cmd=jsonb_populate_record(NULL::anvil.commands,jsonb_build_object('id',cid,'scope_kind','PROJECT','scope_id',p,'project_id',p,'draft_id',NULL,'actor_id',a,'client_id',c,'operation','defineSourceContentPolicy',
  'command_id',q->>'commandId','request_hash',qh,'operation_id',ids->>'operationId','state','APPLIED','authorization_receipt_id',ids->>'authorizationReceiptId','approval_consumption_id',NULL,'expected_version',0,
  'control_generation',g,'policy_ref',policy,'payload_ref',NULL,'received_at',received_at,'completed_at',o_at,
  'result_ref',jsonb_build_object('operationId',ids->>'operationId','commandId',q->>'commandId','projectId',p,'status','APPLIED','targetId',e.id,'version',1,
   'data',jsonb_build_object('ref',er,'status','CONTENT_POLICY_EVENT_RECORDED','policyRef',er,'previousPolicyRef',previous,'sequence',seq,'executionAuthorized',false,'agentDispatchPerformed',false,'baselineConfirmed',false,'linkAuthorized',false),
   'evidenceRefs','[]'::jsonb,'warnings','[]'::jsonb,'serverReceivedAt',anvil.source_read_iso(o_at))));
 receipt=jsonb_populate_record(NULL::anvil.authorization_receipts,jsonb_build_object('id',ids->>'authorizationReceiptId','scope_kind','PROJECT','scope_id',p,'command_id',cid,
  'subject_ref',jsonb_build_object('kind','HUMAN','userId',a,'clientId',c),'policy_ref',policy,'scope_digest',digest,'approval_decision_ref',NULL,'authorized_at',o_at));
 audit=jsonb_populate_record(NULL::anvil.audit_events,jsonb_build_object('project_id',p,'server_sequence',9223372036854775807,'event_id',ids->>'auditEventId',
  'actor_ref',jsonb_build_object('kind','HUMAN','userId',a),'client_ref',c,'command_id',cid,'operation_id',ids->>'operationId','target_ref',er,'policy_ref',policy,'approval_ref',NULL,
  'outcome','APPLIED','reason_code','SOURCE_CONTENT_POLICY_EVENT_RECORDED','scope_digest',digest,'recorded_at',o_at,'source_kind','HUMAN_COMMAND','correction_of',NULL));
 prepared=jsonb_build_object('O',anvil.fn03_management_physical(to_jsonb(o)),'E',anvil.fn03_management_physical(to_jsonb(e)),
  'C',anvil.fn03_management_physical(to_jsonb(cmd)),'A',anvil.fn03_management_physical(to_jsonb(receipt)),'U',anvil.fn03_management_physical(to_jsonb(audit)));
 part=jsonb_build_object('key','management_origin','kind','SOURCE_CONTENT_POLICY_MANAGEMENT','id',o.id,'contentHash',o.content_hash,'bytes','0','reservedBytes','0','settledBytes','0');
 plan=jsonb_build_object('schemaVersion',1,'purpose','SOURCE_CONTENT_POLICY_MANAGEMENT_STORAGE','projectId',p,'actorId',a,'clientId',c,'authSessionId',s,
  'credentialGeneration',ctx->'credentialGeneration','controlGeneration',g,'operation','defineSourceContentPolicy','externalCommandId',q->>'commandId','requestHash',qh,'permissionPolicyRef',policy,
  'originRef',orr,'policyEventRef',er,'ids',ids,'coverageGeneration',ac.generation::text,'authorizedUntil',ctx->'authorizedUntil','transactionId',expected_tx,'parts',jsonb_build_array(part));
 -- 미확정 phase 시각은 비용용이다. created_at은 INSERT 직전 실제 관측으로 교체한다.
 r=jsonb_populate_record(NULL::anvil.project_storage_reservations,jsonb_build_object('id',cid,'project_id',p,'actor_id',a,'client_id',c,'external_command_id',q->>'commandId',
  'operation','defineSourceContentPolicy','command_hash',qh,'part_key','management_origin','part_kind','SOURCE_CONTENT_POLICY_MANAGEMENT','plan_json',plan,'plan_hash',repeat('0',64),
  'reserved_bytes',0,'settled_bytes',0,'phase','RESERVED','start_fence',0,'authorized_until',until_at,'server_command_id',NULL,'authorization_receipt_id',NULL,'scope_digest',NULL,'created_at',o_at,'started_at',NULL,'settled_at',NULL));
 template=anvil.fn03_management_physical(to_jsonb(r));maximum=anvil.fn03_management_maximum(prepared,template);
 reserved=anvil.fn03_management_fixed_point(maximum,template);
 IF used+held+reserved+other_bytes>10737418240 THEN RAISE EXCEPTION 'PROJECT_STORAGE_LIMIT_EXCEEDED';END IF;
 part=part||jsonb_build_object('bytes',reserved::text,'reservedBytes',reserved::text,'settledBytes',reserved::text);plan=jsonb_set(plan,'{parts,0}',part);
 IF anvil.fn03_management_plan_valid(plan) IS NOT TRUE THEN RAISE EXCEPTION 'SOURCE_CONTENT_MANAGEMENT_PLAN_INVALID';END IF;
 sealed_hash=anvil.source_read_hash(plan);r.plan_json=plan;r.plan_hash=sealed_hash;r.reserved_bytes=reserved;
 at_time=clock_timestamp();
 IF NOT isfinite(at_time) OR at_time<last_at OR at_time>=until_at OR expected_tx IS DISTINCT FROM txid_current()::text THEN RAISE EXCEPTION 'SOURCE_CONTENT_MANAGEMENT_CURRENT_REQUIRED';END IF;
 r.created_at=at_time;last_at=at_time;
 INSERT INTO anvil.project_storage_reservations SELECT (r).*;
 UPDATE anvil.project_storage_accounts SET held_bytes=held_bytes+reserved,updated_at=at_time
  WHERE project_id=p AND coverage_state='VERIFIED' AND generation=ac.generation AND used_bytes=used AND held_bytes=held;
 IF NOT FOUND THEN RAISE EXCEPTION 'PROJECT_STORAGE_QUOTA_INTEGRITY_FAILED';END IF;
 at_time=clock_timestamp();
 IF NOT isfinite(at_time) OR at_time<last_at OR at_time>=until_at THEN RAISE EXCEPTION 'SOURCE_CONTENT_MANAGEMENT_CURRENT_REQUIRED';END IF;
 UPDATE anvil.project_storage_reservations SET phase='IO_STARTED',start_fence=1,started_at=at_time
  WHERE id=cid AND project_id=p AND plan_json=plan AND plan_hash=sealed_hash AND phase='RESERVED' AND start_fence=0 RETURNING * INTO STRICT r;
 last_at=at_time;
 SELECT COALESCE(max(x.server_sequence),0)+1 INTO audit_seq FROM anvil.audit_events x WHERE x.project_id=p;
 IF audit_seq NOT BETWEEN 1 AND 9007199254740991 THEN RAISE EXCEPTION 'SOURCE_CONTENT_MANAGEMENT_SEQUENCE_INVALID';END IF;
 done_at=clock_timestamp();
 IF NOT isfinite(done_at) OR done_at<last_at OR done_at<received_at OR done_at>=until_at THEN RAISE EXCEPTION 'SOURCE_CONTENT_MANAGEMENT_CURRENT_REQUIRED';END IF;
 cmd.completed_at=done_at;cmd.result_ref=jsonb_set(cmd.result_ref,'{serverReceivedAt}',to_jsonb(anvil.source_read_iso(done_at)));
 receipt.authorized_at=done_at;audit.recorded_at=done_at;audit.server_sequence=audit_seq;last_at=done_at;
 prepared=prepared||jsonb_build_object('C',anvil.fn03_management_physical(to_jsonb(cmd)),'A',anvil.fn03_management_physical(to_jsonb(receipt)),
  'U',anvil.fn03_management_physical(to_jsonb(audit))||jsonb_build_object('server_sequence',audit_seq::text));
 INSERT INTO anvil.commands SELECT (cmd).*;
 INSERT INTO anvil.authorization_receipts SELECT (receipt).*;
 INSERT INTO anvil.audit_events SELECT (audit).*;
 -- E의 generated previous 세 열은 삽입하지 않는다. 기존 생성식이 실값을 다시 계산한다.
 INSERT INTO anvil.source_content_policy_events(project_id,id,version,sequence,subject_user_id,disposition,snapshot_json,content_hash,previous_ref,management_command_id,recorded_at,expires_at)
  VALUES(e.project_id,e.id,e.version,e.sequence,e.subject_user_id,e.disposition,e.snapshot_json,e.content_hash,e.previous_ref,e.management_command_id,e.recorded_at,e.expires_at);
 INSERT INTO anvil.source_content_policy_management_origins SELECT (o).*;
 actual=anvil.fn03_management_actual(p,cid);template=anvil.fn03_management_physical(to_jsonb(r));
 settled=anvil.fn03_management_fixed_point(actual,template,reserved);
 IF actual>maximum OR settled>reserved OR used+settled+held+other_bytes>10737418240 THEN RAISE EXCEPTION 'PROJECT_STORAGE_LIMIT_EXCEEDED';END IF;
 at_time=clock_timestamp();
 IF NOT isfinite(at_time) OR at_time<last_at OR at_time>=until_at THEN RAISE EXCEPTION 'SOURCE_CONTENT_MANAGEMENT_CURRENT_REQUIRED';END IF;
 UPDATE anvil.project_storage_reservations SET phase='SETTLED',settled_bytes=settled,server_command_id=cid,authorization_receipt_id=receipt.id,scope_digest=digest,settled_at=at_time
  WHERE id=cid AND project_id=p AND plan_json=plan AND plan_hash=sealed_hash AND phase='IO_STARTED' AND start_fence=1 RETURNING * INTO STRICT r;
 UPDATE anvil.project_storage_accounts SET used_bytes=used_bytes+settled,held_bytes=held_bytes-reserved,updated_at=at_time
  WHERE project_id=p AND coverage_state='VERIFIED' AND generation=ac.generation AND used_bytes=used AND held_bytes=held+reserved;
 IF NOT FOUND THEN RAISE EXCEPTION 'PROJECT_STORAGE_QUOTA_INTEGRITY_FAILED';END IF;
 last_at=at_time;bundle=anvil.fn03_management_history_bundle(p,cid);
 IF (bundle->'rows'-'R') IS DISTINCT FROM prepared OR bundle->'rows'->'R'->'plan_json' IS DISTINCT FROM plan
  OR bundle->'rows'->'R'->>'plan_hash' IS DISTINCT FROM sealed_hash THEN RAISE EXCEPTION 'SOURCE_CONTENT_MANAGEMENT_STORED_MISMATCH';END IF;
 -- 원 목적 역할 안에서만 기존 정확16 대기 검사를 발화하고 원 DEFERRED 모드로 복원한다.
 -- 다른 도메인 대기 이벤트는 원 root 그대로 검산된다. 오류는 거래 전체 거절이며 삼키지 않는다.
 PERFORM anvil.fn03_management_current_final(p,cid,expected_tx);
 SET CONSTRAINTS anvil.fn09_prepare_commands_complete,anvil.fn09_prepare_authorization_receipts_complete,anvil.fn09_prepare_audit_events_complete,anvil.fn09_understanding_commands_complete,anvil.fn09_understanding_authorization_receipts_complete,anvil.fn09_understanding_audit_events_complete,anvil.child_human_commands_complete,anvil.child_human_receipts_complete,anvil.child_human_audits_complete,anvil.fn16_policy_commands_complete,anvil.fn16_policy_authorization_receipts_complete,anvil.fn16_policy_audit_events_complete,anvil.fn09_registered_commands_complete,anvil.fn09_registered_authorization_receipts_complete,anvil.fn09_registered_audit_events_complete,anvil.material_registration_complete IMMEDIATE;
 SET CONSTRAINTS anvil.fn09_prepare_commands_complete,anvil.fn09_prepare_authorization_receipts_complete,anvil.fn09_prepare_audit_events_complete,anvil.fn09_understanding_commands_complete,anvil.fn09_understanding_authorization_receipts_complete,anvil.fn09_understanding_audit_events_complete,anvil.child_human_commands_complete,anvil.child_human_receipts_complete,anvil.child_human_audits_complete,anvil.fn16_policy_commands_complete,anvil.fn16_policy_authorization_receipts_complete,anvil.fn16_policy_audit_events_complete,anvil.fn09_registered_commands_complete,anvil.fn09_registered_authorization_receipts_complete,anvil.fn09_registered_audit_events_complete,anvil.material_registration_complete DEFERRED;
 PERFORM anvil.fn03_management_current_final(p,cid,expected_tx);
 -- 복원 이후에는 현재성 검사/반환만 남고 어떤 추가 DML도 하지 않는다.
 final_ctx=anvil.fn03_management_context(s,a,c,p,g,'defineSourceContentPolicy',policy,until_at);at_time=clock_timestamp();
 IF final_ctx IS DISTINCT FROM ctx OR expected_tx IS DISTINCT FROM txid_current()::text OR NOT isfinite(at_time) OR at_time<last_at OR at_time>=until_at THEN RAISE EXCEPTION 'SOURCE_CONTENT_MANAGEMENT_CURRENT_REQUIRED';END IF;
 RETURN jsonb_build_object('status','RECORDED','transactionId',expected_tx)||bundle;
END;$$;
ALTER FUNCTION anvil.fn03_source_content_management_commit(uuid,uuid,uuid,uuid,jsonb,jsonb,jsonb,text,timestamptz) OWNER TO anvil_v3_source_content_management_owner;
REVOKE ALL ON FUNCTION anvil.fn03_source_content_management_commit(uuid,uuid,uuid,uuid,jsonb,jsonb,jsonb,text,timestamptz) FROM PUBLIC,anvil_v3_app;

-- R의 기존 허용 집합(0081 operation/0082 kind)에는 신규 목적 한 개씩만 더한다.
-- 기존 node/registered-options/origin-reuse 조합 제약과 모든 일반 quota 집계는 그대로다.
ALTER TABLE anvil.project_storage_reservations DROP CONSTRAINT project_storage_reservations_operation_check;
ALTER TABLE anvil.project_storage_reservations ADD CONSTRAINT project_storage_reservations_operation_check CHECK(operation IN('uploadArtifact','proposeDocumentChange','saveCheckpoint','createProject','linkDocumentSource','proposeDocumentSourceChange','prepareExecution','requestApproval','decideApproval','recordNodeDecision','revokeNodeDecision','registerExecutionStartOrigin','defineSourceContentPolicy'));
ALTER TABLE anvil.project_storage_reservations DROP CONSTRAINT project_storage_reservations_part_kind_check;
ALTER TABLE anvil.project_storage_reservations ADD CONSTRAINT project_storage_reservations_part_kind_check CHECK(part_kind IN('ARTIFACT','CHECKPOINT','ADOPTION','SOURCE_LINK_EVENT','PREPARATION_OPTIONS','PREPARATION_APPROVAL_REQUEST','PREPARATION_APPROVAL_DECISION','NODE_DECISION','EXECUTION_START_ORIGIN','ORIGIN_REUSE_APPROVAL_REQUEST','ORIGIN_REUSE_APPROVAL_DECISION','SOURCE_CONTENT_POLICY_MANAGEMENT'));
-- 새 표식의 일부만 있거나 다른 목적과 섞이면 거절한다. 기존 행의 현재 시각/권한을 요구하지 않는다.
ALTER TABLE anvil.project_storage_reservations ADD CONSTRAINT source_content_management_purpose_pair CHECK(
 CASE WHEN operation='defineSourceContentPolicy' OR part_kind='SOURCE_CONTENT_POLICY_MANAGEMENT' OR part_key='management_origin'
  OR plan_json->>'purpose'='SOURCE_CONTENT_POLICY_MANAGEMENT_STORAGE' OR plan_json->>'operation'='defineSourceContentPolicy'
  OR plan_json->'request'->>'operation'='defineSourceContentPolicy'
  OR plan_json->'parts' @> '[{"kind":"SOURCE_CONTENT_POLICY_MANAGEMENT"}]'::jsonb OR plan_json->'parts' @> '[{"key":"management_origin"}]'::jsonb THEN
  (operation='defineSourceContentPolicy' AND part_kind='SOURCE_CONTENT_POLICY_MANAGEMENT' AND part_key='management_origin'
   AND plan_json->>'purpose'='SOURCE_CONTENT_POLICY_MANAGEMENT_STORAGE' AND anvil.fn03_management_plan_valid(plan_json) IS TRUE
   AND plan_hash=anvil.source_read_hash(plan_json) AND plan_json->>'projectId'=project_id::text
   AND plan_json->>'actorId'=actor_id::text AND plan_json->>'clientId'=client_id::text
   AND plan_json->>'externalCommandId'=external_command_id::text AND plan_json->>'requestHash'=command_hash
   AND plan_json->'ids'->>'serverCommandId'=id::text AND plan_json->'parts'->0->>'bytes'=reserved_bytes::text
   AND authorized_until=(plan_json->>'authorizedUntil')::timestamptz) IS TRUE ELSE true END
);

-- CREATE OR REPLACE는 기존 0082 함수의 owner/ACL/모드/search_path를 유지한다.
-- 아래 표시된 분기 외 원 본문은 동일하다. private 목적 helper의 추가 ACL은 아직 발급하지 않는다.
CREATE OR REPLACE FUNCTION anvil.quota_plan_valid(v jsonb) RETURNS boolean LANGUAGE plpgsql IMMUTABLE SECURITY DEFINER SET search_path=pg_catalog AS $$
DECLARE part jsonb;amount numeric;
BEGIN
 -- FN03_MANAGEMENT_DISPATCH_BEGIN
 IF v->>'purpose'='SOURCE_CONTENT_POLICY_MANAGEMENT_STORAGE' OR v->>'operation'='defineSourceContentPolicy'
  OR v->'request'->>'operation'='defineSourceContentPolicy'
  OR v->'parts' @> '[{"kind":"SOURCE_CONTENT_POLICY_MANAGEMENT"}]'::jsonb OR v->'parts' @> '[{"key":"management_origin"}]'::jsonb THEN
  RETURN anvil.fn03_management_plan_valid(v) IS TRUE;
 END IF;
 -- FN03_MANAGEMENT_DISPATCH_END
 IF v->'parts'->0->>'kind'='ORIGIN_REUSE_APPROVAL_CONSUMPTION' THEN
  IF NOT COALESCE(anvil.execution_json_shape(v,ARRAY['request','actorId','parts','commandHash','policyRef','authorizedUntil','replay','planHash','coverageGeneration','requestRecord','requestRef','receiptIds']),false)
   OR v->'replay' IS DISTINCT FROM 'false'::jsonb OR v->'request'->>'operation' IS DISTINCT FROM 'queueExecutionCommand'
   OR v->>'commandHash' IS DISTINCT FROM anvil.fn01_hash(v->'request') OR v->>'planHash' IS DISTINCT FROM anvil.fn01_hash(v-'planHash')
   OR v->'actorId' IS DISTINCT FROM v->'requestRecord'->'grant'->'snapshot'->'binding'->'subject'->'userId'
   OR NOT COALESCE(anvil.execution_preparation_ref_valid(v->'policyRef'),false) OR NOT COALESCE(anvil.execution_preparation_ref_valid(v->'requestRef'),false)
   OR jsonb_typeof(v->'parts') IS DISTINCT FROM 'array' OR jsonb_array_length(v->'parts')<>1
   OR NOT(CASE WHEN v->>'coverageGeneration'~'^[1-9][0-9]{0,15}$' THEN(v->>'coverageGeneration')::numeric<=9007199254740991 ELSE false END)
   OR v->'requestRecord'->>'purpose' IS DISTINCT FROM 'ORIGIN_REUSE_APPROVAL_CONSUMPTION'
   OR v->'requestRef'->>'contentHash' IS DISTINCT FROM anvil.fn01_hash(v->'requestRecord'->'queueIntent') THEN RETURN false;END IF;
  part=v->'parts'->0;
  IF NOT COALESCE(anvil.execution_json_shape(part,ARRAY['key','kind','id','bytes','contentHash','reservedBytes','settledBytes']),false)
   OR part->>'kind' IS DISTINCT FROM 'ORIGIN_REUSE_APPROVAL_CONSUMPTION' OR part->>'key' IS DISTINCT FROM 'origin_reuse_consumption'
   OR part->>'id' IS DISTINCT FROM v->'requestRef'->>'id' OR part->>'contentHash' IS DISTINCT FROM v->'requestRef'->>'contentHash' THEN RETURN false;END IF;
  amount=anvil.quota_decimal(part->'bytes');RETURN COALESCE(amount<=10737418240 AND amount=anvil.quota_decimal(part->'reservedBytes') AND amount=anvil.quota_decimal(part->'settledBytes'),false);
 END IF;
 IF v->'parts'->0->>'kind'='ORIGIN_REUSE_APPROVAL_DECISION' THEN
  IF NOT COALESCE(anvil.execution_json_shape(v,ARRAY['request','actorId','parts','commandHash','policyRef','authorizedUntil','replay','planHash','coverageGeneration','requestRecord','requestRef','receiptIds']),false)
   OR v->'replay' IS DISTINCT FROM 'false'::jsonb OR v->'request'->>'operation' IS DISTINCT FROM 'decideApproval'
   OR v->>'commandHash' IS DISTINCT FROM anvil.fn01_hash(v->'request') OR v->>'planHash' IS DISTINCT FROM anvil.fn01_hash(v-'planHash')
   OR v->'actorId' IS DISTINCT FROM v->'requestRecord'->'decidedBy'->'userId'
   OR NOT COALESCE(anvil.execution_preparation_ref_valid(v->'policyRef'),false) OR NOT COALESCE(anvil.execution_preparation_ref_valid(v->'requestRef'),false)
   OR jsonb_typeof(v->'parts') IS DISTINCT FROM 'array' OR jsonb_array_length(v->'parts')<>1
   OR NOT(CASE WHEN v->>'coverageGeneration'~'^[1-9][0-9]{0,15}$' THEN(v->>'coverageGeneration')::numeric<=9007199254740991 ELSE false END)
   OR v->'request'->'payload' IS DISTINCT FROM jsonb_build_object('requestId',v->'requestRecord'->'requestId','expectedVersion',1,'scopeDigest',v->'requestRecord'->'scopeDigest','decision',v->'requestRecord'->'decision','reason',v->'requestRecord'->'reason')
   OR v->'requestRef'->>'contentHash' IS DISTINCT FROM anvil.fn01_hash((v->'requestRecord')-ARRAY['id','decidedAt']) THEN RETURN false;END IF;
  part=v->'parts'->0;
  IF NOT COALESCE(anvil.execution_json_shape(part,ARRAY['key','kind','id','bytes','contentHash','reservedBytes','settledBytes']),false)
   OR part->>'kind' IS DISTINCT FROM 'ORIGIN_REUSE_APPROVAL_DECISION' OR part->>'key' IS DISTINCT FROM 'origin_reuse_decision'
   OR part->>'id' IS DISTINCT FROM v->'requestRef'->>'id' OR part->>'contentHash' IS DISTINCT FROM v->'requestRef'->>'contentHash' THEN RETURN false;END IF;
  amount=anvil.quota_decimal(part->'bytes');RETURN COALESCE(amount<=10737418240 AND amount=anvil.quota_decimal(part->'reservedBytes') AND amount=anvil.quota_decimal(part->'settledBytes'),false);
 END IF;
 IF COALESCE(v->'parts'->0->>'kind'<>'ORIGIN_REUSE_APPROVAL_REQUEST',false) THEN RETURN anvil.quota_plan_before_origin_reuse_request(v);END IF;
 IF NOT COALESCE(anvil.execution_json_shape(v,ARRAY['request','actorId','parts','commandHash','policyRef','authorizedUntil','replay','planHash','coverageGeneration','requestRecord','requestRef','receiptIds']),false)
  OR v->'replay' IS DISTINCT FROM 'false'::jsonb OR v->'request'->>'operation' IS DISTINCT FROM 'requestApproval'
  OR v->>'commandHash' IS DISTINCT FROM anvil.fn01_hash(v->'request') OR v->>'planHash' IS DISTINCT FROM anvil.fn01_hash(v-'planHash')
  OR NOT COALESCE(anvil.execution_preparation_ref_valid(v->'policyRef'),false) OR NOT COALESCE(anvil.execution_preparation_ref_valid(v->'requestRef'),false)
  OR jsonb_typeof(v->'parts') IS DISTINCT FROM 'array' OR jsonb_array_length(v->'parts')<>1
  OR NOT(CASE WHEN v->>'coverageGeneration'~'^[1-9][0-9]{0,15}$' THEN(v->>'coverageGeneration')::numeric<=9007199254740991 ELSE false END)
  OR v->'requestRecord'->'details' IS DISTINCT FROM v->'request'->'payload'->'details'
  OR v->'requestRecord'->'originReuseEvidence'->'candidatePayload' IS DISTINCT FROM v->'request'->'payload'->'candidatePayload'
  OR v->'requestRef'->>'contentHash' IS DISTINCT FROM anvil.fn01_hash((v->'requestRecord')-ARRAY['id','version','status','createdAt']) THEN RETURN false;END IF;
 part=v->'parts'->0;
 IF NOT COALESCE(anvil.execution_json_shape(part,ARRAY['key','kind','id','bytes','contentHash','reservedBytes','settledBytes']),false)
  OR part->>'kind' IS DISTINCT FROM 'ORIGIN_REUSE_APPROVAL_REQUEST' OR part->>'key' IS DISTINCT FROM 'origin_reuse_request'
  OR part->>'id' IS DISTINCT FROM v->'requestRef'->>'id' OR part->>'contentHash' IS DISTINCT FROM v->'requestRef'->>'contentHash' THEN RETURN false;END IF;
 amount=anvil.quota_decimal(part->'bytes');
 RETURN COALESCE(amount<=10737418240 AND amount=anvil.quota_decimal(part->'reservedBytes') AND amount=anvil.quota_decimal(part->'settledBytes'),false);
EXCEPTION WHEN OTHERS THEN RETURN false;END;$$;

CREATE OR REPLACE FUNCTION anvil.quota_settled_complete(r anvil.project_storage_reservations) RETURNS boolean LANGUAGE plpgsql SECURITY DEFINER SET search_path=pg_catalog AS $$
BEGIN
 -- FN03_MANAGEMENT_DISPATCH_BEGIN
 IF r.operation='defineSourceContentPolicy' OR r.part_kind='SOURCE_CONTENT_POLICY_MANAGEMENT' OR r.part_key='management_origin'
  OR r.plan_json->>'purpose'='SOURCE_CONTENT_POLICY_MANAGEMENT_STORAGE' OR r.plan_json->>'operation'='defineSourceContentPolicy'
  OR r.plan_json->'request'->>'operation'='defineSourceContentPolicy'
  OR r.plan_json->'parts' @> '[{"kind":"SOURCE_CONTENT_POLICY_MANAGEMENT"}]'::jsonb OR r.plan_json->'parts' @> '[{"key":"management_origin"}]'::jsonb THEN
  IF r.operation IS DISTINCT FROM 'defineSourceContentPolicy' OR r.part_kind IS DISTINCT FROM 'SOURCE_CONTENT_POLICY_MANAGEMENT'
   OR r.part_key IS DISTINCT FROM 'management_origin' OR r.phase IS DISTINCT FROM 'SETTLED' OR r.start_fence IS DISTINCT FROM 1
   OR r.id IS DISTINCT FROM r.server_command_id OR r.plan_json->>'purpose' IS DISTINCT FROM 'SOURCE_CONTENT_POLICY_MANAGEMENT_STORAGE'
   OR anvil.fn03_management_plan_valid(r.plan_json) IS NOT TRUE OR r.plan_hash IS DISTINCT FROM anvil.source_read_hash(r.plan_json) THEN RETURN false;END IF;
  IF to_jsonb(r) IS DISTINCT FROM (SELECT to_jsonb(stored) FROM anvil.project_storage_reservations stored WHERE stored.project_id=r.project_id AND stored.id=r.id) THEN RETURN false;END IF;
  RETURN anvil.fn03_management_complete(r.project_id,r.id) IS TRUE;
 END IF;
 -- FN03_MANAGEMENT_DISPATCH_END
 IF r.part_kind='ORIGIN_REUSE_APPROVAL_REQUEST' THEN RETURN anvil.fn09_origin_reuse_request_complete(r.project_id,r.id);END IF;
 IF r.part_kind='ORIGIN_REUSE_APPROVAL_DECISION' THEN RETURN anvil.fn09_origin_reuse_decision_complete(r.project_id,r.id);END IF;
 IF r.part_kind='ORIGIN_REUSE_APPROVAL_CONSUMPTION' THEN RETURN anvil.fn09_origin_reuse_consumption_complete(r.project_id,r.id);END IF;
 RETURN anvil.quota_settled_before_origin_reuse_request(r);
END;$$;

-- 원 deferred NEW의 C/A/U만 검산한다. caller boolean/GUC가 아닌 실제 목적 역할·저장행·봉인 R이다.
-- INVOKER이고 일반 app에 EXEC를 열지 않는다. 기존 root의 다른 목적은 이 함수를 호출하지 않는다.
CREATE FUNCTION anvil.fn03_management_dispatch(table_name text,row_value jsonb) RETURNS void LANGUAGE plpgsql STABLE SET search_path=pg_catalog AS $$
DECLARE p uuid;cid uuid;cmd anvil.commands;r anvil.project_storage_reservations;ids jsonb;stored jsonb;
BEGIN
 IF session_user<>'anvil_v3_app' OR current_user<>'anvil_v3_source_content_management_owner'
  OR table_name IS NULL OR table_name NOT IN('commands','authorization_receipts','audit_events') OR jsonb_typeof(row_value) IS DISTINCT FROM 'object' THEN
  RAISE EXCEPTION 'SOURCE_CONTENT_MANAGEMENT_DISPATCH_INVALID' USING ERRCODE='42501';END IF;
 IF table_name='authorization_receipts' THEN
  IF row_value->>'scope_kind' IS DISTINCT FROM 'PROJECT' THEN RAISE EXCEPTION 'SOURCE_CONTENT_MANAGEMENT_DISPATCH_INVALID';END IF;
  p=(row_value->>'scope_id')::uuid;cid=(row_value->>'command_id')::uuid;
 ELSE p=(row_value->>'project_id')::uuid;cid=(CASE WHEN table_name='commands' THEN row_value->>'id' ELSE row_value->>'command_id' END)::uuid;END IF;
 SELECT x.* INTO STRICT cmd FROM anvil.commands x WHERE x.project_id=p AND x.id=cid AND x.scope_kind='PROJECT' AND x.scope_id=p AND x.operation='defineSourceContentPolicy';
 SELECT x.* INTO STRICT r FROM anvil.project_storage_reservations x WHERE x.project_id=p AND x.id=cid;
 ids=r.plan_json->'ids';
 IF r.operation IS DISTINCT FROM 'defineSourceContentPolicy' OR r.part_kind IS DISTINCT FROM 'SOURCE_CONTENT_POLICY_MANAGEMENT' OR r.part_key IS DISTINCT FROM 'management_origin'
  OR r.phase IS DISTINCT FROM 'SETTLED' OR r.start_fence IS DISTINCT FROM 1 OR r.server_command_id IS DISTINCT FROM cid
  OR r.plan_json->>'transactionId' IS DISTINCT FROM txid_current()::text OR anvil.fn03_management_plan_valid(r.plan_json) IS NOT TRUE
  OR r.plan_hash IS DISTINCT FROM anvil.source_read_hash(r.plan_json)
  OR (SELECT count(*) FROM anvil.project_storage_reservations x WHERE x.project_id=p AND x.plan_json->>'transactionId'=txid_current()::text)<>1
  OR r.actor_id IS DISTINCT FROM cmd.actor_id OR r.client_id IS DISTINCT FROM cmd.client_id OR r.external_command_id IS DISTINCT FROM cmd.command_id
  OR r.command_hash IS DISTINCT FROM cmd.request_hash OR cmd.state IS DISTINCT FROM 'APPLIED'
  OR ids->>'serverCommandId' IS DISTINCT FROM cid::text OR ids->>'operationId' IS DISTINCT FROM cmd.operation_id::text
  OR ids->>'authorizationReceiptId' IS DISTINCT FROM cmd.authorization_receipt_id::text OR r.authorization_receipt_id IS DISTINCT FROM cmd.authorization_receipt_id
  OR r.plan_json->>'projectId' IS DISTINCT FROM p::text OR r.plan_json->>'actorId' IS DISTINCT FROM cmd.actor_id::text
  OR r.plan_json->>'clientId' IS DISTINCT FROM cmd.client_id::text OR r.plan_json->>'externalCommandId' IS DISTINCT FROM cmd.command_id::text
  OR r.plan_json->>'requestHash' IS DISTINCT FROM cmd.request_hash OR r.plan_json->'controlGeneration' IS DISTINCT FROM to_jsonb(cmd.control_generation)
  OR r.plan_json->'permissionPolicyRef' IS DISTINCT FROM cmd.policy_ref OR r.plan_json->>'authorizedUntil' IS DISTINCT FROM anvil.source_read_iso(r.authorized_until)
  OR r.plan_json->'parts'->0->>'bytes' IS DISTINCT FROM r.reserved_bytes::text THEN RAISE EXCEPTION 'SOURCE_CONTENT_MANAGEMENT_DISPATCH_INVALID' USING ERRCODE='42501';END IF;
 IF table_name='commands' THEN stored=to_jsonb(cmd);
 ELSIF table_name='authorization_receipts' THEN
  SELECT to_jsonb(x) INTO STRICT stored FROM anvil.authorization_receipts x WHERE x.scope_kind='PROJECT' AND x.scope_id=p AND x.command_id=cid AND x.id=cmd.authorization_receipt_id;
 ELSE
  SELECT to_jsonb(x) INTO STRICT stored FROM anvil.audit_events x WHERE x.project_id=p AND x.command_id=cid AND x.event_id=(ids->>'auditEventId')::uuid;
 END IF;
 IF row_value IS DISTINCT FROM stored THEN RAISE EXCEPTION 'SOURCE_CONTENT_MANAGEMENT_DISPATCH_INVALID' USING ERRCODE='42501';END IF;
END;$$;
ALTER FUNCTION anvil.fn03_management_dispatch(text,jsonb) OWNER TO anvil_v3_source_content_management_owner;
REVOKE ALL ON FUNCTION anvil.fn03_management_dispatch(text,jsonb) FROM PUBLIC,anvil_v3_app;

-- 역사 complete와 달리 새 거래의 원 시각/등록/봉인 XID를 확인한다. 현재성으로 과거 행을 다시 봉인하지 않는다.
CREATE FUNCTION anvil.fn03_management_current_final(p uuid,cid uuid,expected_tx text) RETURNS void LANGUAGE plpgsql VOLATILE SET search_path=pg_catalog AS $$
DECLARE cmd anvil.commands;r anvil.project_storage_reservations;ctx jsonb;begin_at timestamptz;at_time timestamptz;
BEGIN
 IF session_user<>'anvil_v3_app' OR current_user<>'anvil_v3_source_content_management_owner'
  OR expected_tx IS DISTINCT FROM txid_current()::text THEN RAISE EXCEPTION 'SOURCE_CONTENT_MANAGEMENT_TRANSACTION_INVALID' USING ERRCODE='42501';END IF;
 begin_at=clock_timestamp();
 -- C-only 상태도 STRICT R 선택에서 거절한다. R/원문 JOIN으로 C를 조용히 누락시키지 않는다.
 SELECT x.* INTO STRICT cmd FROM anvil.commands x WHERE x.project_id=p AND x.id=cid AND x.operation='defineSourceContentPolicy';
 SELECT x.* INTO STRICT r FROM anvil.project_storage_reservations x WHERE x.project_id=p AND x.id=cid;
 PERFORM anvil.fn03_management_dispatch('commands',to_jsonb(cmd));
 IF anvil.fn03_management_complete(p,cid) IS NOT TRUE THEN RAISE EXCEPTION 'SOURCE_CONTENT_MANAGEMENT_INCOMPLETE';END IF;
 IF NOT EXISTS(SELECT 1 FROM anvil.project_storage_accounts x WHERE x.project_id=p AND x.coverage_state='VERIFIED' AND x.generation::text=r.plan_json->>'coverageGeneration') THEN RAISE EXCEPTION 'PROJECT_STORAGE_QUOTA_UNVERIFIED';END IF;
 ctx=anvil.fn03_management_context((r.plan_json->>'authSessionId')::uuid,cmd.actor_id,cmd.client_id,p,cmd.control_generation,'defineSourceContentPolicy',cmd.policy_ref,r.authorized_until);
 at_time=clock_timestamp();
 IF ctx->'credentialGeneration' IS DISTINCT FROM r.plan_json->'credentialGeneration' OR ctx->'authorizedUntil' IS DISTINCT FROM r.plan_json->'authorizedUntil'
  OR ctx->>'transactionId' IS DISTINCT FROM expected_tx OR NOT isfinite(begin_at) OR NOT isfinite(at_time)
  OR at_time<begin_at OR at_time<r.settled_at OR at_time>=r.authorized_until THEN RAISE EXCEPTION 'SOURCE_CONTENT_MANAGEMENT_CURRENT_REQUIRED';END IF;
END;$$;
ALTER FUNCTION anvil.fn03_management_current_final(uuid,uuid,text) OWNER TO anvil_v3_source_content_management_owner;
REVOKE ALL ON FUNCTION anvil.fn03_management_current_final(uuid,uuid,text) FROM PUBLIC,anvil_v3_app;

-- 전용 DEFINER의 역완결. 일반 app의 원문 SELECT/EXEC를 추가하지 않는다.
-- OLD/NEW 양쪽 목적을 검사하여 목적 제거·행 이동·C-only·부분 R을 성공으로 숨기지 않는다.
CREATE FUNCTION anvil.fn03_management_final_guard() RETURNS trigger LANGUAGE plpgsql VOLATILE SECURITY DEFINER SET search_path=pg_catalog AS $$
DECLARE raw jsonb;versions jsonb;p uuid;cid uuid;stored jsonb;
BEGIN
 IF TG_TABLE_SCHEMA<>'anvil' OR TG_TABLE_NAME NOT IN('commands','authorization_receipts','audit_events','source_content_policy_events','source_content_policy_management_origins','project_storage_reservations') THEN RAISE EXCEPTION 'SOURCE_CONTENT_MANAGEMENT_TRIGGER_INVALID';END IF;
 IF TG_OP='INSERT' THEN versions=jsonb_build_array(to_jsonb(NEW));
 ELSIF TG_OP='DELETE' THEN versions=jsonb_build_array(to_jsonb(OLD));
 ELSIF TG_OP='UPDATE' THEN versions=jsonb_build_array(to_jsonb(OLD),to_jsonb(NEW));
 ELSE RAISE EXCEPTION 'SOURCE_CONTENT_MANAGEMENT_TRIGGER_INVALID';END IF;
 FOR raw IN SELECT value FROM jsonb_array_elements(versions) LOOP
  IF TG_TABLE_NAME='commands' THEN
   IF raw->>'operation' IS DISTINCT FROM 'defineSourceContentPolicy' THEN CONTINUE;END IF;p=(raw->>'project_id')::uuid;cid=(raw->>'id')::uuid;
  ELSIF TG_TABLE_NAME='authorization_receipts' THEN
   IF raw->>'scope_kind' IS DISTINCT FROM 'PROJECT' THEN CONTINUE;END IF;p=(raw->>'scope_id')::uuid;cid=(raw->>'command_id')::uuid;
   IF NOT EXISTS(SELECT 1 FROM anvil.commands x WHERE x.project_id=p AND x.id=cid AND x.operation='defineSourceContentPolicy') THEN CONTINUE;END IF;
  ELSIF TG_TABLE_NAME='audit_events' THEN
   p=(raw->>'project_id')::uuid;cid=(raw->>'command_id')::uuid;
   IF NOT EXISTS(SELECT 1 FROM anvil.commands x WHERE x.project_id=p AND x.id=cid AND x.operation='defineSourceContentPolicy') THEN CONTINUE;END IF;
  ELSIF TG_TABLE_NAME IN('source_content_policy_events','source_content_policy_management_origins') THEN p=(raw->>'project_id')::uuid;cid=(raw->>'management_command_id')::uuid;
  ELSE
   IF (raw->>'operation'='defineSourceContentPolicy' OR raw->>'part_kind'='SOURCE_CONTENT_POLICY_MANAGEMENT' OR raw->>'part_key'='management_origin'
    OR raw->'plan_json'->>'purpose'='SOURCE_CONTENT_POLICY_MANAGEMENT_STORAGE' OR raw->'plan_json'->>'operation'='defineSourceContentPolicy'
    OR raw->'plan_json'->'parts' @> '[{"kind":"SOURCE_CONTENT_POLICY_MANAGEMENT"}]'::jsonb OR raw->'plan_json'->'parts' @> '[{"key":"management_origin"}]'::jsonb) IS NOT TRUE THEN CONTINUE;END IF;
   p=(raw->>'project_id')::uuid;cid=(raw->>'id')::uuid;
  END IF;
  PERFORM anvil.fn03_management_current_final(p,cid,txid_current()::text);
  IF TG_TABLE_NAME IN('commands','authorization_receipts','audit_events') THEN PERFORM anvil.fn03_management_dispatch(TG_TABLE_NAME,raw);
  ELSIF TG_TABLE_NAME='source_content_policy_events' THEN
   SELECT to_jsonb(x) INTO STRICT stored FROM anvil.source_content_policy_events x WHERE x.project_id=p AND x.management_command_id=cid;
   IF stored IS DISTINCT FROM raw THEN RAISE EXCEPTION 'SOURCE_CONTENT_MANAGEMENT_STORED_MISMATCH';END IF;
  ELSIF TG_TABLE_NAME='source_content_policy_management_origins' THEN
   SELECT to_jsonb(x) INTO STRICT stored FROM anvil.source_content_policy_management_origins x WHERE x.project_id=p AND x.management_command_id=cid;
   IF stored IS DISTINCT FROM raw THEN RAISE EXCEPTION 'SOURCE_CONTENT_MANAGEMENT_STORED_MISMATCH';END IF;
  ELSE
   SELECT to_jsonb(x) INTO STRICT stored FROM anvil.project_storage_reservations x WHERE x.project_id=p AND x.id=cid;
   IF raw-ARRAY['phase','start_fence','settled_bytes','started_at','settled_at','server_command_id','authorization_receipt_id','scope_digest']
    IS DISTINCT FROM stored-ARRAY['phase','start_fence','settled_bytes','started_at','settled_at','server_command_id','authorization_receipt_id','scope_digest'] THEN RAISE EXCEPTION 'SOURCE_CONTENT_MANAGEMENT_STORED_MISMATCH';END IF;
  END IF;
 END LOOP;
 RETURN NULL;
END;$$;
ALTER FUNCTION anvil.fn03_management_final_guard() OWNER TO anvil_v3_source_content_management_owner;
REVOKE ALL ON FUNCTION anvil.fn03_management_final_guard() FROM PUBLIC,anvil_v3_app;

CREATE CONSTRAINT TRIGGER source_content_management_commands_complete AFTER INSERT OR UPDATE OR DELETE ON anvil.commands DEFERRABLE INITIALLY DEFERRED FOR EACH ROW EXECUTE FUNCTION anvil.fn03_management_final_guard();
CREATE CONSTRAINT TRIGGER source_content_management_receipts_complete AFTER INSERT OR UPDATE OR DELETE ON anvil.authorization_receipts DEFERRABLE INITIALLY DEFERRED FOR EACH ROW EXECUTE FUNCTION anvil.fn03_management_final_guard();
CREATE CONSTRAINT TRIGGER source_content_management_audits_complete AFTER INSERT OR UPDATE OR DELETE ON anvil.audit_events DEFERRABLE INITIALLY DEFERRED FOR EACH ROW EXECUTE FUNCTION anvil.fn03_management_final_guard();
CREATE CONSTRAINT TRIGGER source_content_management_events_complete AFTER INSERT OR UPDATE OR DELETE ON anvil.source_content_policy_events DEFERRABLE INITIALLY DEFERRED FOR EACH ROW EXECUTE FUNCTION anvil.fn03_management_final_guard();
CREATE CONSTRAINT TRIGGER source_content_management_origins_complete AFTER INSERT OR UPDATE OR DELETE ON anvil.source_content_policy_management_origins DEFERRABLE INITIALLY DEFERRED FOR EACH ROW EXECUTE FUNCTION anvil.fn03_management_final_guard();
CREATE CONSTRAINT TRIGGER source_content_management_reservations_complete AFTER INSERT OR UPDATE OR DELETE ON anvil.project_storage_reservations DEFERRABLE INITIALLY DEFERRED FOR EACH ROW EXECUTE FUNCTION anvil.fn03_management_final_guard();

-- 16 이름은 24개 실제 부착이다. material의 다른 6표 이벤트는 새 목적 분기를 타지 않는다.
-- 설치 source 검산이며 실제 catalog/PG15 발화 principal 시험을 대신하지 않는다.
DO $$
BEGIN
 IF EXISTS(
  WITH expected(trigger_name,table_name,function_name,event_bits) AS (VALUES
   ('fn09_prepare_commands_complete','commands','fn09_prepare_complete',21),
   ('fn09_prepare_authorization_receipts_complete','authorization_receipts','fn09_prepare_complete',21),
   ('fn09_prepare_audit_events_complete','audit_events','fn09_prepare_complete',21),
   ('fn09_understanding_commands_complete','commands','fn09_understanding_complete',21),
   ('fn09_understanding_authorization_receipts_complete','authorization_receipts','fn09_understanding_complete',21),
   ('fn09_understanding_audit_events_complete','audit_events','fn09_understanding_complete',21),
   ('child_human_commands_complete','commands','guard_child_human_complete',29),
   ('child_human_receipts_complete','authorization_receipts','guard_child_human_complete',29),
   ('child_human_audits_complete','audit_events','guard_child_human_complete',29),
   ('fn16_policy_commands_complete','commands','fn16_policy_complete',29),
   ('fn16_policy_authorization_receipts_complete','authorization_receipts','fn16_policy_complete',29),
   ('fn16_policy_audit_events_complete','audit_events','fn16_policy_complete',29),
   ('fn09_registered_commands_complete','commands','fn09_registered_binding_complete',5),
   ('fn09_registered_authorization_receipts_complete','authorization_receipts','fn09_registered_binding_complete',5),
   ('fn09_registered_audit_events_complete','audit_events','fn09_registered_binding_complete',5),
   ('material_registration_complete','execution_material_manifests','material_registration_reverse',29),
   ('material_registration_complete','execution_materials','material_registration_reverse',29),
   ('material_registration_complete','execution_material_proof_bindings','material_registration_reverse',29),
   ('material_registration_complete','execution_commands','material_registration_reverse',29),
   ('material_registration_complete','commands','material_registration_reverse',29),
   ('material_registration_complete','authorization_receipts','material_registration_reverse',29),
   ('material_registration_complete','audit_events','material_registration_reverse',29),
   ('material_registration_complete','execution_receipts','material_registration_reverse',29),
   ('material_registration_complete','execution_challenges','material_registration_reverse',29))
  SELECT 1 FROM expected e
  LEFT JOIN pg_catalog.pg_namespace n ON n.nspname='anvil'
  LEFT JOIN pg_catalog.pg_class rel ON rel.relnamespace=n.oid AND rel.relname=e.table_name
  LEFT JOIN pg_catalog.pg_trigger t ON t.tgrelid=rel.oid AND t.tgname=e.trigger_name
  LEFT JOIN pg_catalog.pg_proc f ON f.oid=t.tgfoid
  LEFT JOIN pg_catalog.pg_constraint con ON con.oid=t.tgconstraint
  WHERE t.oid IS NULL OR t.tgisinternal OR NOT t.tgdeferrable OR NOT t.tginitdeferred OR t.tgenabled<>'O' OR t.tgtype<>e.event_bits
   OR con.contype IS DISTINCT FROM 't' OR con.connamespace IS DISTINCT FROM n.oid OR con.conrelid IS DISTINCT FROM rel.oid
   OR con.condeferrable IS DISTINCT FROM true OR con.condeferred IS DISTINCT FROM true
   OR f.pronamespace IS DISTINCT FROM n.oid OR f.proname IS DISTINCT FROM e.function_name OR f.prosecdef OR f.pronargs<>0
   OR f.prokind IS DISTINCT FROM 'f' OR f.prorettype IS DISTINCT FROM 'pg_catalog.trigger'::regtype
 ) OR (SELECT count(*) FROM pg_catalog.pg_trigger t JOIN pg_catalog.pg_class rel ON rel.oid=t.tgrelid JOIN pg_catalog.pg_namespace n ON n.oid=rel.relnamespace
  WHERE n.nspname='anvil' AND t.tgname=ANY(ARRAY['fn09_prepare_commands_complete','fn09_prepare_authorization_receipts_complete','fn09_prepare_audit_events_complete','fn09_understanding_commands_complete','fn09_understanding_authorization_receipts_complete','fn09_understanding_audit_events_complete','child_human_commands_complete','child_human_receipts_complete','child_human_audits_complete','fn16_policy_commands_complete','fn16_policy_authorization_receipts_complete','fn16_policy_audit_events_complete','fn09_registered_commands_complete','fn09_registered_authorization_receipts_complete','fn09_registered_audit_events_complete','material_registration_complete']))<>24 THEN
  RAISE EXCEPTION 'SOURCE_CONTENT_MANAGEMENT_TRIGGER_LAYOUT_INVALID';
 END IF;
END;$$;

-- 각 root의 원 owner/ACL/INVOKER/body는 보존하고 명시된 새 목적 분기만 더한다.
CREATE OR REPLACE FUNCTION anvil.fn09_prepare_complete() RETURNS trigger LANGUAGE plpgsql AS $$
DECLARE v jsonb=to_jsonb(NEW);pid uuid;cid uuid;rid uuid;c anvil.commands%ROWTYPE;r anvil.approval_requests%ROWTYPE;did uuid;
BEGIN
 -- FN03_MANAGEMENT_TRIGGER_BEGIN
 IF TG_OP IN('INSERT','UPDATE') THEN
  IF TG_TABLE_NAME='commands' THEN
   IF NEW.operation='defineSourceContentPolicy' THEN PERFORM anvil.fn03_management_dispatch(TG_TABLE_NAME,to_jsonb(NEW));RETURN NULL;END IF;
  ELSIF TG_TABLE_NAME='authorization_receipts' THEN
   IF NEW.scope_kind='PROJECT' AND EXISTS(SELECT 1 FROM anvil.commands x WHERE x.project_id=NEW.scope_id AND x.id=NEW.command_id AND x.operation='defineSourceContentPolicy') THEN
    PERFORM anvil.fn03_management_dispatch(TG_TABLE_NAME,to_jsonb(NEW));RETURN NULL;
   END IF;
  ELSIF TG_TABLE_NAME='audit_events' THEN
   IF EXISTS(SELECT 1 FROM anvil.commands x WHERE x.project_id=NEW.project_id AND x.id=NEW.command_id AND x.operation='defineSourceContentPolicy') THEN
    PERFORM anvil.fn03_management_dispatch(TG_TABLE_NAME,to_jsonb(NEW));RETURN NULL;
   END IF;
  END IF;
 END IF;
 -- FN03_MANAGEMENT_TRIGGER_END
 pid=CASE WHEN TG_TABLE_NAME='authorization_receipts' THEN (v->>'scope_id')::uuid ELSE (v->>'project_id')::uuid END;
 cid=CASE WHEN TG_TABLE_NAME='commands' THEN (v->>'id')::uuid ELSE (v->>'command_id')::uuid END;
 IF TG_TABLE_NAME='execution_preparation_approval_candidates' THEN cid=(v->>'request_command_id')::uuid;rid=(v->>'request_id')::uuid;
 ELSIF TG_TABLE_NAME='approval_requests' THEN rid=(v->>'id')::uuid;
 ELSIF TG_TABLE_NAME='approval_decisions' THEN rid=(v->>'request_id')::uuid;END IF;
 IF TG_TABLE_NAME IN('authorization_receipts','approval_consumptions') THEN
 SELECT d.request_id INTO rid FROM anvil.approval_decisions d WHERE d.project_id=pid AND d.id=COALESCE((v->>'approval_decision_ref')::uuid,(v->>'decision_id')::uuid);
 ELSIF TG_TABLE_NAME='audit_events' THEN
 rid=(v->'approval_ref'->>'requestId')::uuid;
 IF EXISTS(SELECT 1 FROM anvil.execution_preparations ep WHERE ep.project_id=pid AND ep.id::text=v->'target_ref'->>'id' AND ep.command_id IS DISTINCT FROM cid) THEN RAISE EXCEPTION 'PREPARATION_AUDIT_LINK_REQUIRED' USING ERRCODE='42501';END IF;
 END IF;
 SELECT * INTO c FROM anvil.commands x WHERE x.project_id=pid AND x.id=cid;
 IF c.operation='prepareExecution' OR EXISTS(SELECT 1 FROM anvil.execution_preparations x WHERE x.project_id=pid AND x.command_id=cid) THEN
  IF c.id IS NULL OR c.operation<>'prepareExecution' OR c.state<>'APPLIED' OR (SELECT count(*) FROM anvil.execution_preparations x WHERE x.project_id=pid AND x.command_id=cid)<>1
  OR (SELECT count(*) FROM anvil.authorization_receipts x WHERE x.command_id=cid)<>1 OR (SELECT count(*) FROM anvil.audit_events x WHERE x.project_id=pid AND x.command_id=cid AND x.outcome='APPLIED')<>1
  THEN RAISE EXCEPTION 'PREPARATION_COMMAND_COMPLETE_REQUIRED' USING ERRCODE='42501';END IF;
  IF c.approval_consumption_id IS NULL THEN
   IF c.payload_ref IS NOT NULL OR EXISTS(SELECT 1 FROM anvil.approval_consumptions x WHERE x.command_id=cid)
   OR EXISTS(SELECT 1 FROM anvil.authorization_receipts x WHERE x.command_id=cid AND x.approval_decision_ref IS NOT NULL)
   OR EXISTS(SELECT 1 FROM anvil.audit_events x WHERE x.command_id=cid AND x.approval_ref IS NOT NULL)
   OR NOT COALESCE(anvil.execution_preparation_authorized_before_preparation(pid,'prepareExecution'),false) THEN RAISE EXCEPTION 'PREPARATION_AUTO_COMPLETE_REQUIRED' USING ERRCODE='42501';END IF;
  ELSE
   SELECT x.approval_decision_ref INTO did FROM anvil.authorization_receipts x WHERE x.command_id=cid AND x.id=c.authorization_receipt_id;
   IF (SELECT count(*) FROM anvil.approval_consumptions x WHERE x.command_id=cid)<>1 OR NOT COALESCE(anvil.fn09_prepare_approval_execution_valid(pid,cid,did,true),false) THEN RAISE EXCEPTION 'PREPARATION_APPROVAL_COMPLETE_REQUIRED' USING ERRCODE='42501';END IF;
  END IF;
 END IF;
 FOR r IN SELECT x.* FROM anvil.approval_requests x WHERE x.project_id=pid AND (x.id=rid OR x.command_id=cid
 OR EXISTS(SELECT 1 FROM anvil.execution_preparation_approval_candidates b WHERE b.project_id=pid AND b.request_id=x.id AND (b.request_command_id=cid OR b.candidate_command_id=c.command_id))
 OR EXISTS(SELECT 1 FROM anvil.approval_decisions d JOIN anvil.approval_consumptions ac ON ac.project_id=d.project_id AND ac.decision_id=d.id WHERE d.project_id=pid AND d.request_id=x.id AND ac.command_id=cid)) LOOP
  IF r.action_scope_json->>'operation'='prepareExecution' OR EXISTS(SELECT 1 FROM anvil.execution_preparation_approval_candidates b WHERE b.project_id=pid AND b.request_id=r.id) THEN
   IF (SELECT count(*) FROM anvil.execution_preparation_approval_candidates b WHERE b.project_id=pid AND b.request_id=r.id)<>1 OR NOT COALESCE(anvil.fn09_prepare_candidate_valid(pid,r.id),false) THEN RAISE EXCEPTION 'PREPARATION_CANDIDATE_COMPLETE_REQUIRED' USING ERRCODE='42501';END IF;
   IF EXISTS(SELECT 1 FROM anvil.approval_decisions d JOIN anvil.authorization_receipts ar ON ar.scope_kind='PROJECT' AND ar.scope_id=d.project_id AND ar.approval_decision_ref=d.id WHERE d.project_id=pid AND d.request_id=r.id AND NOT EXISTS(SELECT 1 FROM anvil.commands x WHERE x.project_id=pid AND x.id=ar.command_id AND x.operation='prepareExecution' AND x.authorization_receipt_id=ar.id AND x.approval_consumption_id IS NOT NULL))
   OR EXISTS(SELECT 1 FROM anvil.audit_events a WHERE a.project_id=pid AND a.approval_ref->>'requestId'=r.id::text AND NOT EXISTS(SELECT 1 FROM anvil.commands x JOIN anvil.approval_consumptions ac ON ac.project_id=x.project_id AND ac.command_id=x.id JOIN anvil.approval_decisions d ON d.project_id=ac.project_id AND d.id=ac.decision_id WHERE x.project_id=pid AND x.id=a.command_id AND x.operation='prepareExecution' AND x.approval_consumption_id=ac.id AND d.request_id=r.id))
   THEN RAISE EXCEPTION 'PREPARATION_APPROVAL_LINK_GRAPH_REQUIRED' USING ERRCODE='42501';END IF;
   IF r.status='CONSUMED' THEN
    IF (SELECT count(*) FROM anvil.approval_decisions d JOIN anvil.approval_consumptions ac ON ac.project_id=d.project_id AND ac.decision_id=d.id JOIN anvil.commands x ON x.project_id=ac.project_id AND x.id=ac.command_id JOIN anvil.execution_preparations ep ON ep.project_id=x.project_id AND ep.command_id=x.id WHERE d.project_id=pid AND d.request_id=r.id AND d.decision='APPROVE' AND x.operation='prepareExecution' AND anvil.fn09_prepare_approval_execution_valid(pid,x.id,d.id,true))<>1 THEN RAISE EXCEPTION 'PREPARATION_CONSUMED_GRAPH_REQUIRED' USING ERRCODE='42501';END IF;
   ELSIF EXISTS(SELECT 1 FROM anvil.approval_decisions d JOIN anvil.approval_consumptions ac ON ac.project_id=d.project_id AND ac.decision_id=d.id WHERE d.project_id=pid AND d.request_id=r.id) THEN RAISE EXCEPTION 'PREPARATION_UNCONSUMED_GRAPH_REQUIRED' USING ERRCODE='42501';END IF;
  END IF;
 END LOOP;RETURN NEW;
END;
$$;

CREATE OR REPLACE FUNCTION anvil.fn09_understanding_complete() RETURNS trigger LANGUAGE plpgsql AS $$
DECLARE pid uuid;raw jsonb=to_jsonb(NEW);c anvil.commands%ROWTYPE;b anvil.understanding_review_approval_candidates%ROWTYPE;v anvil.understanding_reviews%ROWTYPE;r anvil.approval_requests%ROWTYPE;
BEGIN
 -- FN03_MANAGEMENT_TRIGGER_BEGIN
 IF TG_OP IN('INSERT','UPDATE') THEN
  IF TG_TABLE_NAME='commands' THEN
   IF NEW.operation='defineSourceContentPolicy' THEN PERFORM anvil.fn03_management_dispatch(TG_TABLE_NAME,to_jsonb(NEW));RETURN NULL;END IF;
  ELSIF TG_TABLE_NAME='authorization_receipts' THEN
   IF NEW.scope_kind='PROJECT' AND EXISTS(SELECT 1 FROM anvil.commands x WHERE x.project_id=NEW.scope_id AND x.id=NEW.command_id AND x.operation='defineSourceContentPolicy') THEN
    PERFORM anvil.fn03_management_dispatch(TG_TABLE_NAME,to_jsonb(NEW));RETURN NULL;
   END IF;
  ELSIF TG_TABLE_NAME='audit_events' THEN
   IF EXISTS(SELECT 1 FROM anvil.commands x WHERE x.project_id=NEW.project_id AND x.id=NEW.command_id AND x.operation='defineSourceContentPolicy') THEN
    PERFORM anvil.fn03_management_dispatch(TG_TABLE_NAME,to_jsonb(NEW));RETURN NULL;
   END IF;
  END IF;
 END IF;
 -- FN03_MANAGEMENT_TRIGGER_END
 pid=CASE WHEN TG_TABLE_NAME='authorization_receipts' THEN (raw->>'scope_id')::uuid ELSE (raw->>'project_id')::uuid END;
 IF pid IS NULL THEN RETURN NULL;END IF;
 FOR r IN SELECT * FROM anvil.approval_requests WHERE project_id=pid AND action_scope_json->>'operation'='reviewUnderstanding' LOOP
  IF NOT COALESCE(anvil.fn09_understanding_candidate_valid(pid,r.id),false) THEN RAISE EXCEPTION 'UNDERSTANDING_APPROVAL_CANDIDATE_REQUIRED' USING ERRCODE='42501';END IF;
 END LOOP;
 FOR b IN SELECT * FROM anvil.understanding_review_approval_candidates WHERE project_id=pid LOOP
  IF NOT COALESCE(anvil.fn09_understanding_candidate_valid(pid,b.request_id),false) THEN RAISE EXCEPTION 'UNDERSTANDING_APPROVAL_CANDIDATE_REQUIRED' USING ERRCODE='42501';END IF;
 END LOOP;
 FOR c IN SELECT * FROM anvil.commands WHERE project_id=pid AND scope_kind='PROJECT' AND operation='reviewUnderstanding' LOOP
  SELECT * INTO v FROM anvil.understanding_reviews WHERE project_id=pid AND command_id=c.id;
  IF v.command_id IS NULL OR v.snapshot_json->'requestHash' IS DISTINCT FROM to_jsonb(c.request_hash) OR anvil.execution_json_hash(v.snapshot_json->'request') IS DISTINCT FROM c.request_hash OR v.content_hash IS DISTINCT FROM anvil.execution_json_hash(v.snapshot_json) OR c.result_ref->'data'->'ref' IS DISTINCT FROM jsonb_build_object('id',v.id,'version',v.version,'contentHash',v.content_hash) OR c.result_ref->'data'->'snapshot' IS DISTINCT FROM v.snapshot_json THEN RAISE EXCEPTION 'UNDERSTANDING_APPROVAL_COMPLETE_REQUIRED' USING ERRCODE='42501';END IF;
  IF c.approval_consumption_id IS NOT NULL THEN
   IF NOT COALESCE(anvil.fn09_understanding_approval_valid(pid,c.id,(v.snapshot_json->'request'->'approvalRef'->>'decisionId')::uuid,true),false) THEN RAISE EXCEPTION 'UNDERSTANDING_APPROVAL_COMPLETE_REQUIRED' USING ERRCODE='42501';END IF;
  ELSIF c.payload_ref IS NOT NULL OR v.snapshot_json->'request'->'approvalRef' IS DISTINCT FROM 'null'::jsonb THEN RAISE EXCEPTION 'UNDERSTANDING_AUTO_LINK_REQUIRED' USING ERRCODE='42501';END IF;
 END LOOP;
 IF EXISTS(SELECT 1 FROM anvil.understanding_reviews u LEFT JOIN anvil.commands c ON c.project_id=u.project_id AND c.id=u.command_id WHERE u.project_id=pid AND (c.id IS NULL OR c.operation<>'reviewUnderstanding')) THEN RAISE EXCEPTION 'UNDERSTANDING_APPROVAL_COMPLETE_REQUIRED' USING ERRCODE='42501';END IF;
 IF EXISTS(SELECT 1 FROM anvil.approval_requests r LEFT JOIN anvil.approval_decisions d ON d.project_id=r.project_id AND d.request_id=r.id LEFT JOIN anvil.approval_consumptions ac ON ac.project_id=r.project_id AND ac.decision_id=d.id LEFT JOIN anvil.commands c ON c.project_id=r.project_id AND c.id=ac.command_id LEFT JOIN anvil.understanding_reviews u ON u.project_id=c.project_id AND u.command_id=c.id WHERE r.project_id=pid AND r.action_scope_json->>'operation'='reviewUnderstanding' AND ((r.status='CONSUMED' AND (ac.id IS NULL OR c.id IS NULL OR u.command_id IS NULL)) OR (ac.id IS NOT NULL AND (r.status<>'CONSUMED' OR c.operation IS DISTINCT FROM 'reviewUnderstanding' OR u.command_id IS NULL)))) THEN RAISE EXCEPTION 'UNDERSTANDING_APPROVAL_COMPLETE_REQUIRED' USING ERRCODE='42501';END IF;
 RETURN NULL;
END;
$$;

CREATE OR REPLACE FUNCTION anvil.guard_child_human_complete() RETURNS trigger LANGUAGE plpgsql AS $$
DECLARE n jsonb; cid uuid; pid uuid; c anvil.commands%ROWTYPE; d anvil.assignment_draft_versions%ROWTYPE; at timestamptz;
BEGIN
 -- FN03_MANAGEMENT_TRIGGER_BEGIN
 IF TG_OP IN('INSERT','UPDATE') THEN
  IF TG_TABLE_NAME='commands' THEN
   IF NEW.operation='defineSourceContentPolicy' THEN PERFORM anvil.fn03_management_dispatch(TG_TABLE_NAME,to_jsonb(NEW));RETURN NULL;END IF;
  ELSIF TG_TABLE_NAME='authorization_receipts' THEN
   IF NEW.scope_kind='PROJECT' AND EXISTS(SELECT 1 FROM anvil.commands x WHERE x.project_id=NEW.scope_id AND x.id=NEW.command_id AND x.operation='defineSourceContentPolicy') THEN
    PERFORM anvil.fn03_management_dispatch(TG_TABLE_NAME,to_jsonb(NEW));RETURN NULL;
   END IF;
  ELSIF TG_TABLE_NAME='audit_events' THEN
   IF EXISTS(SELECT 1 FROM anvil.commands x WHERE x.project_id=NEW.project_id AND x.id=NEW.command_id AND x.operation='defineSourceContentPolicy') THEN
    PERFORM anvil.fn03_management_dispatch(TG_TABLE_NAME,to_jsonb(NEW));RETURN NULL;
   END IF;
  END IF;
 END IF;
 -- FN03_MANAGEMENT_TRIGGER_END
 IF TG_OP='DELETE' THEN n=to_jsonb(OLD);ELSE n=to_jsonb(NEW);END IF;
 cid=CASE WHEN TG_TABLE_NAME='commands' THEN (n->>'id')::uuid ELSE (n->>'command_id')::uuid END;
 SELECT * INTO c FROM anvil.commands WHERE id=cid;
 IF c.id IS NULL THEN
  IF EXISTS(SELECT 1 FROM anvil.assignment_content_reviews WHERE command_id=cid) OR EXISTS(SELECT 1 FROM anvil.assignment_versions WHERE command_id=cid) THEN RAISE EXCEPTION 'ASSIGNMENT_CONTENT_INCOMPLETE' USING ERRCODE='42501';END IF;
  RETURN NULL;
 END IF;
 pid=c.project_id;
 IF anvil.child_human_complete(pid,cid) IS NOT TRUE THEN RAISE EXCEPTION 'ASSIGNMENT_CONTENT_INCOMPLETE' USING ERRCODE='42501';END IF;
 -- 새 child 기록은 잠금 대기 뒤 최종 clock에서도 현재 세션/정책/부모가 유효해야 한다.
 IF c.operation='reviewAssignmentContent' THEN
  SELECT dv.* INTO d FROM anvil.assignment_draft_versions dv JOIN anvil.assignment_content_reviews r ON r.project_id=dv.project_id AND r.draft_id=dv.draft_id AND r.draft_version=dv.version WHERE r.project_id=pid AND r.command_id=cid;
 ELSE
  SELECT dv.* INTO d FROM anvil.assignment_draft_versions dv JOIN anvil.assignment_versions v ON v.project_id=dv.project_id AND v.assignment_id=dv.draft_id AND v.version=dv.version WHERE v.project_id=pid AND v.command_id=cid;
 END IF;
 IF d.draft_id IS NOT NULL AND d.version_json->'definition'->'parentAssignmentRef' IS DISTINCT FROM 'null'::jsonb THEN
  at=clock_timestamp();
  IF anvil.assignment_content_authorized(pid,c.operation) IS NOT TRUE OR anvil.assignment_parent_current(pid,d.draft_id,d.version_json) IS NOT TRUE THEN RAISE EXCEPTION 'ASSIGNMENT_PARENT_NOT_CURRENT' USING ERRCODE='42501';END IF;
 END IF;
 RETURN NULL;
END;
$$;

CREATE OR REPLACE FUNCTION anvil.fn16_policy_complete() RETURNS trigger LANGUAGE plpgsql AS $$
DECLARE pid uuid;cid uuid;v anvil.backup_policy_versions;b anvil.backup_policy_approval_candidates;c anvil.commands;
BEGIN
 -- FN03_MANAGEMENT_TRIGGER_BEGIN
 IF TG_OP IN('INSERT','UPDATE') THEN
  IF TG_TABLE_NAME='commands' THEN
   IF NEW.operation='defineSourceContentPolicy' THEN PERFORM anvil.fn03_management_dispatch(TG_TABLE_NAME,to_jsonb(NEW));RETURN NULL;END IF;
  ELSIF TG_TABLE_NAME='authorization_receipts' THEN
   IF NEW.scope_kind='PROJECT' AND EXISTS(SELECT 1 FROM anvil.commands x WHERE x.project_id=NEW.scope_id AND x.id=NEW.command_id AND x.operation='defineSourceContentPolicy') THEN
    PERFORM anvil.fn03_management_dispatch(TG_TABLE_NAME,to_jsonb(NEW));RETURN NULL;
   END IF;
  ELSIF TG_TABLE_NAME='audit_events' THEN
   IF EXISTS(SELECT 1 FROM anvil.commands x WHERE x.project_id=NEW.project_id AND x.id=NEW.command_id AND x.operation='defineSourceContentPolicy') THEN
    PERFORM anvil.fn03_management_dispatch(TG_TABLE_NAME,to_jsonb(NEW));RETURN NULL;
   END IF;
  END IF;
 END IF;
 -- FN03_MANAGEMENT_TRIGGER_END
 IF TG_TABLE_NAME='backup_policies' THEN
  pid=COALESCE(NEW.project_id,OLD.project_id);
  IF NOT EXISTS(SELECT 1 FROM anvil.backup_policy_versions v JOIN anvil.backup_policies h ON h.project_id=v.project_id AND h.id=v.policy_id AND h.head_version=v.version WHERE h.project_id=pid AND h.id=NEW.id AND anvil.fn16_policy_version_valid(v.project_id,v.policy_id,v.version)) THEN RAISE EXCEPTION 'BACKUP_POLICY_HEAD_INCOMPLETE' USING ERRCODE='23514';END IF;
 ELSIF TG_TABLE_NAME='backup_policy_versions' THEN pid=NEW.project_id;cid=NEW.command_id;
 ELSIF TG_TABLE_NAME='backup_policy_approval_candidates' THEN pid=NEW.project_id;cid=NEW.request_command_id;
 ELSIF TG_TABLE_NAME='commands' THEN pid=COALESCE(NEW.project_id,OLD.project_id);cid=COALESCE(NEW.id,OLD.id);
 ELSIF TG_TABLE_NAME='authorization_receipts' THEN
  IF COALESCE(NEW.scope_kind,OLD.scope_kind)<>'PROJECT' THEN RETURN NULL;END IF;
  pid=COALESCE(NEW.scope_id,OLD.scope_id);cid=COALESCE(NEW.command_id,OLD.command_id);
 ELSIF TG_TABLE_NAME='audit_events' OR TG_TABLE_NAME='approval_consumptions' THEN pid=COALESCE(NEW.project_id,OLD.project_id);cid=COALESCE(NEW.command_id,OLD.command_id);
 ELSIF TG_TABLE_NAME='approval_requests' THEN pid=COALESCE(NEW.project_id,OLD.project_id);cid=COALESCE(NEW.command_id,OLD.command_id);
 ELSIF TG_TABLE_NAME='approval_decisions' THEN
  pid=COALESCE(NEW.project_id,OLD.project_id);
  SELECT request_command_id INTO cid FROM anvil.backup_policy_approval_candidates WHERE project_id=pid AND request_id=COALESCE(NEW.request_id,OLD.request_id);
 END IF;
 IF pid IS NULL THEN RETURN NULL;END IF;
 SELECT * INTO c FROM anvil.commands WHERE project_id=pid AND id=cid;
 -- 원행을 먼저 분류한다. operation/result 변조가 원행 보호를 우회하지 않는다.
 FOR v IN SELECT * FROM anvil.backup_policy_versions WHERE project_id=pid AND command_id=cid LOOP
  IF NOT COALESCE(anvil.fn16_policy_version_valid(pid,v.policy_id,v.version),false) THEN RAISE EXCEPTION 'BACKUP_POLICY_INCOMPLETE' USING ERRCODE='23514';END IF;
 END LOOP;
 FOR b IN SELECT * FROM anvil.backup_policy_approval_candidates WHERE project_id=pid AND request_command_id=cid LOOP
  IF NOT COALESCE(anvil.fn16_policy_candidate_valid(pid,b.request_id),false) THEN RAISE EXCEPTION 'BACKUP_POLICY_CANDIDATE_INCOMPLETE' USING ERRCODE='23514';END IF;
  FOR v IN SELECT v0.* FROM anvil.backup_policy_versions v0 JOIN anvil.approval_consumptions ac ON ac.project_id=v0.project_id AND ac.command_id=v0.command_id JOIN anvil.approval_decisions d ON d.project_id=ac.project_id AND d.id=ac.decision_id WHERE d.project_id=pid AND d.request_id=b.request_id LOOP
   IF NOT COALESCE(anvil.fn16_policy_version_valid(pid,v.policy_id,v.version),false) THEN RAISE EXCEPTION 'BACKUP_POLICY_CONSUMPTION_INCOMPLETE' USING ERRCODE='23514';END IF;
  END LOOP;
 END LOOP;
 FOR b IN SELECT b0.* FROM anvil.backup_policy_approval_candidates b0 WHERE b0.project_id=pid AND EXISTS(
  SELECT 1 FROM anvil.approval_decisions d WHERE d.project_id=pid AND d.request_id=b0.request_id AND d.command_id=cid) LOOP
  IF NOT anvil.fn16_policy_candidate_valid(pid,b.request_id) THEN RAISE EXCEPTION 'BACKUP_POLICY_CANDIDATE_INCOMPLETE' USING ERRCODE='23514';END IF;
  FOR v IN SELECT v0.* FROM anvil.backup_policy_versions v0 JOIN anvil.approval_consumptions ac ON ac.project_id=v0.project_id AND ac.command_id=v0.command_id JOIN anvil.approval_decisions d ON d.project_id=ac.project_id AND d.id=ac.decision_id WHERE d.project_id=pid AND d.request_id=b.request_id LOOP
   IF NOT anvil.fn16_policy_version_valid(pid,v.policy_id,v.version) THEN RAISE EXCEPTION 'BACKUP_POLICY_CONSUMPTION_INCOMPLETE' USING ERRCODE='23514';END IF;
  END LOOP;
 END LOOP;
 IF c.operation='saveBackupPolicy' AND c.state='APPLIED' AND (SELECT count(*) FROM anvil.backup_policy_versions WHERE project_id=pid AND command_id=cid)<>1 THEN RAISE EXCEPTION 'BACKUP_POLICY_ROW_MISSING' USING ERRCODE='23514';END IF;
 IF c.operation='requestApproval' AND c.state='APPLIED' AND EXISTS(SELECT 1 FROM anvil.approval_requests r WHERE r.project_id=pid AND r.command_id=cid AND r.action_scope_json->>'operation'='saveBackupPolicy') AND (SELECT count(*) FROM anvil.backup_policy_approval_candidates WHERE project_id=pid AND request_command_id=cid)<>1 THEN RAISE EXCEPTION 'BACKUP_POLICY_CANDIDATE_MISSING' USING ERRCODE='23514';END IF;
 IF NOT anvil.fn16_policy_capacity(pid) THEN RAISE EXCEPTION 'BACKUP_POLICY_LIMIT_UNAVAILABLE' USING ERRCODE='23514';END IF;
 RETURN NULL;
END;$$;

CREATE OR REPLACE FUNCTION anvil.fn09_registered_binding_complete() RETURNS trigger LANGUAGE plpgsql AS $$
DECLARE b anvil.role_bindings%ROWTYPE;s anvil.agent_sessions%ROWTYPE;c anvil.commands%ROWTYPE;d anvil.connection_definition_versions%ROWTYPE;cid uuid;pid uuid;
BEGIN
 -- FN03_MANAGEMENT_TRIGGER_BEGIN
 IF TG_OP IN('INSERT','UPDATE') THEN
  IF TG_TABLE_NAME='commands' THEN
   IF NEW.operation='defineSourceContentPolicy' THEN PERFORM anvil.fn03_management_dispatch(TG_TABLE_NAME,to_jsonb(NEW));RETURN NULL;END IF;
  ELSIF TG_TABLE_NAME='authorization_receipts' THEN
   IF NEW.scope_kind='PROJECT' AND EXISTS(SELECT 1 FROM anvil.commands x WHERE x.project_id=NEW.scope_id AND x.id=NEW.command_id AND x.operation='defineSourceContentPolicy') THEN
    PERFORM anvil.fn03_management_dispatch(TG_TABLE_NAME,to_jsonb(NEW));RETURN NULL;
   END IF;
  ELSIF TG_TABLE_NAME='audit_events' THEN
   IF EXISTS(SELECT 1 FROM anvil.commands x WHERE x.project_id=NEW.project_id AND x.id=NEW.command_id AND x.operation='defineSourceContentPolicy') THEN
    PERFORM anvil.fn03_management_dispatch(TG_TABLE_NAME,to_jsonb(NEW));RETURN NULL;
   END IF;
  END IF;
 END IF;
 -- FN03_MANAGEMENT_TRIGGER_END
 IF TG_TABLE_NAME='commands' THEN pid=NEW.project_id;cid=NEW.id;ELSIF TG_TABLE_NAME='authorization_receipts' THEN pid=NEW.scope_id;cid=NEW.command_id;ELSE pid=NEW.project_id;cid=NEW.command_id;END IF;
 SELECT * INTO b FROM anvil.role_bindings WHERE project_id=pid AND command_id=cid;
 SELECT * INTO c FROM anvil.commands WHERE project_id=pid AND id=cid;
 IF b.snapshot_json ? 'connectionKind' THEN
  IF b.snapshot_json->'connectionKind' IS DISTINCT FROM '"REGISTERED_DEFINITION"'::jsonb OR c.operation IS DISTINCT FROM 'bindResponsibleSession' OR NOT anvil.fn09_binding_variant(b.snapshot_json) THEN RAISE EXCEPTION 'FN09_REGISTERED_BINDING_COMPLETE_REQUIRED';END IF;
  SELECT * INTO s FROM anvil.agent_sessions WHERE project_id=pid AND session_id=b.session_id;
  SELECT * INTO d FROM anvil.connection_definition_versions WHERE project_id=pid AND connection_id::text=b.snapshot_json->'connectionRef'->>'id' AND version=(b.snapshot_json->'connectionRef'->>'version')::bigint;
  IF s.session_id IS NULL OR s.snapshot_json->'connectionKind' IS DISTINCT FROM b.snapshot_json->'connectionKind' OR b.snapshot_json->'connectionRef' IS DISTINCT FROM s.snapshot_json->'connectionRef' OR d.connection_id IS NULL OR b.snapshot_json->'connectionRef' IS DISTINCT FROM jsonb_build_object('id',d.connection_id,'version',d.version,'contentHash',d.content_hash) OR NOT anvil.connection_definition_proof(d) THEN RAISE EXCEPTION 'FN09_REGISTERED_BINDING_COMPLETE_REQUIRED';END IF;
 ELSIF c.result_ref->'data'->'snapshot' ? 'connectionKind' AND c.operation='bindResponsibleSession' THEN RAISE EXCEPTION 'FN09_REGISTERED_BINDING_COMPLETE_REQUIRED';END IF;
 RETURN NEW;
END;$$;

CREATE OR REPLACE FUNCTION anvil.material_registration_reverse() RETURNS trigger LANGUAGE plpgsql AS $$
DECLARE pid uuid;cid uuid;q anvil.execution_commands%ROWTYPE;rid uuid;ch uuid;row_json jsonb;candidate record;is_material boolean=false;
BEGIN
 -- FN03_MANAGEMENT_TRIGGER_BEGIN
 IF TG_OP IN('INSERT','UPDATE') THEN
  IF TG_TABLE_NAME='commands' THEN
   IF NEW.operation='defineSourceContentPolicy' THEN PERFORM anvil.fn03_management_dispatch(TG_TABLE_NAME,to_jsonb(NEW));RETURN NULL;END IF;
  ELSIF TG_TABLE_NAME='authorization_receipts' THEN
   IF NEW.scope_kind='PROJECT' AND EXISTS(SELECT 1 FROM anvil.commands x WHERE x.project_id=NEW.scope_id AND x.id=NEW.command_id AND x.operation='defineSourceContentPolicy') THEN
    PERFORM anvil.fn03_management_dispatch(TG_TABLE_NAME,to_jsonb(NEW));RETURN NULL;
   END IF;
  ELSIF TG_TABLE_NAME='audit_events' THEN
   IF EXISTS(SELECT 1 FROM anvil.commands x WHERE x.project_id=NEW.project_id AND x.id=NEW.command_id AND x.operation='defineSourceContentPolicy') THEN
    PERFORM anvil.fn03_management_dispatch(TG_TABLE_NAME,to_jsonb(NEW));RETURN NULL;
   END IF;
  END IF;
 END IF;
 -- FN03_MANAGEMENT_TRIGGER_END
 row_json=CASE WHEN TG_OP='DELETE' THEN to_jsonb(OLD) ELSE to_jsonb(NEW) END;pid=(row_json->>'project_id')::uuid;
 IF TG_TABLE_NAME='authorization_receipts' THEN IF row_json->>'scope_kind' IS DISTINCT FROM 'PROJECT' THEN RETURN NULL;END IF;pid=(row_json->>'scope_id')::uuid;END IF;
 IF TG_TABLE_NAME IN('execution_material_manifests','execution_materials') THEN cid=(row_json->>'created_command_id')::uuid;
 ELSIF TG_TABLE_NAME='execution_commands' THEN cid=(row_json->>'created_command_id')::uuid;
 ELSIF TG_TABLE_NAME='commands' THEN cid=(row_json->>'id')::uuid;
 ELSIF TG_TABLE_NAME IN('authorization_receipts','audit_events','executions','execution_grants','delivery_outbox') THEN cid=(row_json->>'command_id')::uuid;
 ELSIF TG_TABLE_NAME IN('usage_reservations','writer_claims') THEN cid=(row_json->>'created_command_id')::uuid;
 END IF;
 IF cid IS NOT NULL THEN
  IF EXISTS(SELECT 1 FROM anvil.execution_material_manifests WHERE project_id=pid AND created_command_id=cid) OR EXISTS(SELECT 1 FROM anvil.execution_materials WHERE project_id=pid AND created_command_id=cid) THEN
   IF NOT COALESCE(anvil.material_registration_complete(pid,cid),false) THEN RAISE EXCEPTION 'MATERIAL_REGISTRATION_ATOMIC_REQUIRED';END IF;
  ELSE
   SELECT * INTO q FROM anvil.execution_commands WHERE project_id=pid AND created_command_id=cid;
   IF q.id IS NOT NULL AND (q.snapshot_json->'envelope'->>'operation' IN('SEND_INSTRUCTION','START_SESSION') OR q.snapshot_json->>'state' IN('SYNTHETIC_INSTRUCTION_QUEUED','SYNTHETIC_QUEUED')) THEN RAISE EXCEPTION 'MATERIAL_REGISTRATION_MISSING';END IF;
  END IF;
 END IF;
 IF TG_TABLE_NAME='execution_material_proof_bindings' THEN rid=(row_json->>'proof_result_id')::uuid;
 ELSIF TG_TABLE_NAME='execution_receipts' THEN rid=(row_json->>'id')::uuid;
 ELSIF TG_TABLE_NAME='execution_challenges' THEN ch=(row_json->>'id')::uuid;SELECT id INTO rid FROM anvil.execution_receipts WHERE project_id=pid AND challenge_id=ch;
 END IF;
 IF rid IS NOT NULL THEN
  IF EXISTS(SELECT 1 FROM anvil.execution_material_proof_bindings WHERE project_id=pid AND proof_result_id=rid) THEN
   IF NOT COALESCE(anvil.material_binding_complete(pid,rid),false) THEN RAISE EXCEPTION 'MATERIAL_BINDING_ATOMIC_REQUIRED';END IF;
  ELSE
   IF COALESCE(anvil.material_target_required(pid,rid),false) THEN RAISE EXCEPTION 'MATERIAL_BINDING_MISSING';END IF;
  END IF;
 END IF;RETURN NULL;
END;$$;
