-- 0085의 발급 영수증으로만 명령 조회 challenge를 인증한다. 입력 token 원문은 SQL로 전달하지 않는다.
BEGIN;
CREATE FUNCTION anvil.normal_request_credential(token_hash text,cid uuid,eid uuid,gid uuid,ver bigint,gh text,gen bigint)
RETURNS TABLE(project_id uuid,credential_ref jsonb,expires_at timestamptz) LANGUAGE plpgsql AS $$
DECLARE r anvil.execution_receipts%ROWTYPE; v1 anvil.execution_challenges%ROWTYPE; v2 anvil.execution_challenges%ROWTYPE;
 ec anvil.execution_credentials%ROWTYPE; cur record; s jsonb; cr jsonb;
BEGIN
 IF token_hash IS NULL OR token_hash !~ '^[0-9a-f]{64}$' THEN RETURN;END IF;
 SELECT x.* INTO r FROM anvil.execution_receipts x WHERE x.snapshot_json->>'kind'='NORMAL_CREDENTIAL_ISSUED'
  AND x.snapshot_json->>'tokenDigest'=token_hash AND x.grant_id=gid AND x.grant_version=ver
  AND x.snapshot_json#>>'{binding,executionId}'=eid::text AND x.snapshot_json#>>'{binding,connectorId}'=cid::text
  AND x.snapshot_json#>>'{binding,grantRef,contentHash}'=gh AND x.snapshot_json#>'{binding,credentialGeneration}'=to_jsonb(gen);
 IF NOT FOUND THEN RETURN;END IF;
 s=r.snapshot_json;cr=jsonb_build_object('id',r.id,'version',r.version,'contentHash',r.content_hash);
 IF r.version<>1 OR r.challenge_version<>1 OR r.content_hash IS DISTINCT FROM anvil.execution_json_hash(s)
  OR NOT anvil.execution_json_shape(s,ARRAY['kind','purpose','binding','reservationRef','challengeRef','requestId','packetHash','tokenDigest','issuedAt','expiresAt','storageEvidenceRefs','storageExpiresAt'])
  OR jsonb_typeof(s->'packetHash') IS DISTINCT FROM 'string' OR s->>'packetHash' !~ '^[0-9a-f]{64}$'
  OR s->>'purpose' IS DISTINCT FROM 'EXECUTION_DISPATCH_ONLY' OR s#>>'{binding,transport}' IS DISTINCT FROM 'NORMAL_PROTECTED'
  OR NOT anvil.execution_iso_valid(s->'issuedAt') OR NOT anvil.execution_iso_valid(s->'expiresAt') OR NOT anvil.execution_iso_valid(s->'storageExpiresAt')
  OR NOT anvil.normal_credential_reservation_valid(r.project_id,gid,ver) THEN RETURN;END IF;
 SELECT x.* INTO ec FROM anvil.execution_credentials x WHERE x.project_id=r.project_id AND x.grant_id=gid AND x.grant_version=ver AND x.credential_generation=gen;
 IF NOT FOUND OR ec.snapshot_json->>'state' IS DISTINCT FROM 'RESERVED_NO_TOKEN'
  OR s->'reservationRef' IS DISTINCT FROM jsonb_build_object('id',ec.id,'version',ec.version,'contentHash',ec.content_hash) THEN RETURN;END IF;
 SELECT x.* INTO v1 FROM anvil.execution_challenges x WHERE x.project_id=r.project_id AND x.id=r.challenge_id AND x.version=1;
 IF NOT FOUND OR v1.grant_id<>gid OR v1.grant_version<>ver OR v1.content_hash IS DISTINCT FROM anvil.execution_json_hash(v1.snapshot_json)
  OR v1.snapshot_json->'binding' IS DISTINCT FROM s->'binding' OR v1.snapshot_json#>>'{publicChallenge,purpose}' IS DISTINCT FROM 'CREDENTIAL_EXCHANGE'
  OR v1.snapshot_json#>'{request,requestId}' IS DISTINCT FROM s->'requestId'
  OR (s->>'issuedAt')::timestamptz<(v1.snapshot_json#>>'{publicChallenge,issuedAt}')::timestamptz
  OR (s->>'issuedAt')::timestamptz>=(v1.snapshot_json#>>'{publicChallenge,expiresAt}')::timestamptz
  OR s->'challengeRef' IS DISTINCT FROM jsonb_build_object('id',v1.id,'version',1,'contentHash',v1.content_hash) THEN RETURN;END IF;
 SELECT x.* INTO v2 FROM anvil.execution_challenges x WHERE x.project_id=r.project_id AND x.id=v1.id AND x.version=2;
 IF NOT FOUND OR v2.grant_id<>gid OR v2.grant_version<>ver OR v2.server_sequence<=v1.server_sequence
  OR v2.content_hash IS DISTINCT FROM anvil.execution_json_hash(v2.snapshot_json)
  OR v2.snapshot_json IS DISTINCT FROM (v1.snapshot_json || jsonb_build_object('sequence',v2.server_sequence,'previousRef',s->'challengeRef',
    'consumption',jsonb_build_object('resultRef',cr,'packetHash',s->'packetHash','consumedAt',s->'issuedAt'))) THEN RETURN;END IF;
 SELECT * INTO cur FROM anvil.normal_exchange_current(r.project_id,cid,eid,gid,ver,gh,gen);
 IF NOT FOUND OR cur.binding IS DISTINCT FROM s->'binding' OR (s->>'issuedAt')::timestamptz>cur.observed_at THEN RETURN;END IF;
 expires_at=(s->>'expiresAt')::timestamptz;
 IF expires_at>least((s->>'issuedAt')::timestamptz+interval '15 minutes',(s->>'storageExpiresAt')::timestamptz)
  OR expires_at<=clock_timestamp() THEN RETURN;END IF;
 project_id=r.project_id;credential_ref=cr;RETURN NEXT;
END;
$$;

CREATE FUNCTION anvil.normal_request_challenge_valid(n anvil.execution_challenges,deferred_check boolean) RETURNS boolean LANGUAGE plpgsql AS $$
DECLARE s jsonb=n.snapshot_json;b jsonb=s->'binding';r jsonb=s->'request';t jsonb=r->'target';p jsonb=s->'publicChallenge';
 ref jsonb=s->'credentialRef';receipt anvil.execution_receipts%ROWTYPE;cred record;cur record;at_time timestamptz;ends timestamptz;
 total bigint;recent bigint;live bigint;last_seq bigint;
BEGIN
 IF n.version<>1 OR n.content_hash IS DISTINCT FROM anvil.execution_json_hash(s) OR octet_length(anvil.execution_authority_canonical(s))>16384
  OR NOT anvil.execution_json_shape(s,ARRAY['sequence','credentialRef','binding','request','requestHash','signedInputHash','serverNonceDigest','publicChallenge','previousRef','consumption'])
  OR s->'previousRef' IS DISTINCT FROM 'null'::jsonb OR s->'consumption' IS DISTINCT FROM 'null'::jsonb OR s->'sequence' IS DISTINCT FROM to_jsonb(n.server_sequence)

  OR NOT anvil.execution_json_shape(r,ARRAY['requestId','purpose','grantRef','credentialGeneration','target','clientNonce','issuedAt'])
  OR r->>'purpose' IS DISTINCT FROM 'EXECUTION_REQUEST' OR r->'grantRef' IS DISTINCT FROM b->'grantRef' OR r->'credentialGeneration' IS DISTINCT FROM b->'credentialGeneration'
  OR jsonb_typeof(r->'requestId') IS DISTINCT FROM 'string' OR r->>'requestId' IS DISTINCT FROM (r->>'requestId')::uuid::text
  OR NOT anvil.execution_json_shape(t,ARRAY['method','path','bodyHash','queryHash']) OR t->>'method' IS DISTINCT FROM 'GET'
  OR t->>'path' IS DISTINCT FROM '/api/v1/connectors/'||(b->>'connectorId')||'/executions/'||(b->>'executionId')||'/commands'
  OR jsonb_typeof(t->'queryHash') IS DISTINCT FROM 'string' OR t->>'queryHash' !~ '^[0-9a-f]{64}$' OR t->>'bodyHash' IS DISTINCT FROM anvil.execution_json_hash('null'::jsonb)
  OR s->>'requestHash' IS DISTINCT FROM anvil.execution_json_hash(r)
  OR s->>'signedInputHash' IS DISTINCT FROM anvil.execution_json_hash(jsonb_build_object('purpose','EXECUTION_CHALLENGE_REQUEST','request',r))
  OR NOT anvil.execution_nonce_valid(r->'clientNonce') OR NOT anvil.execution_nonce_valid(p->'serverNonce')
  OR s->>'serverNonceDigest' IS DISTINCT FROM encode(sha256(decode(translate(p->>'serverNonce','-_','+/')||'=','base64')),'hex')
  OR NOT anvil.execution_iso_valid(r->'issuedAt') OR NOT anvil.execution_iso_valid(p->'issuedAt') OR NOT anvil.execution_iso_valid(p->'expiresAt')
  OR p IS DISTINCT FROM jsonb_build_object('id',n.id,'requestId',r->'requestId','purpose','EXECUTION_REQUEST','grantRef',b->'grantRef',
   'credentialGeneration',r->'credentialGeneration','scopeDigest',b->'scopeDigest','serverNonce',p->'serverNonce','clientNonce',r->'clientNonce','issuedAt',p->'issuedAt','expiresAt',p->'expiresAt')
 THEN RETURN false;END IF;
 SELECT * INTO receipt FROM anvil.execution_receipts WHERE project_id=n.project_id AND grant_id=n.grant_id AND grant_version=n.grant_version AND id=(ref->>'id')::uuid;
 IF NOT FOUND OR current_setting('anvil.normal_request_verified',true) IS DISTINCT FROM
    txid_current()::text||':'||n.content_hash||':'||(ref->>'contentHash')||':'||(receipt.snapshot_json->>'tokenDigest') THEN RETURN false;END IF;
 SELECT * INTO cred FROM anvil.normal_request_credential(receipt.snapshot_json->>'tokenDigest',(b->>'connectorId')::uuid,(b->>'executionId')::uuid,
  n.grant_id,n.grant_version,b#>>'{grantRef,contentHash}',(r->>'credentialGeneration')::bigint);
 IF NOT FOUND OR cred.credential_ref IS DISTINCT FROM ref OR cred.project_id<>n.project_id OR receipt.snapshot_json->'binding' IS DISTINCT FROM b THEN RETURN false;END IF;
 SELECT * INTO cur FROM anvil.normal_exchange_current(n.project_id,(b->>'connectorId')::uuid,(b->>'executionId')::uuid,n.grant_id,n.grant_version,
  b#>>'{grantRef,contentHash}',(r->>'credentialGeneration')::bigint);
 IF NOT FOUND OR cur.binding IS DISTINCT FROM b THEN RETURN false;END IF;
 at_time=(p->>'issuedAt')::timestamptz;ends=(p->>'expiresAt')::timestamptz;
 IF at_time>cur.observed_at OR abs(extract(epoch FROM (r->>'issuedAt')::timestamptz-at_time))>30
  OR ends<=clock_timestamp() OR ends>least(at_time+interval '30 seconds',cred.expires_at,cur.deadline) THEN RETURN false;END IF;
 SELECT count(*) FILTER(WHERE v.version=1),coalesce(max(v.server_sequence),0),
  count(*) FILTER(WHERE v.version=1 AND v.snapshot_json->'credentialRef'=ref AND v.snapshot_json#>>'{publicChallenge,purpose}'='EXECUTION_REQUEST'
    AND (v.snapshot_json#>>'{publicChallenge,issuedAt}')::timestamptz>at_time-interval '1 minute'),
  count(*) FILTER(WHERE v.version=1 AND v.snapshot_json->'credentialRef'=ref AND v.snapshot_json#>>'{publicChallenge,purpose}'='EXECUTION_REQUEST'
    AND (v.snapshot_json#>>'{publicChallenge,expiresAt}')::timestamptz>at_time AND NOT EXISTS(SELECT 1 FROM anvil.execution_challenges used WHERE used.project_id=v.project_id AND used.id=v.id AND used.version=2))
 INTO total,last_seq,recent,live FROM anvil.execution_challenges v WHERE v.project_id=n.project_id AND v.grant_id=n.grant_id AND v.grant_version=n.grant_version
  AND (NOT deferred_check OR v.server_sequence<n.server_sequence);
 RETURN total<10000 AND recent<60 AND live=0 AND n.server_sequence=last_seq+1;
END;
$$;
CREATE FUNCTION anvil.guard_normal_request_challenge() RETURNS trigger LANGUAGE plpgsql AS $$
BEGIN
 IF NOT COALESCE(anvil.normal_request_challenge_valid(NEW::anvil.execution_challenges,TG_WHEN='AFTER'),false) THEN
  RAISE EXCEPTION 'NORMAL_REQUEST_CHALLENGE_DENIED' USING ERRCODE='42501';END IF;
 RETURN NEW;
END;
$$;
-- 기존 normal v1은 교환 발급 guard가 계속 담당한다. v2·합성·불변 이력 trigger는 보존한다.
DROP TRIGGER normal_exchange_issue_guard ON anvil.execution_challenges;
DROP TRIGGER normal_exchange_issue_complete ON anvil.execution_challenges;
CREATE TRIGGER normal_exchange_issue_guard BEFORE INSERT ON anvil.execution_challenges FOR EACH ROW
 WHEN (NEW.version=1 AND NEW.snapshot_json#>>'{binding,transport}'='NORMAL_PROTECTED' AND NEW.snapshot_json#>>'{request,purpose}' IS DISTINCT FROM 'EXECUTION_REQUEST') EXECUTE FUNCTION anvil.guard_normal_exchange_issue();
CREATE CONSTRAINT TRIGGER normal_exchange_issue_complete AFTER INSERT ON anvil.execution_challenges DEFERRABLE INITIALLY DEFERRED FOR EACH ROW
 WHEN (NEW.version=1 AND NEW.snapshot_json#>>'{binding,transport}'='NORMAL_PROTECTED' AND NEW.snapshot_json#>>'{request,purpose}' IS DISTINCT FROM 'EXECUTION_REQUEST') EXECUTE FUNCTION anvil.guard_normal_exchange_issue();
CREATE TRIGGER normal_request_challenge_guard BEFORE INSERT ON anvil.execution_challenges FOR EACH ROW
 WHEN (NEW.version=1 AND NEW.snapshot_json#>>'{binding,transport}'='NORMAL_PROTECTED' AND NEW.snapshot_json#>>'{request,purpose}'='EXECUTION_REQUEST') EXECUTE FUNCTION anvil.guard_normal_request_challenge();
CREATE CONSTRAINT TRIGGER normal_request_challenge_complete AFTER INSERT ON anvil.execution_challenges DEFERRABLE INITIALLY DEFERRED FOR EACH ROW
 WHEN (NEW.version=1 AND NEW.snapshot_json#>>'{binding,transport}'='NORMAL_PROTECTED' AND NEW.snapshot_json#>>'{request,purpose}'='EXECUTION_REQUEST') EXECUTE FUNCTION anvil.guard_normal_request_challenge();
REVOKE ALL ON FUNCTION anvil.normal_request_credential(text,uuid,uuid,uuid,bigint,text,bigint),anvil.normal_request_challenge_valid(anvil.execution_challenges,boolean),anvil.guard_normal_request_challenge() FROM PUBLIC;
GRANT EXECUTE ON FUNCTION anvil.normal_request_credential(text,uuid,uuid,uuid,bigint,text,bigint),anvil.normal_request_challenge_valid(anvil.execution_challenges,boolean),anvil.guard_normal_request_challenge() TO anvil_v3_app;
COMMIT;
