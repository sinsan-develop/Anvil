# syntax=docker/dockerfile:1
# QA-only issuer image. Build from a restricted Git archive containing only
# this Dockerfile, requirements-runtime.txt, and oidc_qa_issuer.py.
FROM python:3.12.8-slim-bookworm@sha256:2199a62885a12290dc9c5be3ca0681d367576ab7bf037da120e564723292a2f0
ARG ANVIL_RELEASE_COMMIT
RUN printf '%s' "$ANVIL_RELEASE_COMMIT" | grep -Eq '^[0-9a-f]{40}$'
LABEL org.opencontainers.image.revision="${ANVIL_RELEASE_COMMIT}"
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /opt/anvil
RUN python -m venv /opt/venv
COPY deploy/wsl/requirements-runtime.txt /tmp/requirements-runtime.txt
RUN /opt/venv/bin/pip install --no-cache-dir -r /tmp/requirements-runtime.txt
COPY deploy/wsl/oidc_qa_issuer.py /opt/anvil/oidc_qa_issuer.py
RUN useradd --system --uid 10001 --create-home --home-dir /home/anvil anvil
USER 10001:10001
ENTRYPOINT ["/opt/venv/bin/python", "/opt/anvil/oidc_qa_issuer.py"]
