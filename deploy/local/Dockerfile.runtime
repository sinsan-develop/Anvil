FROM node:22.23.0-bookworm-slim AS web-build
WORKDIR /opt/anvil
COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/package.json
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY apps/web ./apps/web
RUN npm run web:typecheck && npm run web:build

FROM nginx@sha256:a8b39bd9cf0f83869a2162827a0caf6137ddf759d50a171451b335cecc87d236 AS web
COPY deploy/local/nginx.conf /etc/nginx/nginx.conf
COPY --from=web-build /opt/anvil/apps/web/dist/ /usr/share/nginx/html/
USER 101:101

FROM python:3.12.8-slim-bookworm AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/opt/anvil
WORKDIR /opt/anvil
RUN apt-get update \
    && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/* \
    && python -m venv /opt/venv
COPY deploy/wsl/requirements-runtime.txt /tmp/requirements-runtime.txt
RUN /opt/venv/bin/pip install --no-cache-dir -r /tmp/requirements-runtime.txt
COPY packages ./packages
COPY apps/api ./apps/api
COPY apps/worker ./apps/worker
COPY migrations ./migrations
COPY alembic.ini pyproject.toml ./
COPY --from=web-build /opt/anvil/apps/web/dist/ ./apps/web/dist/
RUN useradd --system --uid 10001 --create-home --home-dir /home/anvil anvil && chown -R anvil:anvil /opt/anvil /home/anvil
USER anvil
