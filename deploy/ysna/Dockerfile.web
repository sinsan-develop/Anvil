FROM node:22.14.0-bookworm-slim AS node-runtime
FROM python:3.12.8-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/opt/anvil ANVIL_PYTHON=/opt/venv/bin/python
WORKDIR /opt/anvil
RUN apt-get update && apt-get install --no-install-recommends -y libpq5 tini && rm -rf /var/lib/apt/lists/* && python -m venv /opt/venv
COPY deploy/ysna/requirements-runtime.txt /tmp/requirements-runtime.txt
RUN /opt/venv/bin/pip install --no-cache-dir -r /tmp/requirements-runtime.txt
COPY packages ./packages
COPY apps/api ./apps/api
COPY migrations ./migrations
COPY alembic.ini pyproject.toml ./
RUN useradd --system --uid 10001 --create-home --home-dir /home/anvil anvil && chown -R anvil:anvil /opt/anvil /home/anvil
USER anvil
EXPOSE 4173
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["/opt/venv/bin/uvicorn", "apps.api.anvil_api.asgi:app", "--host", "0.0.0.0", "--port", "4173"]
