{
  "schema_version": "1.0.0",
  "contract_id": "progress-event-contract-anvil-v1",
  "append_only": true,
  "sequence_rule": "strictly_monotonic_contiguous_within_stream",
  "event_types": [
    "MIGRATED_LEGACY_SNAPSHOT",
    "PACKAGE_STARTED",
    "PACKAGE_COMPLETED",
    "MAIN_PACKAGE_ACCEPTED",
    "PACKAGE_FAILED",
    "PACKAGE_INTERRUPTED",
    "PACKAGE_WAITING_APPROVAL",
    "PACKAGE_RESUMED",
    "HANDOFF_RECORDED",
    "FAILURE_REPORT_ACCEPTED",
    "FAILURE_REPORT_REJECTED",
    "WORKER_LEASE_ISSUED",
    "WORKER_LEASE_REVOKED",
    "WRITE_LEASE_ISSUED",
    "WRITE_LEASE_REVOKED",
    "FENCING_TOKEN_EXPIRED",
    "LEASE_TAKEOVER",
    "PHASE_GATE_DECIDED",
    "DIR_REACHED",
    "DIR_REPORTED",
    "DIR_OWNER_DIRECTION_RECORDED",
    "DIRX_TRIGGERED",
    "DIR_DECISION_REQUESTED",
    "BUDGET_RESERVED",
    "BUDGET_CONSUMED",
    "BUDGET_RECONCILED",
    "PRODUCT_VALIDATION_RECORDED",
    "DEFECT_RECORDED",
    "RELEASE_DECISION_RECORDED",
    "APPLY_APPROVAL_RECORDED",
    "DEPLOY_APPROVAL_RECORDED",
    "EVIDENCE_MANIFEST_CREATED",
    "EVIDENCE_MANIFEST_INVALIDATED",
    "RELEASE_MANIFEST_CREATED",
    "RELEASE_MANIFEST_INVALIDATED",
    "GIT_COMMIT",
    "GIT_PUSH",
    "DEPLOYMENT_STARTED",
    "DEPLOYMENT_COMPLETED",
    "MONITORING_BOUNDARY_RECORDED"
  ],
  "payload_contracts": {
    "MIGRATED_LEGACY_SNAPSHOT": {"required_details": ["completed_packages"], "effect": "initialize_projection"},
    "PACKAGE_STARTED": {"required_details": ["work_instruction_id", "package_status"], "effect": "package_status_active"},
    "PACKAGE_COMPLETED": {"required_details": ["result_status", "package_status", "accepted"], "effect": "package_result_recorded"},
    "MAIN_PACKAGE_ACCEPTED": {"required_details": ["decision", "test_report_ref", "test_report_sha256", "manifest_ref", "manifest_sha256", "next_work_package"], "effect": "package_accepted_and_next_ready"},
    "PACKAGE_FAILED": {"required_details": ["result_status", "failure_report_ref"], "effect": "package_rework_or_takeover"},
    "PACKAGE_INTERRUPTED": {"required_details": ["reason", "checkpoint_ref"], "effect": "package_interrupted"},
    "PACKAGE_WAITING_APPROVAL": {"required_details": ["approval_ref", "change_classification"], "effect": "package_waiting_approval"},
    "PACKAGE_RESUMED": {"required_details": ["resume_event_ref"], "effect": "package_active"},
    "HANDOFF_RECORDED": {"required_details": ["handoff_ref", "handoff_sha256"], "effect": "handoff_projection_updated"},
    "FAILURE_REPORT_ACCEPTED": {"required_details": ["entry_id", "evidence_ref", "valid_failure_count"], "effect": "failure_projection_incremented"},
    "FAILURE_REPORT_REJECTED": {"required_details": ["entry_id", "reason"], "effect": "failure_projection_unchanged"},
    "WORKER_LEASE_ISSUED": {"required_details": ["lease_id", "fencing_token", "subject_ref"], "effect": "worker_lease_active"},
    "WORKER_LEASE_REVOKED": {"required_details": ["lease_id", "reason"], "effect": "worker_lease_null"},
    "WRITE_LEASE_ISSUED": {"required_details": ["lease_id", "fencing_token", "path_scope"], "effect": "write_lease_active"},
    "WRITE_LEASE_REVOKED": {"required_details": ["lease_id", "reason"], "effect": "write_lease_null"},
    "FENCING_TOKEN_EXPIRED": {"required_details": ["lease_id", "fencing_token"], "effect": "token_rejected"},
    "LEASE_TAKEOVER": {"required_details": ["prior_lease_id", "new_lease_id", "takeover_reason"], "effect": "lease_owner_changed"},
    "PHASE_GATE_DECIDED": {"required_details": ["gate", "verdict", "evidence_ref"], "effect": "phase_gate_projection_updated"},
    "DIR_REACHED": {"required_details": ["checkpoint", "subject_hash", "canonical_trigger"], "effect": "dir_hold"},
    "DIR_REPORTED": {"required_details": ["checkpoint", "subject_hash", "report_ref"], "effect": "dir_waiting_owner_direction"},
    "DIR_OWNER_DIRECTION_RECORDED": {"required_details": ["checkpoint", "subject_hash", "direction"], "effect": "dir_clearance_eligible"},
    "DIRX_TRIGGERED": {"required_details": ["verification_id", "target_hash", "severity"], "effect": "dir_x_hold"},
    "DIR_DECISION_REQUESTED": {"required_details": ["decision_request_ref", "reason"], "effect": "dir_decision_pending"},
    "BUDGET_RESERVED": {"required_details": ["reservation_id", "amount", "unit"], "effect": "budget_reserved"},
    "BUDGET_CONSUMED": {"required_details": ["reservation_id", "amount", "unit"], "effect": "budget_consumed"},
    "BUDGET_RECONCILED": {"required_details": ["reservation_id", "final_amount", "unit"], "effect": "budget_reconciled"},
    "PRODUCT_VALIDATION_RECORDED": {"required_details": ["validation_ref", "result", "evidence_ref"], "effect": "product_validation_projection_updated"},
    "DEFECT_RECORDED": {"required_details": ["defect_ref", "severity", "blocking"], "effect": "defect_projection_updated"},
    "RELEASE_DECISION_RECORDED": {"required_details": ["release_decision_ref", "decision", "human_actor"], "effect": "release_projection_updated"},
    "APPLY_APPROVAL_RECORDED": {"required_details": ["approval_ref", "target_hash", "human_actor"], "effect": "apply_approval_bound"},
    "DEPLOY_APPROVAL_RECORDED": {"required_details": ["approval_ref", "target_hash", "human_actor"], "effect": "deploy_approval_bound"},
    "EVIDENCE_MANIFEST_CREATED": {"required_details": ["manifest_ref", "manifest_sha256", "target_hash"], "effect": "latest_evidence_manifest_updated"},
    "EVIDENCE_MANIFEST_INVALIDATED": {"required_details": ["manifest_ref", "reason"], "effect": "evidence_invalidated"},
    "RELEASE_MANIFEST_CREATED": {"required_details": ["manifest_ref", "manifest_sha256", "target_hash"], "effect": "release_manifest_updated"},
    "RELEASE_MANIFEST_INVALIDATED": {"required_details": ["manifest_ref", "reason"], "effect": "release_manifest_invalidated"},
    "GIT_COMMIT": {"required_details": ["branch", "commit", "evidence_ref"], "effect": "repository_local_head_updated"},
    "GIT_PUSH": {"required_details": ["remote", "branch", "local_commit", "remote_commit", "evidence_ref"], "effect": "repository_remote_head_updated"},
    "DEPLOYMENT_STARTED": {"required_details": ["environment", "release_manifest_ref", "commit"], "effect": "deployment_active"},
    "DEPLOYMENT_COMPLETED": {"required_details": ["environment", "release_manifest_ref", "commit", "evidence_ref"], "effect": "deployment_complete"},
    "MONITORING_BOUNDARY_RECORDED": {"required_details": ["environment", "window", "evidence_ref"], "effect": "monitoring_boundary_complete"}
  }
}
