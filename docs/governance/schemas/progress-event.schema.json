{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://envil.sinsan.kr/schemas/progress-event.schema.json",
  "title": "Anvil append-only progress event stream",
  "type": "object",
  "required": ["schema_version", "stream_id", "first_sequence", "last_sequence", "events"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "stream_id": {"type": "string", "minLength": 1},
    "first_sequence": {"type": "integer", "minimum": 1},
    "last_sequence": {"type": "integer", "minimum": 1},
    "last_event_id": {"type": "string", "minLength": 1},
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["event_id", "sequence", "event_type", "occurred_at", "actor", "subject_ref", "details"]
      }
    }
  },
  "additionalProperties": false
}
